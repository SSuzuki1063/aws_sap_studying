---
// ResourceLayout.astro — shared layout for all 258+ content pages
// Replaces the boilerplate HTML (head, sidebar TOC, nav header, breadcrumb,
// progress bar, scroll-to-top, bottom nav, home button, footer, scripts).
import SidebarTOC from '../components/SidebarTOC.astro';
import FixedNavHeader from '../components/FixedNavHeader.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageBottomNav from '../components/PageBottomNav.astro';
import HomeButton from '../components/HomeButton.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  pageTitle: string;
  category: string;
  categoryLabel: string;
  subcategory?: string;
  slug: string;
  pageCss?: string;
  tocItems: Array<{ level: string; id: string; text: string }>;
  prevPage?: string;
  nextPage?: string;
  pageNum: number;
  pageTotal: number;
}

const {
  title,
  pageTitle,
  category,
  categoryLabel,
  subcategory,
  slug,
  pageCss,
  tocItems,
  prevPage,
  nextPage,
  pageNum,
  pageTotal,
} = Astro.props;

const base = '/aws_sap_studying';
---

<!DOCTYPE html>

<html lang="ja">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>
   {pageTitle}
  </title>
<!-- 共通CSSファイル（データ駆動アーキテクチャ） -->
<link href={`${base}/css/page-base.css`} rel="stylesheet"/>
<link href={`${base}/css/variables.css`} rel="stylesheet"/>
<link href={`${base}/css/layout.css`} rel="stylesheet"/>
<link href={`${base}/css/responsive.css`} rel="stylesheet"/>
  <!-- ページ固有CSSファイル -->
  <link href={`${base}/css/common.css`} rel="stylesheet"/><link href={`${base}/css/components/sidebar-toc.css`} rel="stylesheet"/>{pageCss && <link href={pageCss} rel="stylesheet"/>}
<link href={`${base}/css/components/page-bottom-nav.css`} rel="stylesheet"/>
</head>
<body>

<SidebarTOC tocItems={tocItems} />

<FixedNavHeader />

<!-- 読書進捗インジケーター -->
<div aria-label="ページ読書進捗" aria-valuemax="100" aria-valuemin="0" aria-valuenow="0" class="reading-progress" id="readingProgress" role="progressbar">
<div class="reading-progress-bar" id="readingProgressBar">
</div>
</div>
<!-- トップに戻るボタン -->
<button aria-label="ページトップに戻る" class="scroll-to-top" id="scrollToTop" title="トップに戻る">
   ↑
  </button>
<div class="container">
<!-- ブレッドクラムナビゲーション -->
<Breadcrumb
  categoryLabel={categoryLabel}
  subcategory={subcategory}
  currentTitle={title}
/>

<!-- ページコンテンツ (slot) -->
<slot />

<!-- ページ下部ナビゲーション -->
<PageBottomNav
  prevPage={prevPage}
  nextPage={nextPage}
  pageNum={pageNum}
  pageTotal={pageTotal}
/>

</div>

<HomeButton />
<Footer />

<!-- 外部JS -->
<script is:inline src={`${base}/js/sidebar-toc.js`}></script>
<script is:inline src={`${base}/js/scroll-progress.js`}></script>
<script is:inline src={`${base}/js/mobile-nav.js`}></script>
</body>
</html>
