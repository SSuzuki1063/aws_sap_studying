---
// BaseLayout.astro — minimal shell for special pages (index, quiz, roadmap, etc.)
// Only provides the HTML document wrapper. Page-specific CSS/JS loaded via slots.
interface Props {
  pageTitle: string;
  extraHead?: string;
}

const { pageTitle } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{pageTitle}</title>
<slot name="head" />
</head>
<body>
<slot />
</body>
</html>
