---
// BaseLayout.astro — minimal shell for special pages (index, quiz, roadmap, etc.)
// Only provides the HTML document wrapper. Page-specific CSS/JS loaded via slots.
interface Props {
  pageTitle: string;
  extraHead?: string;
}

const { pageTitle } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{pageTitle}</title>
<!-- Google Fonts: Inter -->
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<!-- FOUC prevention: apply dark mode before paint -->
<script is:inline>
(function(){var t=localStorage.getItem('theme');if(!t)t=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t)})();
</script>
<slot name="head" />
</head>
<body>
<slot />
</body>
</html>
