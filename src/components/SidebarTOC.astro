---
// Sidebar Table of Contents component
// Receives tocItems: Array<{ level: 'h2'|'h3', id: string, text: string }>
interface Props {
  tocItems: Array<{ level: string; id: string; text: string }>;
}

const { tocItems } = Astro.props;
---

<!-- 左サイドバー目次 -->
<div id="sidebar-toc" class="sidebar-toc">
    <div class="sidebar-toc-header">
        <h2>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" role="img" aria-label="目次アイコン">
                <rect x="1" y="2" width="6" height="1.5" rx="0.75" fill="currentColor" opacity="0.4"/>
                <rect x="1" y="5.5" width="10" height="1.5" rx="0.75" fill="currentColor"/>
                <rect x="1" y="9" width="8" height="1.5" rx="0.75" fill="currentColor" opacity="0.7"/>
                <rect x="1" y="12.5" width="11" height="1.5" rx="0.75" fill="currentColor" opacity="0.4"/>
            </svg>
            目次
        </h2>
    </div>
    <nav class="sidebar-toc-content" aria-label="ページ目次">
        <ul>
            {tocItems.map((item) => (
                <li class={`toc-${item.level}`}>
                    <a href={`#${item.id}`} set:html={item.text} />
                </li>
            ))}
        </ul>
    </nav>
</div>

<!-- サイドバー折りたたみボタン -->
<button id="sidebar-toc-toggle" class="sidebar-toc-toggle" onclick="toggleSidebarTOC()" aria-label="目次を開閉">
    <span id="sidebar-toc-toggle-icon">◀</span>
</button>
