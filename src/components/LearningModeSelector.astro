---
// LearningModeSelector — renders a grid of learning mode cards
// Each card applies preset filters when clicked (client-side JS in index.js)
import type { LearningMode } from '../data/resources';

interface Props {
  modes: LearningMode[];
}

const { modes } = Astro.props;
---

<section class="learning-mode-section" aria-labelledby="learning-modes-heading">
  <h3 id="learning-modes-heading"><span aria-hidden="true">🎓</span> 学習モードを選択</h3>
  <div class="learning-mode-grid" role="group" aria-label="学習モード選択">
    {modes.map((mode) => (
      <button
        class="learning-mode-card"
        data-mode-id={mode.id}
        data-mode-filters={JSON.stringify(mode.filters)}
        aria-pressed="false"
        aria-describedby={`mode-desc-${mode.id}`}
      >
        <span class="learning-mode-icon" aria-hidden="true">{mode.icon}</span>
        <span class="learning-mode-title">{mode.title}</span>
        <span class="learning-mode-desc" id={`mode-desc-${mode.id}`}>{mode.description}</span>
      </button>
    ))}
  </div>
</section>
