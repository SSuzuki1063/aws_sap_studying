---
// CategorySection — renders a section (subcategory) with heading and resources
// Replaces renderSection() from render.js
import type { Section } from '../data/resources';
import ResourceList from './ResourceList.astro';
import { generateSectionSlug } from '../utils/slug';

interface Props {
  section: Section;
}

const { section } = Astro.props;
const sectionId = generateSectionSlug(section.title);

// Freshness badge logic (matches render.js renderFreshnessBadge)
function getFreshnessBadge(dateStr: string): { text: string; cls: string } | null {
  if (!dateStr) return null;
  const now = new Date();
  const updated = new Date(dateStr + 'T00:00:00');
  const diffDays = Math.floor((now.getTime() - updated.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays <= 14) return { text: '最近更新', cls: 'freshness-recent' };
  if (diffDays <= 60) return { text: '更新済み', cls: 'freshness-moderate' };
  return null;
}

const badge = getFreshnessBadge(section.lastUpdated);
---

<div class="toc-section">
  <h2 id={sectionId}>
    <span class="section-icon">{section.icon}</span>
    {section.title}
    <span class="resource-count">{section.count}</span>
    {badge && <span class={`freshness-badge ${badge.cls}`}>{badge.text}</span>}
  </h2>
  <ResourceList resources={section.resources} />
</div>
