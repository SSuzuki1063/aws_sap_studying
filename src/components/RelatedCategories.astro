---
import type { Category } from '../data/resources';

interface Props {
  current: string;
  related: string[];
  allCategories: Category[];
}

const { current, related, allCategories } = Astro.props;
const base = '/aws_sap_studying';

const relatedCats = related
  .map(id => allCategories.find(c => c.id === id))
  .filter((c): c is Category => c !== null && c !== undefined);
---

{relatedCats.length > 0 && (
  <section class="related-categories" id="related-categories" aria-labelledby="related-heading">
    <h2 id="related-heading" class="related-categories-title">
      <span aria-hidden="true">🔗</span> 関連カテゴリ
    </h2>
    <div class="related-categories-grid">
      {relatedCats.map(cat => (
        <a href={`${base}/learning-resources/${cat.id}.html`} class="related-category-card">
          <span class="related-category-icon" aria-hidden="true">{cat.icon}</span>
          <div class="related-category-info">
            <span class="related-category-name">{cat.title}</span>
            <span class="related-category-count">{cat.count} resources</span>
          </div>
          <span class="related-category-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
    <div class="related-categories-back">
      <a href={`${base}/learning-resources.html`} class="back-to-hub-link">
        ← 学習リソース トップに戻る
      </a>
    </div>
  </section>
)}
