---
interface Props {
  id: string;
  title: string;
  icon: string;
  count: number;
  description: string;
  color: string;
}

const { id, title, icon, count, description, color } = Astro.props;
const base = '/aws_sap_studying';
---

<a href={`${base}/learning-resources/${id}.html`} class="hub-category-card" style={`--card-accent: ${color}`}>
  <div class="hub-category-card-header">
    <span class="hub-category-card-icon" aria-hidden="true">{icon}</span>
    <div class="hub-category-card-title-group">
      <h3 class="hub-category-card-title">{title}</h3>
      <span class="hub-category-card-count">{count} resources</span>
    </div>
  </div>
  <p class="hub-category-card-desc">{description}</p>
  <span class="hub-category-card-link" aria-hidden="true">
    details &rarr;
  </span>
</a>
