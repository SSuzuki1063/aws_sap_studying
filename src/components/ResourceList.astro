---
// ResourceList — renders a list of resources with bookmark buttons
// Replaces renderResourceList() + renderPriorityGroupedResources() from render.js
import type { Resource } from '../data/resources';

interface Props {
  resources: Resource[];
}

const { resources } = Astro.props;

// Priority configuration (matches render.js PRIORITY_CONFIG)
const PRIORITY_CONFIG: Record<string, { label: string; icon: string; order: number }> = {
  high:   { label: '優先度: 高', icon: '🔴', order: 0 },
  medium: { label: '優先度: 中', icon: '🟡', order: 1 },
  low:    { label: '優先度: 低', icon: '🔵', order: 2 },
};

const DIFFICULTY_LABELS: Record<string, { label: string; badge: string }> = {
  beginner:     { label: '初級', badge: 'difficulty-beginner' },
  intermediate: { label: '中級', badge: 'difficulty-intermediate' },
  advanced:     { label: '上級', badge: 'difficulty-advanced' },
};

// Group by priority
const groups: Record<string, Resource[]> = { high: [], medium: [], low: [] };
for (const r of resources) {
  const p = r.priority || 'medium';
  (groups[p] || groups.medium).push(r);
}
const usedLevels = Object.keys(groups).filter(k => groups[k].length > 0);
const hasPriorityGroups = usedLevels.length > 1;
const sortedLevels = usedLevels.sort((a, b) => PRIORITY_CONFIG[a].order - PRIORITY_CONFIG[b].order);

// Helper to check if resource has any metadata to display
function hasMetadata(resource: Resource): boolean {
  return !!(resource.difficulty || resource.estimated_minutes || resource.exam_domains?.length);
}
---

{hasPriorityGroups ? (
  sortedLevels.map((level) => {
    const config = PRIORITY_CONFIG[level];
    const groupResources = groups[level];
    return (
      <div class="priority-group">
        <h3 class={`priority-sub-header priority-${level}`}>
          <span aria-hidden="true">{config.icon}</span>
          {config.label}
          <span class="priority-count">{groupResources.length}</span>
        </h3>
        <ul class="resource-list">
          {groupResources.map((resource) => (
            <li
              data-service={resource.service || ''}
              data-difficulty={resource.difficulty || ''}
              data-domains={resource.exam_domains?.join(',') || ''}
              data-minutes={resource.estimated_minutes || ''}
              data-tags={resource.tags?.join(',') || ''}
            >
              <a href={resource.href}>{resource.title}</a>
              {hasMetadata(resource) && (
                <div class="resource-meta">
                  {resource.difficulty && DIFFICULTY_LABELS[resource.difficulty] && (
                    <span class={`meta-badge ${DIFFICULTY_LABELS[resource.difficulty].badge}`} aria-label={`難易度: ${DIFFICULTY_LABELS[resource.difficulty].label}`}>
                      {DIFFICULTY_LABELS[resource.difficulty].label}
                    </span>
                  )}
                  {resource.estimated_minutes && (
                    <span class="meta-badge time-badge" aria-label={`所要時間: 約${resource.estimated_minutes}分`}>
                      <span aria-hidden="true">⏱</span>{resource.estimated_minutes}分
                    </span>
                  )}
                  {resource.exam_domains?.map(d => (
                    <span class="meta-badge domain-badge" aria-label={`試験ドメイン ${d}`}>D{d}</span>
                  ))}
                </div>
              )}
              <button class="bookmark-icon" data-href={resource.href} aria-label="ブックマークに追加" title="ブックマークに追加">☆</button>
            </li>
          ))}
        </ul>
      </div>
    );
  })
) : (
  <ul class="resource-list">
    {resources.map((resource) => (
      <li
        data-service={resource.service || ''}
        data-difficulty={resource.difficulty || ''}
        data-domains={resource.exam_domains?.join(',') || ''}
        data-minutes={resource.estimated_minutes || ''}
        data-tags={resource.tags?.join(',') || ''}
      >
        <a href={resource.href}>{resource.title}</a>
        {hasMetadata(resource) && (
          <div class="resource-meta">
            {resource.difficulty && DIFFICULTY_LABELS[resource.difficulty] && (
              <span class={`meta-badge ${DIFFICULTY_LABELS[resource.difficulty].badge}`} aria-label={`難易度: ${DIFFICULTY_LABELS[resource.difficulty].label}`}>
                {DIFFICULTY_LABELS[resource.difficulty].label}
              </span>
            )}
            {resource.estimated_minutes && (
              <span class="meta-badge time-badge" aria-label={`所要時間: 約${resource.estimated_minutes}分`}>
                <span aria-hidden="true">⏱</span>{resource.estimated_minutes}分
              </span>
            )}
            {resource.exam_domains?.map(d => (
              <span class="meta-badge domain-badge" aria-label={`試験ドメイン ${d}`}>D{d}</span>
            ))}
          </div>
        )}
        <button class="bookmark-icon" data-href={resource.href} aria-label="ブックマークに追加" title="ブックマークに追加">☆</button>
      </li>
    ))}
  </ul>
)}
