---
// Page bottom navigation (prev/next page links)
interface Props {
  prevPage?: string;
  nextPage?: string;
  pageNum: number;
  pageTotal: number;
}

const { prevPage, nextPage, pageNum, pageTotal } = Astro.props;
const hasPrev = prevPage && prevPage !== '#';
const hasNext = nextPage && nextPage !== '#';
---

<nav class="page-bottom-nav" aria-label="前後ページナビゲーション">
    {hasPrev ? (
        <a href={prevPage} class="page-bottom-nav-link prev" aria-label="前のページへ">
            <span class="nav-arrow" aria-hidden="true">←</span>
            <span class="nav-label">前のページ</span>
        </a>
    ) : (
        <a href="#" class="page-bottom-nav-link prev disabled" aria-disabled="true" tabindex="-1" aria-label="前のページへ">
            <span class="nav-arrow" aria-hidden="true">←</span>
            <span class="nav-label">前のページ</span>
        </a>
    )}
    <div class="page-bottom-nav-counter" role="status">
        <span class="visually-hidden">ページ </span>
        <span class="current">{pageNum}</span>
        <span class="separator" aria-hidden="true">/</span>
        <span class="total">{pageTotal}</span>
    </div>
    {hasNext ? (
        <a href={nextPage} class="page-bottom-nav-link next" aria-label="次のページへ">
            <span class="nav-label">次のページ</span>
            <span class="nav-arrow" aria-hidden="true">→</span>
        </a>
    ) : (
        <a href="#" class="page-bottom-nav-link next disabled" aria-disabled="true" tabindex="-1" aria-label="次のページへ">
            <span class="nav-label">次のページ</span>
            <span class="nav-arrow" aria-hidden="true">→</span>
        </a>
    )}
</nav>
