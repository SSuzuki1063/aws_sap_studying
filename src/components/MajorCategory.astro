---
// MajorCategory — renders a major category with all its sections
// Replaces renderMajorCategory() from render.js
import type { Category } from '../data/resources';
import CategorySection from './CategorySection.astro';

interface Props {
  category: Category;
}

const { category } = Astro.props;

// networking and security-governance use <section> elements with aria attributes
const useSection = category.id === 'networking' || category.id === 'security-governance';
const Element = useSection ? 'section' : 'div';
---

{useSection ? (
  <section id={category.id} class="major-category" aria-labelledby={`${category.id}-heading`}>
    <h2 id={`${category.id}-heading`} class="major-category-header">
      <span class="major-category-icon" aria-hidden="true">{category.icon}</span>
      {category.title}
      <span class="resource-count">{category.count}</span>
    </h2>
    {category.sections.map((section) => (
      <CategorySection section={section} />
    ))}
  </section>
) : (
  <div id={category.id} class="major-category">
    <h2 class="major-category-header">
      <span class="major-category-icon" aria-hidden="true">{category.icon}</span>
      {category.title}
      <span class="resource-count">{category.count}</span>
    </h2>
    {category.sections.map((section) => (
      <CategorySection section={section} />
    ))}
  </div>
)}
