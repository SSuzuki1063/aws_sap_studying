---
// DomainNav — renders SAP-C02 exam domain navigation with resource counts
import type { ExamDomain, DomainIndexItem } from '../data/resources';

interface Props {
  domains: ExamDomain[];
  domainIndex: DomainIndexItem[];
}

const { domains, domainIndex } = Astro.props;

// Build count lookup
const countMap = new Map(domainIndex.map(d => [d.domainId, d.count]));
---

<section class="domain-nav-section" aria-labelledby="exam-domains-heading">
  <h3 id="exam-domains-heading"><span aria-hidden="true">📋</span> SAP-C02 試験ドメイン</h3>
  <div class="domain-nav-grid" role="group" aria-label="試験ドメインフィルター">
    {domains.map((domain) => {
      const count = countMap.get(domain.id) || 0;
      return (
        <button
          class="domain-card"
          data-domain-id={domain.id}
          aria-pressed="false"
          aria-label={`Domain ${domain.id}: ${domain.title_ja} (${domain.weight}, ${count}件)`}
        >
          <span class="domain-icon" aria-hidden="true">{domain.icon}</span>
          <div class="domain-info">
            <span class="domain-id">Domain {domain.id}</span>
            <span class="domain-title">{domain.title_ja}</span>
          </div>
          <div class="domain-stats">
            <span class="domain-weight">{domain.weight}</span>
            <span class="domain-count">{count}件</span>
          </div>
        </button>
      );
    })}
  </div>
</section>
