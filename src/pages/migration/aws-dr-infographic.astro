                element.style.boxShadow = '0 25px 50px rgba(0,0,0,0.2)';
            }, 3000);
        }

        function calculateStrategy() {
            const revenue = parseInt(document.getElementById('revenue').value) || 0;
            const hourlyLoss = parseInt(document.getElementById('hourly-loss').value) || 0;
            const maxDowntime = document.getElementById('max-downtime').value;
            const budget = parseInt(document.getElementById('budget').value) || 0;
            
            let recommendation = '';
            let strategy = '';
            
            if (maxDowntime === 'minutes' && budget >= 1000) {
                strategy = 'マルチサイトアクティブ/アクティブ';
                recommendation = \`
                    <h4>🏢 \${strategy}がおすすめです！</h4>
                    <p><strong>理由：</strong> 数分の停止も許容できない要件と、十分な予算があります。</p>
                    <p><strong>メリット：</strong> ほぼ無停止、データ損失なし</p>
                    <p><strong>月額コスト目安：</strong> \${budget * 0.8}万円〜</p>
                \`;
            } else if (maxDowntime === 'hours' && budget >= 200) {
                strategy = 'ウォームスタンバイ';
                recommendation = \`
                    <h4>🏠 \${strategy}がおすすめです！</h4>
                    <p><strong>理由：</strong> 数時間での復旧要件と、適度な予算バランスです。</p>
                    <p><strong>メリット：</strong> 迅速な復旧、コストパフォーマンス良好</p>
                    <p><strong>月額コスト目安：</strong> \${budget * 0.6}万円〜</p>
                \`;
            } else if (maxDowntime === 'days' && budget >= 50) {
                strategy = 'パイロットライト';
                recommendation = \`
                    <h4>🕯️ \${strategy}がおすすめです！</h4>
                    <p><strong>理由：</strong> 数日での復旧要件で、コストを抑えたい場合に最適です。</p>
                    <p><strong>メリット：</strong> 適度な復旧時間、リーズナブルなコスト</p>
                    <p><strong>月額コスト目安：</strong> \${budget * 0.4}万円〜</p>
                \`;
            } else {
                strategy = 'バックアップ＆リカバリー';
                recommendation = \`
                    <h4>💾 \${strategy}がおすすめです！</h4>
                    <p><strong>理由：</strong> コストを最小限に抑えつつ、基本的な災害対策を実現できます。</p>
                    <p><strong>メリット：</strong> 低コスト、シンプルな管理</p>
                    <p><strong>月額コスト目安：</strong> \${Math.max(budget * 0.1, 10)}万円〜</p>
                \`;
            }
            
            if (hourlyLoss > 0) {
                const dailyLoss = hourlyLoss * 24;
                recommendation += \`<p><strong>💰 停止コスト分析：</strong> 1日停止すると\${dailyLoss}万円の損失が発生します。</p>\`;
            }
            
            document.getElementById('recommendation-content').innerHTML = recommendation;
            document.getElementById('recommendation').style.display = 'block';
            
            // アニメーション効果
            document.getElementById('recommendation').style.opacity = '0';
            document.getElementById('recommendation').style.transform = 'translateY(20px)';
            
            setTimeout(() => {
                document.getElementById('recommendation').style.transition = 'all 0.5s ease';
                document.getElementById('recommendation').style.opacity = '1';
                document.getElementById('recommendation').style.transform = 'translateY(0)';
            }, 100);
        }

        // ページロード時のアニメーション
        document.addEventListener('DOMContentLoaded', function() {
            // スクロール時のアニメーション
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            });
            
            document.querySelectorAll('.section').forEach(section => {
                observer.observe(section);
            });

            // カードのホバー効果
            document.querySelectorAll('.scenario-card').forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-15px) scale(1.02)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(-10px) scale(1)';
                });
            });

            // 定期的な災害アニメーション
            setInterval(() => {
                const disasterElements = document.querySelectorAll('.disaster-animation');
                disasterElements.forEach(element => {
                    element.style.animation = 'none';
                    setTimeout(() => {
                        element.style.animation = 'pulse 2s infinite';
                    }, 100);
                });
            }, 10000);
        });
  </script>
<div style="text-align: center; padding: 20px; margin-top: 40px; border-top: 2px solid #909296; background-color: #F9FAFB;">
