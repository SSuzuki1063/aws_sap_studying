---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Aws Migration Infographic',
  pageTitle: 'AWS移行戦略7Rと移行サービス群',
  category: 'migration',
  categoryLabel: '移行・転送',
  subcategory: 'Migration Hub & 移行戦略',
  slug: 'aws_migration_infographic',
  pageCss: '/aws_sap_studying/css/pages/aws_migration_infographic.css',
  tocItems: [
    { level: 'h2', id: '移行戦略-7R---あなたの引っ越しスタイルは？', text: '🚚 移行戦略 7R - あなたの引っ越しスタイルは？' },
    { level: 'h2', id: 'AWS移行サービス群---あなたの引っ越しパートナー', text: '🔍 AWS移行サービス群 - あなたの引っ越しパートナー' },
    { level: 'h3', id: '移行プロセスの流れ', text: '🔄 移行プロセスの流れ' }
  ],
  prevPage: 'aws-migration-hub-infographic.html',
  nextPage: 'aws_migration_services_infographic.html',
  pageNum: 6,
  pageTotal: 9,
};

const rawContent = `<div class="header">
<h1>
     🏠 AWS移行戦略 7R と移行サービス群
    </h1>

<p>
     引っ越しで理解する クラウド移行の基本
    </p>
</div>
<div class="section">
<h2 class="section-title" id="移行戦略-7R---あなたの引っ越しスタイルは？">
     🚚 移行戦略 7R - あなたの引っ越しスタイルは？
    </h2>
<div class="strategy-grid">
<div class="strategy-card rehost">
<div class="strategy-icon">
       📦
      </div>
<div class="strategy-title">
       1. Rehost（リホスト）
      </div>
<div class="strategy-description">
<strong>
        リフトアンドシフト
       </strong>
<br/>
       今の家具をそのまま新しい家に運ぶ
      </div>
<div class="strategy-example">
       💡 例：オンプレミスのサーバーをEC2にそのまま移行。最速で移行できるが、クラウドの恩恵は少ない
      </div>
</div>
<div class="strategy-card replatform">
<div class="strategy-icon">
       🔧
      </div>
<div class="strategy-title">
       2. Replatform（リプラットフォーム）
      </div>
<div class="strategy-description">
<strong>
        リフトアンドシフトの改良版
       </strong>
<br/>
       引っ越しと同時に一部をリフォーム
      </div>
<div class="strategy-example">
       💡 例：データベースをRDSに変更しつつ、アプリケーションはそのまま移行。管理負荷を軽減
      </div>
</div>
<div class="strategy-card repurchase">
<div class="strategy-icon">
       🛒
      </div>
<div class="strategy-title">
       3. Repurchase（リパーチェス）
      </div>
<div class="strategy-description">
<strong>
        新しいサービスを購入
       </strong>
<br/>
       家具を買い替えて新調
      </div>
<div class="strategy-example">
       💡 例：自社メールサーバーを廃止してOffice 365を導入。運用コストを大幅削減
      </div>
</div>
<div class="strategy-card refactor">
<div class="strategy-icon">
       🏗️
      </div>
<div class="strategy-title">
       4. Refactor（リファクタリング）
      </div>
<div class="strategy-description">
<strong>
        アーキテクチャを再設計
       </strong>
<br/>
       間取りから全面的に見直し
      </div>
<div class="strategy-example">
       💡 例：モノリシックなアプリをマイクロサービス化してServerlessで構築。最大の効果を得られる
      </div>
</div>
<div class="strategy-card retire">
<div class="strategy-icon">
       🗑️
      </div>
<div class="strategy-title">
       5. Retire（リタイア）
      </div>
<div class="strategy-description">
<strong>
        廃止・撤去
       </strong>
<br/>
       不要な家具は処分
      </div>
<div class="strategy-example">
       💡 例：使われなくなったレガシーシステムを廃止。運用コストとセキュリティリスクを削減
      </div>
</div>
<div class="strategy-card retain">
<div class="strategy-icon">
       🏠
      </div>
<div class="strategy-title">
       6. Retain（リテイン）
      </div>
<div class="strategy-description">
<strong>
        現状維持
       </strong>
<br/>
       今の家にそのまま住み続ける
      </div>
<div class="strategy-example">
       💡 例：法規制や技術的制約でクラウド化が困難なシステムをオンプレミスで維持
      </div>
</div>
<div class="strategy-card relocate">
<div class="strategy-icon">
       🌉
      </div>
<div class="strategy-title">
       7. Relocate（リロケート）
      </div>
<div class="strategy-description">
<strong>
        ハイブリッド移行
       </strong>
<br/>
       二拠点居住のような運用
      </div>
<div class="strategy-example">
       💡 例：VMware環境をAWS上のVMware Cloudに移行。クラウドとオンプレミスの良いとこ取り
      </div>
</div>
</div>
</div>
<div class="section">
<h2 class="section-title" id="AWS移行サービス群---あなたの引っ越しパートナー">
     🔍 AWS移行サービス群 - あなたの引っ越しパートナー
    </h2>
<div class="services-grid">
<div class="service-card">
<div class="service-icon">
       🕵️
      </div>
<div class="service-title">
       Application Discovery Service
      </div>
<div class="service-description">
<strong>
        引っ越し前の家財道具調査員
       </strong>
<br/>
       どんな家具があるか、どこに置いてあるか、どのくらい使っているかを詳細に調査してくれるサービス
      </div>
<div class="service-usecase">
       📋 ユースケース：
       <br/>
       ・オンプレミス環境の現状把握
       <br/>
       ・アプリケーション間の依存関係の発見
       <br/>
       ・リソース使用量の分析
       <br/>
       ・移行計画の策定支援
      </div>
</div>
<div class="service-card">
<div class="service-icon">
       🎯
      </div>
<div class="service-title">
       Migration Hub
      </div>
<div class="service-description">
<strong>
        引っ越し全体のプロジェクトマネージャー
       </strong>
<br/>
       複数の引っ越し業者の作業を統一的に管理し、進捗を一元的に把握できるダッシュボード
      </div>
<div class="service-usecase">
       📊 ユースケース：
       <br/>
       ・複数の移行プロジェクトの統合管理
       <br/>
       ・移行進捗の可視化
       <br/>
       ・移行ツール間の連携
       <br/>
       ・ステークホルダーへの報告
      </div>
</div>
<div class="service-card">
<div class="service-icon">
       📝
      </div>
<div class="service-title">
       CART (Cloud Adoption Readiness Tool)
      </div>
<div class="service-description">
<strong>
        引っ越し準備度チェッカー
       </strong>
<br/>
       あなたの組織がクラウドへの引っ越しにどの程度準備できているかを診断し、改善点を教えてくれるツール
      </div>
<div class="service-usecase">
       ✅ ユースケース：
       <br/>
       ・組織のクラウド準備度評価
       <br/>
       ・移行戦略の検討
       <br/>
       ・スキルギャップの特定
       <br/>
       ・移行計画の優先順位付け
      </div>
</div>
</div>
</div>
<div class="flow-diagram">
<h3 class="flow-title" id="移行プロセスの流れ">
     🔄 移行プロセスの流れ
    </h3>
<div class="flow-steps">
<div class="flow-step">
<div class="step-icon">
       📋
      </div>
<div class="step-text">
       CART で
       <br/>
       準備度診断
      </div>
</div>
<div class="flow-step">
<div class="step-icon">
       🔍
      </div>
<div class="step-text">
       Discovery Service で
       <br/>
       現状把握
      </div>
</div>
<div class="flow-step">
<div class="step-icon">
       📊
      </div>
<div class="step-text">
       Migration Hub で
       <br/>
       計画・管理
      </div>
</div>
<div class="flow-step">
<div class="step-icon">
       🚀
      </div>
<div class="step-text">
       7R戦略で
       <br/>
       実行
      </div>
</div>
</div>
</div>
<div class="tip-box">
<div class="tip-title">
     💡 初心者向けアドバイス
    </div>
<div class="tip-content">
<strong>
      引っ越しと同じく、計画が9割！
     </strong>
<br/>
     まずはCARTで準備度をチェックし、Application Discovery Serviceで現状を正確に把握。そしてMigration Hubで全体を管理しながら、適切な7R戦略を選択することが成功のカギです。小さなシステムから始めて、徐々に大きなシステムに挑戦していきましょう。
    </div>
</div>


</div>
<div style="text-align: center; padding: 20px; margin-top: 40px; border-top: 2px solid #909296; background-color: #F9FAFB;">
<p style="color: #6B7280; font-size: 0.9em; margin: 0;">
    Created by
    <a href="https://github.com/SSuzuki1063" style="color: #dc7600; text-decoration: none; font-weight: 600;" target="_blank">
     SSuzuki1063
    </a>
</p>
<p style="color: #6f7682; font-size: 0.8em; margin: 5px 0 0 0;">
    AWS SAP Learning Resources
   </p>
</div>`;
---

<ResourceLayout {...frontmatter}>
  <Fragment set:html={rawContent} />
</ResourceLayout>
