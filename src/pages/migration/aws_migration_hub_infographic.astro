<script>
   function toggleFaq(element) {
            const answer = element.nextElementSibling;
            const isVisible = answer.style.display !== 'none';
            
            answer.style.display = isVisible ? 'none' : 'block';
            element.style.background = isVisible ? '#0369A1' : '#3a96fe';
        }

        // アニメーション効果
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.analogy-card, .diagram-item, .tool-card');
            
            cards.forEach(card => {
                card.addEventListener('click', function() {
                    this.style.transform = 'scale(1.1) rotate(1deg)';
                    setTimeout(() => {
                        this.style.transform = 'translateY(-10px)';
                    }, 200);
                });
            });

            // スクロール時のアニメーション
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            });
            
            document.querySelectorAll('.section').forEach(section => {
                observer.observe(section);
            });

            // プログレスバーアニメーション
            const progressBars = document.querySelectorAll('.progress-fill');
            progressBars.forEach(bar => {
                const width = bar.style.width;
                bar.style.width = '0%';
                setTimeout(() => {
                    bar.style.width = width;
                }, 1000);
            });

            // ステップアニメーション
            const steps = document.querySelectorAll('.step-item');
            function animateSteps() {
                steps.forEach((step, index) => {
                    setTimeout(() => {
                        step.style.transform = 'translateX(15px) scale(1.02)';
                        step.style.borderLeftColor = '#00f2fe';
                        
                        setTimeout(() => {
                            step.style.transform = 'translateX(0) scale(1)';
                            step.style.borderLeftColor = '#0369A1';
                        }, 800);
                    }, index * 500);
                });
            }
            
            // 15秒ごとにステップアニメーションを実行
            setInterval(animateSteps, 15000);

            // ダッシュボードアニメーション
            const dashboardItems = document.querySelectorAll('.dashboard-item');
            function animateDashboard() {
                dashboardItems.forEach((item, index) => {
                    setTimeout(() => {
                        item.style.animation = 'pulse 1s ease-in-out';
                        setTimeout(() => {
                            item.style.animation = '';
                        }, 1000);
                    }, index * 200);
                });
            }
            
            // 12秒ごとにダッシュボードアニメーションを実行
            setInterval(animateDashboard, 12000);
        });
  </script>
