---
import LearningResourcesLayout from '../layouts/LearningResourcesLayout.astro';
import CategoryQuickNav from '../components/CategoryQuickNav.astro';
import MajorCategory from '../components/MajorCategory.astro';
import { categoriesData, categoryQuickNav, siteStats } from '../data/resources';
import { generateSectionSlug } from '../utils/slug';

const pageTitle = `AWS SAP 学習リソース集 - ${siteStats.totalResources}リソース`;

// Build TOC at compile time
const tocItems = [
  { level: 'h2', id: 'リソース統計', text: 'リソース統計' },
  { level: 'h3', id: 'search-heading', text: '🔍リソースを検索' },
  ...categoriesData.flatMap(cat => [
    { level: 'h2', id: cat.id, text: `${cat.icon} ${cat.title}` },
    ...cat.sections.map(sec => ({
      level: 'h3', id: generateSectionSlug(sec.title), text: `${sec.icon} ${sec.title}`,
    })),
  ]),
];
---

<LearningResourcesLayout pageTitle={pageTitle} tocItems={tocItems}>
<div class="container">
<header class="header">
<h1>📚 AWS SAP 学習リソース集</h1>
<p>{siteStats.majorCategories}カテゴリ、{siteStats.minorCategories}セクション、{siteStats.totalResources}リソース</p>
<div style="margin-top: 20px;">
<a href="index.html" style="color: white; padding: 10px 20px; background: rgba(255,255,255,0.2); border-radius: 8px; text-decoration: none; display: inline-block; transition: all 0.3s;">
  ← リソース集に戻る
</a>
</div>
</header>
<main class="content" id="main-content">
<!-- リソース統計 -->
<div class="stats">
<h2 id="リソース統計">リソース統計</h2>
<div class="stats-grid">
  <div class="stat-item">
    <div class="stat-number">{siteStats.majorCategories}</div>
    <div class="stat-label">大カテゴリ</div>
  </div>
  <div class="stat-item">
    <div class="stat-number">{siteStats.minorCategories}</div>
    <div class="stat-label">セクション</div>
  </div>
  <div class="stat-item">
    <div class="stat-number">{siteStats.totalResources}</div>
    <div class="stat-label">学習リソース</div>
  </div>
</div>
</div>
<!-- 検索セクション (client-side: public/index.js) -->
<div aria-label="リソース検索" class="search-section" role="search">
<h3 id="search-heading"><span aria-hidden="true">🔍</span>リソースを検索</h3>
<div class="search-container">
<input aria-describedby="search-heading" aria-label="リソース検索" autocomplete="off" class="search-input" id="searchInput" placeholder="キーワードを入力してリソースを検索..." type="text"/>
<button aria-label="検索をクリア" class="search-clear" id="searchClear" title="検索をクリア">×</button>
</div>
<div aria-label="検索結果" aria-live="polite" class="search-results" id="searchResults" role="region">
<div class="search-results-header">
  検索結果: <span class="search-results-count" id="searchResultsCount">0</span>件
</div>
<ul class="search-results-list" id="searchResultsList"></ul>
<div class="search-no-results" id="searchNoResults" style="display: none;">
  <div aria-hidden="true" class="search-no-results-icon">🔍</div>
  <p>該当するリソースが見つかりませんでした</p>
  <p style="font-size: 0.9em; margin-top: 10px;">別のキーワードで検索してください</p>
</div>
</div>
</div>
<!-- カテゴリクイックナビゲーション (build-time) -->
<CategoryQuickNav navData={categoryQuickNav} />
<!-- 大カテゴリ (build-time) -->
{categoriesData.map(cat => <MajorCategory category={cat} />)}
<div class="footer-note">
<p>
  すべてのリソースはオフラインで利用可能です<br/>
  詳細な図解とインフォグラフィックで効率的な学習を実現
</p>
</div>
</main>
</div>
</LearningResourcesLayout>
