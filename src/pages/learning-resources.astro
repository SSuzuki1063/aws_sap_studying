---
import LearningResourcesLayout from '../layouts/LearningResourcesLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import LearningModeSelector from '../components/LearningModeSelector.astro';
import DomainNav from '../components/DomainNav.astro';
import { categoriesData, siteStats, examDomains, learningModes, domainIndex } from '../data/resources';
import categoryDescriptions from '../data/category-descriptions.json';
import updateHistory from '../data/update-history.json';

const base = '/aws_sap_studying';
const descriptions = categoryDescriptions as Record<string, { description: string; color: string }>;

const pageTitle = `AWS SAP 学習リソース集 - ${siteStats.totalResources}リソース`;

// Recent updates (latest 5)
const recentUpdates = (updateHistory as Array<{ date: string; title: string; categories: string[] }>).slice(0, 5);

// Priority picks: high priority + advanced resources across all categories (max 10)
const priorityPicks = categoriesData.flatMap(cat =>
  cat.sections.flatMap(sec =>
    sec.resources
      .filter(r => r.priority === 'high' && r.difficulty === 'advanced')
      .map(r => ({ ...r, categoryId: cat.id, categoryTitle: cat.title, categoryIcon: cat.icon }))
  )
).slice(0, 10);

// Build TOC
const tocItems = [
  { level: 'h3', id: 'learning-modes-heading', text: '学習モード' },
  { level: 'h3', id: 'exam-domains-heading', text: '試験ドメイン' },
  { level: 'h3', id: 'search-heading', text: 'リソースを検索' },
  { level: 'h2', id: 'categories', text: 'カテゴリ一覧' },
  { level: 'h2', id: 'recent-updates', text: '最近の更新' },
  { level: 'h2', id: 'priority-picks', text: '直前対策ピックアップ' },
];
---

<LearningResourcesLayout
  pageTitle={pageTitle}
  tocItems={tocItems}
  extraCss={[`${base}/css/pages/learning-resources-hub.css`]}
>
<div class="container">
<header class="header">
<h1>AWS SAP 学習リソース集</h1>
<p>{siteStats.majorCategories}カテゴリ、{siteStats.minorCategories}セクション、{siteStats.totalResources}リソース</p>
<div style="margin-top: 20px;">
<a href="index.html" style="color: white; padding: 10px 20px; background: rgba(255,255,255,0.2); border-radius: 8px; text-decoration: none; display: inline-block; transition: all 0.3s;">
  ← トップに戻る
</a>
</div>
</header>

<main class="content" id="main-content">

<!-- 学習モードセクション -->
<LearningModeSelector modes={learningModes} />

<!-- 試験ドメインナビゲーション -->
<DomainNav domains={examDomains} domainIndex={domainIndex} />

<!-- 検索セクション (client-side: public/index.js) -->
<div aria-label="リソース検索" class="search-section" role="search">
<h3 id="search-heading"><span aria-hidden="true">🔍</span>リソースを検索</h3>
<div class="search-container">
<input aria-describedby="search-heading" aria-label="リソース検索" autocomplete="off" class="search-input" id="searchInput" placeholder="キーワードを入力してリソースを検索..." type="text"/>
<button aria-label="検索をクリア" class="search-clear" id="searchClear" title="検索をクリア">×</button>
</div>
<div aria-label="検索結果" aria-live="polite" class="search-results" id="searchResults" role="region">
<div class="search-results-header">
  検索結果: <span class="search-results-count" id="searchResultsCount">0</span>件
</div>
<ul class="search-results-list" id="searchResultsList"></ul>
<div class="search-no-results" id="searchNoResults" style="display: none;">
  <div aria-hidden="true" class="search-no-results-icon">🔍</div>
  <p>該当するリソースが見つかりませんでした</p>
  <p style="font-size: 0.9em; margin-top: 10px;">別のキーワードで検索してください</p>
</div>
</div>
</div>

<!-- カテゴリ一覧 -->
<section class="hub-categories-section" id="categories" aria-labelledby="categories-heading">
  <h2 id="categories-heading">カテゴリ一覧</h2>
  <p style="color: var(--color-text-secondary, #6b7280); margin-top: 0.25rem;">各カテゴリをクリックすると、詳細な学習ガイドとリソース一覧を表示します</p>
  <div class="hub-categories-grid">
    {categoriesData.map(cat => (
      <CategoryCard
        id={cat.id}
        title={cat.title}
        icon={cat.icon}
        count={cat.count}
        description={descriptions[cat.id]?.description || ''}
        color={descriptions[cat.id]?.color || '#6b7280'}
      />
    ))}
  </div>
</section>

<!-- 最近の更新 -->
<section class="hub-recent-updates" id="recent-updates" aria-labelledby="recent-updates-heading">
  <h2 id="recent-updates-heading">最近の更新</h2>
  <ul class="hub-updates-list">
    {recentUpdates.map(entry => (
      <li class="hub-update-item">
        <span class="hub-update-date">{entry.date}</span>
        <div class="hub-update-content">
          <p class="hub-update-title">{entry.title}</p>
          <div class="hub-update-categories">
            {entry.categories.map(catId => {
              const cat = categoriesData.find(c => c.id === catId);
              return cat ? (
                <a href={`${base}/learning-resources/${catId}.html`} class="hub-update-cat-badge">
                  {cat.icon} {cat.title}
                </a>
              ) : null;
            })}
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<!-- 直前対策ピックアップ -->
{priorityPicks.length > 0 && (
  <section class="hub-priority-picks" id="priority-picks" aria-labelledby="priority-picks-heading">
    <h2 id="priority-picks-heading">直前対策ピックアップ</h2>
    <p style="color: var(--color-text-secondary, #6b7280); margin-top: 0.25rem;">高優先度 × 上級レベルのリソースを厳選</p>
    <div class="hub-picks-grid">
      {priorityPicks.map(r => (
        <a href={r.href} class="hub-pick-card">
          <span class="hub-pick-priority-dot" aria-hidden="true"></span>
          <div class="hub-pick-content">
            <span class="hub-pick-title">{r.title}</span>
            <div class="hub-pick-meta">
              <span class="hub-pick-cat">{r.categoryIcon} {r.categoryTitle}</span>
              {r.estimated_minutes && (
                <span class="hub-pick-cat">⏱ {r.estimated_minutes}分</span>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<div class="footer-note">
<p>
  すべてのリソースはオフラインで利用可能です<br/>
  詳細な図解とインフォグラフィックで効率的な学習を実現
</p>
</div>
</main>
</div>
</LearningResourcesLayout>
