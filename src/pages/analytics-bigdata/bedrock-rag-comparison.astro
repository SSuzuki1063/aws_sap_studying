            <rect x="225" y="260" width="30" height="45" fill="#F97316"/>
            <text x="420" y="284" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="20" font-weight="600" fill="#374151">Word・HTML等</text>

            <!-- Bottom: self service reader -->
            <text x="325" y="345" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="40">🧍‍♂️💨</text>
            <text x="325" y="375" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="18" fill="#475569">セルフサービスで即アクセス</text>
          </g>

          <!-- Caption for left -->
