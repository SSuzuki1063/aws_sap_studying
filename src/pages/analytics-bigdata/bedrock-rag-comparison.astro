          <g>
            <rect x="340" y="148" width="220" height="96" rx="16" fill="#FEFCE8" stroke="#FACC15" stroke-width="2"/>
            <text x="450" y="184" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="22" font-weight="700" fill="#1E293B">✂️ チャンク分割</text>
            <text x="450" y="212" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="20" fill="#475569">段落・意味単位に</text>
          </g>

          <g>
            <rect x="620" y="148" width="220" height="96" rx="16" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
            <text x="730" y="184" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="22" font-weight="700" fill="#1E293B">🔢 埋め込み変換</text>
            <text x="730" y="212" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="20" fill="#475569">Embedding Model</text>
          </g>

          <g>
            <rect x="900" y="148" width="220" height="96" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
            <text x="1010" y="184" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="22" font-weight="700" fill="#1E293B">🗄️ ベクトルDB</text>
            <text x="1010" y="212" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="20" fill="#475569">座標として格納</text>
          </g>

          <!-- Stage 1 Arrows -->
          <line x1="280" y1="196" x2="340" y2="196" stroke="#3B82F6" stroke-width="3" marker-end="url(#arrow-blue)"/>
          <line x1="560" y1="196" x2="620" y2="196" stroke="#3B82F6" stroke-width="3" marker-end="url(#arrow-blue)"/>
