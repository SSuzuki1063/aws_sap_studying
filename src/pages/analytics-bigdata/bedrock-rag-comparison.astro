          <!-- Stage 1 Label -->
          <rect x="60" y="88" width="260" height="36" rx="18" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1"/>
          <text x="190" y="106" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="20" font-weight="600" fill="#92400E">① データ取り込み（事前）</text>

          <!-- Stage 1 Nodes (Row 170) -->
          <g>
            <rect x="60" y="148" width="220" height="96" rx="16" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
