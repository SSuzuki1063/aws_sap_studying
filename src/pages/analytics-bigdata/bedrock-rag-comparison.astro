          <!-- Divider -->
          <line x1="60" y1="280" x2="1140" y2="280" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="5,5"/>

          <!-- Stage 2 Label -->
          <rect x="60" y="300" width="260" height="36" rx="18" fill="#DBEAFE" stroke="#3B82F6" stroke-width="1"/>
          <text x="190" y="318" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="20" font-weight="600" fill="#1E40AF">② 質問→検索→生成（実行時）</text>

          <!-- Stage 2 Nodes (Row 380) -->
          <g>
            <rect x="60" y="360" width="220" height="96" rx="16" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
            <text x="170" y="396" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="22" font-weight="700" fill="#1E293B">👤 ユーザー質問</text>
            <text x="170" y="424" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="20" fill="#475569">「◯◯の手順は？」</text>
          </g>

          <g>
            <rect x="340" y="360" width="220" height="96" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
            <text x="450" y="396" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="22" font-weight="700" fill="#1E293B">🔍 関連文書を検索</text>
            <text x="450" y="424" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-size="20" fill="#475569">ベクトルDBから抽出</text>
          </g>

          <g>
            <rect x="620" y="360" width="220" height="96" rx="16" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
