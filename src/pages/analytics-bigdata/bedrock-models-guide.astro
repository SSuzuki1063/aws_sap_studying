              <text x="1000" y="210" text-anchor="middle" font-size="22" font-weight="700" fill="#1E293B">Bedrock</text>
              <text x="1000" y="240" text-anchor="middle" font-size="20" fill="#475569">(ピザ屋)</text>
              <text x="1000" y="285" text-anchor="middle" font-size="20" fill="#475569">modelIdの中身で</text>
              <text x="1000" y="315" text-anchor="middle" font-size="20" fill="#475569">動きが変わる</text>
            </g>

