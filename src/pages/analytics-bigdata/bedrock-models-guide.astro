            <line x1="760" y1="240" x2="870" y2="240" stroke="#3B82F6" stroke-width="3" marker-end="url(#arrow-primary-1)"/>
            <text x="375" y="225" text-anchor="middle" font-size="20" fill="#3B82F6" font-weight="600">書く</text>
            <text x="815" y="225" text-anchor="middle" font-size="20" fill="#3B82F6" font-weight="600">送る</text>

