  pageTitle: 'Redshift スケーリング手段完全図解',
  category: 'analytics-bigdata',
  categoryLabel: '分析・運用・クイズ',
  subcategory: 'データ分析',
  slug: 'redshift_scaling_infographic',
  pageCss: '/aws_sap_studying/css/pages/redshift_scaling_infographic.css',
  tocItems: [
    { level: 'h2', id: '️-レストラン経営で理解するRedshiftスケーリング', text: '🍽️ レストラン経営で理解するRedshiftスケーリング' },
    { level: 'h3', id: 'Concurrency-Scaling', text: 'Concurrency Scaling' },
    { level: 'h3', id: 'Elastic-Resize', text: 'Elastic Resize' },
