              </tr>
              <tr>
                <th scope="row">最大処理時間</th>
                <td>60秒（ストリーミング8分）</td>
                <td>60秒</td>
                <td><strong>最大1時間</strong></td>
                <td>数時間〜数日</td>
              </tr>
              <tr>
