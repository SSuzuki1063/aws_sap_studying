            <text x="80" y="420" font-size="15" font-weight="700" fill="#6D28D9">&#128229; 応答返却</text>

            <rect x="700" y="430" width="100" height="35" rx="6" fill="#F5F3FF" stroke="#A78BFA" stroke-width="1.5"/>
