      <!-- ==================== SECTION 1: ANALOGY ==================== -->
      <section class="section" id="analogy" aria-label="たとえ話で理解する">
        <div class="section-header">
          <span class="section-icon" aria-hidden="true">&#127979;</span>
          <h2>1. たとえ話：多国籍ホテルのコンシェルジュサービス</h2>
        </div>

        <p>
          DJL Serving の本質は <strong>「フレームワークを問わず、どんな深層学習モデルでも均一に HTTP で配信できる汎用モデルサーバ」</strong> という点にあります。これを <strong>「どの国の言語で話しかけられても対応できる多国籍ホテルのコンシェルジュ」</strong> にたとえて理解しましょう。
        </p>

        <!-- SVG 1: Hotel Concierge Analogy -->
        <div class="svg-container">
          <svg viewBox="0 0 1200 720" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="多国籍ホテルのコンシェルジュのたとえ話。お客様（リクエスト）がホテルフロント（SageMakerエンドポイント）に来訪し、コンシェルジュ（DJL Serving）が多言語の通訳者（各種深層学習モデル）に取り次ぐ様子を示した図。">
            <defs>
              <filter id="dropshadow1" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#0F172A" flood-opacity="0.12"/>
              </filter>
            </defs>

            <!-- Background -->
            <rect x="0" y="0" width="1200" height="720" fill="#F3F4F6"/>
            <text x="600" y="42" text-anchor="middle" font-size="24" font-weight="700" fill="#0F172A">多国籍ホテル = SageMaker AI のエンドポイント</text>
            <text x="600" y="68" text-anchor="middle" font-size="18" fill="#475569">コンシェルジュ（DJL Serving）が、どんな言語のモデルでも取り次ぐ</text>

            <!-- ========== 客（リクエスト） Left ========== -->
            <g>
              <rect x="40" y="140" width="200" height="160" rx="16" fill="#EEF2FF" stroke="#818CF8" stroke-width="2.5" filter="url(#dropshadow1)"/>
              <text x="140" y="180" text-anchor="middle" font-size="36">&#128100;</text>
              <text x="140" y="220" text-anchor="middle" font-size="20" font-weight="700" fill="#3730A3">お客様</text>
              <text x="140" y="248" text-anchor="middle" font-size="17" fill="#475569">アプリ / 推論</text>
              <text x="140" y="272" text-anchor="middle" font-size="17" fill="#475569">リクエスト</text>
            </g>

            <!-- 矢印: 客 → ホテル -->
            <path d="M 245 220 L 335 220" stroke="#3B82F6" stroke-width="3.5" fill="none" marker-end="url(#arrow-req)"/>
            <text x="290" y="208" text-anchor="middle" font-size="15" font-weight="600" fill="#1D4ED8">HTTPS</text>
            <text x="290" y="242" text-anchor="middle" font-size="14" fill="#64748B">InvokeEndpoint</text>

            <!-- ========== ホテル（SageMaker Endpoint） Center ========== -->
            <g>
              <!-- ホテル外観 -->
              <rect x="340" y="110" width="460" height="500" rx="20" fill="#FFFFFF" stroke="#FDBA74" stroke-width="3" filter="url(#dropshadow1)"/>

              <!-- ホテル屋根 -->
              <polygon points="340,110 800,110 770,80 370,80" fill="#FED7AA" stroke="#FDBA74" stroke-width="2.5"/>
              <text x="570" y="102" text-anchor="middle" font-size="18" font-weight="700" fill="#92400E">SageMaker AI エンドポイント（ホテル）</text>

              <!-- フロントデスクの帯 -->
              <rect x="360" y="140" width="420" height="42" rx="10" fill="#FFF7ED" stroke="#FDBA74" stroke-width="1.5"/>
              <text x="570" y="167" text-anchor="middle" font-size="17" font-weight="600" fill="#92400E">&#127976; フロント（HTTP Ingress / InvokeEndpoint API）</text>

              <!-- コンシェルジュ（DJL Serving） -->
              <rect x="390" y="205" width="360" height="150" rx="14" fill="#FEFCE8" stroke="#FACC15" stroke-width="2.5"/>
              <text x="570" y="238" text-anchor="middle" font-size="32">&#128104;&#8205;&#128188;</text>
              <text x="570" y="282" text-anchor="middle" font-size="20" font-weight="700" fill="#854D0E">コンシェルジュ = DJL Serving</text>
              <text x="570" y="310" text-anchor="middle" font-size="16" fill="#475569">「どの言語（フレームワーク）の</text>
              <text x="570" y="332" text-anchor="middle" font-size="16" fill="#475569">依頼でも受け付けます」</text>

              <!-- 通訳チーム見出し -->
              <text x="570" y="392" text-anchor="middle" font-size="17" font-weight="700" fill="#475569">&#128172; 専門通訳チーム（モデル）</text>

              <!-- 通訳者4人（モデル）: 4列均等 -->
              <!-- PyTorch -->
              <g>
                <rect x="360" y="410" width="100" height="92" rx="10" fill="#FEE2E2" stroke="#F87171" stroke-width="2"/>
                <text x="410" y="438" text-anchor="middle" font-size="22">&#128100;</text>
                <text x="410" y="466" text-anchor="middle" font-size="15" font-weight="700" fill="#991B1B">PyTorch</text>
                <text x="410" y="486" text-anchor="middle" font-size="13" fill="#475569">通訳</text>
              </g>
              <!-- TensorFlow -->
              <g>
                <rect x="470" y="410" width="100" height="92" rx="10" fill="#FFEDD5" stroke="#FB923C" stroke-width="2"/>
                <text x="520" y="438" text-anchor="middle" font-size="22">&#128100;</text>
                <text x="520" y="466" text-anchor="middle" font-size="15" font-weight="700" fill="#9A3412">TF</text>
                <text x="520" y="486" text-anchor="middle" font-size="13" fill="#475569">通訳</text>
              </g>
              <!-- ONNX -->
              <g>
                <rect x="580" y="410" width="100" height="92" rx="10" fill="#DBEAFE" stroke="#60A5FA" stroke-width="2"/>
                <text x="630" y="438" text-anchor="middle" font-size="22">&#128100;</text>
                <text x="630" y="466" text-anchor="middle" font-size="15" font-weight="700" fill="#1E40AF">ONNX</text>
                <text x="630" y="486" text-anchor="middle" font-size="13" fill="#475569">通訳</text>
              </g>
              <!-- MXNet -->
              <g>
                <rect x="690" y="410" width="100" height="92" rx="10" fill="#E9D5FF" stroke="#A78BFA" stroke-width="2"/>
                <text x="740" y="438" text-anchor="middle" font-size="22">&#128100;</text>
                <text x="740" y="466" text-anchor="middle" font-size="15" font-weight="700" fill="#6B21A8">MXNet</text>
                <text x="740" y="486" text-anchor="middle" font-size="13" fill="#475569">通訳</text>
              </g>

              <!-- 矢印: コンシェルジュ → 通訳 -->
              <path d="M 500 365 L 410 405" stroke="#64748B" stroke-width="1.8" fill="none" stroke-dasharray="4,3"/>
              <path d="M 540 365 L 520 405" stroke="#64748B" stroke-width="1.8" fill="none" stroke-dasharray="4,3"/>
              <path d="M 600 365 L 630 405" stroke="#64748B" stroke-width="1.8" fill="none" stroke-dasharray="4,3"/>
              <path d="M 640 365 L 740 405" stroke="#64748B" stroke-width="1.8" fill="none" stroke-dasharray="4,3"/>

              <!-- ホテル床ライン -->
              <rect x="360" y="540" width="420" height="40" rx="6" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1"/>
              <text x="570" y="565" text-anchor="middle" font-size="16" font-weight="600" fill="#475569">&#127968; JVM（ホテルの基礎）：マルチスレッドで同時接客</text>
            </g>

            <!-- 矢印: ホテル → 食材倉庫 -->
            <path d="M 810 320 L 890 320" stroke="#10B981" stroke-width="3" fill="none" marker-end="url(#arrow-s3)" stroke-dasharray="8,4"/>
            <text x="850" y="308" text-anchor="middle" font-size="14" font-weight="600" fill="#047857">モデル読込</text>

            <!-- ========== S3（モデル倉庫） Right Top ========== -->
            <g>
              <rect x="895" y="160" width="245" height="200" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2.5" filter="url(#dropshadow1)"/>
              <text x="1017" y="195" text-anchor="middle" font-size="34">&#128230;</text>
              <text x="1017" y="236" text-anchor="middle" font-size="20" font-weight="700" fill="#065F46">Amazon S3</text>
              <text x="1017" y="260" text-anchor="middle" font-size="17" fill="#047857">食材倉庫（モデル倉庫）</text>
              <line x1="920" y1="278" x2="1115" y2="278" stroke="#A7F3D0" stroke-width="1"/>
              <text x="1017" y="302" text-anchor="middle" font-size="16" fill="#475569">• model.tar.gz</text>
              <text x="1017" y="323" text-anchor="middle" font-size="16" fill="#475569">• serving.properties</text>
              <text x="1017" y="344" text-anchor="middle" font-size="16" fill="#475569">• 重みファイル</text>
            </g>

            <!-- ========== ECR / DLC（ホテルチェーン標準設備） Right Bottom ========== -->
            <g>
              <rect x="895" y="400" width="245" height="210" rx="16" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2.5" filter="url(#dropshadow1)"/>
              <text x="1017" y="435" text-anchor="middle" font-size="34">&#127959;&#65039;</text>
              <text x="1017" y="478" text-anchor="middle" font-size="20" font-weight="700" fill="#9A3412">Amazon ECR (DLC)</text>
              <text x="1017" y="502" text-anchor="middle" font-size="17" fill="#9A3412">ホテル標準設備</text>
              <line x1="920" y1="520" x2="1115" y2="520" stroke="#FED7AA" stroke-width="1"/>
              <text x="1017" y="543" text-anchor="middle" font-size="15" fill="#475569">Deep Learning</text>
              <text x="1017" y="563" text-anchor="middle" font-size="15" fill="#475569">Container（AWS 提供）</text>
              <text x="1017" y="590" text-anchor="middle" font-size="15" fill="#64748B">djl-inference / djl-lmi</text>
            </g>

            <!-- 矢印: ホテル → ECR -->
            <path d="M 810 495 L 890 495" stroke="#F97316" stroke-width="3" fill="none" marker-end="url(#arrow-ecr)" stroke-dasharray="8,4"/>
            <text x="850" y="483" text-anchor="middle" font-size="14" font-weight="600" fill="#9A3412">コンテナ</text>

            <!-- 下部キャプション -->
            <rect x="40" y="650" width="1120" height="50" rx="10" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="1"/>
            <text x="600" y="682" text-anchor="middle" font-size="18" fill="#1E293B">
              <tspan font-weight="700" fill="#92400E">ポイント：</tspan>
              <tspan>お客様（アプリ）は「どの通訳が対応するか」を気にする必要なし。コンシェルジュ＝DJL Serving が全てを取り次ぐ。</tspan>
            </text>

            <!-- Arrow defs -->
            <defs>
              <marker id="arrow-req" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto">
                <polygon points="0,0 10,5 0,10" fill="#3B82F6"/>
              </marker>
              <marker id="arrow-s3" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto">
                <polygon points="0,0 10,5 0,10" fill="#10B981"/>
              </marker>
              <marker id="arrow-ecr" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto">
                <polygon points="0,0 10,5 0,10" fill="#F97316"/>
              </marker>
            </defs>
          </svg>
          <p class="svg-caption">図1：多国籍ホテルのコンシェルジュ（DJL Serving）を中心とした推論リクエストの流れ</p>
        </div>

        <h3>たとえ話マッピング表</h3>
        <p>このたとえを AWS の概念に対応付けると次のようになります。以降の章でも、この対応関係を一貫して使います。</p>

        <table class="mapping-table" aria-label="たとえ話マッピング表">
          <thead>
            <tr>
              <th scope="col" class="col-analogy">たとえ話（ホテル）</th>
              <th scope="col" class="col-aws">AWS / 技術要素</th>
              <th scope="col">役割</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="analogy">&#127976; 多国籍ホテル</td>
              <td class="aws">SageMaker AI エンドポイント</td>
              <td>推論リクエストの窓口となる HTTPS サービス</td>
            </tr>
            <tr>
              <td class="analogy">&#128104;&#8205;&#128188; コンシェルジュ</td>
              <td class="aws">DJL Serving（モデルサーバ）</td>
              <td>リクエストを解析し、適切なモデルへルーティング</td>
            </tr>
            <tr>
              <td class="analogy">&#128172; 多言語通訳者</td>
              <td class="aws">各種フレームワークのモデル</td>
              <td>PyTorch / TensorFlow / ONNX / MXNet などの推論処理</td>
            </tr>
            <tr>
              <td class="analogy">&#128230; 食材倉庫</td>
              <td class="aws">Amazon S3（model.tar.gz 格納先）</td>
              <td>学習済みモデル成果物と設定ファイルの保管庫</td>
            </tr>
            <tr>
              <td class="analogy">&#127959;&#65039; ホテル標準設備</td>
              <td class="aws">Amazon ECR / DLC イメージ</td>
              <td>AWS が提供する DJL Serving 入りコンテナ</td>
            </tr>
            <tr>
              <td class="analogy">&#127968; ホテルの基礎（JVM）</td>
              <td class="aws">Java Virtual Machine</td>
              <td>DJL Serving を動かす実行環境（マルチスレッド性能の源）</td>
            </tr>
            <tr>
              <td class="analogy">&#128100; 複数の接客スタッフ</td>
              <td class="aws">Worker（モデルワーカー）</td>
              <td>同時に複数リクエストを処理する並列ユニット</td>
            </tr>
            <tr>
              <td class="analogy">&#128230; ツアー団体客対応</td>
              <td class="aws">Dynamic Batching</td>
              <td>複数リクエストをまとめて効率的に推論</td>
            </tr>
            <tr>
              <td class="analogy">&#128101; 繁忙期の人員増員</td>
              <td class="aws">Auto Scaling（ワーカー単位）</td>
              <td>負荷に応じてワーカー数を自動増減</td>
            </tr>
          </tbody>
        </table>

        <div class="info-box tip">
          <div class="info-box-title"><span aria-hidden="true">&#128161;</span> 本質のひと言</div>
          <p>DJL Serving は、モデルの「国籍（フレームワーク）」を意識せずに、どんなモデルでも同じ入口から推論できるようにする <strong>「翻訳可能な受付係」</strong>。SageMaker AI がそれを「予約済みのホテル」として本番運用可能にする。</p>
        </div>
      </section>


      <!-- ==================== SECTION 2: WHAT IS DJL SERVING ==================== -->
      <section class="section" id="what-is" aria-label="DJL Serving とは">
        <div class="section-header">
          <span class="section-icon" aria-hidden="true">&#10067;</span>
          <h2>2. DJL Serving とは？（結論先出し）</h2>
        </div>

        <div class="info-box note">
          <div class="info-box-title"><span aria-hidden="true">&#128221;</span> 結論</div>
          <p><strong>DJL Serving</strong>（Deep Java Library Serving）は、深層学習モデルを HTTP エンドポイント経由で配信するための <strong>フレームワーク非依存・高性能・Java ベース</strong> のモデルサーバです。Amazon SageMaker AI では、DJL Serving を同梱した <strong>Deep Learning Container（DLC）</strong> を使うことで、モデル成果物を S3 に置くだけで LLM を含むあらゆる深層学習モデルを即座に本番デプロイできます。</p>
        </div>

        <h3>DJL Serving の 6 つの特徴</h3>
        <div class="feature-grid">
          <div class="feature-card">
            <div class="feat-icon" aria-hidden="true">&#127760;</div>
            <div class="feat-title">フレームワーク非依存</div>
            <div class="feat-desc">PyTorch / TensorFlow / ONNX / MXNet / TensorRT / Python スクリプトなど、主要な深層学習モデル形式をすべて扱える。</div>
          </div>
          <div class="feature-card">
            <div class="feat-icon" aria-hidden="true">&#128187;</div>
            <div class="feat-title">デバイス対応が広い</div>
            <div class="feat-desc">CPU / GPU / AWS Inferentia などあらゆるハードウェアに対応。同じ仕組みのまま推論基盤を切り替えられる。</div>
          </div>
          <div class="feature-card">
            <div class="feat-icon" aria-hidden="true">&#9889;</div>
            <div class="feat-title">高パフォーマンス</div>
            <div class="feat-desc">単一 JVM 上でマルチスレッド推論を実行し、スループットを最大化。Python の GIL に縛られない設計。</div>
          </div>
          <div class="feature-card">
            <div class="feat-icon" aria-hidden="true">&#128230;</div>
            <div class="feat-title">Dynamic Batching 内蔵</div>
            <div class="feat-desc">同時到達したリクエストを自動でまとめ、GPU の演算効率を引き上げる。</div>
          </div>
          <div class="feature-card">
            <div class="feat-icon" aria-hidden="true">&#128200;</div>
            <div class="feat-title">Auto Scaling</div>
            <div class="feat-desc">負荷に応じてワーカー数を自動で増減。バースト時もスロットリングを回避しやすい。</div>
          </div>
          <div class="feature-card">
            <div class="feat-icon" aria-hidden="true">&#129302;</div>
            <div class="feat-title">LMI で LLM 最適化</div>
            <div class="feat-desc">Large Model Inference コンテナには vLLM / TensorRT-LLM / DeepSpeed が統合済み。巨大 LLM を分散配信可能。</div>
          </div>
        </div>

        <h3>他のモデルサーバとの比較</h3>
        <p>SageMaker AI は複数のモデルサーバを DLC として提供しています。DJL Serving がどの位置に立つかを整理します。</p>

        <table class="comparison-table" aria-label="モデルサーバ比較表">
          <thead>
            <tr>
              <th scope="col">観点</th>
              <th scope="col" class="highlight">DJL Serving</th>
              <th scope="col">TorchServe</th>
              <th scope="col">TF Serving</th>
              <th scope="col">Triton Inference Server</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="label">対応フレームワーク</td>
              <td>多数（universal）</td>
              <td>PyTorch 中心</td>
              <td>TensorFlow 中心</td>
              <td>多数（universal）</td>
            </tr>
            <tr>
              <td class="label">実装言語</td>
              <td>Java（JVM）</td>
              <td>Java + Python</td>
              <td>C++</td>
              <td>C++</td>
            </tr>
            <tr>
              <td class="label">LLM 分散推論</td>
              <td>LMI（vLLM / TRT-LLM / DeepSpeed）</td>
              <td>限定的</td>
              <td>非対応</td>
              <td>TRT-LLM バックエンド</td>
            </tr>
            <tr>
              <td class="label">Dynamic Batching</td>
              <td>対応</td>
              <td>対応</td>
              <td>対応</td>
              <td>対応（強力）</td>
            </tr>
            <tr>
              <td class="label">SageMaker 統合</td>
              <td>公式 DLC 多数</td>
              <td>公式 DLC あり</td>
              <td>公式 DLC あり</td>
              <td>公式 DLC あり</td>
            </tr>
            <tr>
              <td class="label">推奨ユースケース</td>
              <td><strong>LLM・マルチフレームワーク</strong></td>
              <td>PyTorch 特化</td>
              <td>TF SavedModel 特化</td>
              <td>NVIDIA GPU で最適化</td>
            </tr>
          </tbody>
        </table>

        <div class="info-box tip">
          <div class="info-box-title"><span aria-hidden="true">&#127919;</span> 選び方の指針</div>
          <p>「どのフレームワークで学習しているか不明」「複数モデルを一つのエンドポイントに載せたい」「Hugging Face の LLM を最短で本番化したい」── これらに当てはまるなら <strong>DJL Serving（特に LMI）</strong> が第一選択肢。</p>
        </div>
      </section>


