            <!-- Timeline axis -->
            <line x1="80" y1="480" x2="1120" y2="480" stroke="#475569" stroke-width="2"/>
            <text x="600" y="525" text-anchor="middle" font-size="15" fill="#475569">時間 (ms) →</text>

            <!-- Time marks -->
            <g font-size="12" fill="#64748B">
              <line x1="120" y1="475" x2="120" y2="485" stroke="#475569" stroke-width="1.5"/>
              <text x="120" y="503" text-anchor="middle">0</text>
              <line x1="320" y1="475" x2="320" y2="485" stroke="#475569" stroke-width="1.5"/>
              <text x="320" y="503" text-anchor="middle">20</text>
              <line x1="520" y1="475" x2="520" y2="485" stroke="#475569" stroke-width="1.5"/>
              <text x="520" y="503" text-anchor="middle">40</text>
              <line x1="720" y1="475" x2="720" y2="485" stroke="#475569" stroke-width="1.5"/>
              <text x="720" y="503" text-anchor="middle">60</text>
              <line x1="920" y1="475" x2="920" y2="485" stroke="#475569" stroke-width="1.5"/>
              <text x="920" y="503" text-anchor="middle">80</text>
              <line x1="1080" y1="475" x2="1080" y2="485" stroke="#475569" stroke-width="1.5"/>
              <text x="1080" y="503" text-anchor="middle">100</text>
            </g>

            <!-- Lane 1: Incoming requests -->
            <text x="80" y="110" font-size="15" font-weight="700" fill="#1E40AF">&#128234; リクエスト到着</text>

            <g>
              <rect x="150" y="125" width="70" height="40" rx="6" fill="#DBEAFE" stroke="#3B82F6" stroke-width="1.5"/>
              <text x="185" y="150" text-anchor="middle" font-size="13" font-weight="700" fill="#1D4ED8">Req-1</text>

              <rect x="235" y="125" width="70" height="40" rx="6" fill="#DBEAFE" stroke="#3B82F6" stroke-width="1.5"/>
              <text x="270" y="150" text-anchor="middle" font-size="13" font-weight="700" fill="#1D4ED8">Req-2</text>

              <rect x="320" y="125" width="70" height="40" rx="6" fill="#DBEAFE" stroke="#3B82F6" stroke-width="1.5"/>
