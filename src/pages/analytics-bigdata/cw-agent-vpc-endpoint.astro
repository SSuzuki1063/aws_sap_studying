              <text x="460" y="235" text-anchor="middle" font-size="18" font-weight="600" fill="#1E293B">Gateway</text>
              <text x="460" y="258" text-anchor="middle" font-size="14" fill="#94A3B8">（正面玄関）</text>
            </g>

            <!-- Internet cloud: cx=720, cy=220 -->
            <g>
              <ellipse cx="720" cy="220" rx="100" ry="55" fill="#FEF2F2" stroke="#F87171" stroke-width="2"/>
              <text x="720" y="215" text-anchor="middle" font-size="18" font-weight="600" fill="#991B1B">🌐 インターネット</text>
              <text x="720" y="240" text-anchor="middle" font-size="14" fill="#94A3B8">（公道）</text>
            </g>

            <!-- CloudWatch Logs: cx=1020, cy=160 -->
            <g>
              <rect x="890" y="110" width="250" height="80" rx="14" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
              <text x="1015" y="142" text-anchor="middle" font-size="17" font-weight="600" fill="#1E293B">CloudWatch Logs</text>
              <text x="1015" y="170" text-anchor="middle" font-size="14" fill="#475569">logs.region.amazonaws.com</text>
            </g>

            <!-- CloudWatch Metrics: cx=1020, cy=300 -->
            <g>
              <rect x="890" y="260" width="250" height="80" rx="14" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
              <text x="1015" y="292" text-anchor="middle" font-size="17" font-weight="600" fill="#1E293B">CloudWatch Metrics</text>
              <text x="1015" y="320" text-anchor="middle" font-size="14" fill="#475569">monitoring.region.amazonaws.com</text>
            </g>

            <!-- Arrows -->
