            <text x="655" y="105" text-anchor="middle" font-size="15" font-weight="600" fill="#854D0E">🔍 プライベート DNS（社内電話帳）</text>

            <!-- Private Subnet -->
            <rect x="50" y="120" width="280" height="330" rx="10" fill="#ECFDF5" stroke="#34D399" stroke-width="1.5"/>
            <text x="70" y="148" font-size="16" font-weight="600" fill="#065F46">プライベートサブネット</text>

            <!-- EC2 + Agent: cx=190, cy=250 -->
            <g>
              <rect x="75" y="170" width="230" height="160" rx="14" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
              <text x="190" y="205" text-anchor="middle" font-size="18" font-weight="600" fill="#1E293B">EC2 インスタンス</text>
              <text x="190" y="232" text-anchor="middle" font-size="16" fill="#475569">🔧 CW エージェント</text>
              <text x="190" y="258" text-anchor="middle" font-size="14" fill="#94A3B8">（事務員が報告書を持つ）</text>
              <text x="190" y="290" text-anchor="middle" font-size="14" fill="#6366F1">logs.region.amazonaws.com</text>
              <text x="190" y="310" text-anchor="middle" font-size="14" fill="#6366F1">→ VPC EP のプライベート IP に解決</text>
            </g>

            <!-- VPC Endpoint (Logs): cx=520, cy=200 -->
            <g>
