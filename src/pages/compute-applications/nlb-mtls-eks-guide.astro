            font-size: 0.85em;
            line-height: 1.7;
            overflow-x: auto;
            white-space: pre;
        }

        .code-comment { color: #64748b; }
        .code-key { color: #93c5fd; }
        .code-value { color: #86efac; }
        .code-string { color: #fde68a; }
        .code-highlight { background: rgba(251,191,36,0.1); display: inline; padding: 1px 4px; border-radius: 3px; }

        /* ===== 注釈付きコード ===== */
        .annotated-code {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
            margin-bottom: 20px;
        }

        .annotations {
            display: flex;
            flex-direction: column;
            gap: 12px;
