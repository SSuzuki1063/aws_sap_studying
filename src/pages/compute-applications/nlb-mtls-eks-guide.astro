        .node-active { background: #dbeafe; color: #1d4ed8; border: 2px solid #93c5fd; }
        .node-new { background: #fef3c7; color: #92400e; border: 2px dashed #f59e0b; }

        .scaling-detail {
            font-size: 0.92em;
            color: #475569;
            line-height: 1.7;
        }

        .scaling-detail strong {
