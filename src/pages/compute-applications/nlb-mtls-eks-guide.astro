        .annotation-1 { background: #eff6ff; border-left: 4px solid #3b82f6; }
        .annotation-1 .annotation-title { color: #1d4ed8; }
        .annotation-1 p { color: #1e40af; }

        .annotation-2 { background: #f0fdf4; border-left: 4px solid #10b981; }
        .annotation-2 .annotation-title { color: #059669; }
        .annotation-2 p { color: #047857; }

        .annotation-3 { background: #fefce8; border-left: 4px solid #eab308; }
        .annotation-3 .annotation-title { color: #ca8a04; }
        .annotation-3 p { color: #a16207; }

        .annotation-4 { background: #fdf2f8; border-left: 4px solid #ec4899; }
        .annotation-4 .annotation-title { color: #db2777; }
        .annotation-4 p { color: #be185d; }

        /* ===== オートスケーリング ===== */
        .scaling-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            margin-bottom: 30px;
        }

        .scaling-card {
            background: white;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border-top: 5px solid;
            transition: transform 0.3s ease;
        }

        .scaling-card:hover {
            transform: translateY(-4px);
        }

        .scaling-card-hpa {
            border-color: #ec4899;
        }

        .scaling-card-ca {
            border-color: #f97316;
        }

        .scaling-card-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
        }

        .scaling-card-icon {
            font-size: 2.4em;
        }

        .scaling-card h3 {
            font-size: 1.3em;
            color: #1e293b;
        }

        .scaling-card h3 small {
            display: block;
            font-size: 0.6em;
            color: #64748b;
            font-weight: 400;
        }

        .scaling-visual {
            background: #f8fafc;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 18px;
            text-align: center;
        }

        .scaling-visual-row {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-bottom: 6px;
        }

        .pod-box {
            width: 42px;
            height: 36px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75em;
            font-weight: 600;
            color: white;
        }

        .pod-active { background: #10b981; }
        .pod-new { background: #f59e0b; border: 2px dashed #d97706; }
        .pod-placeholder { background: #e2e8f0; color: #94a3b8; border: 2px dashed #cbd5e1; }

        .node-box {
            padding: 10px 16px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85em;
