        }

        /* ===== トラブルシューティング ===== */
        .troubleshoot-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .trouble-card {
            background: white;
            border-radius: 14px;
