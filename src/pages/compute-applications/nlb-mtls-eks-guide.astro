                <div class="comparison-card card-nlb-tcp">
                    <div class="comparison-card-header">
                        <div class="comparison-card-icon">✅</div>
                        <div>
                            <div class="comparison-card-title">NLB + TCPリスナー</div>
                            <div class="comparison-card-subtitle">レイヤー4 / パススルー</div>
                        </div>
                    </div>
                    <div class="comparison-item">
                        <span class="comparison-item-icon">🔒</span>
