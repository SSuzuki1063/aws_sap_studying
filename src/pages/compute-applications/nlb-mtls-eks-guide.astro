            align-items: flex-start;
            gap: 12px;
        }

        .highlight-box-icon {
            font-size: 1.6em;
            flex-shrink: 0;
        }

        .highlight-box-text {
            color: #92400e;
            font-size: 0.95em;
            line-height: 1.6;
        }

        .highlight-box-text strong {
            color: #78350f;
        }

        .info-box {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 10px;
            padding: 16px 20px;
            margin: 16px 0;
            font-size: 0.9em;
            color: #1e40af;
        }

        .divider {
