        }

        /* ===== 要件マッピング ===== */
        .requirements-section {
            background: linear-gradient(135deg, #fdf4ff 0%, #fae8ff 100%);
            border-radius: 16px;
            padding: 40px;
            margin-bottom: 50px;
            border: 2px solid #e879f9;
        }

        .requirements-section h3 {
            text-align: center;
            color: #86198f;
            font-size: 1.5em;
            margin-bottom: 25px;
        }

        .req-grid {
