            justify-content: center;
            font-size: 0.75em;
            font-weight: 700;
            flex-shrink: 0;
            color: white;
        }

        .comp-without .comp-step-num { background: #ef4444; }
        .comp-with .comp-step-num { background: #10b981; }

        .controller-flow {
            background: white;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            border: 1px solid #e2e8f0;
        }

        .controller-flow h4 {
            text-align: center;
            color: #334155;
            font-size: 1.2em;
            margin-bottom: 20px;
        }

        .cflow-track {
            display: flex;
            align-items: stretch;
            gap: 0;
