</div>
<p>
<strong>
         レストラン例：
        </strong>
        フロントデスクの案内ルール
       </p>
<div class="code-example">
<div class="code-header">
         Terraform設定例
        </div>
<div class="code-line">
<span class="code-keyword">
          resource
         </span>
<span class="code-string">
          "aws_lb_target_group"
         </span>
<span class="code-string">
          "restaurant_app"
         </span>
         {
        </div>
<div class="code-line">
         name     =
         <span class="code-string">
          "restaurant-waiters"
         </span>
</div>
<div class="code-line">
         port     =
         <span class="code-string">
          80
         </span>
</div>
<div class="code-line">
         protocol =
         <span class="code-string">
          "HTTP"
         </span>
</div>
<div class="code-line">
         vpc_id   =
         <span class="code-property">
          var
         </span>
