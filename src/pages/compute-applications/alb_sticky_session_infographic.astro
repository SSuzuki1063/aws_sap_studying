         <span class="code-string">
          86400
         </span>
<span class="code-comment">
          # 24時間
         </span>
</div>
<div class="code-line">
         }
        </div>
<div class="code-line">
         }
        </div>
</div>
</div>
<div class="config-card">
<div class="config-header">
<div class="config-icon">
         📊
        </div>
