<!-- インタラクティブデモ -->
<div class="interactive-demo">
<h2 id="インタラクティブデモ-スティッキーセッションの動作確認" style="margin-bottom: 20px;">
     🎮 インタラクティブデモ：スティッキーセッションの動作確認
    </h2>
<p>
     ボタンを押して、ALBがどのようにセッションを管理するかを体験してみましょう
    </p>
<div class="demo-buttons">
<button class="demo-btn" onclick="simulateNewSession()">
      新規ユーザーアクセス
     </button>
<button class="demo-btn secondary" onclick="simulateReturningUser()">
      既存ユーザーアクセス
     </button>
<button class="demo-btn" onclick="simulateLoadBalancing()">
      負荷分散状況確認
     </button>
<button class="demo-btn danger" onclick="simulateContainerFailure()">
      コンテナ障害シミュレート
     </button>
<button class="demo-btn secondary" onclick="clearSessionDemo()">
      リセット
     </button>
</div>
<div class="demo-result" id="sessionDemoResult">
     ボタンをクリックしてスティッキーセッションの動作を確認してください
    </div>
</div>


</div>
<script is:inline>
   let sessionData = [];
        let containerStatus = {
            'Container-A': { active: true, sessions: 0, load: 0 },
            'Container-B': { active: true, sessions: 0, load: 0 },
            'Container-C': { active: true, sessions: 0, load: 0 },
            'Container-D': { active: true, sessions: 0, load: 0 }
        };

        function simulateNewSession() {
            const userId = 'User-' + Math.floor(Math.random() * 1000);
            const cookieId = 'AWSALB-' + Math.random().toString(36).substr(2, 9);
            
            // 最も負荷の少ないアクティブなコンテナを選択
            const availableContainers = Object.keys(containerStatus).filter(c => containerStatus[c].active);
            const selectedContainer = availableContainers.reduce((a, b) => 
                containerStatus[a].load < containerStatus[b].load ? a : b
            );
            
            const session = {
                userId: userId,
                cookieId: cookieId,
                container: selectedContainer,
                startTime: new Date().toLocaleTimeString(),
                requestCount: 1,
                status: 'active'
            };
            
            sessionData.push(session);
            containerStatus[selectedContainer].sessions++;
            containerStatus[selectedContainer].load += 25;
            
            updateSessionDemo();
        }

        function simulateReturningUser() {
            if (sessionData.length === 0) {
                alert('先に新規ユーザーアクセスを実行してください');
                return;
            }
            
            // ランダムに既存セッションを選択
            const activeSession = sessionData.find(s => s.status === 'active');
            if (!activeSession) {
                alert('アクティブなセッションがありません');
                return;
            }
            
            activeSession.requestCount++;
            
            const accessLog = {
                type: 'RETURNING_ACCESS',
                userId: activeSession.userId,
                container: activeSession.container,
                timestamp: new Date().toLocaleTimeString(),
                cookieMatched: true,
                requestCount: activeSession.requestCount
            };
            
            sessionData.push(accessLog);
            updateSessionDemo();
        }

        function simulateLoadBalancing() {
            const balancingInfo = {
                type: 'LOAD_BALANCING_STATUS',
                timestamp: new Date().toLocaleTimeString(),
                containers: {...containerStatus},
                totalSessions: sessionData.filter(s => s.status === 'active').length,
                distribution: {}
            };
            
            // セッション分散状況を計算
            Object.keys(containerStatus).forEach(container => {
                const sessionCount = sessionData.filter(s => s.container === container && s.status === 'active').length;
                balancingInfo.distribution[container] = sessionCount;
            });
            
            sessionData.push(balancingInfo);
            updateSessionDemo();
        }

        function simulateContainerFailure() {
            const activeContainers = Object.keys(containerStatus).filter(c => containerStatus[c].active);
            if (activeContainers.length === 0) {
                alert('すべてのコンテナが停止中です');
                return;
            }
            
            const failedContainer = activeContainers[Math.floor(Math.random() * activeContainers.length)];
            containerStatus[failedContainer].active = false;
            
            // 該当コンテナのセッションを失効
            const affectedSessions = sessionData.filter(s => s.container === failedContainer && s.status === 'active');
            affectedSessions.forEach(session => {
                session.status = 'lost';
                session.endTime = new Date().toLocaleTimeString();
            });
            
            const failureEvent = {
                type: 'CONTAINER_FAILURE',
                container: failedContainer,
                timestamp: new Date().toLocaleTimeString(),
                affectedSessions: affectedSessions.length,
                recoveryAction: 'Redirect to healthy containers'
            };
            
            sessionData.push(failureEvent);
            updateSessionDemo();
        }

        function clearSessionDemo() {
            sessionData = [];
            containerStatus = {
                'Container-A': { active: true, sessions: 0, load: 0 },
                'Container-B': { active: true, sessions: 0, load: 0 },
                'Container-C': { active: true, sessions: 0, load: 0 },
                'Container-D': { active: true, sessions: 0, load: 0 }
            };
            updateSessionDemo();
        }

        function updateSessionDemo() {
            const demoResult = document.getElementById('sessionDemoResult');
            
            if (sessionData.length === 0) {
                demoResult.innerHTML = 'ボタンをクリックしてスティッキーセッションの動作を確認してください';
                return;
            }
            
            let html = '<h3 id="ALB-スティッキーセッション-ログ">🔐 ALB スティッキーセッション ログ</h3>';
            html += '<div style="text-align: left; max-height: 400px; overflow-y: auto;">';
            
            // 最新5件のイベントを表示
            const recentEvents = sessionData.slice(-8).reverse();
            
            recentEvents.forEach(event => {
                let color = '#2196f3';
                let icon = '🔄';
                let title = '';
                let details = '';
                
                if (event.type === 'RETURNING_ACCESS') {
                    color = '#2E7D32';
                    icon = '🎯';
                    title = \`リターニングユーザー: \${event.userId}\`;
                    details = \`Cookie照合成功 → \${event.container} (\${event.requestCount}回目のアクセス)\`;
                } else if (event.type === 'LOAD_BALANCING_STATUS') {
                    color = '#D97706';
                    icon = '⚖️';
                    title = '負荷分散状況';
                    details = \`アクティブセッション: \${event.totalSessions}件<br>\`;
                    Object.keys(event.distribution).forEach(container => {
                        details += \`\${container}: \${event.distribution[container]}セッション \`;
                    });
                } else if (event.type === 'CONTAINER_FAILURE') {
                    color = '#f44336';
                    icon = '🚨';
                    title = \`コンテナ障害: \${event.container}\`;
                    details = \`影響セッション: \${event.affectedSessions}件 | 対応: \${event.recoveryAction}\`;
                } else if (event.userId) {
                    color = '#2E7D32';
                    icon = '🆕';
                    title = \`新規セッション: \${event.userId}\`;
                    details = \`Cookie: \${event.cookieId} → \${event.container}に固定\`;
                }
                
                html += \`
                    <div style="margin: 10px 0; padding: 15px; background: \${color}20; border-left: 4px solid \${color}; border-radius: 4px;">
                        <div style="display: flex; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 1.2rem; margin-right: 8px;">\${icon}</span>
                            <strong>[\${event.timestamp || event.startTime}] \${title}</strong>
                        </div>
                        <div style="font-size: 0.9rem; color: #666; margin: 5px 0;">
                            \${details}
                        </div>
                \`;
                
                html += '</div>';
            });
            
            html += '</div>';
            
            // コンテナ状況サマリー
            html += '<div style="margin-top: 20px; padding: 15px; background: #f8f9fa; border-radius: 8px;">';
            html += '<h4>📊 現在のコンテナ状況</h4>';
            html += '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; margin-top: 10px;">';
            
            Object.keys(containerStatus).forEach(container => {
                const status = containerStatus[container];
                const statusColor = status.active ? '#2E7D32' : '#f44336';
                const activeSessions = sessionData.filter(s => s.container === container && s.status === 'active').length;
                
                html += \`
                    <div style="background: white; border-radius: 6px; padding: 10px; text-align: center; border: 2px solid \${statusColor};">
                        <div style="font-weight: bold; color: \${statusColor};">\${container}</div>
                        <div style="font-size: 0.8rem;">\${status.active ? 'Active' : 'Failed'}</div>
                        <div style="font-size: 0.8rem;">Sessions: \${activeSessions}</div>
                    </div>
                \`;
            });
            
            html += '</div></div>';
            html += \`<p style="margin-top: 15px;"><small>📈 総イベント数: \${sessionData.length} | 最新8件を表示</small></p>\`;
            
            demoResult.innerHTML = html;
        }

        // ページロード時のアニメーション
        document.addEventListener('DOMContentLoaded', function() {
            // セクションのフェードイン
            const sections = document.querySelectorAll('.section, .flow-step, .config-card, .alternative-card');
            sections.forEach((section, index) => {
                section.style.opacity = '0';
                section.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    section.style.transition = 'all 0.6s ease';
                    section.style.opacity = '1';
                    section.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
  </script>`;
