<div class="code-example">
<div class="code-header">
         スティッキーセッション設定
        </div>
<div class="code-line">
<span class="code-comment">
          # スティッキーセッション有効化
         </span>
</div>
<div class="code-line">
<span class="code-keyword">
          aws
         </span>
         elbv2 modify-target-group-attributes \\
        </div>
<div class="code-line">
         --target-group-arn
         <span class="code-string">
          "arn:aws:elasticloadbalancing:..."
         </span>
         \\
        </div>
<div class="code-line">
         --attributes
         <span class="code-property">
