         </span>
         =
         <span class="code-string">
          "stickiness.enabled"
         </span>
         ,
         <span class="code-property">
          Value
         </span>
         =
         <span class="code-string">
          "true"
         </span>
         \\
        </div>
<div class="code-line">
<span class="code-property">
          Key
         </span>
         =
         <span class="code-string">
          "stickiness.lb_cookie.duration_seconds"
         </span>
         ,
         <span class="code-property">
          Value
         </span>
         =
         <span class="code-string">
          "86400"
