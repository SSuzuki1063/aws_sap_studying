const rawContent = `<!-- ヘッダー -->
<div class="header">
<div class="aws-logo">
     AWS
    </div>
<h1>
     Amazon AppStream 2.0
    </h1>

<p class="subtitle">
     クラウドでアプリケーションを配信する革新的なサービス
    </p>
</div>
<!-- AppStream 2.0とは -->
<div class="section">
<h2 class="section-title" id="️-AppStream-2.0って何？">
<div class="icon">
      🖥️
     </div>
     AppStream 2.0って何？
    </h2>
<div class="analogy-box">
<h3 id="レンタカーのように使えるアプリケーション">
      🚗 レンタカーのように使えるアプリケーション
     </h3>
<p>
      AppStream 2.0は、
      <span class="highlight">
       「クラウド上のレンタカー」
      </span>
      のようなサービスです。自分でアプリケーションを買って、インストールして、メンテナンスする必要がありません。必要な時に、必要な分だけ、インターネット経由でアプリケーションを使うことができます。
     </p>
</div>
<p>
     Amazon AppStream 2.0は、デスクトップアプリケーションをクラウドから安全にストリーミング配信するサービスです。ユーザーは自分のデバイスにアプリケーションをインストールすることなく、ウェブブラウザを通じて高性能なアプリケーションにアクセスできます。
    </p>
</div>
<!-- 従来の方法 vs AppStream 2.0 -->
<div class="section">
<h2 class="section-title" id="⚖️-従来の方法-vs-AppStream-2.0">
<div class="icon">
      ⚖️
     </div>
     従来の方法 vs AppStream 2.0
    </h2>
<div class="comparison-grid">
<div class="comparison-item traditional">
<h3 id="従来の方法">
       🏠 従来の方法
      </h3>
<ul style="text-align: left; margin-top: 15px;">
<li>
        各PCにソフトをインストール
       </li>
<li>
        ライセンス管理が複雑
       </li>
<li>
        アップデートが大変
       </li>
<li>
        高性能PCが必要
       </li>
<li>
        セキュリティリスク
       </li>
</ul>
</div>
<div class="comparison-item appstream">
<h3 id="☁️-AppStream-2.0">
       ☁️ AppStream 2.0
      </h3>
<ul style="text-align: left; margin-top: 15px;">
<li>
        ブラウザだけでアクセス
       </li>
<li>
        中央管理で簡単
       </li>
<li>
        自動アップデート
       </li>
<li>
        低スペックPCでもOK
       </li>
<li>
        データはクラウドで安全
       </li>
</ul>
</div>
</div>
</div>
<!-- 仕組みの説明 -->
<div class="section">
<h2 class="section-title" id="どうやって動くの？">
<div class="icon">
      🔄
     </div>
     どうやって動くの？
    </h2>
<div class="analogy-box">
<h3 id="YouTubeでアプリを見る感覚">
      📺 YouTubeでアプリを見る感覚
     </h3>
<p>
      YouTubeで動画を見るとき、動画ファイルはYouTubeのサーバーにあって、あなたのブラウザに映像が配信されますよね。AppStream 2.0も同じように、
      <span class="highlight">
       アプリケーションはAWSのサーバーで動いて、画面だけがあなたのブラウザに配信
      </span>
      されます。
     </p>
</div>
<div class="flow-diagram">
<div class="flow-step">
<strong>
       1. アクセス
      </strong>
<br/>
      ブラウザで
      <br/>
      専用URLへ
     </div>
<div class="flow-step">
<strong>
       2. 認証
      </strong>
<br/>
      ログイン
      <br/>
      画面で認証
     </div>
<div class="flow-step">
<strong>
       3. 起動
      </strong>
<br/>
      クラウド上で
      <br/>
      アプリ起動
     </div>
<div class="flow-step">
<strong>
       4. 利用
      </strong>
<br/>
      ブラウザ内で
      <br/>
      アプリ操作
     </div>
</div>
</div>
<!-- メリット -->
<div class="section">
<h2 class="section-title" id="✨-AppStream-2.0のメリット">
<div class="icon">
      ✨
     </div>
     AppStream 2.0のメリット
    </h2>
<div class="benefits-grid">
<div class="benefit-card">
<span class="benefit-icon">
       💰
      </span>
<h3 id="コスト削減">
       コスト削減
      </h3>
<p>
       高価なソフトウェアライセンスや高性能PCを全員分用意する必要がありません
      </p>
</div>
<div class="benefit-card">
<span class="benefit-icon">
       🔒
      </span>
<h3 id="セキュリティ強化">
       セキュリティ強化
      </h3>
<p>
       データがローカルPCに残らず、AWS の高度なセキュリティで保護されます
      </p>
</div>
<div class="benefit-card">
<span class="benefit-icon">
       ⚡
      </span>
<h3 id="即座にスケール">
       即座にスケール
      </h3>
<p>
       必要に応じてユーザー数を増減でき、繁忙期にも柔軟に対応できます
      </p>
</div>
<div class="benefit-card">
<span class="benefit-icon">
       🌍
      </span>
<h3 id="どこからでもアクセス">
       どこからでもアクセス
      </h3>
<p>
       インターネットがあれば、世界中どこからでも同じ環境でアプリを使えます
      </p>
</div>
<div class="benefit-card">
<span class="benefit-icon">
       🔄
      </span>
<h3 id="簡単メンテナンス">
       簡単メンテナンス
      </h3>
<p>
       アップデートやメンテナンスが中央で一括管理でき、IT管理者の負担が軽減されます
      </p>
</div>
<div class="benefit-card">
<span class="benefit-icon">
       📱
      </span>
<h3 id="デバイス自由">
       デバイス自由
      </h3>
<p>
       Windows、Mac、タブレット、Chromebookなど、様々なデバイスから利用可能です
      </p>
</div>
</div>
</div>
<!-- 使用例 -->
<div class="section">
<h2 class="section-title" id="こんな場面で活用されています">
<div class="icon">
      🎯
     </div>
     こんな場面で活用されています
    </h2>
<div class="analogy-box">
<h3 id="オフィスの例">
      🏢 オフィスの例
     </h3>
<p>
<strong>
       設計会社のケース：
      </strong>
      高価なCADソフトウェアを全社員のPCにインストールする代わりに、AppStream 2.0で配信。設計者は自宅からでも、高性能なCADソフトを使って設計作業ができるようになりました。
     </p>
</div>
<div class="analogy-box">
<h3 id="教育機関の例">
      🎓 教育機関の例
     </h3>
<p>
<strong>
       大学のケース：
      </strong>
      統計解析ソフトやプログラミング環境を学生に提供。学生は自分の古いノートPCからでも、最新の開発環境やソフトウェアにアクセスして学習できます。
     </p>
</div>
<div class="analogy-box">
<h3 id="医療機関の例">
      🏥 医療機関の例
     </h3>
<p>
<strong>
       病院のケース：
      </strong>
      医療画像解析ソフトウェアを医師に提供。機密性の高い患者データを安全に保ちながら、専門的な画像解析ツールを利用できます。
     </p>
</div>
</div>
<!-- 料金について -->
<div class="section">
<h2 class="section-title" id="料金体系">
<div class="icon">
      💳
     </div>
     料金体系
    </h2>
<div class="analogy-box">
<h3 id="タクシー料金のような課金">
      🚕 タクシー料金のような課金
     </h3>
<p>
      AppStream 2.0の料金は
      <span class="highlight">
       「使った分だけ払う」
      </span>
      システムです。タクシーのように、乗った時間分だけ料金がかかります。誰も使っていない時間は料金が発生しません。
     </p>
</div>
<div class="pricing-table">
<div class="pricing-card">
<h3 id="インスタンス料金">
       💻 インスタンス料金
      </h3>
<p class="price">
       $0.36/時間〜
      </p>
<p>
       使用したコンピューティングリソースの時間料金（インスタンスタイプにより変動）
      </p>
</div>
<div class="pricing-card">
<h3 id="ユーザー料金">
       👥 ユーザー料金
      </h3>
<p class="price">
       $0.03/時間
      </p>
<p>
       アクティブユーザー1人あたりの時間料金
      </p>
</div>
<div class="pricing-card">
<h3 id="ストレージ料金">
       💾 ストレージ料金
      </h3>
<p class="price">
       $0.02/GB
      </p>
<p>
       ユーザーデータやアプリケーションの保存料金（月額）
      </p>
</div>
</div>
<p style="text-align: center; margin-top: 20px; color: #666;">
     ※ 料金は地域やインスタンスタイプによって異なります。最新の料金はAWS公式サイトをご確認ください。
    </p>
</div>
<!-- インタラクティブデモ -->
<div class="interactive-demo">
<h2 id="始め方は簡単！">
     🚀 始め方は簡単！
    </h2>
<p>
     AppStream 2.0の導入は3ステップで完了します
    </p>
<div style="margin: 20px 0;">
<button class="demo-button" onclick="showStep(1)">
      1. アプリの準備
     </button>
<button class="demo-button" onclick="showStep(2)">
      2. フリートの作成
     </button>
<button class="demo-button" onclick="showStep(3)">
      3. ユーザーアクセス
     </button>
</div>
<div id="demo-content" style="margin-top: 20px; padding: 20px; background: rgba(255,255,255,0.1); border-radius: 10px;">
     ボタンをクリックして各ステップの詳細を確認してください
    </div>
</div>
<!-- まとめ -->
<div class="section">
<h2 class="section-title" id="まとめ">
<div class="icon">
      🎯
     </div>
     まとめ
    </h2>
<div class="analogy-box">
<h3 id="AppStream-2.0はアプリのNetflix">
      🌟 AppStream 2.0は「アプリのNetflix」
     </h3>
<p>
      Netflixが映画やドラマをストリーミングで配信するように、AppStream 2.0はアプリケーションをストリーミングで配信します。
      <span class="highlight">
       コスト削減、セキュリティ強化、運用簡素化
      </span>
      を実現する現代的なソリューションです。
     </p>
</div>
<h3 id="こんな方におすすめ">
     こんな方におすすめ：
    </h3>
<ul style="margin: 15px 0 15px 30px;">
<li>
      🏢 高価なソフトウェアライセンスの管理に困っている企業
     </li>
<li>
      🎓 学生に最新の開発環境を提供したい教育機関
     </li>
<li>
      🌍 リモートワークを推進したい組織
     </li>
<li>
      🔒 セキュリティを強化しながら業務効率を上げたい企業
     </li>
<li>
      ⚡ 必要な時だけリソースを使いたいスタートアップ
     </li>
</ul>
<p style="text-align: center; margin-top: 30px; font-size: 1.2em;">
<span class="highlight">
      今すぐAWSコンソールでAppStream 2.0を試してみましょう！
     </span>
</p>
</div>


</div>
<script is:inline>
   function showStep(step) {
            const content = document.getElementById('demo-content');
            const steps = {
                1: '📦 <strong>アプリの準備</strong><br>AppStream 2.0で配信したいアプリケーションをWindows Server上にインストールし、アプリケーションイメージを作成します。AWSが提供するImage Builderを使って簡単に作成できます。',
                2: '🚀 <strong>フリートの作成</strong><br>作成したアプリケーションイメージを使ってフリート（仮想マシンのグループ）を作成します。必要なリソース量やユーザー数に応じて設定できます。',
                3: '👥 <strong>ユーザーアクセス</strong><br>ユーザーにアクセス用のURLを提供し、認証設定を行います。ユーザーはブラウザでアクセスするだけでアプリケーションを利用開始できます。'
            };
            content.innerHTML = steps[step];
        }

        // ページ読み込み時のアニメーション
        window.addEventListener('load', function() {
            const sections = document.querySelectorAll('.section');
            sections.forEach((section, index) => {
                section.style.opacity = '0';
                section.style.transform = 'translateY(30px)';
                
                setTimeout(() => {
                    section.style.transition = 'all 0.6s ease';
                    section.style.opacity = '1';
                    section.style.transform = 'translateY(0)';
                }, index * 200);
            });
        });
  </script>
<div style="text-align: center; padding: 20px; margin-top: 40px; border-top: 2px solid #909296; background-color: #F9FAFB;">
<p style="color: #6B7280; font-size: 0.9em; margin: 0;">
    Created by
    <a href="https://github.com/SSuzuki1063" style="color: #dc7600; text-decoration: none; font-weight: 600;" target="_blank">
     SSuzuki1063
    </a>
</p>
<p style="color: #6f7682; font-size: 0.8em; margin: 5px 0 0 0;">
    AWS SAP Learning Resources
   </p>
</div>`;
---

<ResourceLayout {...frontmatter}>
  <Fragment set:html={rawContent} />
</ResourceLayout>
