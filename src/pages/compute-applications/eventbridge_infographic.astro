            }, observerOptions);

            const animateElements = document.querySelectorAll('.component-card, .flow-step');
            animateElements.forEach(el => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(20px)';
                el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                observer.observe(el);
            });
        });</script>`;
