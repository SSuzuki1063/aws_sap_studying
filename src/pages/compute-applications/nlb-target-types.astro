    <table>
      <thead>
        <tr>
          <th style="text-align:left; width:32%">項目</th>
          <th>🔵 instance</th>
          <th>🟠 ip</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>ターゲットの正体</td>
          <td>EC2インスタンスID</td>
          <td>Pod のIPアドレス</td>
        </tr>
        <tr>
          <td>ホップ数</td>
