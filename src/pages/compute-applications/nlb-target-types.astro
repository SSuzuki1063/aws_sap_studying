const rawContent = `<style>:root {
    --blue: #1a6cf7;
    --blue-light: #e8f0fe;
    --blue-mid: #c2d4fb;
    --orange: #f77f1a;
    --orange-light: #fff0e0;
    --orange-mid: #ffd4a0;
    --green: #1ab87a;
    --green-light: #e0f7ef;
    --slate: #1e2a3a;
    --slate-mid: #3d5068;
    --gray: #f5f7fa;
    --gray-border: #dde3ea;
    --white: #ffffff;
    --shadow: 0 4px 20px rgba(30,42,58,0.10);
    --shadow-hover: 0 8px 32px rgba(30,42,58,0.16);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Noto Sans JP', sans-serif;
    background: #f0f4fa;
    color: var(--slate);
    font-size: 20px;
    line-height: 1.6;
            padding-top: 70px;}

  /* ===== HEADER ===== */
  .header {
    background: var(--slate);
    color: #fff;
    padding: 48px 40px 40px;
    text-align: center;
  }
  .header .eyebrow {
    font-size: 14px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #7fa8e8;
    margin-bottom: 12px;
  }
  .header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 38px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 14px;
  }
  .header h1 span { color: #5ca0ff; }
  .header .subtitle {
    font-size: 20px;
    color: #a8c0da;
    max-width: 700px;
    margin: 0 auto;
  }

  /* ===== CONCLUSION BOX ===== */
  .conclusion-wrap {
    max-width: 900px;
    margin: 36px auto 0;
    padding: 0 24px;
  }
  .conclusion-box {
    background: linear-gradient(135deg, #1a6cf7 0%, #0f4ab5 100%);
    border-radius: 16px;
    padding: 28px 36px;
    color: #fff;
  }
  .conclusion-box .label {
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #a0c4ff;
    margin-bottom: 10px;
  }
  .conclusion-box p {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.5;
  }
  .conclusion-box .tags {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .conclusion-box .tag {
    background: rgba(255,255,255,0.18);
    border-radius: 20px;
    padding: 4px 16px;
    font-size: 16px;
    font-weight: 700;
  }

  /* ===== MAIN ===== */
  .main {
    max-width: 900px;
    margin: 0 auto;
    padding: 36px 24px 60px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ===== SECTION TITLES ===== */
  .section-title {
    font-size: 14px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--slate-mid);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--gray-border);
  }

  /* ===== ANALOGY INTRO ===== */
  .analogy-card {
    background: var(--white);
    border-radius: 16px;
    padding: 32px;
    box-shadow: var(--shadow);
    border: 1px solid var(--gray-border);
  }
  .analogy-card h2 {
    font-size: 26px;
    font-weight: 900;
    margin-bottom: 8px;
  }
  .analogy-card p {
    font-size: 20px;
    color: var(--slate-mid);
    margin-bottom: 20px;
  }
  .analogy-flow {
    display: flex;
    align-items: center;
    gap: 0;
    background: var(--gray);
    border-radius: 12px;
    overflow: hidden;
  }
  .analogy-step {
    flex: 1;
    padding: 20px 16px;
    text-align: center;
    position: relative;
  }
  .analogy-step .icon { font-size: 36px; margin-bottom: 8px; display: block; }
  .analogy-step .name { font-size: 18px; font-weight: 700; color: var(--slate); }
  .analogy-step .desc { font-size: 16px; color: var(--slate-mid); margin-top: 4px; }
  .analogy-arrow {
    font-size: 28px;
    color: var(--gray-border);
    padding: 0 4px;
    flex-shrink: 0;
  }
  .analogy-step.nlb { background: var(--blue-light); }
  .analogy-step.target { background: var(--orange-light); }

  /* ===== EQUAL TWO-COLUMN TARGET TYPES ===== */
  .types-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .type-card {
    background: var(--white);
    border-radius: 16px;
    box-shadow: var(--shadow);
    border: 2px solid var(--gray-border);
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .type-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
  }
  .type-card-header {
    padding: 24px 28px 18px;
    border-bottom: 1px solid var(--gray-border);
  }
  .type-card-header .badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 6px;
    padding: 3px 12px;
    margin-bottom: 12px;
  }
  .type-card.instance .type-card-header { background: var(--blue-light); }
  .type-card.instance .badge { background: var(--blue); color: #fff; }
  .type-card.ip .type-card-header { background: var(--orange-light); }
  .type-card.ip .badge { background: var(--orange); color: #fff; }
  .type-card-header h3 {
    font-size: 28px;
    font-weight: 900;
    margin-bottom: 4px;
  }
  .type-card.instance h3 { color: var(--blue); }
  .type-card.ip h3 { color: var(--orange); }
  .type-card-header .tagline {
    font-size: 18px;
    color: var(--slate-mid);
  }
  .type-card-body {
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
            padding-top: 70px;}

  /* ===== ANALOGY SCENE ===== */
  .scene-box {
    border-radius: 10px;
    padding: 16px 20px;
    font-size: 19px;
    line-height: 1.6;
  }
  .type-card.instance .scene-box { background: var(--blue-light); border-left: 4px solid var(--blue); }
  .type-card.ip .scene-box { background: var(--orange-light); border-left: 4px solid var(--orange); }
  .scene-box .scene-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .type-card.instance .scene-label { color: var(--blue); }
  .type-card.ip .scene-label { color: var(--orange); }

  /* ===== VISUAL DIAGRAM ===== */
  .diagram {
    background: var(--gray);
    border-radius: 10px;
    padding: 20px;
  }
  .diagram-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--slate-mid);
    margin-bottom: 14px;
    text-align: center;
  }
  .diag-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .diag-box {
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 17px;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
  }
  .diag-box.nlb-box { background: var(--slate); color: #fff; }
  .diag-box.node-box { background: var(--blue); color: #fff; }
  .diag-box.pod-box { background: var(--orange); color: #fff; }
  .diag-box.ip-box { background: #fff; color: var(--orange); border: 2px solid var(--orange); }
  .diag-arrow { font-size: 22px; color: #8899aa; }
  .diag-arrow.down { display: block; text-align: center; color: #8899aa; font-size: 22px; margin: 6px 0; }
  .diag-nodes {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .diag-pod-row {
    display: flex;
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .node-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  /* ===== FEATURE ROW ===== */
  .feature-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 18px;
    line-height: 1.5;
  }
  .feature-item .bullet {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    margin-top: 2px;
  }
  .type-card.instance .bullet { background: var(--blue); color: #fff; }
  .type-card.ip .bullet { background: var(--orange); color: #fff; }

  /* ===== USE-CASE ===== */
  .usecase-box {
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 18px;
    font-weight: 700;
  }
  .type-card.instance .usecase-box { background: #eaf2ff; color: var(--blue); }
  .type-card.ip .usecase-box { background: #fff4e8; color: var(--orange); }
  .usecase-box .uc-label { font-size: 13px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; opacity: 0.7; }

  /* ===== COMPARISON TABLE ===== */
  .compare-card {
    background: var(--white);
    border-radius: 16px;
    box-shadow: var(--shadow);
    border: 1px solid var(--gray-border);
    overflow: hidden;
  }
  .compare-card h2 {
    padding: 22px 28px 18px;
    font-size: 24px;
    font-weight: 900;
    border-bottom: 1px solid var(--gray-border);
  }
  table { width: 100%; border-collapse: collapse; }
  thead th {
    padding: 14px 20px;
    font-size: 18px;
    font-weight: 800;
    text-align: center;
    border-bottom: 2px solid var(--gray-border);
  }
  thead th:nth-child(2) { color: var(--blue); background: var(--blue-light); }
  thead th:nth-child(3) { color: var(--orange); background: var(--orange-light); }
  tbody tr { border-bottom: 1px solid var(--gray-border); }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: var(--gray); }
  td {
    padding: 14px 20px;
    font-size: 19px;
    vertical-align: middle;
  }
  td:first-child { font-weight: 700; color: var(--slate-mid); }
  td:nth-child(2), td:nth-child(3) { text-align: center; }
  td .check { font-size: 22px; }

  /* ===== DECISION GUIDE ===== */
  .decision-card {
    background: var(--white);
    border-radius: 16px;
    box-shadow: var(--shadow);
    border: 1px solid var(--gray-border);
    padding: 32px;
  }
  .decision-card h2 {
    font-size: 26px;
    font-weight: 900;
    margin-bottom: 24px;
  }
  .decision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .decision-item {
    border-radius: 12px;
    padding: 20px 22px;
    border: 2px solid;
  }
  .decision-item.choose-instance { border-color: var(--blue); background: var(--blue-light); }
  .decision-item.choose-ip { border-color: var(--orange); background: var(--orange-light); }
  .decision-item .di-header {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .choose-instance .di-header { color: var(--blue); }
  .choose-ip .di-header { color: var(--orange); }
  .decision-item ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .decision-item ul li {
    font-size: 18px;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .decision-item ul li::before {
    content: '→';
    font-weight: 900;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .choose-instance ul li::before { color: var(--blue); }
  .choose-ip ul li::before { color: var(--orange); }

  /* ===== FOOTER NOTE ===== */
  .footer-note {
    background: var(--green-light);
    border: 1px solid var(--green);
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .footer-note .icon { font-size: 28px; flex-shrink: 0; }
  .footer-note p { font-size: 19px; color: var(--slate); line-height: 1.6; }
  .footer-note strong { color: var(--green); }

  @media (max-width: 640px) {
    .types-grid, .decision-grid { grid-template-columns: 1fr; }
    .header h1 { font-size: 26px; }
    .analogy-flow { flex-direction: column; }
    .analogy-arrow { transform: rotate(90deg); }
  }</style>
<!-- HEADER -->
<div class="header">
  <div class="eyebrow">AWS Network Load Balancer</div>
  <h1>NLBの<span>ターゲットタイプ</span>を完全理解</h1>
  <div class="subtitle">instance vs ip ── Kubernetesで知っておきたい2つの振り先の違い</div>
</div>

<!-- CONCLUSION -->
<div class="conclusion-wrap">
  <div class="conclusion-box">
    <div class="label">🎯 最初に結論</div>
    <p>NLBはトラフィックを「どこ」に届けるかで2種類ある。<br>
    <strong>instance</strong> = ノード（建物ごと届ける）　<strong>ip</strong> = Pod IP（部屋に直接届ける）</p>
    <div class="tags">
      <span class="tag">🏢 instance → EC2ノード</span>
      <span class="tag">📬 ip → Pod IPアドレス</span>
      <span class="tag">⚡ ホップ数が変わる</span>
    </div>
  </div>
</div>

<div class="main">

  <!-- ANALOGY INTRO -->
  <div>
    <div class="section-title">🏨 たとえ話で理解する</div>
    <div class="analogy-card">
      <h2 id="NLBは配達ルーティングセンター">NLBは「配達ルーティングセンター」🚚</h2>
      <p>インターネットから届いたパケット（荷物）を、どの宛先に届けるかを決める仕組みです</p>
      <div class="analogy-flow">
        <div class="analogy-step">
          <span class="icon">🌐</span>
          <div class="name">インターネット</div>
          <div class="desc">荷物を送ってくる人</div>
        </div>
        <div class="analogy-arrow">→</div>
        <div class="analogy-step nlb">
          <span class="icon">🏭</span>
          <div class="name">NLB</div>
          <div class="desc">配達ルーティングセンター<br>「どこに届ける？」を決める</div>
        </div>
        <div class="analogy-arrow">→</div>
        <div class="analogy-step target">
          <span class="icon">📦</span>
          <div class="name">ターゲット</div>
          <div class="desc">実際の配達先<br>instance or ip</div>
        </div>
      </div>
    </div>
  </div>

  <!-- TWO TARGET TYPES — equal grid -->
  <div>
    <div class="section-title">⚖️ 2つのターゲットタイプ（同列・均等比較）</div>
    <div class="types-grid">

      <!-- INSTANCE -->
      <div class="type-card instance">
        <div class="type-card-header">
          <div class="badge">ターゲットタイプ 1</div>
          <h3 id="instance">instance</h3>
          <div class="tagline">EC2ノードに届ける</div>
        </div>
        <div class="type-card-body">
          <div class="scene-box">
            <div class="scene-label">📮 たとえ話</div>
            「<strong>マンション棟（ノード）</strong>に荷物を届ける」<br>
            棟の受付（NodePort）が受け取り、<br>
            中の部屋（Pod）に内線で転送する
          </div>

          <!-- Diagram -->
          <div class="diagram">
            <div class="diagram-title">パケットの流れ</div>
            <div class="diag-row">
              <div class="diag-box nlb-box">🏭 NLB</div>
              <div class="diag-arrow">→</div>
              <div class="diag-box node-box">🏢 EC2 Node<br><small>NodePort で受信</small></div>
              <div class="diag-arrow">→</div>
              <div class="diag-box pod-box">📦 Pod</div>
            </div>
          </div>

          <div class="feature-row">
            <div class="feature-item">
              <span class="bullet">✓</span>
              <span>EC2インスタンスID をターゲットとして登録</span>
            </div>
            <div class="feature-item">
              <span class="bullet">✓</span>
              <span>kube-proxy が NodePort → Pod へ転送（1ホップ追加）</span>
            </div>
            <div class="feature-item">
              <span class="bullet">✓</span>
              <span>クラスター外から見ると「ノードのIP」が宛先</span>
            </div>
            <div class="feature-item">
              <span class="bullet">✓</span>
              <span>設定がシンプル、既存クラスターにすぐ適用</span>
            </div>
          </div>

          <div class="usecase-box">
            <div class="uc-label">💡 向いている場面</div>
            シンプルなk8s Service（type: LoadBalancer）<br>
            EKS / self-managed どちらでも簡単に使える
          </div>
        </div>
      </div>

      <!-- IP -->
      <div class="type-card ip">
        <div class="type-card-header">
          <div class="badge">ターゲットタイプ 2</div>
          <h3 id="ip">ip</h3>
          <div class="tagline">Pod IPに直接届ける</div>
        </div>
        <div class="type-card-body">
          <div class="scene-box">
            <div class="scene-label">📬 たとえ話</div>
            「<strong>部屋番号（Pod IP）</strong>に直接届ける宅配便」<br>
            棟の受付を介さず、<br>
            部屋のドア前（Pod）に直接ポスト投函
          </div>

          <!-- Diagram -->
          <div class="diagram">
            <div class="diagram-title">パケットの流れ</div>
            <div class="diag-row">
              <div class="diag-box nlb-box">🏭 NLB</div>
              <div class="diag-arrow">→</div>
              <div class="diag-box ip-box">🔢 Pod IP<br><small>直接指定</small></div>
              <div class="diag-arrow">→</div>
              <div class="diag-box pod-box">📦 Pod</div>
            </div>
          </div>

          <div class="feature-row">
            <div class="feature-item">
              <span class="bullet">✓</span>
              <span>Pod の IP アドレスをターゲットとして登録</span>
            </div>
            <div class="feature-item">
              <span class="bullet">✓</span>
              <span>NodePort を経由しないのでレイテンシが低い</span>
            </div>
            <div class="feature-item">
              <span class="bullet">✓</span>
              <span>クライアントの送信元IPがPodに直接伝わる</span>
            </div>
            <div class="feature-item">
              <span class="bullet">✓</span>
              <span>AWS Load Balancer Controller が必要（EKS推奨）</span>
            </div>
          </div>

          <div class="usecase-box">
            <div class="uc-label">💡 向いている場面</div>
            パフォーマンス重視 / 送信元IP保持が必要な<br>
            本番 EKS ワークロード
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- COMPARISON TABLE -->
  <div class="compare-card">
