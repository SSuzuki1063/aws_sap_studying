---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Cert Vpn Acm Guide',
  pageTitle: '証明書ベースVPN認証 & ACM完全ガイド',
  category: 'security-governance',
  categoryLabel: 'セキュリティ・ガバナンス',
  subcategory: '暗号化 & 証明書管理',
  slug: 'cert-vpn-acm-guide',
  tocItems: [
    { id: 'key-takeaways', text: '最初に押さえる4つの要点', level: 'h2' },
    { id: 'analogy', text: '社員証システムで理解するVPN認証', level: 'h2' },
    { id: 'psk-vs-cert', text: 'PSK認証 vs 証明書認証の比較', level: 'h2' },
    { id: 'architecture', text: '証明書ベースVPN認証の仕組み', level: 'h2' },
    { id: 'cert-features', text: '証明書認証の5つの特徴', level: 'h2' },
    { id: 'acm', text: 'AWS Certificate Manager（ACM）での証明書管理', level: 'h2' },
    { id: 'cert-types', text: '証明書の種類', level: 'h3' },
    { id: 'acm-main-features', text: 'ACMの主要機能', level: 'h3' },
    { id: 'acm-integration', text: 'ACMとAWSサービスの統合パターン', level: 'h2' },
    { id: 'lifecycle', text: '証明書ライフサイクル管理', level: 'h2' },
    { id: 'code-examples', text: '実装コード例', level: 'h2' },
    { id: 'acm-private-ca-vpn', text: 'ACM Private CA & VPN証明書の作成', level: 'h3' },
    { id: 'best-practices', text: 'ベストプラクティス vs アンチパターン', level: 'h2' },
    { id: 'troubleshooting', text: 'トラブルシューティング', level: 'h2' },
    { id: 'exam-tips', text: 'ANS-C01 / SAP-C02 試験対策', level: 'h2' },
    { id: 'faq', text: 'よくある質問（FAQ）', level: 'h2' },
    { id: 'glossary', text: '用語集', level: 'h2' },
    { id: 'cheatsheet', text: 'チートシート（まとめ）', level: 'h2' },
  ],
  pageCss: '/aws_sap_studying/css/pages/cert-vpn-acm-guide.css',
};

const rawContent = `
    <!-- ヒーローセクション -->
    <section class="hero" aria-label="ページ概要">
        <div class="hero-badge">&#128274; Security / VPN / ACM</div>
        <h1>証明書ベースVPN認証 &amp;<br>AWS Certificate Manager</h1>
        <p class="hero-subtitle">
            従来のPSK（事前共有鍵）認証に代わる高セキュリティ認証方式と、
            AWSの証明書管理マネージドサービスを「社員証システム」のたとえで徹底解説
        </p>
    </section>

    <!-- キーテイクアウェイ -->
    <section class="key-takeaways">
        <h2 id="key-takeaways">&#128161; 最初に押さえる4つの要点</h2>
        <div class="takeaway-grid">
            <div class="takeaway-item">
                <div class="takeaway-icon">&#128272;</div>
                <div class="takeaway-text">
                    <strong>PSKは「合言葉」、証明書は「社員証」</strong><br>
                    PSKは全員同じ合言葉を使い回すのに対し、証明書は一人一枚の社員証。個別管理・個別失効が可能
                </div>
            </div>
            <div class="takeaway-item">
                <div class="takeaway-icon">&#128196;</div>
                <div class="takeaway-text">
                    <strong>ACMは証明書の「総務部門」</strong><br>
                    発行・更新・配布・失効をまとめて管理するマネージドサービス。手作業ゼロで証明書ライフサイクルを自動化
                </div>
            </div>
            <div class="takeaway-item">
                <div class="takeaway-icon">&#128737;</div>
                <div class="takeaway-text">
                    <strong>パブリック証明書＝公的身分証、プライベート証明書＝社内ID</strong><br>
                    外向けWebサイトにはパブリック、VPN・内部通信にはプライベート証明書を使い分ける
                </div>
            </div>
            <div class="takeaway-item">
                <div class="takeaway-icon">&#128260;</div>
                <div class="takeaway-text">
                    <strong>自動更新で「期限切れ事故」を防止</strong><br>
                    ACMはパブリック証明書を自動更新。プライベート証明書もAPI連携で自動ローテーション対応
                </div>
            </div>
        </div>
    </section>

    <!-- たとえ話セクション -->
    <section class="section">
        <h2 id="analogy">&#127970; 社員証システムで理解するVPN認証</h2>
        <p>
            VPN認証の仕組みを「会社の入退館管理」にたとえてみましょう。
            PSK認証が「全員同じ合言葉で入館する方式」だとすれば、
            証明書認証は「顔写真付き社員証で入館する方式」です。
        </p>

        <div class="analogy-table-wrapper">
            <table class="analogy-table">
                <thead>
                    <tr>
                        <th class="emoji-col"></th>
                        <th>社員証システム（たとえ）</th>
                        <th>AWS/VPN（実際の仕組み）</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="emoji-col">&#127970;</td>
                        <td>会社のビル（入りたい場所）</td>
                        <td>AWS VPC（接続先ネットワーク）</td>
                    </tr>
                    <tr>
                        <td class="emoji-col">&#128101;</td>
                        <td>社員（入館したい人）</td>
                        <td>VPNクライアント（接続元デバイス）</td>
                    </tr>
                    <tr>
                        <td class="emoji-col">&#128179;</td>
                        <td>社員証（個人の身分証明）</td>
                        <td>クライアント証明書（デバイス認証情報）</td>
                    </tr>
                    <tr>
                        <td class="emoji-col">&#127971;</td>
                        <td>総務部門（社員証を発行・管理）</td>
                        <td>ACM / プライベートCA（証明書管理）</td>
                    </tr>
                    <tr>
                        <td class="emoji-col">&#128682;</td>
                        <td>入退館ゲート（出入りを管理）</td>
                        <td>VPNエンドポイント（接続制御ポイント）</td>
                    </tr>
                    <tr>
                        <td class="emoji-col">&#128466;</td>
                        <td>退職者リスト（無効社員証の一覧）</td>
                        <td>CRL（証明書失効リスト）</td>
                    </tr>
                    <tr>
                        <td class="emoji-col">&#128197;</td>
                        <td>社員証の有効期限</td>
                        <td>証明書の有効期限（自動更新対応）</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="highlight-box">
            <p>
                &#128161; <strong>ポイント：</strong>社員証（証明書）なら退職者の分だけ無効化すればよいですが、
                合言葉（PSK）は一人に漏れると全員分の変更が必要になります。これがスケーラビリティの決定的な差です。
            </p>
        </div>
    </section>

    <!-- PSK vs 証明書比較 -->
    <section class="section">
        <h2 id="psk-vs-cert">&#128275; PSK認証 vs 証明書認証の比較</h2>
        <p>VPN接続の認証方式を入退館管理のたとえで比べてみましょう。</p>

        <!-- 比較SVG図 -->
        <div class="svg-container">
            <svg viewBox="0 0 1200 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="PSK認証と証明書認証の比較図">
                <!-- 背景 -->
                <rect x="0" y="0" width="1200" height="520" rx="18" fill="#F8FAFC"/>

                <!-- タイトル -->
                <text x="600" y="42" text-anchor="middle" font-size="22" font-weight="700" fill="#0F172A">PSK認証 vs 証明書認証 ― 入退館管理で比較</text>

                <!-- 左：PSK認証 -->
                <rect x="30" y="65" width="560" height="430" rx="14" fill="#FEF2F2" stroke="#F87171" stroke-width="2"/>
                <text x="310" y="100" text-anchor="middle" font-size="20" font-weight="700" fill="#DC2626">&#10060; PSK認証 = 合言葉方式</text>

                <!-- PSK: 守衛 -->
                <rect x="200" y="130" width="220" height="70" rx="12" fill="white" stroke="#F87171" stroke-width="2"/>
                <text x="310" y="160" text-anchor="middle" font-size="20" fill="#1E293B">&#127970; 守衛室</text>
                <text x="310" y="185" text-anchor="middle" font-size="16" fill="#475569">合言葉：「ABCD1234」</text>

                <!-- PSK: 社員たち -->
                <g>
                    <rect x="60" y="240" width="150" height="60" rx="10" fill="white" stroke="#CBD5E1" stroke-width="1.5"/>
                    <text x="135" y="268" text-anchor="middle" font-size="18" fill="#1E293B">&#128100; 社員A</text>
                    <text x="135" y="288" text-anchor="middle" font-size="14" fill="#475569">合言葉で入館</text>
                </g>
                <g>
                    <rect x="230" y="240" width="150" height="60" rx="10" fill="white" stroke="#CBD5E1" stroke-width="1.5"/>
                    <text x="305" y="268" text-anchor="middle" font-size="18" fill="#1E293B">&#128100; 社員B</text>
                    <text x="305" y="288" text-anchor="middle" font-size="14" fill="#475569">同じ合言葉</text>
                </g>
                <g>
                    <rect x="400" y="240" width="150" height="60" rx="10" fill="white" stroke="#CBD5E1" stroke-width="1.5"/>
                    <text x="475" y="268" text-anchor="middle" font-size="18" fill="#1E293B">&#128100; 退職者</text>
                    <text x="475" y="288" text-anchor="middle" font-size="14" fill="#DC2626">合言葉を知ってる!</text>
                </g>

                <!-- PSK: 矢印 -->
                <line x1="135" y1="235" x2="260" y2="205" stroke="#F87171" stroke-width="2" marker-end="url(#arrowRed)"/>
                <line x1="305" y1="235" x2="305" y2="205" stroke="#F87171" stroke-width="2" marker-end="url(#arrowRed)"/>
                <line x1="475" y1="235" x2="355" y2="205" stroke="#DC2626" stroke-width="2.5" stroke-dasharray="6,4" marker-end="url(#arrowRed)"/>

                <!-- PSK: 問題点ボックス -->
                <rect x="60" y="330" width="500" height="150" rx="10" fill="white" stroke="#FECACA" stroke-width="1.5"/>
                <text x="310" y="360" text-anchor="middle" font-size="18" font-weight="600" fill="#DC2626">&#9888;&#65039; PSKの問題点</text>
                <text x="80" y="390" font-size="16" fill="#475569">• 全員が同じ鍵を共有 → 1人漏洩で全体がリスク</text>
                <text x="80" y="416" font-size="16" fill="#475569">• 退職者の個別無効化が不可能</text>
                <text x="80" y="442" font-size="16" fill="#475569">• 鍵の変更時は全ユーザーへ再配布が必要</text>
                <text x="80" y="468" font-size="16" fill="#475569">• 誰がいつ接続したか追跡困難</text>

                <!-- 右：証明書認証 -->
                <rect x="610" y="65" width="560" height="430" rx="14" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
                <text x="890" y="100" text-anchor="middle" font-size="20" font-weight="700" fill="#059669">&#9989; 証明書認証 = 社員証方式</text>

                <!-- 証明書: 総務部 -->
                <rect x="780" y="130" width="220" height="70" rx="12" fill="white" stroke="#34D399" stroke-width="2"/>
                <text x="890" y="160" text-anchor="middle" font-size="20" fill="#1E293B">&#127971; 総務部(CA)</text>
                <text x="890" y="185" text-anchor="middle" font-size="16" fill="#475569">個別社員証を発行</text>

                <!-- 証明書: 社員たち -->
                <g>
                    <rect x="640" y="240" width="150" height="60" rx="10" fill="white" stroke="#CBD5E1" stroke-width="1.5"/>
                    <text x="715" y="268" text-anchor="middle" font-size="18" fill="#1E293B">&#129707; 社員A</text>
                    <text x="715" y="288" text-anchor="middle" font-size="14" fill="#059669">固有の社員証</text>
                </g>
                <g>
                    <rect x="810" y="240" width="150" height="60" rx="10" fill="white" stroke="#CBD5E1" stroke-width="1.5"/>
                    <text x="885" y="268" text-anchor="middle" font-size="18" fill="#1E293B">&#129707; 社員B</text>
                    <text x="885" y="288" text-anchor="middle" font-size="14" fill="#059669">固有の社員証</text>
                </g>
                <g>
                    <rect x="980" y="240" width="150" height="60" rx="10" fill="white" stroke="#6EE7B7" stroke-width="2" stroke-dasharray="6,4"/>
                    <text x="1055" y="268" text-anchor="middle" font-size="18" fill="#1E293B">&#128683; 退職者</text>
                    <text x="1055" y="288" text-anchor="middle" font-size="14" fill="#DC2626">証明書を失効</text>
                </g>

                <!-- 証明書: 矢印 -->
                <line x1="715" y1="235" x2="835" y2="205" stroke="#34D399" stroke-width="2" marker-end="url(#arrowGreen)"/>
                <line x1="885" y1="235" x2="885" y2="205" stroke="#34D399" stroke-width="2" marker-end="url(#arrowGreen)"/>
                <line x1="1055" y1="240" x2="940" y2="205" stroke="#EF4444" stroke-width="2.5" marker-end="url(#arrowRedX)"/>
                <text x="1010" y="225" text-anchor="middle" font-size="20" fill="#DC2626">&#10006;</text>

                <!-- 証明書: メリットボックス -->
                <rect x="640" y="330" width="500" height="150" rx="10" fill="white" stroke="#A7F3D0" stroke-width="1.5"/>
                <text x="890" y="360" text-anchor="middle" font-size="18" font-weight="600" fill="#059669">&#9989; 証明書認証のメリット</text>
                <text x="660" y="390" font-size="16" fill="#475569">• 一人一枚の固有証明書 → 個別管理が可能</text>
                <text x="660" y="416" font-size="16" fill="#475569">• 退職者の証明書だけをCRLで即座に失効</text>
                <text x="660" y="442" font-size="16" fill="#475569">• 他のユーザーには一切影響なし</text>
                <text x="660" y="468" font-size="16" fill="#475569">• 証明書ごとに詳細な接続ログ（監査証跡）</text>

                <!-- 矢印マーカー定義 -->
                <defs>
                    <marker id="arrowRed" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="#F87171"/>
                    </marker>
                    <marker id="arrowGreen" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="#34D399"/>
                    </marker>
                    <marker id="arrowRedX" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="#EF4444"/>
                    </marker>
                </defs>
            </svg>
        </div>
    </section>

    <!-- 証明書ベースVPN認証の仕組み -->
    <section class="section">
        <h2 id="architecture">&#128736; 証明書ベースVPN認証の仕組み</h2>
        <p>社員証で入館する流れを、証明書認証のプロセスに対応させて見ていきましょう。</p>

        <!-- 認証フロー SVG -->
        <div class="svg-container">
            <svg viewBox="0 0 1200 640" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="証明書ベースVPN認証フロー図">
                <!-- 外側カード -->
                <rect x="24" y="24" width="1152" height="592" rx="22" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="1.5"/>

                <!-- タイトル -->
                <text x="600" y="62" text-anchor="middle" font-size="22" font-weight="700" fill="#0F172A">証明書ベースVPN認証フロー（社員証での入館プロセス）</text>

                <!-- 内側パネル -->
                <rect x="40" y="82" width="1120" height="510" rx="18" fill="white" stroke="#E2E8F0" stroke-width="1"/>

                <!-- Row 1: メイン認証フロー -->

                <!-- Node 1: VPNクライアント -->
                <g>
                    <rect x="50" y="150" width="220" height="96" rx="16" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
                    <text x="160" y="188" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">&#128100; VPNクライアント</text>
                    <text x="160" y="216" text-anchor="middle" font-size="16" fill="#475569">（社員 / 入館希望者）</text>
                </g>

                <!-- Node 2: Client VPN Endpoint -->
                <g>
                    <rect x="350" y="150" width="240" height="96" rx="16" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
                    <text x="470" y="185" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">&#128682; Client VPN</text>
                    <text x="470" y="212" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">Endpoint</text>
                    <text x="470" y="238" text-anchor="middle" font-size="14" fill="#475569">（入退館ゲート）</text>
                </g>

                <!-- Node 3: AWS VPC -->
                <g>
                    <rect x="670" y="150" width="240" height="96" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
                    <text x="790" y="188" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">&#127970; AWS VPC</text>
                    <text x="790" y="216" text-anchor="middle" font-size="16" fill="#475569">（会社のビル内）</text>
                </g>

                <!-- Node 4: ACM Private CA -->
                <g>
                    <rect x="940" y="150" width="220" height="96" rx="16" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
                    <text x="1060" y="185" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">&#127971; ACM</text>
                    <text x="1060" y="212" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">Private CA</text>
                    <text x="1060" y="238" text-anchor="middle" font-size="14" fill="#475569">（総務部門）</text>
                </g>

                <!-- Row 2: 認証検証フロー -->

                <!-- Node 5: クライアント証明書 -->
                <g>
                    <rect x="50" y="330" width="220" height="96" rx="16" fill="#FEFCE8" stroke="#FACC15" stroke-width="2"/>
                    <text x="160" y="365" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">&#129707; クライアント</text>
                    <text x="160" y="393" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">証明書</text>
                    <text x="160" y="418" text-anchor="middle" font-size="14" fill="#475569">（社員証）</text>
                </g>

                <!-- Node 6: 証明書検証 -->
                <g>
                    <rect x="350" y="330" width="240" height="96" rx="16" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
                    <text x="470" y="368" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">&#128269; 証明書検証</text>
                    <text x="470" y="396" text-anchor="middle" font-size="16" fill="#475569">有効期限・CA署名・</text>
                    <text x="470" y="418" text-anchor="middle" font-size="16" fill="#475569">CRL照合</text>
                </g>

                <!-- Node 7: CRL（失効リスト） -->
                <g>
                    <rect x="670" y="330" width="240" height="96" rx="16" fill="#FEF2F2" stroke="#F87171" stroke-width="2"/>
                    <text x="790" y="365" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">&#128203; CRL</text>
                    <text x="790" y="393" text-anchor="middle" font-size="16" fill="#475569">証明書失効リスト</text>
                    <text x="790" y="418" text-anchor="middle" font-size="14" fill="#475569">（退職者リスト）</text>
                </g>

                <!-- Node 8: サーバー証明書 -->
                <g>
                    <rect x="940" y="330" width="220" height="96" rx="16" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
                    <text x="1060" y="368" text-anchor="middle" font-size="20" font-weight="600" fill="#1E293B">&#128220; サーバー証明書</text>
                    <text x="1060" y="396" text-anchor="middle" font-size="16" fill="#475569">VPN側の身分証明</text>
                    <text x="1060" y="418" text-anchor="middle" font-size="14" fill="#475569">（ビルの許可証）</text>
                </g>

                <!-- 矢印（フロー） -->
                <!-- 1→2: クライアントが証明書を提示 -->
                <line x1="275" y1="198" x2="345" y2="198" stroke="#3B82F6" stroke-width="2.5" marker-end="url(#arrowBlue)"/>
                <text x="310" y="186" text-anchor="middle" font-size="13" fill="#3B82F6" font-weight="600">&#9312;証明書提示</text>

                <!-- 2→3: 認証OK → 接続許可 -->
                <line x1="595" y1="198" x2="665" y2="198" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrowGreen2)"/>
                <text x="630" y="186" text-anchor="middle" font-size="13" fill="#10B981" font-weight="600">&#9315;接続許可</text>

                <!-- 4→2: CAがサーバー証明書を発行（ノード上方を迂回） -->
                <path d="M 1060 150 L 1060 108 L 470 108 L 470 145" stroke="#F59E0B" stroke-width="2" stroke-dasharray="6,4" fill="none" marker-end="url(#arrowAmber)"/>
