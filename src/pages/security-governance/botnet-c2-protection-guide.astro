const rawContent = `<style>/* ==========================================
           CSS Variables
           ========================================== */
        :root {
            --aws-dark: #232F3E;
            --aws-orange: #FF9900;
            --aws-orange-deep: #EC7211;
            --color-danger: #E74C3C;
            --color-danger-light: #FFF5F5;
            --color-danger-border: #FED7D7;
            --color-success: #10B981;
            --color-success-light: #F0FDF4;
            --color-success-border: #BBF7D0;
            --color-info: #3B82F6;
            --color-info-light: #EFF6FF;
            --color-info-border: #BFDBFE;
            --color-warning: #F59E0B;
            --color-warning-light: #FFFBEB;
            --color-warning-border: #FDE68A;
            --color-purple: #8B5CF6;
            --color-purple-light: #F5F3FF;
            --color-purple-border: #DDD6FE;
            --text-primary: #1E293B;
            --text-secondary: #475569;
            --text-tertiary: #64748B;
            --bg-white: #FFFFFF;
            --bg-light: #F8FAFC;
            --bg-subtle: #F1F5F9;
            --border-light: #E2E8F0;
            --border-medium: #CBD5E1;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
            --shadow-lg: 0 8px 32px rgba(0,0,0,0.10);
            --shadow-xl: 0 16px 48px rgba(0,0,0,0.12);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;
            --font-main: 'Noto Sans JP', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        /* ==========================================
           Base Reset & Typography
           ========================================== */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-main);
            font-size: 20px;
            line-height: 1.7;
            color: var(--text-primary);
            background: var(--bg-light);
            -webkit-font-smoothing: antialiased;
            padding-top: 70px;}

        /* ==========================================
           Layout Container
           ========================================== */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ==========================================
           Hero Header
           ========================================== */
        .hero {
            background: linear-gradient(135deg, var(--aws-dark) 0%, #1a2332 50%, #2d3a4a 100%);
            color: white;
            padding: 56px 0 48px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(255,153,0,0.08) 0%, transparent 70%);
            border-radius: 50%;
        }

        .hero::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(59,130,246,0.06) 0%, transparent 70%);
            border-radius: 50%;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,153,0,0.15);
            border: 1px solid rgba(255,153,0,0.3);
            color: var(--aws-orange);
            padding: 8px 18px;
            border-radius: 100px;
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 36px;
            font-weight: 800;
            line-height: 1.3;
            margin-bottom: 16px;
            letter-spacing: -0.5px;
        }

        .hero h1 .highlight {
            color: var(--aws-orange);
        }

        .hero-subtitle {
            font-size: 22px;
            color: rgba(255,255,255,0.75);
            max-width: 800px;
            line-height: 1.6;
        }

        /* ==========================================
           Conclusion First Box
           ========================================== */
        .conclusion-first {
            background: linear-gradient(135deg, #FFF7ED 0%, #FFFBF5 100%);
            border: 2px solid #FDBA74;
            border-radius: var(--radius-xl);
            padding: 36px 40px;
            margin: 40px 0;
            position: relative;
        }

        .conclusion-first::before {
            content: '💡';
            position: absolute;
            top: -18px;
            left: 32px;
            font-size: 32px;
            background: var(--bg-light);
            padding: 0 12px;
        }

        .conclusion-label {
            font-size: 20px;
            font-weight: 700;
            color: var(--aws-orange-deep);
            margin-bottom: 12px;
            letter-spacing: 0.5px;
        }

        .conclusion-text {
            font-size: 22px;
            font-weight: 600;
            color: var(--text-primary);
            line-height: 1.7;
        }

        .conclusion-text strong {
            color: var(--aws-orange-deep);
        }

        /* ==========================================
           Section Headers
           ========================================== */
        .section {
            margin: 48px 0;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 28px;
        }

        .section-number {
            width: 44px;
            height: 44px;
            background: var(--aws-dark);
            color: var(--aws-orange);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .section-title {
            font-size: 28px;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -0.3px;
        }

        /* ==========================================
           Analogy Box
           ========================================== */
        .analogy-box {
            background: var(--bg-white);
            border-radius: var(--radius-xl);
            padding: 36px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-light);
            margin-bottom: 32px;
        }

        .analogy-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 20px;
            font-weight: 700;
            color: var(--color-info);
            background: var(--color-info-light);
            padding: 6px 16px;
            border-radius: 100px;
            margin-bottom: 18px;
        }

        .analogy-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 16px;
        }

        .analogy-desc {
            font-size: 20px;
            color: var(--text-secondary);
            line-height: 1.8;
        }

        /* ==========================================
           Diagram: Botnet Structure
           ========================================== */
        .diagram-card {
            background: var(--bg-white);
            border-radius: var(--radius-xl);
            padding: 36px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-light);
            margin-bottom: 32px;
            overflow: hidden;
        }

        .diagram-title {
            font-size: 22px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 28px;
            color: var(--text-primary);
        }

        /* Botnet Visual */
        .botnet-diagram {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0;
            padding: 20px 0;
        }

        .attacker-node {
            background: linear-gradient(135deg, #991B1B, #DC2626);
            color: white;
            padding: 18px 32px;
            border-radius: var(--radius-lg);
            font-size: 22px;
            font-weight: 700;
            text-align: center;
            box-shadow: 0 4px 20px rgba(220,38,38,0.3);
            position: relative;
            z-index: 2;
        }

        .attacker-node .sub {
            font-size: 20px;
            font-weight: 400;
            opacity: 0.85;
            display: block;
            margin-top: 4px;
        }

        .connection-line {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 8px 0;
        }

        .connection-line .arrow {
            font-size: 28px;
            color: var(--color-danger);
            line-height: 1;
        }

        .connection-label {
            font-size: 20px;
            font-weight: 600;
            color: var(--color-danger);
            background: var(--color-danger-light);
            border: 1px solid var(--color-danger-border);
            padding: 6px 18px;
            border-radius: 100px;
            margin: 4px 0;
        }

        .c2-server-node {
            background: linear-gradient(135deg, #92400E, #D97706);
            color: white;
            padding: 18px 32px;
            border-radius: var(--radius-lg);
            font-size: 22px;
            font-weight: 700;
            text-align: center;
            box-shadow: 0 4px 20px rgba(217,119,6,0.3);
        }

        .c2-server-node .sub {
            font-size: 20px;
            font-weight: 400;
            opacity: 0.85;
            display: block;
            margin-top: 4px;
        }

        .dns-query-label {
            font-size: 20px;
            font-weight: 600;
            color: var(--color-purple);
            background: var(--color-purple-light);
            border: 1px solid var(--color-purple-border);
            padding: 6px 18px;
            border-radius: 100px;
            margin: 4px 0;
        }

        .bot-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            max-width: 560px;
            margin: 0 auto;
        }

        .bot-node {
            background: var(--bg-subtle);
            border: 2px solid var(--border-medium);
            border-radius: var(--radius-md);
            padding: 14px;
            text-align: center;
            font-size: 20px;
            font-weight: 500;
            color: var(--text-secondary);
            position: relative;
        }

        .bot-node .bot-icon {
            font-size: 28px;
            display: block;
            margin-bottom: 4px;
        }

        .bot-node.infected {
            border-color: var(--color-danger);
            background: var(--color-danger-light);
            color: var(--color-danger);
        }

        .bot-node.infected::after {
            content: '⚠️';
            position: absolute;
            top: -8px;
            right: -8px;
            font-size: 20px;
        }

        /* ==========================================
           Feature Grid
           ========================================== */
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .feature-card {
            background: var(--bg-white);
            border-radius: var(--radius-lg);
            padding: 28px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-light);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .feature-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .feature-icon {
            font-size: 36px;
            margin-bottom: 14px;
        }

        .feature-name {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .feature-desc {
            font-size: 20px;
            color: var(--text-secondary);
            line-height: 1.7;
        }

        /* ==========================================
           Protection Flow Diagram
           ========================================== */
        .flow-diagram {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0;
            padding: 28px 0;
        }

        .flow-node {
            width: 100%;
            max-width: 600px;
            padding: 22px 28px;
            border-radius: var(--radius-lg);
            text-align: center;
            font-size: 20px;
            font-weight: 600;
            position: relative;
        }

        .flow-node.ec2 {
            background: linear-gradient(135deg, #1E40AF, #3B82F6);
            color: white;
            box-shadow: 0 4px 16px rgba(59,130,246,0.3);
        }

        .flow-node.dns-query {
            background: var(--color-purple-light);
            border: 2px solid var(--color-purple-border);
            color: var(--color-purple);
        }

        .flow-node.firewall {
            background: linear-gradient(135deg, #065F46, #10B981);
            color: white;
            box-shadow: 0 4px 16px rgba(16,185,129,0.3);
            padding: 26px 28px;
        }

        .flow-node.firewall .shield-icon {
            font-size: 32px;
            display: block;
            margin-bottom: 4px;
        }

        .flow-node.block {
            background: var(--color-danger-light);
            border: 2px solid var(--color-danger-border);
            color: var(--color-danger);
        }

        .flow-node.allow {
            background: var(--color-success-light);
            border: 2px solid var(--color-success-border);
            color: #065F46;
        }

        .flow-arrow {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 6px 0;
            color: var(--text-tertiary);
            font-size: 24px;
        }

        .flow-arrow .arrow-text {
            font-size: 20px;
            font-weight: 500;
            margin-bottom: 2px;
        }

        .flow-branch {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            width: 100%;
            max-width: 600px;
        }

        .flow-branch-arrow {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 100px;
            padding: 4px 0;
        }

        .flow-branch-arrow .branch-left,
        .flow-branch-arrow .branch-right {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 20px;
            font-weight: 600;
        }

        .flow-branch-arrow .branch-left {
            color: var(--color-danger);
        }

        .flow-branch-arrow .branch-right {
            color: var(--color-success);
        }

        /* ==========================================
           Managed List Table
           ========================================== */
        .managed-list-card {
            background: var(--bg-white);
            border-radius: var(--radius-xl);
            padding: 36px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-light);
            margin-bottom: 32px;
        }

        .managed-list-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .managed-item {
            background: var(--bg-light);
            border-radius: var(--radius-md);
            padding: 24px;
            border: 1px solid var(--border-light);
        }

        .managed-item-icon {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .managed-item-name {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 6px;
        }

        .managed-item-desc {
            font-size: 20px;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        .managed-item.primary {
            background: linear-gradient(135deg, #FFF7ED, #FEF3C7);
            border: 2px solid #FDBA74;
        }

        .managed-item.primary .managed-item-name {
            color: var(--aws-orange-deep);
        }

        /* ==========================================
           Steps
           ========================================== */
        .steps-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .step-item {
            display: flex;
            gap: 20px;
            background: var(--bg-white);
            border-radius: var(--radius-lg);
            padding: 28px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-light);
            align-items: flex-start;
        }

        .step-number {
            width: 48px;
            height: 48px;
            background: var(--aws-dark);
            color: var(--aws-orange);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .step-content {
            flex: 1;
        }

        .step-title {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .step-desc {
            font-size: 20px;
            color: var(--text-secondary);
            line-height: 1.7;
        }

        .step-code {
            font-family: var(--font-mono);
            background: var(--aws-dark);
            color: #E2E8F0;
            padding: 18px 22px;
            border-radius: var(--radius-md);
            font-size: 17px;
            margin-top: 14px;
            overflow-x: auto;
            line-height: 1.6;
            white-space: pre;
        }

        .step-code .keyword {
            color: #93C5FD;
        }

        .step-code .string {
            color: #86EFAC;
        }

        .step-code .comment {
            color: #64748B;
        }

        /* ==========================================
           Comparison: Before / After
           ========================================== */
        .comparison-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .comparison-card {
            border-radius: var(--radius-xl);
            padding: 32px;
            box-shadow: var(--shadow-md);
        }

        .comparison-card.before {
            background: linear-gradient(135deg, #FFF5F5, #FEF2F2);
            border: 2px solid var(--color-danger-border);
        }

        .comparison-card.after {
            background: linear-gradient(135deg, #F0FDF4, #ECFDF5);
            border: 2px solid var(--color-success-border);
        }

        .comparison-label {
            font-size: 20px;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 100px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
        }

        .comparison-card.before .comparison-label {
            background: rgba(239,68,68,0.12);
            color: var(--color-danger);
        }

        .comparison-card.after .comparison-label {
            background: rgba(16,185,129,0.12);
            color: #065F46;
        }

        .comparison-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .comparison-list li {
            font-size: 20px;
            color: var(--text-secondary);
            padding-left: 28px;
            position: relative;
            line-height: 1.6;
        }

        .comparison-list li::before {
            position: absolute;
            left: 0;
            font-size: 20px;
        }

        .comparison-card.before .comparison-list li::before {
            content: '❌';
        }

        .comparison-card.after .comparison-list li::before {
            content: '✅';
        }

        /* ==========================================
           DNS Analogy Visual
           ========================================== */
        .analogy-visual {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0;
            padding: 24px 0;
        }

        .analogy-node {
            width: 100%;
            max-width: 520px;
            padding: 20px 28px;
            border-radius: var(--radius-lg);
            text-align: center;
            font-size: 20px;
            font-weight: 600;
        }

        .analogy-node.person {
            background: var(--color-info-light);
            border: 2px solid var(--color-info-border);
            color: #1E40AF;
        }

        .analogy-node.guard {
            background: linear-gradient(135deg, #065F46, #10B981);
            color: white;
            box-shadow: 0 4px 16px rgba(16,185,129,0.3);
            padding: 24px 28px;
        }

        .analogy-node.guard .guard-icon {
            font-size: 36px;
            display: block;
            margin-bottom: 4px;
        }

        .analogy-node.danger-dest {
            background: var(--color-danger-light);
            border: 2px solid var(--color-danger-border);
            color: var(--color-danger);
        }

        .analogy-node.safe-dest {
            background: var(--color-success-light);
            border: 2px solid var(--color-success-border);
            color: #065F46;
        }

        .analogy-arrow {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 6px 0;
            font-size: 20px;
            color: var(--text-tertiary);
        }

        /* ==========================================
           Best Practices
           ========================================== */
        .practices-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .practice-card {
            background: var(--bg-white);
            border-radius: var(--radius-lg);
            padding: 28px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-light);
        }

        .practice-icon {
            font-size: 36px;
            margin-bottom: 12px;
        }

        .practice-name {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .practice-desc {
            font-size: 20px;
            color: var(--text-secondary);
            line-height: 1.7;
        }

        /* ==========================================
           FAQ Section
           ========================================== */
        .faq-item {
            background: var(--bg-white);
            border-radius: var(--radius-lg);
            padding: 28px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-light);
            margin-bottom: 16px;
        }

        .faq-q {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 10px;
            display: flex;
            gap: 10px;
        }

        .faq-a {
            font-size: 20px;
            color: var(--text-secondary);
            line-height: 1.7;
            padding-left: 34px;
