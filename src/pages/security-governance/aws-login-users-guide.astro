---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: '',
  pageTitle: 'AWS ログインユーザーの種類 - 完全ガイド',
  category: 'security-governance',
  categoryLabel: 'セキュリティ・ガバナンス',
  subcategory: '',
  slug: 'aws-login-users-guide',
  pageCss: '/aws_sap_studying/css/pages/aws-login-users-guide.css',
  tocItems: [
    { level: 'h2', id: '結論ファースト', text: '💡 結論ファースト' },
    { level: 'h2', id: 'オフィスビルで理解する3つのログイン方法', text: 'オフィスビルで理解する3つのログイン方法' },
    { level: 'h2', id: '各ログイン方法の詳細', text: '📚 各ログイン方法の詳細' },
    { level: 'h3', id: 'IAM-ユーザーとは？', text: '🔑 IAM ユーザーとは？' },
    { level: 'h3', id: 'IAM-ロールとは？', text: '🔄 IAM ロールとは？' },
    { level: 'h3', id: 'フェデレーティッドユーザーとは？', text: '🌐 フェデレーティッドユーザーとは？' },
    { level: 'h2', id: 'AWSへのログインフロー', text: '🔄 AWSへのログインフロー' },
    { level: 'h2', id: '3つのユーザータイプ比較表', text: '📊 3つのユーザータイプ比較表' },
    { level: 'h2', id: '✅-ベストプラクティス', text: '✅ ベストプラクティス' },
    { level: 'h3', id: 'ルートユーザーは使わない', text: 'ルートユーザーは使わない' },
    { level: 'h2', id: '❓-よくある質問', text: '❓ よくある質問' }
  ],
  prevPage: 'saml-certificate-rotation-guide.html',
  nextPage: 'iam-role-policies-guide.html',
  pageNum: 6,
  pageTotal: 71,
};

const rawContent = `<!-- オフィスビルのたとえ話 -->
<section class="analogy-section">
<div class="analogy-header">
<span class="emoji">
      🏢
     </span>
<h2 id="オフィスビルで理解する3つのログイン方法">
      オフィスビルで理解する3つのログイン方法
     </h2>
<p style="color: var(--text-secondary);">
      AWSを「セキュリティの厳しいオフィスビル」に例えて考えてみましょう
     </p>
</div>
<div class="analogy-grid">
<div class="analogy-card iam-user">
<div class="analogy-icon">
       👨‍💼
      </div>
<div class="analogy-title">
       正社員（社員証を持つ人）
      </div>
<div class="analogy-aws">
       = IAM ユーザー
      </div>
<p class="analogy-desc">
       会社から発行された
       <strong>
        自分専用の社員証
       </strong>
       を持っている人。毎日その社員証でビルに入館し、決められたフロアにアクセスできます。
      </p>
</div>
<div class="analogy-card iam-role">
<div class="analogy-icon">
       🎭
      </div>
<div class="analogy-title">
       役職バッジ（一時的な権限）
      </div>
<div class="analogy-aws">
       = IAM ロール
      </div>
<p class="analogy-desc">
       必要な時だけ受付で借りる
       <strong>
        特別な役職バッジ
       </strong>
       。「本日は経理部長代理」など、一時的に特定の権限を持てます。使い終わったら返却します。
      </p>
</div>
<div class="analogy-card federated">
<div class="analogy-icon">
       🤝
      </div>
<div class="analogy-title">
       外部企業からの訪問者
      </div>
<div class="analogy-aws">
       = フェデレーティッドユーザー
      </div>
<p class="analogy-desc">
       パートナー企業の社員が
       <strong>
        自社のIDカード
       </strong>
       で入館する仕組み。受付で身元確認後、ゲストバッジが発行されて必要なエリアにアクセスできます。
      </p>
</div>
</div>
</section>
<!-- 各ユーザータイプの詳細 -->
<section class="section-title">
<h2 id="各ログイン方法の詳細">
     📚 各ログイン方法の詳細
    </h2>
<p>
     それぞれの特徴と使いどころを理解しましょう
    </p>
</section>
<div class="detail-cards">
<!-- IAMユーザー -->
<article class="detail-card iam-user">
<div class="detail-visual">
<div class="visual-icon">
       👨‍💼
      </div>
<div class="visual-label">
       IAM ユーザー
      </div>
<span class="visual-badge">
       永続的な認証情報
      </span>
</div>
<div class="detail-content">
<h3 id="IAM-ユーザーとは？">
       🔑 IAM ユーザーとは？
      </h3>
<p class="detail-desc">
       AWSアカウント内で作成される、固定のユーザー名とパスワード（またはアクセスキー）を持つ個人用アカウントです。長期的な認証情報を持ち、特定の人や自動化プロセスに割り当てられます。
      </p>
<ul class="feature-list">
<li>
        ユーザー名とパスワードでAWSコンソールにログイン
       </li>
<li>
        アクセスキーでCLI/SDKからプログラム的にアクセス
       </li>
<li>
        MFA（多要素認証）でセキュリティを強化可能
       </li>
<li>
        IAMポリシーで細かく権限を制御
       </li>
</ul>
<div class="use-cases">
<h4>
        💼 主な利用シーン
       </h4>
<div class="use-case-tags">
<span class="use-case-tag">
         開発者の個人アカウント
        </span>
<span class="use-case-tag">
         管理者アカウント
        </span>
<span class="use-case-tag">
         CI/CD用サービスアカウント
        </span>
</div>
</div>
</div>
</article>
<!-- IAMロール -->
<article class="detail-card iam-role">
<div class="detail-visual">
<div class="visual-icon">
       🎭
      </div>
<div class="visual-label">
       IAM ロール
      </div>
<span class="visual-badge">
       一時的な認証情報
      </span>
</div>
<div class="detail-content">
<h3 id="IAM-ロールとは？">
       🔄 IAM ロールとは？
      </h3>
<p class="detail-desc">
       特定のユーザーに紐づかない、一時的に引き受ける（Assume）ことができる権限のセットです。認証情報は自動的に発行・更新・失効するため、セキュリティが高く、現在推奨されるベストプラクティスです。
      </p>
<ul class="feature-list">
<li>
        一時的なセキュリティ認証情報（STS）を使用
       </li>
<li>
        EC2インスタンスやLambda関数に権限を付与
       </li>
<li>
        クロスアカウントアクセスに活用
       </li>
<li>
        認証情報の自動ローテーションで安全
       </li>
</ul>
<div class="use-cases">
<h4>
        💼 主な利用シーン
       </h4>
<div class="use-case-tags">
<span class="use-case-tag">
         EC2からS3へのアクセス
        </span>
<span class="use-case-tag">
         Lambda関数の実行権限
        </span>
<span class="use-case-tag">
         別AWSアカウントへのアクセス
        </span>
</div>
</div>
</div>
</article>
<!-- フェデレーティッドユーザー -->
<article class="detail-card federated">
<div class="detail-visual">
<div class="visual-icon">
       🤝
      </div>
<div class="visual-label">
       フェデレーティッド
      </div>
<span class="visual-badge">
       外部認証連携
      </span>
</div>
<div class="detail-content">
<h3 id="フェデレーティッドユーザーとは？">
       🌐 フェデレーティッドユーザーとは？
      </h3>
<p class="detail-desc">
       社内のActive DirectoryやGoogleなどの外部IDプロバイダー（IdP）で認証されたユーザーが、そのIDを使ってAWSにアクセスする仕組みです。既存の認証基盤を活用でき、ユーザー管理が一元化できます。
      </p>
<ul class="feature-list">
<li>
        SAML 2.0やOIDCで外部IdPと連携
       </li>
<li>
        AWS IAM Identity Center（旧AWS SSO）で統合管理
       </li>
<li>
        既存の企業ID管理システムを活用
       </li>
<li>
        シングルサインオン（SSO）で利便性向上
       </li>
</ul>
<div class="use-cases">
<h4>
        💼 主な利用シーン
       </h4>
<div class="use-case-tags">
<span class="use-case-tag">
         企業のSSO環境
        </span>
<span class="use-case-tag">
         Google/Oktaでのログイン
        </span>
<span class="use-case-tag">
         大規模組織のID管理
        </span>
</div>
</div>
</div>
</article>
</div>
<!-- 認証フロー図 -->
<section class="flow-section">
<div class="flow-header">
<h2 id="AWSへのログインフロー">
      🔄 AWSへのログインフロー
     </h2>
<p style="color: var(--text-secondary);">
      どのユーザータイプも最終的にAWSリソースにアクセスします
     </p>
</div>
<div class="flow-diagram">
<div class="flow-step">
<div class="flow-icon">
       👤
      </div>
<div class="flow-label">
       ユーザー
      </div>
<div class="flow-desc">
       アクセスを要求
      </div>
</div>
<div class="flow-step">
<div class="flow-icon">
       🔐
      </div>
<div class="flow-label">
       認証
      </div>
<div class="flow-desc">
       本人確認を実施
      </div>
</div>
<div class="flow-step">
<div class="flow-icon">
       📋
      </div>
<div class="flow-label">
       認可
      </div>
<div class="flow-desc">
       権限をチェック
      </div>
</div>
<div class="flow-step">
<div class="flow-icon">
       ☁️
      </div>
<div class="flow-label">
       AWSリソース
      </div>
<div class="flow-desc">
       操作を実行
      </div>
</div>
</div>
</section>
<!-- 比較テーブル -->
<section class="comparison-section">
<div class="section-title">
<h2 id="3つのユーザータイプ比較表">
      📊 3つのユーザータイプ比較表
     </h2>
</div>
<table class="comparison-table">
<thead>
<tr>
<th>
        比較項目
       </th>
<th class="table-header-iam-user">
        👨‍💼 IAMユーザー
       </th>
<th class="table-header-iam-role">
        🎭 IAMロール
       </th>
<th class="table-header-federated">
        🤝 フェデレーティッド
       </th>
</tr>
</thead>
<tbody>
<tr>
<td>
        認証情報の種類
       </td>
<td>
        永続的（パスワード/アクセスキー）
       </td>
<td>
        一時的（STS トークン）
       </td>
<td>
        一時的（外部IdP経由）
       </td>
</tr>
<tr>
<td>
        認証情報の管理
       </td>
<td>
        手動で管理・ローテーション
       </td>
<td>
        自動で発行・失効
       </td>
<td>
        外部IdPが管理
       </td>
</tr>
<tr>
<td>
        セキュリティ
       </td>
<td>
        △ 漏洩リスクあり
       </td>
<td>
        ◎ 一時的で安全
       </td>
<td>
        ◎ 一元管理で安全
       </td>
</tr>
<tr>
<td>
        適用対象
       </td>
<td>
        特定の人・プロセス
       </td>
<td>
        AWSサービス/人/外部
       </td>
<td>
        企業ユーザー
       </td>
</tr>
<tr>
<td>
        ユースケース
       </td>
<td>
        個人開発者、CI/CDパイプライン
       </td>
<td>
        EC2、Lambda、クロスアカウント
       </td>
<td>
        企業SSO、大規模組織
       </td>
</tr>
<tr>
<td>
        管理の手間
       </td>
<td>
        ユーザーごとに管理が必要
       </td>
<td>
        ロール定義のみ
       </td>
<td>
        IdPで一元管理
       </td>
</tr>
</tbody>
</table>
</section>
<!-- ベストプラクティス -->
<section class="best-practices">
<h2 id="✅-ベストプラクティス">
     ✅ ベストプラクティス
    </h2>
<div class="practice-grid">
<div class="practice-item">
<span class="practice-icon">
       🚫
      </span>
<div class="practice-text">
<h3 id="ルートユーザーは使わない">
        ルートユーザーは使わない
       </h3>
<p>
        日常作業では絶対に使用せず、IAMユーザーまたはロールを使いましょう
       </p>
</div>
</div>
<div class="practice-item">
<span class="practice-icon">
       🔄
      </span>
<div class="practice-text">
<h4>
        ロールを優先的に使用
       </h4>
<p>
        可能な限りIAMロールを使用し、長期的な認証情報を避けましょう
       </p>
</div>
</div>
<div class="practice-item">
<span class="practice-icon">
       🔐
      </span>
<div class="practice-text">
<h4>
        MFAを必ず有効化
       </h4>
<p>
        IAMユーザーには必ず多要素認証を設定しましょう
       </p>
</div>
</div>
<div class="practice-item">
<span class="practice-icon">
       🏢
      </span>
<div class="practice-text">
<h4>
        企業はフェデレーションを検討
       </h4>
<p>
        大規模組織ではIAM Identity Centerでの一元管理がおすすめです
       </p>
</div>
</div>
</div>
</section>
<!-- FAQ -->
<section class="faq-section">
<div class="section-title" style="margin-bottom: 2rem;">
<h2 id="❓-よくある質問">
      ❓ よくある質問
     </h2>
</div>
<div class="faq-item">
<div class="faq-q">
      IAMユーザーとIAMロールはどちらを使えばいいですか？
     </div>
<p class="faq-a">
      基本的にはIAMロールの使用が推奨されます。EC2やLambdaなどのAWSサービスにはロールを割り当て、人間のユーザーもIAM Identity Centerなどでロールを使う形が理想的です。IAMユーザーは、どうしても長期的なアクセスキーが必要な場合（一部のCI/CDツールなど）に限定しましょう。
     </p>
</div>
<div class="faq-item">
<div class="faq-q">
      フェデレーションを使うメリットは何ですか？
     </div>
<p class="faq-a">
      既存のID管理システム（Active Directory、Okta、Google Workspaceなど）をそのまま活用できるため、ユーザーの追加・削除がAWS側で不要になります。退職者のアクセス権削除漏れなどのリスクも軽減できます。また、ユーザーは一つのパスワードで複数のシステムにアクセスできるため利便性も向上します。
     </p>
</div>
<div class="faq-item">
<div class="faq-q">
      「ロールを引き受ける（Assume Role）」とはどういう意味ですか？
     </div>
<p class="faq-a">
      たとえ話でいうと「受付で役職バッジを借りる」ことに相当します。技術的には、AWS STSに対して「このロールの権限を一時的に使わせてください」とリクエストし、許可されると一時的なセキュリティ認証情報が発行されます。この認証情報には有効期限があり、期限が切れると自動的に無効になります。
     </p>
</div>
<div class="faq-item">
<div class="faq-q">
      アクセスキーとパスワードの違いは何ですか？
     </div>
<p class="faq-a">
      パスワードはAWSマネジメントコンソール（Webブラウザ）へのログインに使用します。一方、アクセスキー（アクセスキーIDとシークレットアクセスキー）はAWS CLIやSDKからプログラム的にAWSを操作する際に使用します。どちらも長期的な認証情報なので、定期的なローテーションとMFAの設定が重要です。
     </p>
</div>
</section>
</main>
<footer>
<p>
    AWS ログインユーザーガイド | 作成日: 2025年
   </p>
<p>
    詳細は
    <a href="https://docs.aws.amazon.com/IAM/" target="_blank">
     AWS IAM ドキュメント
    </a>
    を参照してください
   </p>
</footer>`;
---

<ResourceLayout {...frontmatter}>
  <Fragment set:html={rawContent} />
</ResourceLayout>
