const frontmatter = {
  title: 'Aws Organization Control Tower',
  pageTitle: 'AWS Organization と AWS Control Tower の関係',
  category: 'security-governance',
  categoryLabel: 'セキュリティ・ガバナンス',
  subcategory: 'Organizations & ガバナンス',
  slug: 'aws-organization-control-tower',
  pageCss: '/aws_sap_studying/css/pages/aws-organization-control-tower.css',
  tocItems: [
    { level: 'h2', id: 'わかりやすい例え話-マンション管理で考える', text: 'わかりやすい例え話：マンション管理で考える' },
    { level: 'h3', id: 'AWS-Organizations-=-マンションの基本構造', text: 'AWS Organizations = マンションの基本構造' },
    { level: 'h3', id: 'AWS-Control-Tower-=-高級マンションの管理サービス', text: 'AWS Control Tower = 高級マンションの管理サービス' },
