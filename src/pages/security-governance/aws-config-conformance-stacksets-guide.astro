       </span>
<span class="code-key">
        Resources:
       </span>
<span class="code-comment">
        # Config記録用のIAMロール
       </span>
<span class="code-key">
        ConfigRole:
       </span>
<span class="code-key">
        Type:
       </span>
       AWS::IAM::Role
       <span class="code-key">
        Properties:
       </span>
<span class="code-key">
