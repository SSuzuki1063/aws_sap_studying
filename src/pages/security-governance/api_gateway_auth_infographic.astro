                    color: "#DC2626"
                },
                jwt: {
                    title: "🆔 JWTがおすすめ！",
                    content: "モバイルアプリやWebアプリケーション開発には業界標準のJWTが最適です。ユーザー認証システムを構築する際の鉄板選択です。",
                    color: "#4ECDC4"
                },
                apikey: {
                    title: "🗝️ APIキーがおすすめ！",
                    content: "開発段階やシンプルなAPIには、実装が簡単で高速なAPIキーが最適です。プロトタイプ作成時にぴったりです。",
                    color: "#45B7D1"
                },
                lambda: {
                    title: "🤖 Lambda オーソライザーがおすすめ！",
                    content: "複雑な認証ロジックや外部システムとの連携が必要な場合は、最も柔軟性の高いLamba オーソライザーが最適です。",
                    color: "#96CEB4"
                }
            };

            const rec = recommendations[type];
            const recDiv = document.getElementById('recommendation');
            const contentDiv = document.getElementById('rec-content');
            
            contentDiv.innerHTML = \`
                <h3 id="\${rec.title}" style="color: \${rec.color}; margin-bottom: 10px;">\${rec.title}</h3>
                <p>\${rec.content}</p>
            \`;
            
            recDiv.style.display = 'block';
            recDiv.style.borderLeft = \`5px solid \${rec.color}\`;
            recDiv.scrollIntoView({ behavior: 'smooth' });
        }

        // アニメーション効果
        document.addEventListener('DOMContentLoaded', function() {
            // セキュリティメーターのアニメーション
            setTimeout(() => {
                document.querySelectorAll('.meter-fill').forEach(fill => {
                    const width = fill.style.width;
                    fill.style.width = '0%';
                    setTimeout(() => {
                        fill.style.width = width;
                    }, 100);
                });
            }, 1000);

            // 複雑さチャートのアニメーション
            setTimeout(() => {
                document.querySelectorAll('.complexity-bar').forEach(bar => {
                    const height = bar.style.height;
                    bar.style.height = '0%';
                    setTimeout(() => {
                        bar.style.height = height;
                    }, 100);
                });
            }, 1500);
        });
  </script>`;
