---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Cloudformation Protection Guide',
  pageTitle: 'CloudFormation リソース保持メカニズム',
  category: 'development-deployment',
  categoryLabel: '開発・デプロイメント',
  subcategory: 'IaC & CloudFormation',
  slug: 'cloudformation-protection-guide',
  pageCss: '/aws_sap_studying/css/pages/cloudformation-protection-guide.css',
  tocItems: [
    { level: 'h2', id: 'CloudFormationスタックとは？', text: 'CloudFormationスタックとは？' },
    { level: 'h3', id: 'スタック-=-家の設計図-+-建築プロジェクト', text: 'スタック = 家の設計図 + 建築プロジェクト' },
    { level: 'h2', id: 'DeletionPolicy---解体時のルール', text: 'DeletionPolicy - 解体時のルール' },
    { level: 'h3', id: 'Delete削除', text: 'Delete（削除）' },
    { level: 'h3', id: 'Retain保持', text: 'Retain（保持）' },
    { level: 'h3', id: 'Snapshotスナップショット', text: 'Snapshot（スナップショット）' },
    { level: 'h2', id: 'UpdateReplacePolicy---リノベーション時のルール', text: 'UpdateReplacePolicy - リノベーション時のルール' },
    { level: 'h3', id: 'Delete削除-1', text: 'Delete（削除）' },
    { level: 'h3', id: 'Retain保持-1', text: 'Retain（保持）' },
    { level: 'h3', id: 'Snapshotスナップショット-1', text: 'Snapshot（スナップショット）' },
    { level: 'h2', id: 'Termination-Protection---家全体の解体防止', text: 'Termination Protection - 家全体の解体防止' },
    { level: 'h3', id: 'スタック全体を誤って削除することを防ぐ安全装置', text: 'スタック全体を誤って削除することを防ぐ安全装置' },
    { level: 'h2', id: 'まとめ-3つの安全対策で大切なものを守ろう', text: '🎉 まとめ：3つの安全対策で大切なものを守ろう' },
    { level: 'h3', id: '️-DeletionPolicy', text: '🗑️ DeletionPolicy' }
  ],
  prevPage: 'aws-cloudformation-infographic.html',
  nextPage: '../organizational-complexity/cf-service-catalog-infographic.html',
  pageNum: 2,
  pageTotal: 15,
};

const rawContent = `<div class="header">
<h1>
     🏗️ CloudFormation 保護メカニズム
    </h1>
<p>
     家の建築管理で学ぶAWS CloudFormationの安全対策
    </p>
</div>
<div class="content">
<div class="section">
<div class="section-title">
<div class="icon stack">
       🏠
      </div>
<h2 id="CloudFormationスタックとは？">
       CloudFormationスタックとは？
      </h2>
</div>
<div class="house-diagram">
<div class="house">
       🏘️
      </div>
<h3 id="スタック-=-家の設計図-+-建築プロジェクト">
       スタック = 家の設計図 + 建築プロジェクト
      </h3>
<p>
       CloudFormationスタックは、AWSリソース（EC2、S3、RDSなど）を一括管理する「家の設計図」のようなものです。
      </p>
</div>
<div class="flow-diagram">
<div class="flow-step">
<div class="flow-step-icon">
        📋
       </div>
<h4>
        テンプレート
       </h4>
<p>
        設計図
       </p>
</div>
<div class="arrow">
       →
      </div>
<div class="flow-step">
<div class="flow-step-icon">
        🏗️
       </div>
<h4>
        スタック
       </h4>
<p>
        建築プロジェクト
       </p>
</div>
<div class="arrow">
       →
      </div>
<div class="flow-step">
<div class="flow-step-icon">
        🏠
       </div>
<h4>
        リソース
       </h4>
<p>
        実際の部屋・設備
       </p>
</div>
</div>
</div>
<div class="section">
<div class="section-title">
<div class="icon deletion">
       🗑️
      </div>
<h2 id="DeletionPolicy---解体時のルール">
       DeletionPolicy - 解体時のルール
      </h2>
</div>
<p>
<strong>
       DeletionPolicy
      </strong>
      は、家（スタック）を解体する時に、各部屋や設備をどう扱うかを決めるルールです。
     </p>
<div class="policy-grid">
<div class="policy-card">
<span class="policy-emoji">
        💥
       </span>
<h3 id="Delete削除">
        Delete（削除）
       </h3>
<p>
        家と一緒にすべて解体。デフォルトの動作で、一般的な設備に使用。
       </p>
</div>
<div class="policy-card">
<span class="policy-emoji">
        📦
       </span>
<h3 id="Retain保持">
        Retain（保持）
       </h3>
<p>
        貴重品は残しておく。重要なデータベースやファイルに使用。
       </p>
</div>
<div class="policy-card">
<span class="policy-emoji">
        📸
       </span>
<h3 id="Snapshotスナップショット">
        Snapshot（スナップショット）
       </h3>
<p>
        写真に残してから解体。データベースのバックアップに使用。
       </p>
</div>
</div>
<div class="highlight-box">
<h4>
       💡 例：家族の思い出の部屋
      </h4>
<p>
       大切な家族写真やアルバムが保管された部屋は「Retain」に設定。家を解体しても、この部屋だけは残しておきます。AWS では重要なS3バケットやRDSデータベースに相当します。
      </p>
</div>
</div>
<div class="section">
<div class="section-title">
<div class="icon update">
       🔄
      </div>
<h2 id="UpdateReplacePolicy---リノベーション時のルール">
       UpdateReplacePolicy - リノベーション時のルール
      </h2>
</div>
<p>
<strong>
       UpdateReplacePolicy
      </strong>
      は、家をリノベーション（更新）する時に、古い設備を新しいものに交換する際のルールです。
     </p>
<div class="policy-grid">
<div class="policy-card">
<span class="policy-emoji">
        🔨
       </span>
<h3 id="Delete削除-1">
        Delete（削除）
       </h3>
<p>
        古い設備は処分して新しいものに交換。
       </p>
</div>
<div class="policy-card">
<span class="policy-emoji">
        🏪
       </span>
<h3 id="Retain保持-1">
        Retain（保持）
       </h3>
<p>
        古い設備も倉庫に保管しておく。
       </p>
</div>
<div class="policy-card">
<span class="policy-emoji">
        📷
       </span>
<h3 id="Snapshotスナップショット-1">
        Snapshot（スナップショット）
       </h3>
<p>
        古い設備の状態を記録してから交換。
       </p>
</div>
</div>
<div class="warning-box">
<h4>
       ⚠️ 注意：DeletionPolicy vs UpdateReplacePolicy
      </h4>
<p>
       DeletionPolicyは「家全体の解体時」、UpdateReplacePolicyは「部分的なリノベーション時」に適用されます。両方設定することで、どんな場面でも大切なデータを守れます。
      </p>
</div>
</div>
<div class="section">
<div class="section-title">
<div class="icon protection">
       🛡️
      </div>
<h2 id="Termination-Protection---家全体の解体防止">
       Termination Protection - 家全体の解体防止
      </h2>
</div>
<div class="protection-demo">
<div class="shield">
       🛡️
      </div>
<h3 id="スタック全体を誤って削除することを防ぐ安全装置">
       スタック全体を誤って削除することを防ぐ安全装置
      </h3>
<p>
       重要な本番環境などで、うっかり家全体を解体してしまわないようにする「解体禁止ロック」です。
      </p>
</div>
<div class="flow-diagram">
<div class="flow-step">
<div class="flow-step-icon">
        🔒
       </div>
<h4>
        保護ON
       </h4>
<p>
        解体不可
       </p>
</div>
<div class="arrow">
       →
      </div>
<div class="flow-step">
<div class="flow-step-icon">
        🔓
       </div>
<h4>
        保護解除
       </h4>
<p>
        解体許可
       </p>
</div>
<div class="arrow">
       →
      </div>
<div class="flow-step">
<div class="flow-step-icon">
        🗑️
       </div>
<h4>
        削除実行
       </h4>
<p>
        安全に解体
       </p>
</div>
</div>
<div class="highlight-box">
<h4>
       🎯 使用場面
      </h4>
<p>
<strong>
        本番環境
       </strong>
       ：顧客が使用している重要なシステム
       <br/>
<strong>
        共有リソース
       </strong>
       ：チーム全体で使用するデータベースやネットワーク
       <br/>
<strong>
        高価なリソース
       </strong>
       ：作成に時間とコストがかかるリソース
      </p>
</div>
</div>
<div class="summary">
<h2 id="まとめ-3つの安全対策で大切なものを守ろう">
      🎉 まとめ：3つの安全対策で大切なものを守ろう
     </h2>
<div class="policy-grid">
<div style="background: rgba(255,255,255,0.1); padding: 20px; border-radius: 10px;">
<h3 id="️-DeletionPolicy">
        🗑️ DeletionPolicy
       </h3>
<p>
        スタック削除時の各リソースの扱い方
       </p>
</div>
<div style="background: rgba(255,255,255,0.1); padding: 20px; border-radius: 10px;">
<h4>
        🔄 UpdateReplacePolicy
       </h4>
<p>
        リソース交換時の旧リソースの扱い方
       </p>
</div>
<div style="background: rgba(255,255,255,0.1); padding: 20px; border-radius: 10px;">
<h4>
        🛡️ Termination Protection
       </h4>
<p>
        スタック全体の誤削除防止
       </p>
</div>
</div>
<p style="margin-top: 20px; font-size: 1.1rem;">
      これらの機能を適切に設定することで、AWSの重要なリソースを安全に管理できます！
     </p>
</div>
</div>


</div>
<div style="text-align: center; padding: 20px; margin-top: 40px; border-top: 2px solid #909296; background-color: #F9FAFB;">
<p style="color: #6B7280; font-size: 0.9em; margin: 0;">
    Created by
    <a href="https://github.com/SSuzuki1063" style="color: #dc7600; text-decoration: none; font-weight: 600;" target="_blank">
     SSuzuki1063
    </a>
</p>
<p style="color: #6f7682; font-size: 0.8em; margin: 5px 0 0 0;">
    AWS SAP Learning Resources
   </p>
</div>`;
---

<ResourceLayout {...frontmatter}>
  <Fragment set:html={rawContent} />
</ResourceLayout>
