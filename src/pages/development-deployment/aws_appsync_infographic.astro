const frontmatter = {
  title: '',
  pageTitle: 'AWS AppSync - 初心者向けガイド',
  category: 'development-deployment',
  categoryLabel: '開発・デプロイメント',
  subcategory: '',
  slug: 'aws_appsync_infographic',
  pageCss: '/aws_sap_studying/css/pages/aws_appsync_infographic.css',
  tocItems: [
    { level: 'h2', id: 'AWS-AppSyncって何？', text: '🤔 AWS AppSyncって何？' },
    { level: 'h2', id: '️-レストランで理解するAppSync', text: '🍽️ レストランで理解するAppSync' },
    { level: 'h3', id: 'お客さんアプリ', text: 'お客さん（アプリ）' },
    { level: 'h3', id: 'ウェイターAppSync', text: 'ウェイター（AppSync）' },
