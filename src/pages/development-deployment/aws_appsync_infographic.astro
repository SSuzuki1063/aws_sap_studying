    { level: 'h2', id: '従来のAPIとの比較', text: '📊 従来のAPIとの比較' },
    { level: 'h2', id: 'こんな時にAppSyncが便利', text: '💡 こんな時にAppSyncが便利' },
    { level: 'h3', id: '️-チャットアプリ', text: '🗨️ チャットアプリ' },
    { level: 'h3', id: 'ダッシュボード', text: '📈 ダッシュボード' },
    { level: 'h3', id: 'ECアプリ', text: '🛒 ECアプリ' },
