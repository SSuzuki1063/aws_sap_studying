   function toggleFaq(element) {
            const answer = element.nextElementSibling;
            const isVisible = answer.style.display !== 'none';
            
            answer.style.display = isVisible ? 'none' : 'block';
            element.style.background = isVisible ? '#667eea' : '#5a6fd8';
        }

        function highlightStage(element) {
            // Remove previous highlights
            document.querySelectorAll('.stage-area').forEach(stage => {
                stage.style.transform = 'translateY(0)';
                stage.style.boxShadow = '0 10px 25px rgba(0,0,0,0.1)';
            });
            
            // Highlight clicked stage
            element.style.transform = 'translateY(-10px) scale(1.05)';
            element.style.boxShadow = '0 20px 40px rgba(0,0,0,0.3)';
            
            // Reset after 2 seconds
            setTimeout(() => {
                element.style.transform = 'translateY(0) scale(1)';
                element.style.boxShadow = '0 10px 25px rgba(0,0,0,0.1)';
            }, 2000);
        }

        function showDeployInfo(type) {
            const infoDiv = document.getElementById('deploy-info');
            const titleElement = document.getElementById('deploy-title');
            const descriptionElement = document.getElementById('deploy-description');
            
            const deployInfo = {
                'canary': {
                    title: '🐤 カナリアデプロイメント',
                    description: '少数の観客（例：10%）に新演目を先行公開し、問題がなければ段階的に全観客に展開。炭鉱のカナリアのように、早期に問題を検知する手法です。'
                },
                'linear': {
                    title: '📈 リニアデプロイメント',
                    description: '一定の間隔で段階的に観客を移動（例：10分ごとに10%ずつ）。Linear10PercentEvery10Minutesのように設定し、安全に段階展開します。'
                },
                'all-at-once': {
                    title: '⚡ 一括デプロイメント',
                    description: '全観客を一気に新演目に移動。最も高速ですが、問題があった場合の影響も最大。緊急性が高い場合や確実に動作することが分かっている場合に使用。'
                },
                'stop': {
                    title: '⏹️ デプロイメント停止',
                    description: '舞台転換を緊急停止し、現在の状態を維持。問題を発見した際に被害拡大を防ぐための重要な機能です。'
                }
            };
            
            titleElement.textContent = deployInfo[type].title;
            descriptionElement.textContent = deployInfo[type].description;
            infoDiv.style.display = 'block';
            
            // Highlight effect
            infoDiv.style.opacity = '0';
            setTimeout(() => {
                infoDiv.style.opacity = '1';
                infoDiv.style.transition = 'opacity 0.5s ease';
            }, 100);
        }

        // Animation effects
        document.addEventListener('DOMContentLoaded', function() {
            // Stage clicking animation
            const stages = document.querySelectorAll('.stage-area');
            
            stages.forEach(stage => {
                stage.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-5px)';
                });
                
                stage.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });

            // Control button hover effects
            const controlButtons = document.querySelectorAll('.control-button');
            controlButtons.forEach(button => {
                button.addEventListener('mouseenter', function() {
                    this.style.background = 'rgba(255,255,255,0.3)';
                    this.style.transform = 'translateY(-3px) scale(1.02)';
                });
                
                button.addEventListener('mouseleave', function() {
                    this.style.background = 'rgba(255,255,255,0.2)';
                    this.style.transform = 'translateY(0) scale(1)';
                });
            });

            // Scroll-triggered animations
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            });
            
            document.querySelectorAll('.section').forEach(section => {
                observer.observe(section);
            });

            // Rollback animation
            function animateRollback() {
                const rollbackArrow = document.querySelector('.rollback-arrow');
                if (rollbackArrow) {
                    rollbackArrow.style.color = '#ff4444';
                    rollbackArrow.style.transform = 'translateX(-20px) scale(1.2)';
                    
                    setTimeout(() => {
                        rollbackArrow.style.color = 'white';
                        rollbackArrow.style.transform = 'translateX(0) scale(1)';
                    }, 1000);
                }
            }
            
            // Animate rollback every 8 seconds
            setInterval(animateRollback, 8000);

            // Stage switching demonstration
            function demonstrateStageSwitch() {
                const blueStage = document.querySelector('.blue-stage');
                const greenStage = document.querySelector('.green-stage');
                
                if (blueStage && greenStage) {
                    // Highlight green stage first
                    greenStage.style.transform = 'translateY(-10px) scale(1.05)';
                    greenStage.style.boxShadow = '0 20px 40px rgba(50,205,50,0.4)';
                    
                    setTimeout(() => {
                        // Switch to blue stage
                        greenStage.style.transform = 'translateY(0) scale(1)';
                        greenStage.style.boxShadow = '0 10px 25px rgba(0,0,0,0.1)';
                        
                        blueStage.style.transform = 'translateY(-10px) scale(1.05)';
                        blueStage.style.boxShadow = '0 20px 40px rgba(65,105,225,0.4)';
                        
                        setTimeout(() => {
                            blueStage.style.transform = 'translateY(0) scale(1)';
                            blueStage.style.boxShadow = '0 10px 25px rgba(0,0,0,0.1)';
                        }, 2000);
                    }, 3000);
                }
            }
            
            // Demonstrate stage switching every 15 seconds
            setInterval(demonstrateStageSwitch, 15000);
        });
  </script>`;
