    { level: 'h3', id: '劇場の例', text: '🎭 劇場の例' },
    { level: 'h3', id: '☁️-AWSの世界', text: '☁️ AWSの世界' },
    { level: 'h2', id: 'ブルー-グリーンデプロイメントとは？', text: '🎭 ブルー/グリーンデプロイメントとは？' },
    { level: 'h2', id: '2つの舞台システム', text: '🎪 2つの舞台システム' },
    { level: 'h3', id: '劇場の舞台配置', text: '🎭 劇場の舞台配置' },
    { level: 'h3', id: '舞台転換の流れ', text: '💡 舞台転換の流れ' },
    { level: 'h2', id: 'デプロイメントの流れ', text: '🔄 デプロイメントの流れ' },
    { level: 'h3', id: '新演目の準備開始', text: '新演目の準備開始' },
    { level: 'h3', id: 'リハーサルとテスト', text: 'リハーサルとテスト' },
    { level: 'h3', id: '瞬間的な舞台転換', text: '瞬間的な舞台転換' },
    { level: 'h3', id: '旧舞台は控えに', text: '旧舞台は控えに' },
    { level: 'h2', id: 'ロールバック機能', text: '🚨 ロールバック機能' },
    { level: 'h3', id: '緊急事態の対応！', text: '緊急事態の対応！' },
    { level: 'h2', id: '️-CodeDeployの制御機能', text: '🎛️ CodeDeployの制御機能' },
    { level: 'h3', id: '劇場の制御室', text: '劇場の制御室' },
    { level: 'h2', id: '⚖️-デプロイメント戦略の比較', text: '⚖️ デプロイメント戦略の比較' },
    { level: 'h3', id: 'ブルー-グリーンデプロイメント', text: '🎭 ブルー/グリーンデプロイメント' },
    { level: 'h3', id: 'インプレースデプロイメント', text: '🔄 インプレースデプロイメント' },
    { level: 'h2', id: '❓-よくある質問', text: '❓ よくある質問' },
    { level: 'h2', id: '✨-CodeDeployの主要メリット', text: '✨ CodeDeployの主要メリット' },
    { level: 'h3', id: '高速デプロイ', text: '高速デプロイ' },
    { level: 'h3', id: '安全性', text: '安全性' },
    { level: 'h3', id: '自動化', text: '自動化' },
    { level: 'h3', id: '可視化', text: '可視化' },
    { level: 'h3', id: '柔軟性', text: '柔軟性' },
    { level: 'h3', id: 'コスト効率', text: 'コスト効率' },
    { level: 'h2', id: 'まとめ', text: '🎯 まとめ' }
  ],
  prevPage: undefined,
  nextPage: undefined,
  pageNum: 1,
  pageTotal: 1,
};

const rawContent = `<header class="header">
<h1>
     🎭 AWS CodeDeploy
    </h1>

<p>
     劇場システムで理解する超入門ガイド
    </p>
<div class="intro-analogy">
<h2 id="ブルー舞台-↔️-グリーン舞台">
      🎭 ブルー舞台 ↔️ 🎬 グリーン舞台
     </h2>
<p>
      AWS CodeDeployのブルー/グリーンデプロイメントとロールバック機能を、劇場の舞台転換で分かりやすく説明します！
     </p>
</div>
</header>
<div class="section">
<h2 id="まず、CodeDeployって何？">
     🤔 まず、CodeDeployって何？
    </h2>
<div class="highlight-box">
<h3 id="簡単に言うと...">
      📝 簡単に言うと...
     </h3>
<p style="font-size: 1.2em; margin-top: 15px;">
<strong>
       新しいアプリケーション
      </strong>
      を
      <strong>
       安全に
      </strong>
      サーバーに配布して、
                    問題があったら
      <strong>
       瞬時に元に戻せる
      </strong>
      サービスです
     </p>
</div>
<div class="comparison-table">
<div class="comparison-side theater-side">
<h3 id="劇場の例">
       🎭 劇場の例
      </h3>
<div style="font-size: 1.1em; margin-top: 15px;">
<p>
<strong>
         新しい演目
        </strong>
        を上演したい
        <br/>
        でも
        <strong>
         失敗したら困る
        </strong>
</p>
<br/>
<p>
        👆 準備用の舞台で練習して
        <br/>
        🎬
        <strong>
         瞬時に舞台転換
        </strong>
        しよう！
        <br/>
        ダメなら
        <strong>
         すぐ元に戻そう
        </strong>
        ！
       </p>
</div>
</div>
<div class="comparison-side aws-side">
<h3 id="☁️-AWSの世界">
       ☁️ AWSの世界
      </h3>
<div style="font-size: 1.1em; margin-top: 15px;">
<p>
<strong>
         新しいアプリ
        </strong>
        をリリースしたい
        <br/>
        でも
        <strong>
         バグがあったら困る
        </strong>
</p>
<br/>
<p>
        👆 別サーバーで準備して
        <br/>
        🚀
        <strong>
         瞬時に切り替え
        </strong>
        しよう！
        <br/>
        ダメなら
        <strong>
         すぐロールバック
        </strong>
        ！
       </p>
</div>
</div>
</div>
</div>
<div class="section">
<h2 id="ブルー-グリーンデプロイメントとは？">
     🎭 ブルー/グリーンデプロイメントとは？
    </h2>
<div class="intro-analogy">
<h2 id="2つの舞台システム">
      🎪 2つの舞台システム
     </h2>
<p>
      観客に迷惑をかけずに、新しい演目に切り替える劇場の秘密技術です！
     </p>
</div>
<div class="stage-diagram">
<h3 id="劇場の舞台配置" style="text-align: center; margin-bottom: 30px; color: #667eea;">
      🎭 劇場の舞台配置
     </h3>
<div class="stage-container">
<div class="stage-area blue-stage" onclick="highlightStage(this)">
<div class="stage-title">
        🔵 ブルー舞台
       </div>
<div style="font-size: 2.5em; margin: 20px 0;">
        🎭
       </div>
<p>
<strong>
         現在上演中
        </strong>
</p>
<p>
        お客様が観ている舞台
       </p>
<small>
        （Version 1.0の演目）
       </small>
</div>
<div class="stage-area green-stage" onclick="highlightStage(this)">
<div class="stage-title">
        🟢 グリーン舞台
       </div>
<div style="font-size: 2.5em; margin: 20px 0;">
        🎬
       </div>
<p>
<strong>
         新演目準備中
        </strong>
</p>
<p>
        裏で準備している舞台
       </p>
<small>
        （Version 2.0の演目）
       </small>
</div>
</div>
<div class="audience-section">
<h4>
       👥 観客席（ユーザー）
      </h4>
<p>
       観客は常にどちらか一つの舞台を観ています
      </p>
<div class="audience-arrow">
       👀
      </div>
</div>
<div class="highlight-box">
<h3 id="舞台転換の流れ">
       💡 舞台転換の流れ
      </h3>
<p>
       グリーン舞台で新演目の準備 → リハーサル → 観客の視線を切り替え → ブルー舞台が控えに
      </p>
</div>
</div>
</div>
<div class="section">
<h2 id="デプロイメントの流れ">
     🔄 デプロイメントの流れ
    </h2>
<div class="deployment-flow">
<div class="flow-step">
<div class="step-number">
       1
      </div>
<div class="step-content">
<h3 id="新演目の準備開始">
        新演目の準備開始
       </h3>
<p>
<strong>
         グリーン舞台でリハーサル
        </strong>
<br/>
        → 新しいアプリケーションをグリーン環境にデプロイ
        <br/>
        → 観客（ユーザー）にはまだ見えない状態で準備
       </p>
</div>
</div>
<div class="flow-step">
<div class="step-number">
       2
      </div>
<div class="step-content">
<h3 id="リハーサルとテスト">
        リハーサルとテスト
       </h3>
<p>
<strong>
         舞台スタッフが最終確認
        </strong>
<br/>
        → グリーン環境で動作テスト
        <br/>
        → 演出、照明、音響すべてチェック（機能テスト）
       </p>
</div>
</div>
<div class="flow-step">
<div class="step-number">
       3
      </div>
<div class="step-content">
<h3 id="瞬間的な舞台転換">
        瞬間的な舞台転換
       </h3>
<p>
<strong>
         観客の視線を新舞台へ
        </strong>
<br/>
        → ロードバランサーでトラフィックを切り替え
        <br/>
        → 観客は一瞬で新しい演目を観ることに
       </p>
</div>
</div>
<div class="flow-step">
<div class="step-number">
       4
      </div>
<div class="step-content">
<h3 id="旧舞台は控えに">
        旧舞台は控えに
       </h3>
<p>
<strong>
         ブルー舞台が待機状態に
        </strong>
<br/>
        → 問題があればすぐに戻せる状態で保持
        <br/>
        → 新演目が安定したら旧舞台を片付け
       </p>
</div>
</div>
</div>
</div>
<div class="section">
<h2 id="ロールバック機能">
     🚨 ロールバック機能
    </h2>
<div class="rollback-section">
<h3 id="緊急事態の対応！" style="text-align: center; margin-bottom: 20px;">
      緊急事態の対応！
     </h3>
<p style="text-align: center; font-size: 1.2em;">
      新演目で問題発生 → 瞬時に前の演目に戻す
     </p>
<div class="rollback-demo">
<div class="rollback-stage">
<div style="position: relative;">
<div class="problem-indicator">
         ⚠️ 問題発生
        </div>
<div style="font-size: 2em; margin: 20px 0;">
         🟢
        </div>
<h4>
         グリーン舞台
        </h4>
<p>
         新演目で音響トラブル！
         <br/>
         （新アプリでバグ発生）
        </p>
</div>
</div>
<div class="rollback-arrow">
       ⬅️
      </div>
<div class="rollback-stage">
<div style="font-size: 2em; margin: 20px 0;">
        🔵
       </div>
<h4>
        ブルー舞台
       </h4>
<p>
        安全な前の演目に復帰
        <br/>
        （前バージョンに自動復旧）
       </p>
</div>
</div>
<div style="background: rgba(255,255,255,0.2); padding: 20px; border-radius: 10px; margin-top: 20px;">
<h4>
       🎯 ロールバックの種類
      </h4>
<div style="margin-top: 15px;">
<p>
<strong>
         🤖 自動ロールバック
        </strong>
        : 演出家（CloudWatch）が異常を検知して自動で前の演目に戻す
       </p>
<p>
<strong>
         👨‍💼 手動ロールバック
        </strong>
        : 劇場支配人（管理者）が判断して手動で戻す
       </p>
</div>
</div>
</div>
</div>
<div class="section">
<h2 id="️-CodeDeployの制御機能">
     🎛️ CodeDeployの制御機能
    </h2>
<div class="control-panel">
<h3 id="劇場の制御室" style="text-align: center; margin-bottom: 20px;">
      劇場の制御室
     </h3>
<p style="text-align: center;">
      舞台監督が使う様々なコントロール機能
     </p>
<div class="control-buttons">
<div class="control-button" onclick="showDeployInfo('canary')">
<div style="font-size: 2em; margin-bottom: 10px;">
        🐤
       </div>
<h4>
        カナリアデプロイ
       </h4>
<p>
        少数の観客だけに新演目を先行公開
       </p>
</div>
<div class="control-button" onclick="showDeployInfo('linear')">
<div style="font-size: 2em; margin-bottom: 10px;">
        📈
       </div>
<h4>
        リニアデプロイ
       </h4>
<p>
        段階的に観客を新演目に移動
       </p>
</div>
<div class="control-button" onclick="showDeployInfo('all-at-once')">
<div style="font-size: 2em; margin-bottom: 10px;">
        ⚡
       </div>
<h4>
        一括デプロイ
       </h4>
<p>
        全観客を一気に新演目に移動
       </p>
</div>
<div class="control-button" onclick="showDeployInfo('stop')">
<div style="font-size: 2em; margin-bottom: 10px;">
        ⏹️
       </div>
<h4>
        デプロイ停止
       </h4>
<p>
        舞台転換を緊急停止
       </p>
</div>
</div>
<div id="deploy-info" style="margin-top: 30px; padding: 20px; background: rgba(255,255,255,0.2); border-radius: 10px; display: none;">
<h4 id="deploy-title">
</h4>
<p id="deploy-description">
</p>
</div>
</div>
</div>
<div class="section">
<h2 id="⚖️-デプロイメント戦略の比較">
     ⚖️ デプロイメント戦略の比較
    </h2>
<div class="strategy-comparison">
<div class="strategy-card blue-green-card">
<h3 id="ブルー-グリーンデプロイメント">
       🎭 ブルー/グリーンデプロイメント
      </h3>
<div style="font-size: 2em; margin: 20px 0; text-align: center;">
       🔵🟢
      </div>
<h4 style="color: #4169E1;">
       👍 メリット
      </h4>
<ul style="margin-left: 20px; margin-top: 10px;">
<li>
        瞬時の切り替えが可能
       </li>
<li>
        ダウンタイムがほぼゼロ
       </li>
<li>
        即座にロールバック可能
       </li>
<li>
        本番環境と同じ環境でテスト
       </li>
</ul>
<h4 style="color: #4169E1; margin-top: 20px;">
       👎 デメリット
      </h4>
<ul style="margin-left: 20px; margin-top: 10px;">
<li>
        2倍のリソースが必要
       </li>
<li>
        データベースの同期が複雑
       </li>
<li>
        コストが高い
       </li>
</ul>
<div style="background: #f0f8ff; padding: 15px; border-radius: 8px; margin-top: 15px;">
<strong>
        適用場面:
       </strong>
       重要なWebサービス、ECサイト、金融システム
      </div>
</div>
<div class="strategy-card in-place-card">
<h3 id="インプレースデプロイメント">
       🔄 インプレースデプロイメント
      </h3>
<div style="font-size: 2em; margin: 20px 0; text-align: center;">
       🎭➡️🎬
      </div>
<h4 style="color: #FFA500;">
       👍 メリット
      </h4>
<ul style="margin-left: 20px; margin-top: 10px;">
<li>
        リソースが1つで済む
       </li>
<li>
        シンプルな構成
       </li>
<li>
        コストが安い
       </li>
<li>
        設定が簡単
       </li>
</ul>
<h4 style="color: #FFA500; margin-top: 20px;">
       👎 デメリット
      </h4>
<ul style="margin-left: 20px; margin-top: 10px;">
<li>
        短時間のダウンタイムあり
       </li>
<li>
        ロールバックに時間がかかる
       </li>
<li>
        デプロイ中はサービス停止
       </li>
</ul>
<div style="background: #fff8dc; padding: 15px; border-radius: 8px; margin-top: 15px;">
<strong>
        適用場面:
       </strong>
       内部システム、開発環境、小規模アプリ
      </div>
</div>
</div>
</div>
<div class="section">
<h2 id="❓-よくある質問">
     ❓ よくある質問
    </h2>
<div class="faq-section">
<div class="faq-item">
<div class="faq-question" onclick="toggleFaq(this)">
       🤔 なぜブルー/グリーンが安全なの？
      </div>
<div class="faq-answer" style="display: none;">
<p>
<strong>
         リスクが最小限
        </strong>
        だからです！
       </p>
<br/>
<p>
<strong>
         劇場の例：
        </strong>
        新演目で失敗しても、観客は一瞬で元の演目を観ることができます。舞台転換は瞬間的で、観客に迷惑をかけません。
       </p>
<br/>
<p>
<strong>
         AWSの場合：
        </strong>
        新アプリでバグがあっても、ロードバランサーが瞬時に前のバージョンに切り替えるので、ユーザーは停止を感じません。
       </p>
</div>
</div>
<div class="faq-item">
<div class="faq-question" onclick="toggleFaq(this)">
       💰 コストはどのくらいかかるの？
      </div>
<div class="faq-answer" style="display: none;">
<p>
<strong>
         ブルー/グリーンデプロイメント：
        </strong>
</p>
<ul style="margin-left: 20px; margin-top: 10px;">
<li>
         デプロイ中は2倍のEC2インスタンス料金
        </li>
<li>
         CodeDeploy自体は無料
        </li>
<li>
         ロードバランサー料金（月額約20ドル〜）
        </li>
</ul>
<br/>
<p>
<strong>
         インプレースデプロイメント：
        </strong>
</p>
<ul style="margin-left: 20px; margin-top: 10px;">
<li>
         追加のインスタンス料金なし
        </li>
<li>
         CodeDeploy自体は無料
        </li>
</ul>
<br/>
<p>
        💡
        <strong>
         コスト削減のコツ：
        </strong>
        デプロイ完了後にブルー環境を停止すれば、通常時のコストは変わりません。
       </p>
</div>
</div>
<div class="faq-item">
<div class="faq-question" onclick="toggleFaq(this)">
       ⏱️ ロールバックはどのくらい早い？
      </div>
<div class="faq-answer" style="display: none;">
<p>
<strong>
         ブルー/グリーンデプロイメント：
        </strong>
</p>
<ul style="margin-left: 20px; margin-top: 10px;">
<li>
         ⚡
         <strong>
          数秒〜数分
         </strong>
         で完了
        </li>
<li>
         ロードバランサーの設定変更だけ
        </li>
<li>
         前のバージョンが起動中なので即座に切り替え可能
        </li>
</ul>
<br/>
<p>
<strong>
         インプレースデプロイメント：
        </strong>
</p>
<ul style="margin-left: 20px; margin-top: 10px;">
<li>
         ⏳
         <strong>
          数分〜数十分
         </strong>
         かかる
        </li>
<li>
         前のバージョンを再デプロイする必要
        </li>
<li>
         アプリケーションサイズに依存
        </li>
</ul>
<br/>
<p>
        🎭
        <strong>
         劇場で例えると：
        </strong>
        ブルー/グリーンは「照明を切り替えるだけ」、インプレースは「舞台セットを組み直す」ような違いです。
       </p>
</div>
</div>
<div class="faq-item">
<div class="faq-question" onclick="toggleFaq(this)">
       🔧 設定は難しい？
      </div>
<div class="faq-answer" style="display: none;">
<p>
<strong>
         基本設定は簡単
        </strong>
        です！
