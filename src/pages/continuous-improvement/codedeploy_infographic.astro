---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Codedeploy Infographic',
  pageTitle: 'AWS CodeDeploy を劇場システムで理解しよう',
  category: 'continuous-improvement',
  categoryLabel: 'セキュリティ・ガバナンス',
  subcategory: 'CI/CD & デプロイメント',
  slug: 'codedeploy_infographic',
  pageCss: '/aws_sap_studying/css/pages/codedeploy_infographic.css',
  tocItems: [
    { level: 'h2', id: 'ブルー舞台-↔️-グリーン舞台', text: '🎭 ブルー舞台 ↔️ 🎬 グリーン舞台' },
    { level: 'h2', id: 'まず、CodeDeployって何？', text: '🤔 まず、CodeDeployって何？' },
