const rawContent = `<div class="header">
<h1>📊 QuickSight vs OpenSearch Dashboards</h1>
<p>レストラン経営で理解する！2つの可視化ツールの違いと使い分け完全ガイド</p>
</div>
<div class="content">
<!-- 結論ファースト -->
<div class="conclusion-first">
<h2 id="結論-目的で選ぶ2つのダッシュボード">📌 結論：目的で選ぶ2つのダッシュボード</h2>
<div class="conclusion-cards">
<div class="conclusion-card">
<div class="conclusion-icon">📈</div>
<div class="conclusion-title quicksight-color">Amazon QuickSight</div>
<div class="conclusion-subtitle">ビジネス分析・経営判断向け</div>
<div class="conclusion-points">
