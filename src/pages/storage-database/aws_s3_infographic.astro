</div>
<div class="flow-step">
<div class="step-icon">
       📦
      </div>
<h4>
       書庫
      </h4>
<p>
       Glacier
       <br/>
       保管が主目的
      </p>
</div>
<div class="flow-step">
<div class="step-icon">
       🗃️
      </div>
<h4>
       深層保管
      </h4>
<p>
