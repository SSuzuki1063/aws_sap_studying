    { level: 'h2', id: 'オブジェクトロックWORM運用', text: 'オブジェクトロック（WORM運用）' },
    { level: 'h3', id: 'デジタル金庫の仕組み', text: 'デジタル金庫の仕組み' },
    { level: 'h2', id: 'まとめ-3つの機能の組み合わせ効果', text: 'まとめ：3つの機能の組み合わせ効果' },
    { level: 'h3', id: '最強のデータ管理体制を構築', text: '最強のデータ管理体制を構築' },
    { level: 'h3', id: '次のステップ', text: '🚀 次のステップ' }
