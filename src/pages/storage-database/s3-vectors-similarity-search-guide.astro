            <marker id="arrow-blue-5" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M0,0 L12,6 L0,12 Z" fill="#3B82F6"/>
            </marker>
            <marker id="arrow-green-5" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M0,0 L12,6 L0,12 Z" fill="#10B981"/>
