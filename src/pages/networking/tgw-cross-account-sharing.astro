---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Tgw Cross Account Sharing',
  pageTitle: 'AWS Transit Gateway クロスアカウント共有 完全ガイド',
  category: 'networking',
  categoryLabel: 'ネットワーキング',
  subcategory: 'Transit Gateway & ゲートウェイ',
  slug: 'tgw-cross-account-sharing',
  tocItems: [
    { id: 'analogy', text: 'たとえ話：「共有バスターミナル」', level: 'h2' },
    { id: 'architecture', text: 'アーキテクチャ構成図', level: 'h2' },
    { id: 'sharing-scope', text: '共有範囲と仕組み', level: 'h2' },
    { id: 'permissions', text: '権限モデル比較：所有者 vs 共有先', level: 'h2' },
    { id: 'setup-flow', text: 'セットアップ手順', level: 'h2' },
    { id: 'decision', text: '判断フローチャート：どの接続方式を選ぶ？', level: 'h2' },
    { id: 'optimization', text: '運用オーバーヘッドを最小化する5つの原則', level: 'h2' },
    { id: 'before-after', text: 'Before / After 比較', level: 'h2' },
    { id: 'code-examples', text: 'コード例', level: 'h2' },
    { id: 'best-practices', text: 'ベストプラクティス vs アンチパターン', level: 'h2' },
    { id: 'troubleshooting', text: 'トラブルシューティング', level: 'h2' },
    { id: 'exam-tips', text: '試験対策ポイント', level: 'h2' },
    { id: 'faq', text: 'よくある質問（FAQ）', level: 'h2' },
    { id: 'cheatsheet', text: 'チートシート', level: 'h2' },
    { id: 'glossary', text: '用語集', level: 'h3' },
  ],
  pageCss: '/aws_sap_studying/css/pages/tgw-cross-account-sharing.css',
};

const rawContent = `
        <!-- ===== 1. ANALOGY ===== -->
        <section class="section" id="analogy">
            <h2 class="section-title"><span>&#127970;</span> たとえ話：「共有バスターミナル」</h2>

            <div class="analogy-intro">
                <div class="analogy-intro-title">&#128652; 街のバスターミナルに例えてみよう</div>
                <p class="analogy-intro-text">Transit Gatewayのクロスアカウント共有は、<strong>「A社が建設したバスターミナルを、B社にも使わせてあげる」</strong>仕組みとそっくりです。</p>
            </div>

            <!-- SVG: Analogy Diagram -->
            <div class="svg-container">
                <svg viewBox="0 0 1200 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="バスターミナルのたとえ話を図解。A社が建設したターミナルにB社のバスが乗り入れる構図。">
                    <rect x="24" y="24" width="1152" height="472" rx="22" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
                    <text x="600" y="62" text-anchor="middle" font-size="22" font-weight="700" fill="#0F172A">&#128652; バスターミナルのたとえ話</text>

                    <!-- A社エリア -->
                    <rect x="50" y="82" width="370" height="395" rx="16" fill="#EFF6FF" stroke="#93C5FD" stroke-width="1.5" stroke-dasharray="6,3"/>
                    <text x="235" y="112" text-anchor="middle" font-size="17" font-weight="600" fill="#1D4ED8">&#128188; A社（ターミナル所有者）</text>

                    <!-- A社バス -->
                    <rect x="80" y="135" width="150" height="65" rx="14" fill="#DBEAFE" stroke="#60A5FA" stroke-width="2"/>
                    <text x="155" y="163" text-anchor="middle" font-size="15" font-weight="600" fill="#1E40AF">&#128652; A社バス路線</text>
                    <text x="155" y="185" text-anchor="middle" font-size="12" fill="#3B82F6">（VPC-A）</text>

                    <!-- ターミナル (TGW) 中央 -->
                    <rect x="420" y="140" width="360" height="180" rx="20" fill="#FFF7ED" stroke="#F59E0B" stroke-width="3"/>
                    <text x="600" y="185" text-anchor="middle" font-size="28" fill="#92400E">&#127970;</text>
                    <text x="600" y="220" text-anchor="middle" font-size="20" font-weight="700" fill="#92400E">バスターミナル</text>
                    <text x="600" y="250" text-anchor="middle" font-size="15" fill="#B45309">= Transit Gateway</text>
                    <text x="600" y="275" text-anchor="middle" font-size="13" fill="#D97706">A社が建設し、A社が管理</text>
                    <text x="600" y="300" text-anchor="middle" font-size="12" fill="#92400E">運行ダイヤ変更 = ルートテーブル管理</text>

                    <!-- 利用許可契約書 (RAM) -->
                    <rect x="475" y="340" width="250" height="65" rx="14" fill="#FEFCE8" stroke="#FACC15" stroke-width="2"/>
                    <text x="600" y="368" text-anchor="middle" font-size="15" font-weight="600" fill="#713F12">&#128203; 利用許可契約書</text>
                    <text x="600" y="390" text-anchor="middle" font-size="13" fill="#A16207">= AWS RAM</text>

                    <!-- B社エリア -->
                    <rect x="830" y="82" width="330" height="395" rx="16" fill="#ECFDF5" stroke="#6EE7B7" stroke-width="1.5" stroke-dasharray="6,3"/>
                    <text x="995" y="112" text-anchor="middle" font-size="17" font-weight="600" fill="#065F46">&#128101; B社（利用者）</text>

                    <!-- B社バス -->
                    <rect x="870" y="135" width="150" height="65" rx="14" fill="#D1FAE5" stroke="#34D399" stroke-width="2"/>
                    <text x="945" y="163" text-anchor="middle" font-size="15" font-weight="600" fill="#065F46">&#128652; B社バス路線</text>
                    <text x="945" y="185" text-anchor="middle" font-size="12" fill="#059669">（VPC-B）</text>

                    <!-- B社 制限表示 -->
                    <rect x="855" y="230" width="280" height="120" rx="12" fill="#FFF" stroke="#D1D5DB" stroke-width="1"/>
                    <text x="995" y="258" text-anchor="middle" font-size="14" font-weight="600" fill="#374151">B社ができること</text>
                    <text x="995" y="283" text-anchor="middle" font-size="13" fill="#059669">&#10004; バスの乗り入れ（アタッチ）</text>
                    <text x="995" y="303" text-anchor="middle" font-size="13" fill="#059669">&#10004; 乗降客数の確認（監視）</text>
                    <text x="995" y="323" text-anchor="middle" font-size="13" fill="#EF4444">&#10008; ダイヤ変更（ルート管理）</text>
                    <text x="995" y="343" text-anchor="middle" font-size="13" fill="#EF4444">&#10008; ターミナル取壊（TGW削除）</text>

                    <!-- A社 ダイヤ管理 -->
                    <rect x="80" y="240" width="310" height="100" rx="12" fill="#FFF" stroke="#D1D5DB" stroke-width="1"/>
                    <text x="235" y="268" text-anchor="middle" font-size="14" font-weight="600" fill="#374151">A社ができること（全権限）</text>
                    <text x="235" y="293" text-anchor="middle" font-size="13" fill="#059669">&#10004; ターミナルの建設・取壊</text>
                    <text x="235" y="313" text-anchor="middle" font-size="13" fill="#059669">&#10004; 運行ダイヤの作成・変更</text>
                    <text x="235" y="333" text-anchor="middle" font-size="13" fill="#059669">&#10004; 乗り入れ許可の管理</text>

                    <!-- Arrow: A社バス → ターミナル -->
                    <line x1="230" y1="175" x2="415" y2="210" stroke="#3B82F6" stroke-width="3" marker-end="url(#arr-blue)"/>
                    <text x="310" y="178" text-anchor="middle" font-size="12" fill="#3B82F6" font-weight="600">乗り入れ</text>

                    <!-- Arrow: B社バス → ターミナル -->
                    <line x1="870" y1="175" x2="785" y2="210" stroke="#10B981" stroke-width="3" stroke-dasharray="8,4" marker-end="url(#arr-green)"/>
                    <text x="840" y="178" text-anchor="middle" font-size="12" fill="#059669" font-weight="600">乗り入れ</text>

                    <!-- Arrow: RAM → ターミナル -->
                    <line x1="600" y1="340" x2="600" y2="325" stroke="#F59E0B" stroke-width="2" marker-end="url(#arr-orange)"/>

                    <!-- Arrow: RAM → B社 -->
                    <path d="M725 372 L830 372" stroke="#F59E0B" stroke-width="2" marker-end="url(#arr-orange)"/>
                    <text x="775" y="365" text-anchor="middle" font-size="11" fill="#A16207">共有許可</text>

                    <!-- A社ラベル下 -->
                    <rect x="80" y="380" width="310" height="65" rx="12" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5"/>
                    <text x="235" y="408" text-anchor="middle" font-size="14" font-weight="600" fill="#1D4ED8">&#128337; ダイヤ管理（ルートテーブル）</text>
                    <text x="235" y="430" text-anchor="middle" font-size="12" fill="#3B82F6">A社のみが作成・変更・削除可能</text>

                    <!-- B社 ラベル下 -->
                    <rect x="855" y="380" width="280" height="65" rx="12" fill="#D1FAE5" stroke="#6EE7B7" stroke-width="1.5"/>
                    <text x="995" y="408" text-anchor="middle" font-size="14" font-weight="600" fill="#065F46">&#128270; モニタリング参照</text>
                    <text x="995" y="430" text-anchor="middle" font-size="12" fill="#059669">参照のみ。設定変更は不可</text>

                    <defs>
                        <marker id="arr-blue" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto"><polygon points="0 0,10 3.5,0 7" fill="#3B82F6"/></marker>
                        <marker id="arr-green" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto"><polygon points="0 0,10 3.5,0 7" fill="#10B981"/></marker>
                        <marker id="arr-orange" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto"><polygon points="0 0,10 3.5,0 7" fill="#F59E0B"/></marker>
                    </defs>
                </svg>
            </div>

            <div style="overflow-x:auto">
                <table class="analogy-table">
                    <thead><tr><th>&#128652; バスターミナルの世界</th><th>&#9729;&#65039; AWSの世界</th><th>ポイント</th></tr></thead>
                    <tbody>
                        <tr><td>&#127970; バスターミナル</td><td>Transit Gateway (TGW)</td><td>ネットワークの中央ハブ</td></tr>
                        <tr><td>&#128188; ターミナル所有者（A社）</td><td>TGW所有者アカウント</td><td>全権限を持つ管理者</td></tr>
                        <tr><td>&#128101; 乗り入れ許可された会社（B社）</td><td>共有先アカウント</td><td>限定的な利用権限のみ</td></tr>
                        <tr><td>&#128203; 利用許可契約書</td><td>AWS RAM</td><td>共有の仲介サービス</td></tr>
                        <tr><td>&#128652; バスの乗り入れ</td><td>VPCアタッチメント作成</td><td>共有先が実行できる操作</td></tr>
                        <tr><td>&#128337; 運行ダイヤ（時刻表）</td><td>ルートテーブル</td><td>所有者のみが管理可能</td></tr>
                        <tr><td>&#128270; 乗降客数モニター</td><td>モニタリング・ログ</td><td>共有先は参照のみ</td></tr>
                        <tr><td>&#128683; ターミナルの取り壊し</td><td>TGWの削除</td><td>所有者のみが実行可能</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ===== 2. ARCHITECTURE ===== -->
        <section class="section" id="architecture">
            <h2 class="section-title"><span>&#128736;</span> アーキテクチャ構成図</h2>

            <div class="svg-container">
                <svg viewBox="0 0 1200 640" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Transit Gatewayクロスアカウント共有のアーキテクチャ構成図">
                    <rect x="24" y="24" width="1152" height="592" rx="22" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
                    <text x="600" y="66" text-anchor="middle" font-size="22" font-weight="700" fill="#0F172A">Transit Gateway クロスアカウント共有 アーキテクチャ</text>
                    <rect x="40" y="92" width="1120" height="500" rx="18" fill="#FFF" stroke="#E5E7EB" stroke-width="1"/>

                    <!-- Account A -->
                    <rect x="60" y="110" width="460" height="460" rx="14" fill="#EFF6FF" stroke="#93C5FD" stroke-width="1.5" stroke-dasharray="6,3"/>
                    <text x="290" y="140" text-anchor="middle" font-size="17" font-weight="600" fill="#1D4ED8">&#128081; アカウントA（TGW所有者）</text>

                    <!-- AWS RAM -->
                    <rect x="535" y="155" width="130" height="80" rx="14" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
                    <text x="600" y="190" text-anchor="middle" font-size="15" font-weight="700" fill="#92400E">AWS RAM</text>
                    <text x="600" y="215" text-anchor="middle" font-size="12" fill="#B45309">リソース共有</text>

                    <!-- Account B -->
                    <rect x="680" y="110" width="460" height="460" rx="14" fill="#ECFDF5" stroke="#6EE7B7" stroke-width="1.5" stroke-dasharray="6,3"/>
                    <text x="910" y="140" text-anchor="middle" font-size="17" font-weight="600" fill="#065F46">&#128101; アカウントB（共有先）</text>

                    <!-- VPC-A -->
                    <g><rect x="90" y="170" width="200" height="80" rx="16" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
                    <text x="190" y="205" text-anchor="middle" font-size="16" font-weight="700" fill="#3730A3">VPC-A</text>
                    <text x="190" y="232" text-anchor="middle" font-size="13" fill="#475569">10.1.0.0/16</text></g>

                    <!-- TGW-A -->
                    <g><rect x="230" y="300" width="270" height="110" rx="16" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2.5"/>
                    <text x="365" y="340" text-anchor="middle" font-size="20" font-weight="700" fill="#92400E">&#9729; TGW-A</text>
                    <text x="365" y="367" text-anchor="middle" font-size="14" fill="#B45309">Transit Gateway</text>
                    <text x="365" y="393" text-anchor="middle" font-size="12" fill="#D97706">所有者: アカウントA</text></g>

                    <!-- Route Table -->
                    <g><rect x="100" y="460" width="200" height="70" rx="14" fill="#FEFCE8" stroke="#FACC15" stroke-width="2"/>
                    <text x="200" y="492" text-anchor="middle" font-size="15" font-weight="600" fill="#713F12">ルートテーブル</text>
                    <text x="200" y="515" text-anchor="middle" font-size="12" fill="#A16207">&#128274; 所有者のみ管理</text></g>

                    <!-- Workload A -->
                    <g><rect x="330" y="460" width="170" height="70" rx="12" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="1.5"/>
                    <text x="415" y="492" text-anchor="middle" font-size="14" font-weight="600" fill="#1E293B">ワークロードA</text>
                    <text x="415" y="515" text-anchor="middle" font-size="12" fill="#475569">&#128994; 既存稼働中</text></g>

                    <!-- VPC-B -->
                    <g><rect x="810" y="170" width="200" height="80" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
                    <text x="910" y="205" text-anchor="middle" font-size="16" font-weight="700" fill="#065F46">VPC-B</text>
                    <text x="910" y="232" text-anchor="middle" font-size="13" fill="#475569">10.2.0.0/16</text></g>

                    <!-- VPC-B Attachment -->
                    <g><rect x="780" y="290" width="260" height="65" rx="14" fill="#F0FDF4" stroke="#86EFAC" stroke-width="1.5"/>
                    <text x="910" y="317" text-anchor="middle" font-size="14" font-weight="600" fill="#166534">&#128279; VPCアタッチメント</text>
                    <text x="910" y="340" text-anchor="middle" font-size="12" fill="#15803D">アカウントBが作成可能</text></g>

                    <!-- Monitoring -->
                    <g><rect x="780" y="380" width="260" height="60" rx="14" fill="#FFF7ED" stroke="#FED7AA" stroke-width="1.5"/>
                    <text x="910" y="407" text-anchor="middle" font-size="14" font-weight="600" fill="#92400E">&#128200; モニタリング・ログ</text>
                    <text x="910" y="427" text-anchor="middle" font-size="12" fill="#B45309">&#128065; 参照のみ可能</text></g>

                    <!-- Workload B -->
                    <g><rect x="810" y="470" width="200" height="70" rx="12" fill="#ECFDF5" stroke="#6EE7B7" stroke-width="1.5"/>
                    <text x="910" y="500" text-anchor="middle" font-size="14" font-weight="600" fill="#065F46">ワークロードB</text>
                    <text x="910" y="523" text-anchor="middle" font-size="12" fill="#059669">&#128309; 移行対象</text></g>

                    <!-- Arrows -->
                    <line x1="290" y1="225" x2="290" y2="295" stroke="#3B82F6" stroke-width="2.5" marker-end="url(#arr-blue)"/>
                    <text x="300" y="268" font-size="12" fill="#3B82F6" font-weight="600">Attach</text>

                    <line x1="365" y1="410" x2="300" y2="455" stroke="#FACC15" stroke-width="2" marker-end="url(#arr-orange)"/>
                    <line x1="365" y1="410" x2="415" y2="455" stroke="#94A3B8" stroke-width="1.5" marker-end="url(#arr-blue)"/>

                    <line x1="535" y1="195" x2="500" y2="325" stroke="#F59E0B" stroke-width="2" marker-end="url(#arr-orange)"/>
                    <text x="510" y="260" font-size="11" fill="#B45309">TGW登録</text>

                    <line x1="665" y1="195" x2="780" y2="310" stroke="#10B981" stroke-width="2.5" marker-end="url(#arr-green)"/>
                    <text x="725" y="240" font-size="12" fill="#059669" font-weight="600">共有</text>

                    <line x1="780" y1="322" x2="500" y2="345" stroke="#10B981" stroke-width="2.5" stroke-dasharray="8,4" marker-end="url(#arr-green)"/>
                    <text x="640" y="315" text-anchor="middle" font-size="13" fill="#059669" font-weight="600">クロスアカウント接続</text>

                    <line x1="910" y1="250" x2="910" y2="285" stroke="#34D399" stroke-width="2" marker-end="url(#arr-green)"/>
                    <line x1="910" y1="440" x2="910" y2="465" stroke="#94A3B8" stroke-width="1.5" marker-end="url(#arr-green)"/>

                    <!-- Legend -->
                    <g transform="translate(60,560)">
                        <text x="0" y="12" font-size="12" fill="#475569" font-weight="600">凡例:</text>
                        <line x1="55" y1="8" x2="85" y2="8" stroke="#3B82F6" stroke-width="2.5"/><text x="90" y="13" font-size="11" fill="#475569">同一アカウント</text>
                        <line x1="220" y1="8" x2="250" y2="8" stroke="#10B981" stroke-width="2.5" stroke-dasharray="6,3"/><text x="255" y="13" font-size="11" fill="#475569">クロスアカウント</text>
                        <line x1="400" y1="8" x2="430" y2="8" stroke="#F59E0B" stroke-width="2"/><text x="435" y="13" font-size="11" fill="#475569">RAM共有フロー</text>
                    </g>
                </svg>
            </div>
        </section>

        <!-- ===== 3. SHARING SCOPE ===== -->
        <section class="section" id="sharing-scope">
            <h2 class="section-title"><span>&#128270;</span> 共有範囲と仕組み</h2>

            <!-- SVG: Sharing Scope Visual -->
            <div class="svg-container">
                <svg viewBox="0 0 1200 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="共有範囲の可視化。共有できる機能と制限を色分けで表示。">
                    <rect x="24" y="24" width="1152" height="352" rx="22" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
                    <text x="600" y="62" text-anchor="middle" font-size="20" font-weight="700" fill="#0F172A">共有先アカウントの権限マップ</text>

                    <!-- 共有可能（緑） -->
                    <rect x="50" y="85" width="545" height="270" rx="16" fill="#F0FDF4" stroke="#86EFAC" stroke-width="2"/>
                    <text x="322" y="115" text-anchor="middle" font-size="18" font-weight="700" fill="#065F46">&#10004; 共有先が利用可能</text>

                    <rect x="70" y="135" width="245" height="90" rx="12" fill="#FFF" stroke="#34D399" stroke-width="2"/>
                    <text x="192" y="165" text-anchor="middle" font-size="28">&#128279;</text>
                    <text x="192" y="195" text-anchor="middle" font-size="14" font-weight="600" fill="#065F46">VPCアタッチメント作成</text>
                    <text x="192" y="213" text-anchor="middle" font-size="11" fill="#059669">自VPCをTGWに接続</text>

                    <rect x="330" y="135" width="245" height="90" rx="12" fill="#FFF" stroke="#34D399" stroke-width="2"/>
                    <text x="452" y="165" text-anchor="middle" font-size="28">&#128200;</text>
                    <text x="452" y="195" text-anchor="middle" font-size="14" font-weight="600" fill="#065F46">モニタリング参照</text>
                    <text x="452" y="213" text-anchor="middle" font-size="11" fill="#059669">接続状態・トラフィック確認</text>

                    <rect x="70" y="240" width="245" height="90" rx="12" fill="#FFF" stroke="#34D399" stroke-width="2"/>
                    <text x="192" y="270" text-anchor="middle" font-size="28">&#128202;</text>
                    <text x="192" y="300" text-anchor="middle" font-size="14" font-weight="600" fill="#065F46">使用統計アクセス</text>
                    <text x="192" y="318" text-anchor="middle" font-size="11" fill="#059669">データ転送量・接続数</text>

                    <rect x="330" y="240" width="245" height="90" rx="12" fill="#FFF" stroke="#34D399" stroke-width="2"/>
                    <text x="452" y="270" text-anchor="middle" font-size="28">&#128209;</text>
                    <text x="452" y="300" text-anchor="middle" font-size="14" font-weight="600" fill="#065F46">ルートテーブル参照</text>
                    <text x="452" y="318" text-anchor="middle" font-size="11" fill="#059669">内容の閲覧のみ可能</text>

                    <!-- 制限事項（赤） -->
