      <rect x="40" y="80" width="1120" height="660" rx="18" fill="#F8FAFC"/>

      <!-- Left offices -->
      <rect x="56" y="280" width="120" height="180" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
