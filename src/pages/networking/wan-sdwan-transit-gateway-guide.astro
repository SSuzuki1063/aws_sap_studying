      <!-- Step 1 -->
      <rect x="100" y="216" width="1000" height="92" rx="16" fill="#FEFCE8" stroke="#FACC15" stroke-width="2"/>
      <rect x="100" y="216" width="70" height="92" rx="16" fill="#F59E0B"/>
      <rect x="116" y="216" width="54" height="92" fill="#F59E0B"/>
      <text x="135" y="258" text-anchor="middle" class="sb sblbl" style="font-size:14px;">STEP</text>
      <text x="135" y="280" text-anchor="middle" class="sb sblbl" style="font-size:20px;">1</text>
      <text x="200" y="250" class="sb sbh" style="fill:#92400E;font-size:17px;">⭐ Local Preference（最高値を優先）</text>
      <text x="200" y="272" class="sb sbb" style="fill:#78350F;">自分側のルーターで設定 → 出方向（オンプレ→AWS）を確実に制御</text>
