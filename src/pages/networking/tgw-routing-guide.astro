    { id: 'transit-gateway-ピアリングの詳細', text: 'Transit Gateway ピアリングの詳細', level: 'h2' },
    { id: '実装コード例', text: '実装コード例', level: 'h2' },
    { id: 'tgwピアリング構築とルート設定', text: 'TGWピアリング構築とルート設定', level: 'h3' },
    { id: 'ベストプラクティス-vs-アンチパターン', text: 'ベストプラクティス vs アンチパターン', level: 'h2' },
    { id: 'トラブルシューティング', text: 'トラブルシューティング', level: 'h2' },
    { id: '試験対策ポイント', text: '試験対策ポイント', level: 'h2' },
    { id: 'よくある質問-faq', text: 'よくある質問（FAQ）', level: 'h2' },
    { id: 'チートシート-まとめ', text: 'チートシート まとめ', level: 'h2' },
  ],
  pageCss: '/aws_sap_studying/css/pages/tgw-routing-guide.css',
};

const rawContent = `
<!-- ========================================
     Navigation Header
     ======================================== -->
<header class="nav-header">
    <div class="nav-container">
        <a href="#" class="nav-logo" aria-label="トップへ戻る">&#9729;&#65039; AWS Networking</a>
        <nav class="nav-links" aria-label="メインナビゲーション">
            <a href="#analogy">たとえ話</a>
            <a href="#routing-core">ルーティング</a>
            <a href="#full-path">完全パス</a>
            <a href="#code-examples">コード例</a>
            <a href="#faq">FAQ</a>
        </nav>
    </div>
</header>

<!-- Reading Progress -->
<div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="progressBar"></div>
</div>

<!-- ========================================
     Main Content
     ======================================== -->
<main class="container">

    <!-- Hero Section -->
    <section class="hero" aria-label="ガイド概要">
        <span class="hero-badge" aria-hidden="true">&#128640; ANS-C01 / SAP-C02 対応</span>
        <h1>Transit Gateway ルーティング完全ガイド</h1>
        <p class="hero-sub">クロスリージョン・クロスアカウントVPC接続の完全なルーティングパスを<br>「国際空港ハブ」のたとえ話で徹底理解</p>

        <div class="takeaways">
            <div class="takeaway-item">
                <span class="takeaway-icon" aria-hidden="true">&#128270;</span>
                <span class="takeaway-text"><strong>TGWルートテーブル</strong>はアタッチメント間のトラフィック転送先を決定する「空港の発着案内板」</span>
            </div>
            <div class="takeaway-item">
                <span class="takeaway-icon" aria-hidden="true">&#9888;&#65039;</span>
                <span class="takeaway-text"><strong>VPCルートテーブル</strong>はTGWからルートを自動伝播しない。必ず手動更新が必要</span>
            </div>
            <div class="takeaway-item">
                <span class="takeaway-icon" aria-hidden="true">&#127760;</span>
                <span class="takeaway-text"><strong>TGWピアリング</strong>はクロスリージョン接続に使い、静的ルートのみサポート（自動伝播なし）</span>
            </div>
            <div class="takeaway-item">
                <span class="takeaway-icon" aria-hidden="true">&#128279;</span>
                <span class="takeaway-text">完全なパスは <strong>VPC RT → TGW RT → ピアリング → TGW RT → VPC RT</strong> の5段構成</span>
            </div>
        </div>
    </section>

    <!-- ========================================
         Analogy Section
         ======================================== -->
    <section class="section-block" id="analogy">
        <div class="section-header">
            <span class="section-emoji" aria-hidden="true">&#9992;&#65039;</span>
            <h2 id="国際空港ハブで理解するtransit-gateway">国際空港ハブで理解するTransit Gateway</h2>
        </div>

        <div class="analogy-box">
            <div class="analogy-title">
                <span aria-hidden="true">&#128161;</span>
                たとえ話：国際空港ハブ ネットワーク
            </div>
            <p class="analogy-content">
                あなたが東京から大阪、ニューヨーク、ロンドンへ旅行したいとします。各都市に直行便を飛ばすのは非効率ですよね？
                そこで<strong>「ハブ空港」</strong>を使います。東京はまずハブ空港へ行き、そこから各都市へ乗り継ぎます。
                <br><br>
                <strong>Transit Gateway</strong>はまさにこの「ハブ空港」です。各VPC（都市）を直接つなぐ代わりに、
                中央のハブを経由することで、管理がシンプルになります。
                そして<strong>異なるリージョン</strong>のTGWをつなぐ「ピアリング」は、東京の成田空港とロンドンのヒースロー空港の間に
                <strong>国際線</strong>を開設するようなものです。
            </p>
        </div>

        <!-- Analogy Mapping SVG Diagram -->
        <div class="diagram-container">
            <!--
            ノード配置表（空港↔AWS対応図）:
            左列（空港の世界）x=50, 右列（AWSの世界）x=680
            中央に矢印（=）と役割テキスト
            各行: y=130, 210, 290, 370, 450, 530, 610, 690
            ノードサイズ: 左=240x56, 右=240x56
            -->
            <svg width="1200" height="780" viewBox="0 0 1200 780" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="空港ハブのたとえ話とAWSサービスの対応関係を示す図。左側に空港の概念、右側に対応するAWSサービスを配置し、中央に役割の説明を表示">
                <defs>
                    <filter id="am-shadow" x="-10%" y="-10%" width="120%" height="120%">
                        <feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#0F172A" flood-opacity="0.07"/>
                    </filter>
                    <filter id="am-card-shadow" x="-4%" y="-4%" width="108%" height="108%">
                        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#0F172A" flood-opacity="0.05"/>
                    </filter>
                    <linearGradient id="am-connect" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#818CF8" stop-opacity="0.6"/>
                        <stop offset="50%" stop-color="#A78BFA" stop-opacity="0.9"/>
                        <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.6"/>
                    </linearGradient>
                    <style>
                        .am-title { font-family: Inter, Arial, sans-serif; font-size: 20px; font-weight: 700; fill: #0F172A; }
                        .am-col-title { font-family: Inter, Arial, sans-serif; font-size: 16px; font-weight: 700; }
                        .am-node-text { font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 700; fill: #1E293B; }
                        .am-node-emoji { font-family: Inter, Arial, sans-serif; font-size: 16px; }
                        .am-role { font-family: Inter, Arial, sans-serif; font-size: 11.5px; font-weight: 500; fill: #475569; }
                        .am-equals { font-family: Inter, Arial, sans-serif; font-size: 16px; font-weight: 800; fill: #A78BFA; }
                        .am-sub { font-family: Inter, Arial, sans-serif; font-size: 11px; font-weight: 500; fill: #6B7280; }
                    </style>
                </defs>

                <!-- Background -->
                <rect x="0" y="0" width="1200" height="780" fill="#F3F4F6"/>
                <rect x="16" y="16" width="1168" height="748" rx="20" fill="#FFFFFF" filter="url(#am-shadow)"/>

                <!-- Title -->
                <text x="600" y="55" text-anchor="middle" class="am-title">&#9992;&#65039; 空港ハブ ↔ AWSサービス 対応マップ</text>

                <!-- ===== Column Headers ===== -->
                <!-- Airport column header -->
                <rect x="50" y="72" width="260" height="38" rx="10" fill="#EEF2FF" stroke="#818CF8" stroke-width="1.5"/>
                <text x="180" y="97" text-anchor="middle" class="am-col-title" fill="#4338CA">&#9992;&#65039; 空港の世界</text>

                <!-- AWS column header -->
                <rect x="890" y="72" width="260" height="38" rx="10" fill="#FFF7ED" stroke="#FDBA74" stroke-width="1.5"/>
                <text x="1020" y="97" text-anchor="middle" class="am-col-title" fill="#92400E">&#9729;&#65039; AWSの世界</text>

                <!-- Center: "役割" label -->
                <text x="600" y="97" text-anchor="middle" class="am-col-title" fill="#6B7280">役割</text>

                <!-- ===================================================================== -->
                <!-- Row 1: ハブ空港 = Transit Gateway                                      -->
                <!-- ===================================================================== -->
                <!-- Airport node -->
                <rect x="50" y="124" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="80" y="160" class="am-node-emoji">&#127963;&#65039;</text>
                <text x="105" y="152" class="am-node-text">ハブ空港</text>
                <text x="105" y="172" class="am-sub">すべてが集まる中継拠点</text>

                <!-- AWS node -->
                <rect x="890" y="124" width="260" height="60" rx="12" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="920" y="160" class="am-node-emoji">&#128992;</text>
                <text x="945" y="152" class="am-node-text">Transit Gateway</text>
                <text x="945" y="172" class="am-sub">(TGW)</text>

                <!-- Connection + Role -->
                <line x1="310" y1="154" x2="890" y2="154" stroke="url(#am-connect)" stroke-width="2" stroke-dasharray="6 4"/>
                <rect x="400" y="138" width="400" height="32" rx="6" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
                <text x="600" y="159" text-anchor="middle" class="am-role">すべてのネットワーク接続が集まる中継地点</text>

                <!-- ===================================================================== -->
                <!-- Row 2: 各都市 = VPC                                                    -->
                <!-- ===================================================================== -->
                <rect x="50" y="204" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="80" y="240" class="am-node-emoji">&#127961;&#65039;</text>
                <text x="105" y="232" class="am-node-text">各都市</text>
                <text x="105" y="252" class="am-sub">東京・大阪・NY・ロンドン</text>

                <rect x="890" y="204" width="260" height="60" rx="12" fill="#ECFDF5" stroke="#34D399" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="920" y="240" class="am-node-emoji">&#128423;</text>
                <text x="945" y="232" class="am-node-text">VPC</text>
                <text x="945" y="252" class="am-sub">仮想プライベートクラウド</text>

                <line x1="310" y1="234" x2="890" y2="234" stroke="url(#am-connect)" stroke-width="2" stroke-dasharray="6 4"/>
                <rect x="400" y="218" width="400" height="32" rx="6" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
                <text x="600" y="239" text-anchor="middle" class="am-role">独立したネットワーク環境（ワークロードが稼働）</text>

                <!-- ===================================================================== -->
                <!-- Row 3: 発着案内板 = TGWルートテーブル                                    -->
                <!-- ===================================================================== -->
                <rect x="50" y="284" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="80" y="320" class="am-node-emoji">&#128203;</text>
                <text x="105" y="312" class="am-node-text">空港の発着案内板</text>
                <text x="105" y="332" class="am-sub">どの便がどのゲートから出発？</text>

                <rect x="890" y="284" width="260" height="60" rx="12" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="920" y="320" class="am-node-emoji">&#128208;</text>
                <text x="945" y="312" class="am-node-text">TGWルートテーブル</text>
                <text x="945" y="332" class="am-sub">アタッチメント間の転送先定義</text>

                <line x1="310" y1="314" x2="890" y2="314" stroke="url(#am-connect)" stroke-width="2" stroke-dasharray="6 4"/>
                <rect x="400" y="298" width="400" height="32" rx="6" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
                <text x="600" y="319" text-anchor="middle" class="am-role">どのアタッチメントへトラフィックを転送するか定義</text>

                <!-- ===================================================================== -->
                <!-- Row 4: 都市内の道路案内 = VPCルートテーブル                               -->
                <!-- ===================================================================== -->
                <rect x="50" y="364" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="80" y="400" class="am-node-emoji">&#128739;&#65039;</text>
                <text x="105" y="392" class="am-node-text">都市内の道路案内</text>
                <text x="105" y="412" class="am-sub">市内のどの道を通る？</text>

                <rect x="890" y="364" width="260" height="60" rx="12" fill="#FEFCE8" stroke="#FACC15" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="920" y="400" class="am-node-emoji">&#128678;</text>
                <text x="945" y="392" class="am-node-text">VPCルートテーブル</text>
                <text x="945" y="412" class="am-sub">&#9888;&#65039; 手動更新が必要!</text>

                <line x1="310" y1="394" x2="890" y2="394" stroke="url(#am-connect)" stroke-width="2" stroke-dasharray="6 4"/>
                <rect x="400" y="378" width="400" height="32" rx="6" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
                <text x="600" y="399" text-anchor="middle" class="am-role">VPC内サブネットからのトラフィックの送り先を制御</text>

                <!-- ===================================================================== -->
                <!-- Row 5: 空港ゲート = TGWアタッチメント                                    -->
                <!-- ===================================================================== -->
                <rect x="50" y="444" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="80" y="480" class="am-node-emoji">&#128682;</text>
                <text x="105" y="472" class="am-node-text">空港ゲート（搭乗口）</text>
                <text x="105" y="492" class="am-sub">各便の乗降口</text>

                <rect x="890" y="444" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="920" y="480" class="am-node-emoji">&#128268;</text>
                <text x="945" y="472" class="am-node-text">TGWアタッチメント</text>
                <text x="945" y="492" class="am-sub">VPC / VPN / DX接続点</text>

                <line x1="310" y1="474" x2="890" y2="474" stroke="url(#am-connect)" stroke-width="2" stroke-dasharray="6 4"/>
                <rect x="400" y="458" width="400" height="32" rx="6" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
                <text x="600" y="479" text-anchor="middle" class="am-role">VPC、VPN、Direct Connectなどの接続ポイント</text>

                <!-- ===================================================================== -->
                <!-- Row 6: 国際線ルート = TGWピアリング                                     -->
                <!-- ===================================================================== -->
                <rect x="50" y="524" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="80" y="560" class="am-node-emoji">&#127760;</text>
                <text x="105" y="552" class="am-node-text">国際線ルート</text>
                <text x="105" y="572" class="am-sub">成田⇔ヒースロー直行便</text>

                <rect x="890" y="524" width="260" height="60" rx="12" fill="#FEFCE8" stroke="#FACC15" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="920" y="560" class="am-node-emoji">&#128256;</text>
                <text x="945" y="552" class="am-node-text">TGWピアリング</text>
                <text x="945" y="572" class="am-sub">&#9888;&#65039; 静的ルートのみ!</text>

                <line x1="310" y1="554" x2="890" y2="554" stroke="url(#am-connect)" stroke-width="2" stroke-dasharray="6 4"/>
                <rect x="400" y="538" width="400" height="32" rx="6" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
                <text x="600" y="559" text-anchor="middle" class="am-role">異なるリージョンのTGW同士を接続</text>

                <!-- ===================================================================== -->
                <!-- Row 7: 自動路線登録 = ルート伝播                                        -->
                <!-- ===================================================================== -->
                <rect x="50" y="604" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="80" y="640" class="am-node-emoji">&#128260;</text>
                <text x="105" y="632" class="am-node-text">航空会社の自動路線登録</text>
                <text x="105" y="652" class="am-sub">新路線を自動で案内板に反映</text>

                <rect x="890" y="604" width="260" height="60" rx="12" fill="#ECFDF5" stroke="#34D399" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="920" y="640" class="am-node-emoji">&#9989;</text>
                <text x="945" y="632" class="am-node-text">ルート伝播</text>
                <text x="945" y="652" class="am-sub">VPC/VPNからTGW RTへ自動反映</text>

                <line x1="310" y1="634" x2="890" y2="634" stroke="url(#am-connect)" stroke-width="2" stroke-dasharray="6 4"/>
                <rect x="400" y="618" width="400" height="32" rx="6" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
                <text x="600" y="639" text-anchor="middle" class="am-role">アタッチメントからルートを自動取得</text>

                <!-- ===================================================================== -->
                <!-- Row 8: チャーター便 = 静的ルート                                        -->
                <!-- ===================================================================== -->
                <rect x="50" y="684" width="260" height="60" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="80" y="720" class="am-node-emoji">&#128295;</text>
                <text x="105" y="712" class="am-node-text">チャーター便の手配</text>
                <text x="105" y="732" class="am-sub">手動で路線を個別に手配</text>

                <rect x="890" y="684" width="260" height="60" rx="12" fill="#FEF2F2" stroke="#F87171" stroke-width="2" filter="url(#am-card-shadow)"/>
                <text x="920" y="720" class="am-node-emoji">&#128295;</text>
                <text x="945" y="712" class="am-node-text">静的ルート</text>
                <text x="945" y="732" class="am-sub">ピアリング時は必須!</text>

                <line x1="310" y1="714" x2="890" y2="714" stroke="url(#am-connect)" stroke-width="2" stroke-dasharray="6 4"/>
                <rect x="400" y="698" width="400" height="32" rx="6" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
                <text x="600" y="719" text-anchor="middle" class="am-role">手動で定義する特定の経路</text>

                <!-- ===== Decorative "=" symbols on connector lines ===== -->
                <text x="350" y="160" class="am-equals">=</text>
                <text x="350" y="240" class="am-equals">=</text>
                <text x="350" y="320" class="am-equals">=</text>
                <text x="350" y="400" class="am-equals">=</text>
                <text x="350" y="480" class="am-equals">=</text>
                <text x="350" y="560" class="am-equals">=</text>
                <text x="350" y="640" class="am-equals">=</text>
                <text x="350" y="720" class="am-equals">=</text>

                <text x="850" y="160" class="am-equals">=</text>
                <text x="850" y="240" class="am-equals">=</text>
                <text x="850" y="320" class="am-equals">=</text>
                <text x="850" y="400" class="am-equals">=</text>
                <text x="850" y="480" class="am-equals">=</text>
                <text x="850" y="560" class="am-equals">=</text>
                <text x="850" y="640" class="am-equals">=</text>
                <text x="850" y="720" class="am-equals">=</text>
            </svg>
            <p class="diagram-caption">図: 空港ハブのたとえ話と AWS サービスの対応マップ — 左の空港概念が右のAWSサービスに対応</p>
        </div>
    </section>

    <!-- ========================================
         Architecture SVG Diagram 1: Overall
         ======================================== -->
    <section class="section-block" id="architecture">
        <div class="section-header">
            <span class="section-emoji" aria-hidden="true">&#128506;</span>
            <h2 id="全体アーキテクチャ図">全体アーキテクチャ図</h2>
        </div>

        <div class="diagram-container">
            <!-- SVG: Cross-Region TGW Architecture -->
            <!--
            ノード配置表:
            | ノード名              | x    | y    | 色タイプ           |
            |----------------------|------|------|--------------------|
            | VPC-A (10.1.0.0/16)  | 60   | 200  | private resource   |
