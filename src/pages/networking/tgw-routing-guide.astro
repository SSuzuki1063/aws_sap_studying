  categoryLabel: 'ネットワーキング',
  subcategory: 'Transit Gateway & ゲートウェイ',
  slug: 'tgw-routing-guide',
  tocItems: [
    { id: '国際空港ハブで理解するtransit-gateway', text: '国際空港ハブで理解するTransit Gateway', level: 'h2' },
    { id: '全体アーキテクチャ図', text: '全体アーキテクチャ図', level: 'h2' },
    { id: 'tgwルーティングの4大要素', text: 'TGWルーティングの4大要素', level: 'h2' },
