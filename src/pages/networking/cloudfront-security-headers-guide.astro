<li>⚠️ コード記述が必要</li>
<li>⚠️ レイテンシが追加される</li>
<li>⚠️ 追加コストがかかる</li>
<li>⚠️ us-east-1でのみ作成可能</li>
<li>⚠️ メンテナンスが必要</li>
</ul>
</div>
</div>
<div class="code-example">
<div class="code-title">📝 Lambda@Edge サンプルコード（Node.js）</div>
<pre><span class="code-keyword">exports</span>.handler = <span class="code-keyword">async</span> (event) =&gt; {
    <span class="code-keyword">const</span> response = event.Records[<span class="code-string">0</span>].cf.response;
    <span class="code-keyword">const</span> headers = response.headers;
    
    <span class="code-comment">// セキュリティヘッダーを追加</span>
    headers[<span class="code-string">'strict-transport-security'</span>] = [{
        <span class="code-property">key</span>: <span class="code-string">'Strict-Transport-Security'</span>,
        <span class="code-property">value</span>: <span class="code-string">'max-age=31536000; includeSubdomains'</span>
    }];
    headers[<span class="code-string">'x-content-type-options'</span>] = [{
        <span class="code-property">key</span>: <span class="code-string">'X-Content-Type-Options'</span>,
        <span class="code-property">value</span>: <span class="code-string">'nosniff'</span>
    }];
    headers[<span class="code-string">'x-frame-options'</span>] = [{
        <span class="code-property">key</span>: <span class="code-string">'X-Frame-Options'</span>,
        <span class="code-property">value</span>: <span class="code-string">'DENY'</span>
    }];
    
    <span class="code-keyword">return</span> response;
};</pre>
