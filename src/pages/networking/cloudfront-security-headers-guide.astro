    <span class="code-keyword">var</span> response = event.response;
    <span class="code-keyword">var</span> headers = response.headers;
    
    <span class="code-comment">// セキュリティヘッダーを追加</span>
    headers[<span class="code-string">'strict-transport-security'</span>] = { 
        <span class="code-property">value</span>: <span class="code-string">'max-age=31536000; includeSubdomains'</span>
    };
    headers[<span class="code-string">'x-content-type-options'</span>] = { 
        <span class="code-property">value</span>: <span class="code-string">'nosniff'</span>
    };
    headers[<span class="code-string">'x-frame-options'</span>] = { 
        <span class="code-property">value</span>: <span class="code-string">'DENY'</span>
    };
    
    <span class="code-keyword">return</span> response;
}</pre>
</div>
