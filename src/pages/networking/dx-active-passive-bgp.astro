              <text x="190" y="158" text-anchor="middle" font-size="20" fill="#475569">本番 → LP 200 &#128994;</text>
              <text x="190" y="183" text-anchor="middle" font-size="20" fill="#475569">開発 → LP 100</text>
              <text x="190" y="218" text-anchor="middle" font-size="20" font-weight="bold" fill="#3B82F6">eBGP経由で本番を送出</text>
            </g>

            <!-- DC2 -->
            <g>
              <rect x="60" y="290" width="260" height="140" rx="14" fill="#F8FAFC" stroke="#94A3B8" stroke-width="2.5"/>
              <text x="190" y="320" text-anchor="middle" font-size="20" font-weight="bold" fill="#475569">&#128739; DC2（大阪）</text>
              <text x="190" y="348" text-anchor="middle" font-size="20" fill="#475569">本番 → LP 100</text>
              <text x="190" y="373" text-anchor="middle" font-size="20" fill="#475569">開発 → LP 200 &#128994;</text>
              <text x="190" y="408" text-anchor="middle" font-size="20" font-weight="bold" fill="#94A3B8">eBGP経由で開発を送出</text>
            </g>

            <!-- iBGP Link -->
            <line x1="190" y1="240" x2="190" y2="290" stroke="#94A3B8" stroke-width="2" stroke-dasharray="6,4"/>
            <text x="220" y="270" font-size="18" fill="#94A3B8">iBGP</text>

            <!-- AWS Side -->
            <rect x="750" y="100" width="380" height="330" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2" stroke-dasharray="8,4"/>
            <text x="940" y="128" text-anchor="middle" font-size="20" font-weight="bold" fill="#475569">AWS</text>

            <g>
              <rect x="790" y="155" width="300" height="55" rx="12" fill="white" stroke="#3B82F6" stroke-width="2"/>
              <text x="940" y="188" text-anchor="middle" font-size="20" font-weight="bold" fill="#1E293B">&#128230; 本番VPC 10.0.1.0/24</text>
            </g>
            <g>
              <rect x="790" y="240" width="300" height="55" rx="12" fill="white" stroke="#94A3B8" stroke-width="2"/>
              <text x="940" y="273" text-anchor="middle" font-size="20" font-weight="bold" fill="#1E293B">&#128230; 開発VPC 10.0.2.0/24</text>
            </g>

            <!-- DXGW -->
            <g>
              <rect x="500" y="200" width="180" height="70" rx="14" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2.5"/>
