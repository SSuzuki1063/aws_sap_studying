            </g>

            <!-- Active Arrow DC1 → DXGW (prod) -->
            <path d="M 320 170 Q 400 170 500 220" stroke="#3B82F6" stroke-width="3" fill="none" marker-end="url(#arrowBlue2)"/>
            <text x="410" y="180" text-anchor="middle" font-size="18" font-weight="bold" fill="#3B82F6">本番 &#128994;</text>

            <!-- Passive Arrow DC2 → DXGW (dev) -->
            <path d="M 320 360 Q 400 360 500 250" stroke="#94A3B8" stroke-width="2.5" fill="none" stroke-dasharray="8,4" marker-end="url(#arrowGray)"/>
