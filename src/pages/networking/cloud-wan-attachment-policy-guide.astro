    { level: 'h2', id: '✈️-国際空港の入国審査でたとえると...', text: '✈️ 国際空港の入国審査でたとえると...' },
    { level: 'h2', id: '️-空港ネットワーク構成図', text: '🏗️ 空港ネットワーク構成図' },
    { level: 'h2', id: '承認ルールの詳細設計', text: '📋 承認ルールの詳細設計' },
    { level: 'h2', id: '⚖️-AND条件-vs-OR条件の違い', text: '⚖️ AND条件 vs OR条件の違い' },
    { level: 'h2', id: 'ルール評価の順序', text: '🔄 ルール評価の順序' },
    { level: 'h2', id: 'シナリオ別の動作確認', text: '🧪 シナリオ別の動作確認' },
    { level: 'h2', id: '実装例-Core-Network-Policy-JSON', text: '💻 実装例：Core Network Policy JSON' },
    { level: 'h2', id: 'ベストプラクティス', text: '💡 ベストプラクティス' },
    { level: 'h2', id: '❓-よくある質問FAQ', text: '❓ よくある質問（FAQ）' },
    { level: 'h2', id: 'まとめ-試験のポイント', text: '📌 まとめ：試験のポイント' }
  ],
  prevPage: 'transit-gateway-peering-guide.html',
  nextPage: undefined,
  pageNum: 26,
  pageTotal: 26,
};

const rawContent = `<style>:root {
            --color-aws-dark: #232F3E;
            --color-aws-orange: #FF9900;
            --color-aws-orange-dark: #dc7600;
            --color-text-primary: #374151;
            --color-text-secondary: #6B7280;
            --color-bg-light: #F9FAFB;
            --color-success: #10B981;
            --color-warning: #F59E0B;
            --color-error: #EF4444;
            --color-info: #3B82F6;
            --color-purple: #8B5CF6;
            --color-pink: #EC4899;
            --color-teal: #14B8A6;
            --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 40px rgba(0, 0, 0, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
            color: var(--color-text-primary);
            line-height: 1.7;
            min-height: 100vh;
            padding-top: 70px;}

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* ヒーローセクション */
        .hero {
            background: linear-gradient(135deg, var(--color-aws-dark) 0%, #37475A 50%, #4a5568 100%);
            border-radius: 20px;
            padding: 50px 40px;
            margin-bottom: 40px;
            color: white;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255,153,0,0.15) 0%, transparent 70%);
            border-radius: 50%;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 153, 0, 0.2);
            border: 1px solid var(--color-aws-orange);
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 0.9em;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 2.5em;
            margin-bottom: 15px;
            position: relative;
            color: white;
        }

        .hero-subtitle {
            font-size: 1.2em;
            opacity: 0.9;
            max-width: 700px;
        }

        /* 結論ファーストセクション */
        .conclusion-first {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            padding: 35px;
            margin-bottom: 40px;
            color: white;
            box-shadow: var(--shadow-lg);
        }

        .conclusion-first h2 {
            font-size: 1.6em;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .conclusion-box {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(10px);
        }

        .conclusion-point {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 15px;
        }

        .conclusion-point:last-child {
            margin-bottom: 0;
        }

        .conclusion-number {
            background: white;
            color: #764ba2;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            flex-shrink: 0;
        }

        .conclusion-text {
            font-size: 1.05em;
            line-height: 1.6;
        }

        .conclusion-text strong {
            color: #ffd700;
        }

        /* たとえ話セクション */
        .analogy-section {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: var(--shadow-md);
        }

        .section-title {
            font-size: 1.8em;
            color: var(--color-aws-dark);
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .analogy-intro {
            background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%);
            border-left: 5px solid var(--color-info);
            border-radius: 0 15px 15px 0;
            padding: 25px;
            margin-bottom: 30px;
        }

        .analogy-intro p {
            font-size: 1.1em;
            color: var(--color-text-primary);
        }

        /* マッピング表 */
        .mapping-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 25px;
        }

        .mapping-card {
            background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
            border: 2px solid #e5e7eb;
            border-radius: 15px;
            padding: 20px;
            transition: all 0.3s ease;
        }

        .mapping-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
            border-color: var(--color-aws-orange);
        }

        .mapping-icon {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .mapping-aws {
            font-weight: bold;
            color: var(--color-aws-dark);
            font-size: 1.1em;
            margin-bottom: 5px;
        }

        .mapping-arrow {
            color: var(--color-aws-orange);
            font-size: 1.5em;
            margin: 5px 0;
        }

        .mapping-analogy {
            color: var(--color-info);
            font-weight: 600;
        }

        .mapping-desc {
            color: var(--color-text-secondary);
            font-size: 0.9em;
            margin-top: 10px;
        }

        /* 図解セクション */
        .diagram-section {
            background: linear-gradient(135deg, var(--color-aws-dark) 0%, #1a202c 100%);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            color: white;
        }

        .diagram-title {
            font-size: 1.6em;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: white;
        }

        /* 空港ダイアグラム */
        .airport-diagram {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
        }

        .airport-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .terminal-box {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 25px;
            border: 2px dashed rgba(255, 255, 255, 0.3);
        }

        .terminal-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .terminal-name {
            font-size: 1.3em;
            font-weight: bold;
            color: var(--color-aws-orange);
        }

        .terminal-location {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9em;
        }

        .wings-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .wing {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            border-radius: 10px;
            font-size: 0.95em;
        }

        .wing-dev {
            background: linear-gradient(90deg, rgba(59, 130, 246, 0.3) 0%, rgba(59, 130, 246, 0.1) 100%);
            border-left: 4px solid var(--color-info);
        }

        .wing-prod {
            background: linear-gradient(90deg, rgba(239, 68, 68, 0.3) 0%, rgba(239, 68, 68, 0.1) 100%);
            border-left: 4px solid var(--color-error);
        }

        .wing-shared {
            background: linear-gradient(90deg, rgba(16, 185, 129, 0.3) 0%, rgba(16, 185, 129, 0.1) 100%);
            border-left: 4px solid var(--color-success);
        }

        .wing-icon {
            font-size: 1.2em;
        }

        /* 入国審査フロー */
        .immigration-flow {
            margin-top: 30px;
        }

        .flow-title {
            font-size: 1.2em;
            margin-bottom: 20px;
            text-align: center;
            color: var(--color-aws-orange);
        }

        .flow-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .flow-step {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            min-width: 150px;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .flow-step-icon {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .flow-step-text {
            font-size: 0.9em;
        }

        .flow-arrow {
            font-size: 2em;
            color: var(--color-aws-orange);
        }

        /* ルール説明セクション */
        .rules-section {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: var(--shadow-md);
        }

        .rule-card {
            border: 2px solid #e5e7eb;
            border-radius: 15px;
            margin-bottom: 25px;
            overflow: hidden;
        }

        .rule-header {
            padding: 20px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .rule-header-100 {
            background: linear-gradient(135deg, #fee2e2 0%, #fef2f2 100%);
            border-bottom: 3px solid var(--color-error);
        }

        .rule-header-200 {
            background: linear-gradient(135deg, #d1fae5 0%, #ecfdf5 100%);
            border-bottom: 3px solid var(--color-success);
        }

        .rule-number {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .rule-badge {
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 1.1em;
        }

        .badge-100 {
            background: var(--color-error);
            color: white;
        }

        .badge-200 {
            background: var(--color-success);
            color: white;
        }

        .rule-priority {
            font-size: 0.85em;
            color: var(--color-text-secondary);
        }

        .rule-action {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: 600;
        }

        .action-require {
            background: rgba(239, 68, 68, 0.1);
            color: var(--color-error);
            border: 2px solid var(--color-error);
        }

        .action-auto {
            background: rgba(16, 185, 129, 0.1);
            color: var(--color-success);
            border: 2px solid var(--color-success);
        }

        .rule-body {
            padding: 25px;
            padding-top: 70px;}

        .condition-box {
            background: var(--color-bg-light);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .condition-title {
            font-weight: bold;
            color: var(--color-aws-dark);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .conditions-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .condition-item {
            background: white;
            padding: 15px 20px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            min-width: 180px;
        }

        .condition-key {
            font-size: 0.85em;
            color: var(--color-text-secondary);
            margin-bottom: 5px;
        }

        .condition-value {
            font-weight: bold;
            color: var(--color-aws-dark);
            font-size: 1.1em;
        }

        .condition-logic {
            background: var(--color-purple);
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 0.9em;
        }

        .rule-explanation {
            background: linear-gradient(135deg, #fef3c7 0%, #fffbeb 100%);
            border-left: 4px solid var(--color-warning);
            border-radius: 0 10px 10px 0;
            padding: 15px 20px;
        }

        .rule-explanation-title {
            font-weight: bold;
            color: #92400e;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .rule-explanation p {
            color: #78350f;
            font-size: 0.95em;
        }

        /* AND vs OR 比較 */
        .comparison-section {
            background: linear-gradient(135deg, #f3e8ff 0%, #faf5ff 100%);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
        }

        .comparison-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-top: 25px;
        }

        .comparison-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: var(--shadow-md);
        }

        .comparison-header {
            padding: 20px;
            text-align: center;
            font-weight: bold;
            font-size: 1.2em;
        }

        .header-and {
            background: linear-gradient(135deg, var(--color-success) 0%, #059669 100%);
            color: white;
        }

        .header-or {
            background: linear-gradient(135deg, var(--color-error) 0%, #dc2626 100%);
            color: white;
        }

        .comparison-body {
            padding: 25px;
            padding-top: 70px;}

        .comparison-formula {
            background: var(--color-bg-light);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            margin-bottom: 20px;
            font-family: monospace;
            font-size: 0.95em;
        }

        .comparison-result {
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
        }

        .result-correct {
            background: rgba(16, 185, 129, 0.1);
            border: 2px solid var(--color-success);
        }

        .result-incorrect {
            background: rgba(239, 68, 68, 0.1);
            border: 2px solid var(--color-error);
        }

        .result-title {
            font-weight: bold;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .comparison-cases {
            font-size: 0.9em;
            line-height: 1.8;
        }

        .case-item {
            padding: 8px 12px;
            border-radius: 6px;
            margin-bottom: 5px;
        }

        .case-match {
            background: rgba(16, 185, 129, 0.1);
        }

        .case-no-match {
            background: rgba(107, 114, 128, 0.1);
        }

        /* ルール評価フロー */
        .evaluation-section {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: var(--shadow-md);
        }

        .eval-flow {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 25px;
        }

        .eval-step {
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }

        .eval-number {
            background: var(--color-aws-dark);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            flex-shrink: 0;
        }

        .eval-content {
            flex: 1;
            background: var(--color-bg-light);
            border-radius: 12px;
            padding: 20px;
            border-left: 4px solid var(--color-aws-orange);
        }

        .eval-title {
            font-weight: bold;
            color: var(--color-aws-dark);
            margin-bottom: 10px;
        }

        .eval-desc {
            color: var(--color-text-secondary);
        }

        /* シナリオテスト */
        .scenarios-section {
            background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
        }

        .scenario-grid {
            display: grid;
            gap: 20px;
            margin-top: 25px;
        }

        .scenario-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: var(--shadow-md);
        }

        .scenario-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .scenario-icon {
            font-size: 1.8em;
        }

        .scenario-title {
            font-weight: bold;
            color: var(--color-aws-dark);
        }

        .scenario-tags {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .scenario-tag {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 500;
        }

        .tag-region {
            background: rgba(59, 130, 246, 0.1);
            color: var(--color-info);
        }

        .tag-env {
            background: rgba(139, 92, 246, 0.1);
            color: var(--color-purple);
        }

        .scenario-process {
            background: var(--color-bg-light);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .process-step {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .process-step:last-child {
            margin-bottom: 0;
        }

        .scenario-result {
            padding: 15px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .result-approved {
            background: rgba(16, 185, 129, 0.1);
            border: 2px solid var(--color-success);
        }

        .result-pending {
            background: rgba(245, 158, 11, 0.1);
            border: 2px solid var(--color-warning);
        }

        .result-icon {
            font-size: 1.5em;
        }

        .result-text {
            font-weight: bold;
        }

        /* コード例 */
        .code-section {
            background: var(--color-aws-dark);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            color: white;
        }

        .code-block {
            background: #1a202c;
            border-radius: 12px;
            padding: 25px;
            overflow-x: auto;
            margin-top: 20px;
        }

        .code-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .code-lang {
            background: var(--color-aws-orange);
            color: white;
            padding: 5px 12px;
            border-radius: 5px;
            font-size: 0.85em;
            font-weight: bold;
        }

        pre {
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
            font-size: 0.9em;
            line-height: 1.6;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .code-comment {
            color: #6b7280;
        }

        .code-key {
            color: #93c5fd;
        }

        .code-string {
            color: #86efac;
        }

        .code-number {
            color: #fca5a5;
        }

        /* ベストプラクティス */
        .best-practices {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: var(--shadow-md);
        }

        .practice-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 25px;
        }

        .practice-card {
            background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
            border: 2px solid #e5e7eb;
            border-radius: 15px;
            padding: 25px;
            transition: all 0.3s ease;
        }

        .practice-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        .practice-icon {
            font-size: 2em;
            margin-bottom: 15px;
        }

        .practice-title {
            font-weight: bold;
            color: var(--color-aws-dark);
            margin-bottom: 10px;
        }

        .practice-desc {
            color: var(--color-text-secondary);
            font-size: 0.95em;
        }

        /* FAQ */
        .faq-section {
            background: linear-gradient(135deg, #fef3c7 0%, #fffbeb 100%);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
        }

        .faq-item {
            background: white;
            border-radius: 12px;
            margin-bottom: 15px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .faq-question {
