---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: '',
  pageTitle: 'AWS Cloud WAN アタッチメント承認ポリシー完全ガイド',
  category: 'networking',
  categoryLabel: 'ネットワーキング',
  subcategory: '',
  slug: 'cloud-wan-attachment-policy-guide',
  pageCss: undefined,
  tocItems: [
