const rawContent = `<style>/* ======================================== 
       リセット & ベース 
       ======================================== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --white: #FFFFFF;
      --gray-50: #F9FAFB;
      --gray-100: #F3F4F6;
      --gray-200: #E5E7EB;
      --gray-300: #D1D5DB;
      --gray-400: #9CA3AF;
      --gray-500: #6B7280;
      --gray-600: #4B5563;
      --gray-700: #374151;
      --gray-800: #1F2937;
      --gray-900: #111827;
      --blue-50: #EFF6FF;
      --blue-100: #DBEAFE;
      --blue-200: #BFDBFE;
      --blue-400: #60A5FA;
      --blue-500: #3B82F6;
      --blue-600: #2563EB;
      --blue-700: #1D4ED8;
      --orange-50: #FFF7ED;
      --orange-100: #FFEDD5;
      --orange-400: #FB923C;
      --orange-500: #F97316;
      --orange-600: #EA580C;
      --green-50: #F0FDF4;
      --green-100: #DCFCE7;
      --green-400: #4ADE80;
      --green-500: #22C55E;
      --green-600: #16A34A;
      --green-700: #15803D;
      --red-50: #FEF2F2;
      --red-100: #FEE2E2;
      --red-400: #F87171;
      --red-500: #EF4444;
      --red-600: #DC2626;
      --purple-50: #FAF5FF;
      --purple-100: #F3E8FF;
      --purple-400: #C084FC;
      --purple-500: #A855F7;
      --purple-600: #9333EA;
      --teal-50: #F0FDFA;
      --teal-100: #CCFBF1;
      --teal-500: #14B8A6;
      --teal-600: #0D9488;
      --amber-50: #FFFBEB;
      --amber-100: #FEF3C7;
      --amber-500: #F59E0B;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
      --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
      --shadow-lg: 0 8px 30px rgba(0,0,0,0.1);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 20px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
      background: var(--gray-50);
      color: var(--gray-700);
      line-height: 1.8;
      font-size: 20px;
      min-height: 100vh;
            padding-top: 70px;}

    /* ======================================== 
       レイアウト 
       ======================================== */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ======================================== 
       ヘッダー 
       ======================================== */
    .hero {
      background: var(--white);
      border-bottom: 1px solid var(--gray-200);
      padding: 60px 0 50px;
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--blue-50);
      color: var(--blue-600);
      padding: 8px 20px;
      border-radius: 100px;
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 24px;
      border: 1px solid var(--blue-200);
    }

    .hero h1 {
      font-size: 40px;
      font-weight: 800;
      color: var(--gray-900);
      line-height: 1.3;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }

    .hero-sub {
      font-size: 22px;
      color: var(--gray-500);
      max-width: 700px;
      margin: 0 auto;
    }

    /* ======================================== 
       結論ファースト 
       ======================================== */
    .conclusion-section {
      padding: 60px 0;
    }

    .conclusion-box {
      background: var(--white);
      border: 2px solid var(--blue-200);
      border-radius: var(--radius-xl);
      padding: 48px;
      box-shadow: var(--shadow-md);
    }

    .conclusion-title {
      font-size: 28px;
      font-weight: 700;
      color: var(--blue-700);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .conclusion-text {
      font-size: 22px;
      line-height: 2;
      color: var(--gray-700);
      margin-bottom: 32px;
    }

    .conclusion-points {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .conclusion-point {
      background: var(--gray-50);
      border-radius: var(--radius-md);
      padding: 24px;
      text-align: center;
      border: 1px solid var(--gray-200);
    }

    .conclusion-point-icon {
      font-size: 36px;
      margin-bottom: 12px;
    }

    .conclusion-point-label {
      font-size: 20px;
      font-weight: 700;
      color: var(--gray-800);
      margin-bottom: 8px;
    }

    .conclusion-point-desc {
      font-size: 20px;
      color: var(--gray-500);
    }

    /* ======================================== 
       セクション共通 
       ======================================== */
    .section {
      padding: 60px 0;
    }

    .section-header {
      text-align: center;
      margin-bottom: 48px;
    }

    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 20px;
      font-weight: 600;
      color: var(--gray-400);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 12px;
    }

    .section-title {
      font-size: 32px;
      font-weight: 800;
      color: var(--gray-900);
      line-height: 1.3;
    }

    .section-desc {
      font-size: 20px;
      color: var(--gray-500);
      max-width: 720px;
      margin: 12px auto 0;
    }

    /* ======================================== 
       たとえ話：ショッピングモール 
       ======================================== */
    .analogy-intro {
      background: var(--white);
      border-radius: var(--radius-xl);
      padding: 48px;
      box-shadow: var(--shadow-md);
      margin-bottom: 40px;
      border: 1px solid var(--gray-200);
    }

    .analogy-intro-title {
      font-size: 26px;
      font-weight: 700;
      color: var(--gray-800);
      margin-bottom: 16px;
    }

    .analogy-intro-text {
      font-size: 20px;
      color: var(--gray-600);
      line-height: 2;
    }

    /* たとえマッピンググリッド */
    .mapping-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 40px;
    }

    .mapping-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      padding: 32px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .mapping-card:hover {
      box-shadow: var(--shadow-lg);
      transform: translateY(-2px);
    }

    .mapping-icon {
      flex-shrink: 0;
      width: 56px;
      height: 56px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
    }

    .mapping-icon.tgw { background: var(--blue-100); }
    .mapping-icon.isolated { background: var(--orange-100); }
    .mapping-icon.shared { background: var(--green-100); }
    .mapping-icon.vpn { background: var(--purple-100); }
    .mapping-icon.route-table { background: var(--amber-100); }
    .mapping-icon.propagation { background: var(--teal-100); }

    .mapping-content { flex: 1; }

    .mapping-aws-label {
      font-size: 20px;
      font-weight: 700;
      color: var(--gray-800);
      margin-bottom: 4px;
    }

    .mapping-arrow {
      font-size: 20px;
      color: var(--gray-400);
      margin-bottom: 4px;
    }

    .mapping-analogy-label {
      font-size: 20px;
      font-weight: 600;
      color: var(--blue-600);
      margin-bottom: 8px;
    }

    .mapping-desc {
      font-size: 20px;
      color: var(--gray-500);
    }

    /* ======================================== 
       メイン図解 
       ======================================== */
    .diagram-panel {
      background: var(--white);
      border-radius: var(--radius-xl);
      padding: 48px;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--gray-200);
      margin-bottom: 40px;
    }

    .diagram-title {
      font-size: 24px;
      font-weight: 700;
      color: var(--gray-800);
      margin-bottom: 32px;
      text-align: center;
    }

    /* SVG図解 */
    .architecture-svg {
      width: 100%;
      max-width: 1000px;
      margin: 0 auto;
      display: block;
    }

    /* ======================================== 
       ルートテーブル解説 
       ======================================== */
    .route-tables-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .route-table-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-sm);
    }

    .route-table-header {
      padding: 20px 24px;
      font-size: 20px;
      font-weight: 700;
      color: var(--white);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .route-table-header.isolated-header { background: var(--orange-500); }
    .route-table-header.shared-header { background: var(--green-600); }

    .route-table-body { padding: 24px;
            padding-top: 70px;}

    .route-table-desc {
      font-size: 20px;
      color: var(--gray-600);
      margin-bottom: 20px;
      line-height: 1.8;
    }

    .rt-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 20px;
    }

    .rt-table th {
      background: var(--gray-100);
      padding: 12px 16px;
      text-align: left;
      font-weight: 600;
      color: var(--gray-700);
      border-bottom: 2px solid var(--gray-200);
    }

    .rt-table td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--gray-100);
      color: var(--gray-600);
    }

    .rt-table tr:last-child td { border-bottom: none; }

    .rt-badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 100px;
      font-size: 18px;
      font-weight: 600;
    }

    .rt-badge.propagated {
      background: var(--blue-50);
      color: var(--blue-600);
    }

    /* ======================================== 
       通信フローセクション 
       ======================================== */
    .flow-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .flow-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      padding: 32px;
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-sm);
      text-align: center;
    }

    .flow-icon-area {
      font-size: 48px;
      margin-bottom: 16px;
    }

    .flow-label {
      font-size: 20px;
      font-weight: 700;
      color: var(--gray-800);
      margin-bottom: 8px;
    }

    .flow-route {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .flow-result {
      display: inline-block;
      padding: 6px 16px;
      border-radius: 100px;
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 12px;
    }

    .flow-result.ok {
      background: var(--green-50);
      color: var(--green-700);
      border: 1px solid var(--green-400);
    }

    .flow-result.ng {
      background: var(--red-50);
      color: var(--red-600);
      border: 1px solid var(--red-400);
    }

    .flow-desc {
      font-size: 20px;
      color: var(--gray-500);
    }

    /* ======================================== 
       Association / Propagation解説 
       ======================================== */
    .ap-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin-bottom: 40px;
    }

    .ap-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      padding: 36px;
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-sm);
    }

    .ap-card-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .ap-card-title.assoc { color: var(--blue-700); }
    .ap-card-title.propag { color: var(--teal-600); }

    .ap-card-text {
      font-size: 20px;
      color: var(--gray-600);
      margin-bottom: 20px;
      line-height: 1.9;
    }

    .ap-analogy {
      background: var(--gray-50);
      border-radius: var(--radius-md);
      padding: 20px;
      border-left: 4px solid var(--blue-400);
    }

    .ap-analogy.propag-analogy { border-left-color: var(--teal-500); }

    .ap-analogy-title {
      font-size: 20px;
      font-weight: 600;
      color: var(--gray-700);
      margin-bottom: 8px;
    }

    .ap-analogy-text {
      font-size: 20px;
      color: var(--gray-500);
    }

    /* ======================================== 
       設定マトリクス 
       ======================================== */
    .matrix-card {
      background: var(--white);
      border-radius: var(--radius-xl);
      overflow: hidden;
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-md);
      margin-bottom: 40px;
    }

    .matrix-header {
      padding: 24px 32px;
      font-size: 22px;
      font-weight: 700;
      color: var(--white);
      background: var(--gray-800);
    }

    .matrix-body { padding: 32px; overflow-x: auto;
            padding-top: 70px;}

    .matrix-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 20px;
    }

    .matrix-table th {
      background: var(--gray-100);
      padding: 14px 18px;
      text-align: center;
      font-weight: 600;
      color: var(--gray-700);
      border-bottom: 2px solid var(--gray-200);
    }

    .matrix-table td {
      padding: 14px 18px;
      text-align: center;
      border-bottom: 1px solid var(--gray-100);
      color: var(--gray-600);
    }

    .matrix-table tr:last-child td { border-bottom: none; }

    .check-yes {
      color: var(--green-500);
      font-weight: 700;
      font-size: 22px;
    }

    .check-no {
      color: var(--gray-300);
      font-size: 22px;
    }

    .vpc-tag {
      display: inline-block;
      padding: 4px 14px;
      border-radius: 100px;
      font-weight: 600;
      font-size: 18px;
    }

    .vpc-tag.vpc-a { background: var(--orange-50); color: var(--orange-600); border: 1px solid var(--orange-400); }
    .vpc-tag.vpc-b { background: var(--red-50); color: var(--red-600); border: 1px solid var(--red-400); }
    .vpc-tag.vpc-c { background: var(--purple-50); color: var(--purple-600); border: 1px solid var(--purple-400); }
    .vpc-tag.vpc-d { background: var(--green-50); color: var(--green-600); border: 1px solid var(--green-400); }
    .vpc-tag.vpn { background: var(--blue-50); color: var(--blue-600); border: 1px solid var(--blue-400); }

    /* ======================================== 
       ステップ解説 
       ======================================== */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .step-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      padding: 32px;
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-sm);
      position: relative;
    }

    .step-number {
      position: absolute;
      top: -14px;
      left: 24px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--blue-600);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 700;
    }

    .step-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--gray-800);
      margin-bottom: 12px;
      margin-top: 8px;
    }

    .step-text {
      font-size: 20px;
      color: var(--gray-500);
      line-height: 1.8;
    }

    /* ======================================== 
       ユースケース 
       ======================================== */
    .usecase-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .usecase-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      padding: 32px;
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-sm);
    }

    .usecase-icon { font-size: 40px; margin-bottom: 16px; }

    .usecase-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--gray-800);
      margin-bottom: 12px;
    }

    .usecase-text {
      font-size: 20px;
      color: var(--gray-500);
      line-height: 1.8;
    }

    /* ======================================== 
       比較表 
       ======================================== */
    .compare-card {
      background: var(--white);
      border-radius: var(--radius-xl);
      overflow: hidden;
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-md);
    }

    .compare-header {
      padding: 24px 32px;
      font-size: 22px;
      font-weight: 700;
      color: var(--white);
      background: var(--gray-800);
    }

    .compare-body { padding: 32px; overflow-x: auto;
            padding-top: 70px;}

    .compare-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 20px;
    }

    .compare-table th {
      background: var(--gray-100);
      padding: 14px 18px;
      text-align: left;
      font-weight: 600;
      color: var(--gray-700);
      border-bottom: 2px solid var(--gray-200);
    }

    .compare-table td {
      padding: 14px 18px;
      border-bottom: 1px solid var(--gray-100);
      color: var(--gray-600);
    }

    .compare-table tr:last-child td { border-bottom: none; }

    /* ======================================== 
       FAQセクション 
       ======================================== */
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .faq-item {
      background: var(--white);
      border-radius: var(--radius-lg);
      border: 1px solid var(--gray-200);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }

    .faq-question {
      padding: 24px 32px;
      font-size: 20px;
      font-weight: 600;
      color: var(--gray-800);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 12px;
      user-select: none;
