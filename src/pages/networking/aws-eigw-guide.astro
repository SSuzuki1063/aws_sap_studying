const rawContent = `
<!-- Progress Bar -->
  <div class="progress-bar" id="progressBar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

  <!-- Header -->
  <header class="site-header">
    <h1><span>&#9656;</span> Egress-Only Internet Gateway 完全ガイド</h1>
  </header>

  <!-- Navigation -->
  <nav class="toc-nav" aria-label="目次ナビゲーション">
    <ul>
      <li><a href="#overview">概要</a></li>
      <li><a href="#analogy">たとえ話</a></li>
      <li><a href="#architecture">構成図</a></li>
      <li><a href="#features">特徴</a></li>
      <li><a href="#comparison">比較</a></li>
      <li><a href="#code">コード例</a></li>
      <li><a href="#bestpractice">ベストプラクティス</a></li>
      <li><a href="#troubleshoot">トラブルシュート</a></li>
      <li><a href="#exam">試験対策</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
  </nav>

  <!-- Main Content -->
  <main>
    <!-- ==============================
         Section 1: Hero / Key Takeaways
         ============================== -->
    <section class="hero">
      <div class="hero-badge">AWS VPC Networking &#8212; IPv6</div>
      <h2 id="overview">Egress-Only Internet Gateway（EIGW）とは？</h2>
      <p>IPv6のプライベートサブネットから「外に出る」通信だけを許可し、インターネットからの「入ってくる」通信をブロックするVPCコンポーネントです。IPv4のNAT Gatewayに相当する役割を、IPv6の世界で無料で提供します。</p>

      <div class="takeaways">
        <div class="takeaway-card">
          <div class="takeaway-num">1</div>
          <h3>IPv6専用の出口ゲート</h3>
          <p>IPv6トラフィックのみ対象。IPv4はNAT Gatewayを使う</p>
        </div>
        <div class="takeaway-card">
          <div class="takeaway-num">2</div>
          <h3>ステートフルに応答を返す</h3>
          <p>内部からのリクエストの応答は自動で通過させる</p>
        </div>
        <div class="takeaway-card">
          <div class="takeaway-num">3</div>
          <h3>利用料金は無料</h3>
          <p>EIGW自体の料金は不要。データ転送料のみ発生</p>
        </div>
        <div class="takeaway-card">
          <div class="takeaway-num">4</div>
          <h3>高可用性を標準装備</h3>
          <p>水平スケーリング・冗長化済み。AZ障害にも耐える</p>
        </div>
      </div>
    </section>

    <!-- ==============================
         Section 2: Analogy
         ============================== -->
    <section>
      <div class="section-header">
        <div class="section-icon" style="background:#FFF7ED;">&#128682;</div>
        <div>
          <h2 id="analogy">たとえ話：「出口専用の回転ドア」</h2>
          <p>マンションのセキュリティシステムでEIGWを理解する</p>
        </div>
      </div>

      <div class="analogy-banner">
        <h3>&#127970; マンションの「出口専用回転ドア」</h3>
        <p>あなたの住むマンションには、正面玄関（Internet Gateway）のほかに<strong>「出口専用の回転ドア」</strong>が設置されています。住人は外出できますが、外部の人はこのドアからは入れません。しかも、住人が出かけて帰ってくる（応答トラフィック）ときは、同じドアを通って戻れます。このドアは常に管理人が見張っていて（ステートフル）、「この人はさっき出て行った住人だな」と判断して通してくれるのです。</p>
      </div>

      <table class="analogy-table">
        <thead>
          <tr>
            <th></th>
            <th>マンションのたとえ</th>
            <th>AWS の実態</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="emoji-col">&#127970;</td>
            <td>マンション全体</td>
            <td>VPC（IPv6 CIDRブロック付き）</td>
          </tr>
          <tr>
            <td class="emoji-col">&#128694;</td>
            <td>住人（外に出たい）</td>
            <td>プライベートサブネット内のEC2インスタンス</td>
          </tr>
          <tr>
            <td class="emoji-col">&#128682;</td>
            <td>出口専用の回転ドア</td>
            <td>Egress-Only Internet Gateway</td>
          </tr>
          <tr>
            <td class="emoji-col">&#128374;</td>
            <td>正面玄関（出入り自由）</td>
            <td>Internet Gateway（双方向）</td>
          </tr>
          <tr>
            <td class="emoji-col">&#128101;</td>
            <td>外部の訪問者</td>
            <td>インターネット上のホスト</td>
          </tr>
          <tr>
            <td class="emoji-col">&#128221;</td>
            <td>管理人の外出記録帳</td>
            <td>ステートフル接続追跡</td>
          </tr>
          <tr>
            <td class="emoji-col">&#128270;</td>
            <td>フロアごとの入退室ルール</td>
            <td>ネットワークACL</td>
          </tr>
          <tr>
            <td class="emoji-col">&#128209;</td>
            <td>住人名簿の掲示板</td>
            <td>ルートテーブル（::/0 → eigw-id）</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- ==============================
         Section 3: Architecture Diagram
         ============================== -->
    <section>
      <div class="section-header">
        <div class="section-icon" style="background:#EEF2FF;">&#128421;</div>
        <div>
          <h2 id="architecture">アーキテクチャ図</h2>
          <p>EIGW を使ったデュアルスタック VPC の通信フロー</p>
        </div>
      </div>

      <!-- SVG Diagram 1: Overall Architecture -->
      <!--
        ノード配置表（EC2を縦積みにして矢印の交差・テキスト重なりを解消）
        ノード名                    | x      | y      | w    | h    | cx   | cy
        EC2 インスタンス A          | 100    | 175    | 270  | 80   | 235  | 215
        EC2 インスタンス B          | 100    | 275    | 270  | 80   | 235  | 315
        ルートテーブル              | 80     | 430    | 450  | 80   | 305  | 470
        NAT Gateway                 | 120    | 560    | 230  | 75   | 235  | 598
        Egress-Only IGW             | 750    | 160    | 230  | 120  | 865  | 220
        Internet Gateway            | 750    | 440    | 230  | 90   | 865  | 485
        Internet                    | 1080   | 340    | rx80 | ry50 | 1080 | 340
      -->
      <div class="diagram-container">
        <svg width="1340" height="720" viewBox="0 0 1340 720" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Egress-Only Internet Gatewayのアーキテクチャ図。VPC内のプライベートサブネットからEIGWを経由してインターネットへの一方向通信フローを示す。">
          <defs>
            <marker id="arrow-blue" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
              <path d="M0,0 L10,5 L0,10 Z" fill="#3B82F6"/>
            </marker>
            <marker id="arrow-green" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
              <path d="M0,0 L10,5 L0,10 Z" fill="#10B981"/>
            </marker>
            <marker id="arrow-red" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
              <path d="M0,0 L10,5 L0,10 Z" fill="#EF4444"/>
            </marker>
            <marker id="arrow-gray" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
              <path d="M0,0 L10,5 L0,10 Z" fill="#94A3B8"/>
            </marker>
            <filter id="shadow-soft" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#0F172A" flood-opacity="0.08"/>
            </filter>
            <style>
              .svg-title { font-family: Inter, Arial, sans-serif; font-size: 20px; font-weight: 700; fill: #0F172A; }
              .node-title { font-family: Inter, Arial, sans-serif; font-size: 16px; font-weight: 700; fill: #1E293B; }
              .node-sub { font-family: Inter, Arial, sans-serif; font-size: 13px; font-weight: 500; fill: #475569; }
              .label-text { font-family: Inter, Arial, sans-serif; font-size: 13px; font-weight: 600; fill: #3B82F6; }
              .label-green { font-family: Inter, Arial, sans-serif; font-size: 13px; font-weight: 600; fill: #10B981; }
              .label-red { font-family: Inter, Arial, sans-serif; font-size: 13px; font-weight: 600; fill: #EF4444; }
              .zone-label { font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 700; fill: #64748B; letter-spacing: 0.05em; }
            </style>
          </defs>

          <!-- Background -->
          <rect x="0" y="0" width="1340" height="720" fill="#F3F4F6"/>
          <!-- Outer Card -->
          <rect x="24" y="24" width="1292" height="672" rx="22" fill="#FFFFFF" filter="url(#shadow-soft)"/>
          <!-- Title -->
          <text x="670" y="66" text-anchor="middle" class="svg-title">EIGW を使ったデュアルスタック VPC 通信フロー</text>

          <!-- VPC boundary -->
          <rect x="50" y="88" width="660" height="580" rx="18" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="8,4"/>
          <text x="70" y="116" class="zone-label">VPC（10.0.0.0/16 + 2001:db8::/56）</text>

          <!-- Private Subnet (EC2を縦積み) -->
          <rect x="80" y="135" width="320" height="260" rx="14" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
          <text x="100" y="163" class="zone-label">プライベートサブネット</text>
          <text x="100" y="180" class="node-sub">10.0.1.0/24 + 2001:db8:1a00::/64</text>

          <!-- EC2 Instance A - cx=235, cy=215 -->
          <g>
            <rect x="100" y="195" width="270" height="70" rx="14" fill="#FFFFFF" stroke="#34D399" stroke-width="2"/>
            <text x="235" y="224" text-anchor="middle" dominant-baseline="middle" class="node-title">EC2 インスタンス A</text>
            <text x="235" y="248" text-anchor="middle" dominant-baseline="middle" class="node-sub">IPv4 + IPv6 アドレス</text>
          </g>

          <!-- EC2 Instance B - cx=235, cy=315 -->
          <g>
            <rect x="100" y="285" width="270" height="70" rx="14" fill="#FFFFFF" stroke="#34D399" stroke-width="2"/>
            <text x="235" y="314" text-anchor="middle" dominant-baseline="middle" class="node-title">EC2 インスタンス B</text>
            <text x="235" y="338" text-anchor="middle" dominant-baseline="middle" class="node-sub">IPv6-only</text>
          </g>

          <!-- Route Table - cx=305, cy=470 -->
          <g>
            <rect x="80" y="430" width="450" height="80" rx="14" fill="#FEFCE8" stroke="#FACC15" stroke-width="2"/>
            <text x="305" y="462" text-anchor="middle" dominant-baseline="middle" class="node-title">ルートテーブル</text>
            <text x="305" y="488" text-anchor="middle" dominant-baseline="middle" class="node-sub">::/0 → eigw-id ｜ 0.0.0.0/0 → nat-gw-id</text>
          </g>

          <!-- NAT Gateway - cx=235, cy=598 -->
          <g>
            <rect x="120" y="560" width="230" height="75" rx="14" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
            <text x="235" y="590" text-anchor="middle" dominant-baseline="middle" class="node-title">NAT Gateway</text>
            <text x="235" y="614" text-anchor="middle" dominant-baseline="middle" class="node-sub">IPv4 出口用</text>
          </g>

          <!-- ===================== 右側：ゲートウェイ群 ===================== -->

          <!-- EIGW - cx=865, cy=220 -->
          <g>
            <rect x="750" y="160" width="230" height="120" rx="16" fill="#EEF2FF" stroke="#818CF8" stroke-width="2.5"/>
            <text x="865" y="200" text-anchor="middle" dominant-baseline="middle" class="node-title">Egress-Only</text>
            <text x="865" y="222" text-anchor="middle" dominant-baseline="middle" class="node-title">Internet Gateway</text>
            <text x="865" y="258" text-anchor="middle" dominant-baseline="middle" class="node-sub">IPv6 出口専用 &#x1F512;</text>
          </g>

          <!-- IGW - cx=865, cy=485 -->
          <g>
            <rect x="750" y="440" width="230" height="90" rx="14" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
            <text x="865" y="478" text-anchor="middle" dominant-baseline="middle" class="node-title">Internet Gateway</text>
            <text x="865" y="504" text-anchor="middle" dominant-baseline="middle" class="node-sub">IPv4/IPv6 双方向</text>
          </g>

          <!-- Internet Cloud - cx=1200, cy=340 (右に120px移動して矢印間隔を確保) -->
          <g>
            <ellipse cx="1200" cy="340" rx="80" ry="55" fill="#FEF2F2" stroke="#F87171" stroke-width="2"/>
            <text x="1200" y="335" text-anchor="middle" dominant-baseline="middle" class="node-title">Internet</text>
            <text x="1200" y="360" text-anchor="middle" dominant-baseline="middle" class="node-sub">&#127760;</text>
          </g>

          <!-- ===================== 矢印（通信フロー） ===================== -->

          <!-- ① EC2 A → EIGW (IPv6 outbound) : 水平に右へ -->
          <path d="M370,225 L748,205" stroke="#3B82F6" stroke-width="2.5" fill="none" marker-end="url(#arrow-blue)"/>
          <text x="540" y="198" text-anchor="middle" class="label-text">&#9312; IPv6 送信リクエスト</text>

          <!-- ② EIGW → Internet (outbound) : 上段の経路 y=190 -->
          <path d="M980,190 L1118,300" stroke="#3B82F6" stroke-width="2.5" fill="none" marker-end="url(#arrow-blue)"/>
          <text x="1030" y="218" text-anchor="start" class="label-text">&#9313; 転送</text>

          <!-- 応答OK Internet → EIGW (response) : 中段の経路 y=250 -->
          <path d="M1120,330 L982,255" stroke="#10B981" stroke-width="2" fill="none" marker-end="url(#arrow-green)" stroke-dasharray="6,3"/>
          <text x="1030" y="270" text-anchor="start" class="label-green">応答OK</text>

          <!-- ③ EIGW → EC2 B (response return) : ノードを横断しない経路 -->
          <path d="M750,250 L372,318" stroke="#10B981" stroke-width="2" fill="none" marker-end="url(#arrow-green)" stroke-dasharray="6,3"/>
          <text x="555" y="268" text-anchor="middle" class="label-green">&#9314; 応答を返送</text>

          <!-- ✕ 外部起点 → EIGW (blocked inbound) : 下段の経路 y=370 -->
          <path d="M1120,365 L985,275" stroke="#EF4444" stroke-width="2.5" fill="none" stroke-dasharray="4,4"/>
          <text x="1050" y="340" text-anchor="start" class="label-red" style="font-size:20px;">&#128683;</text>
          <text x="1120" y="430" text-anchor="middle" class="label-red">&#10060; 外部起点はブロック</text>

          <!-- ===================== 経路線（グレー） ===================== -->

          <!-- Route Table → EIGW (IPv6 経路) -->
          <path d="M530,460 L748,240" stroke="#94A3B8" stroke-width="1.5" fill="none" marker-end="url(#arrow-gray)"/>
          <text x="660" y="370" text-anchor="middle" class="node-sub">IPv6</text>

          <!-- Route Table → NAT GW (IPv4 経路) -->
          <line x1="260" y1="510" x2="245" y2="558" stroke="#94A3B8" stroke-width="1.5" marker-end="url(#arrow-gray)"/>
          <text x="210" y="540" text-anchor="middle" class="node-sub">IPv4</text>

          <!-- NAT GW → IGW -->
          <path d="M350,598 L748,500" stroke="#94A3B8" stroke-width="1.5" fill="none" marker-end="url(#arrow-gray)" stroke-dasharray="6,3"/>

          <!-- IGW → Internet -->
          <line x1="980" y1="480" x2="1125" y2="380" stroke="#94A3B8" stroke-width="1.5" marker-end="url(#arrow-gray)"/>

          <!-- ===================== 凡例 ===================== -->
          <rect x="50" y="680" width="420" height="28" rx="6" fill="#F8FAFC"/>
          <line x1="70" y1="694" x2="100" y2="694" stroke="#3B82F6" stroke-width="2.5"/>
          <text x="108" y="699" class="node-sub" fill="#3B82F6">送信</text>
          <line x1="155" y1="694" x2="185" y2="694" stroke="#10B981" stroke-width="2" stroke-dasharray="6,3"/>
          <text x="193" y="699" class="node-sub" fill="#10B981">応答</text>
          <line x1="240" y1="694" x2="270" y2="694" stroke="#EF4444" stroke-width="2.5" stroke-dasharray="4,4"/>
          <text x="278" y="699" class="node-sub" fill="#EF4444">ブロック</text>
          <line x1="340" y1="694" x2="370" y2="694" stroke="#94A3B8" stroke-width="1.5"/>
          <text x="378" y="699" class="node-sub" fill="#94A3B8">経路</text>
        </svg>
      </div>

      <!-- SVG Diagram 2: Stateful Flow -->
      <!--
        ノード配置表（左右パネル共通で、ノード間を十分に空けてラベル重なりを解消）
        【左パネル(許可)】 パネル: x=50, w=560
          EC2:      x=80,  y=175, w=120, h=70, cx=140, cy=210
          EIGW:     x=270, y=175, w=140, h=70, cx=340, cy=210
          Internet: x=480, y=175, w=80,  h=70, cx=520, cy=210
          リクエスト矢印: y=195 (ノード中央上寄り)
          応答矢印:       y=225 (ノード中央下寄り)
          ラベル「リクエスト→」: y=170 (ノード上端より5px上)
          ラベル「←応答」:      y=260 (ノード下端より15px下)
        【右パネル(ブロック)】 パネル: x=640, w=540
          Internet: x=670, y=175, w=80,  h=70, cx=710, cy=210
          EIGW:     x=830, y=175, w=140, h=70, cx=900, cy=210
          EC2:      x=1050,y=175, w=120, h=70, cx=1110,cy=210
      -->
      <div class="diagram-container">
        <svg width="1200" height="480" viewBox="0 0 1200 480" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="EIGWのステートフル動作を示す図。内部からの通信とその応答が許可され、外部からの通信開始はブロックされる様子を示す。">
          <defs>
            <style>
              .flow-title { font-family: Inter, Arial, sans-serif; font-size: 18px; font-weight: 700; fill: #0F172A; }
              .flow-label { font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; }
              .flow-sub { font-family: Inter, Arial, sans-serif; font-size: 13px; fill: #64748B; }
            </style>
          </defs>

          <rect x="0" y="0" width="1200" height="480" fill="#F3F4F6"/>
          <rect x="24" y="24" width="1152" height="432" rx="22" fill="#FFFFFF" filter="url(#shadow-soft)"/>

          <text x="600" y="66" text-anchor="middle" class="svg-title">ステートフル動作：「出たら帰れる、でも外からは入れない」</text>

          <!-- ==================== 左パネル：許可パターン ==================== -->
          <rect x="50" y="90" width="560" height="280" rx="14" fill="#ECFDF5" stroke="#34D399" stroke-width="1.5"/>
          <text x="330" y="120" text-anchor="middle" class="flow-title" fill="#065F46">&#9989; 許可パターン：内部起点の通信</text>

          <!-- EC2 - cx=140, cy=210 -->
          <rect x="80" y="175" width="120" height="70" rx="12" fill="#FFFFFF" stroke="#34D399" stroke-width="2"/>
          <text x="140" y="205" text-anchor="middle" dominant-baseline="middle" class="node-title" style="font-size:14px;">EC2</text>
          <text x="140" y="228" text-anchor="middle" dominant-baseline="middle" class="node-sub" style="font-size:11px;">IPv6</text>

          <!-- EIGW - cx=340, cy=210 -->
          <rect x="270" y="175" width="140" height="70" rx="12" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
          <text x="340" y="205" text-anchor="middle" dominant-baseline="middle" class="node-title" style="font-size:14px;">EIGW</text>
          <text x="340" y="228" text-anchor="middle" dominant-baseline="middle" class="node-sub" style="font-size:11px;">&#x1F512; 出口専用</text>

          <!-- Internet - cx=520, cy=210 -->
          <rect x="480" y="175" width="80" height="70" rx="12" fill="#FEF2F2" stroke="#F87171" stroke-width="1.5"/>
          <text x="520" y="212" text-anchor="middle" dominant-baseline="middle" class="node-title" style="font-size:14px;">&#127760;</text>

