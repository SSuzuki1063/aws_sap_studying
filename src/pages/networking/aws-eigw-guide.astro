        <div>
          <h2 id="code">構成コード例</h2>
          <p>AWS CLI / CloudFormation / Terraform による EIGW 作成手順</p>
        </div>
      </div>

      <div class="code-section">
        <div class="code-tabs" role="tablist">
          <button class="code-tab active" role="tab" aria-selected="true" aria-controls="panel-cli" data-tab="cli">AWS CLI</button>
          <button class="code-tab" role="tab" aria-selected="false" aria-controls="panel-cfn" data-tab="cfn">CloudFormation</button>
