---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'AWS Egress-Only Internet Gateway 完全ガイド',
  pageTitle: 'AWS Egress-Only Internet Gateway 完全ガイド | IPv6出口専用ゲートウェイ',
  category: 'networking',
  categoryLabel: 'ネットワーキング',
  subcategory: 'VPC & ネットワーク基礎',
  slug: 'aws-eigw-guide',
  pageCss: '/aws_sap_studying/css/pages/aws-eigw-guide.css',
  tocItems: [
    { level: 'h2', id: 'overview', text: 'Egress-Only Internet Gateway（EIGW）とは？' },
    { level: 'h2', id: 'analogy', text: 'たとえ話：「出口専用の回転ドア」' },
    { level: 'h2', id: 'architecture', text: 'アーキテクチャ図' },
    { level: 'h2', id: 'features', text: 'EIGWの主要特徴' },
    { level: 'h2', id: 'comparison', text: 'EIGW vs NAT Gateway vs Internet Gateway 比較' },
    { level: 'h2', id: 'code', text: '構成コード例' },
    { level: 'h2', id: 'bestpractice', text: 'ベストプラクティス vs アンチパターン' },
    { level: 'h2', id: 'troubleshoot', text: 'トラブルシューティング' },
    { level: 'h2', id: 'exam', text: '試験対策ポイント' },
    { level: 'h2', id: 'faq', text: 'よくある質問（FAQ）' },
  ],
  prevPage: undefined,
