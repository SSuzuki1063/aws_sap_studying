            <text x="120" y="160" text-anchor="middle" font-size="16" font-weight="700" fill="#2563EB">0秒</text>
            <text x="120" y="215" text-anchor="middle" font-size="15" fill="#1E40AF">クエリ送信</text>

            <!-- Keepalive 1 at 300s -->
            <circle cx="360" cy="180" r="10" fill="#2563EB"/>
            <text x="360" y="160" text-anchor="middle" font-size="16" font-weight="700" fill="#2563EB">300秒</text>
            <text x="360" y="215" text-anchor="middle" font-size="15" fill="#1E40AF">Keepalive #1</text>
