          <svg viewBox="0 0 1100 360" xmlns="http://www.w3.org/2000/svg">
            <rect width="1100" height="360" fill="#FAFBFC"/>

            <text x="550" y="36" text-anchor="middle" font-size="22" font-weight="800" fill="#232F3E">TCP Keepalive による接続維持タイムライン</text>

            <!-- Timeline base -->
            <line x1="80" y1="180" x2="1040" y2="180" stroke="#CBD5E1" stroke-width="3"/>

            <!-- Query sent -->
