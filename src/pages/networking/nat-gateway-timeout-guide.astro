const frontmatter = {
  title: '',
  pageTitle: 'NAT ゲートウェイのタイムアウト動作 完全ガイド',
  category: 'networking',
  categoryLabel: 'ネットワーキング',
  subcategory: '',
  slug: 'nat-gateway-timeout-guide',
  pageCss: undefined,
  tocItems: [
