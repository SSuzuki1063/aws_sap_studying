const rawContent = `<style>/* ========================================
       CSS Custom Properties
       ======================================== */
    :root {
      --color-aws-dark: #232F3E;
      --color-aws-orange: #dc7600;
      --color-aws-orange-original: #FF9900;
      --color-text-primary: #374151;
      --color-text-secondary: #6B7280;
      --color-text-white: #FFFFFF;
      --color-bg-light: #F9FAFB;
      --color-bg-white: #FFFFFF;
      --color-success: #10B981;
      --color-warning: #F59E0B;
      --color-error: #EF4444;
      --color-info: #3B82F6;
      --color-border-light: #E5E7EB;
      --color-timeout: #8B5CF6;
      --color-rst: #DC2626;
      --color-fin: #059669;
      --color-keepalive: #2563EB;
      --shadow-sm: 0 2px 4px rgba(0,0,0,0.06);
      --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
      --shadow-lg: 0 10px 40px rgba(0,0,0,0.12);
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --radius-xl: 20px;
      --font-main: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', sans-serif;
      --transition-base: 0.3s ease;
    }

    /* ========================================
       Reset & Base
       ======================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-main);
      font-size: 20px;
      line-height: 1.8;
      color: var(--color-text-primary);
      background: var(--color-bg-light);
            padding-top: 70px;}

    /* ========================================
       Layout Container
       ======================================== */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ========================================
       Hero Section
       ======================================== */
    .hero {
      background: linear-gradient(135deg, var(--color-aws-dark) 0%, #37475A 50%, #485769 100%);
      color: var(--color-text-white);
      padding: 60px 24px 50px;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,153,0,0.08) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-inner {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(255,153,0,0.15);
      border: 1px solid rgba(255,153,0,0.3);
      color: var(--color-aws-orange-original);
      padding: 6px 18px;
      border-radius: 30px;
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 0.05em;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: 40px;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 16px;
    }

    .hero-subtitle {
      font-size: 22px;
      color: rgba(255,255,255,0.8);
      max-width: 700px;
      line-height: 1.6;
    }

    /* ========================================
       Conclusion First Section
       ======================================== */
    .conclusion-first {
      background: var(--color-bg-white);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
      margin: -30px auto 50px;
      padding: 40px;
      max-width: 1200px;
      position: relative;
      z-index: 2;
    }

    .conclusion-first h2 {
      font-size: 26px;
      font-weight: 700;
      color: var(--color-aws-dark);
      margin-bottom: 28px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .conclusion-first h2 .emoji {
      font-size: 30px;
    }

    .takeaway-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .takeaway-card {
      background: var(--color-bg-light);
      border-radius: var(--radius-md);
      padding: 24px;
      border-left: 5px solid;
      transition: transform var(--transition-base), box-shadow var(--transition-base);
    }

    .takeaway-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .takeaway-card:nth-child(1) { border-left-color: var(--color-error); }
    .takeaway-card:nth-child(2) { border-left-color: var(--color-timeout); }
    .takeaway-card:nth-child(3) { border-left-color: var(--color-keepalive); }
    .takeaway-card:nth-child(4) { border-left-color: var(--color-success); }

    .takeaway-card .card-num {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 8px;
    }

    .takeaway-card:nth-child(1) .card-num { color: var(--color-error); }
    .takeaway-card:nth-child(2) .card-num { color: var(--color-timeout); }
    .takeaway-card:nth-child(3) .card-num { color: var(--color-keepalive); }
    .takeaway-card:nth-child(4) .card-num { color: var(--color-success); }

    .takeaway-card .card-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--color-aws-dark);
      margin-bottom: 8px;
    }

    .takeaway-card .card-desc {
      font-size: 20px;
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    /* ========================================
       Section Common
       ======================================== */
    .content-section {
      max-width: 1200px;
      margin: 0 auto 50px;
      padding: 0 24px;
    }

    .section-card {
      background: var(--color-bg-white);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-sm);
      padding: 44px;
      transition: box-shadow var(--transition-base);
    }

    .section-card:hover {
      box-shadow: var(--shadow-md);
    }

    .section-label {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .section-card h2 {
      font-size: 28px;
      font-weight: 800;
      color: var(--color-aws-dark);
      margin-bottom: 24px;
      line-height: 1.4;
    }

    .section-card h3 {
      font-size: 23px;
      font-weight: 700;
      color: var(--color-aws-dark);
      margin-bottom: 16px;
    }

    .section-card p {
      font-size: 20px;
      line-height: 1.8;
      color: var(--color-text-primary);
      margin-bottom: 20px;
    }

    /* ========================================
       Analogy Section
       ======================================== */
    .analogy-intro {
      background: linear-gradient(135deg, #FFF7ED 0%, #FEF3C7 100%);
      border-radius: var(--radius-lg);
      padding: 30px;
      margin-bottom: 32px;
      border: 1px solid #FDE68A;
    }

    .analogy-intro p {
      font-size: 22px;
      font-weight: 600;
      color: #92400E;
      margin-bottom: 0;
    }

    .analogy-table-wrap {
      overflow-x: auto;
      margin-bottom: 32px;
    }

    .analogy-table {
      width: 100%;
      border-collapse: collapse;
      border-radius: var(--radius-md);
      overflow: hidden;
      font-size: 20px;
    }

    .analogy-table thead {
      background: var(--color-aws-dark);
      color: var(--color-text-white);
    }

    .analogy-table th {
      padding: 16px 24px;
      text-align: left;
      font-weight: 700;
      font-size: 20px;
    }

    .analogy-table td {
      padding: 16px 24px;
      border-bottom: 1px solid var(--color-border-light);
      font-size: 20px;
      vertical-align: top;
    }

    .analogy-table tbody tr:nth-child(even) {
      background: var(--color-bg-light);
    }

    .analogy-table tbody tr:hover {
      background: #FFF7ED;
    }

    /* ========================================
       SVG Diagram Containers
       ======================================== */
    .diagram-wrapper {
      margin: 32px 0;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: var(--color-bg-light);
      border: 1px solid var(--color-border-light);
    }

    .diagram-wrapper svg {
      display: block;
      width: 100%;
      height: auto;
    }

    .diagram-caption {
      font-size: 18px;
      color: var(--color-text-secondary);
      text-align: center;
      padding: 12px;
      background: var(--color-bg-white);
      border-top: 1px solid var(--color-border-light);
      font-weight: 500;
    }

    /* ========================================
       Timeline / Lifecycle
       ======================================== */
    .lifecycle-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin: 28px 0;
    }

    .lifecycle-step {
      background: var(--color-bg-light);
      border-radius: var(--radius-md);
      padding: 24px 20px;
      text-align: center;
      position: relative;
      border-top: 4px solid;
      transition: transform var(--transition-base), box-shadow var(--transition-base);
    }

    .lifecycle-step:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }

    .lifecycle-step:nth-child(1) { border-top-color: var(--color-info); }
    .lifecycle-step:nth-child(2) { border-top-color: var(--color-success); }
    .lifecycle-step:nth-child(3) { border-top-color: var(--color-warning); }
    .lifecycle-step:nth-child(4) { border-top-color: var(--color-error); }

    .lifecycle-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      font-size: 20px;
      font-weight: 800;
      color: var(--color-text-white);
      margin-bottom: 12px;
    }

    .lifecycle-step:nth-child(1) .lifecycle-num { background: var(--color-info); }
    .lifecycle-step:nth-child(2) .lifecycle-num { background: var(--color-success); }
    .lifecycle-step:nth-child(3) .lifecycle-num { background: var(--color-warning); }
    .lifecycle-step:nth-child(4) .lifecycle-num { background: var(--color-error); }

    .lifecycle-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--color-aws-dark);
      margin-bottom: 8px;
    }

    .lifecycle-desc {
      font-size: 18px;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Arrow between steps */
    .lifecycle-step:not(:last-child)::after {
      content: '→';
      position: absolute;
      right: -16px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 24px;
      color: var(--color-text-secondary);
      z-index: 1;
    }

    /* ========================================
       Comparison: FIN vs RST
       ======================================== */
    .compare-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin: 28px 0;
    }

    .compare-card {
      border-radius: var(--radius-lg);
      padding: 32px;
      border: 2px solid;
      position: relative;
    }

    .compare-card--fin {
      background: #ECFDF5;
      border-color: #A7F3D0;
    }

    .compare-card--rst {
      background: #FEF2F2;
      border-color: #FECACA;
    }

    .compare-label {
      display: inline-block;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 4px 14px;
      border-radius: 20px;
      margin-bottom: 16px;
    }

    .compare-card--fin .compare-label {
      background: #059669;
      color: white;
    }

    .compare-card--rst .compare-label {
      background: #DC2626;
      color: white;
    }

    .compare-card h3 {
      margin-bottom: 12px;
    }

    .compare-card--fin h3 { color: #065F46; }
    .compare-card--rst h3 { color: #991B1B; }

    .compare-card p {
      font-size: 20px;
      line-height: 1.7;
    }

    .compare-card--fin p { color: #047857; }
    .compare-card--rst p { color: #B91C1C; }

    .compare-emoji {
      font-size: 48px;
      margin-bottom: 12px;
      display: block;
    }

    /* ========================================
       Highlight Boxes
       ======================================== */
    .highlight-box {
      border-radius: var(--radius-md);
      padding: 24px 28px;
      margin: 24px 0;
      font-size: 20px;
      line-height: 1.7;
    }

    .highlight-box--warning {
      background: #FEF3C7;
      border-left: 5px solid #F59E0B;
      color: #92400E;
    }

    .highlight-box--danger {
      background: #FEE2E2;
      border-left: 5px solid #EF4444;
      color: #991B1B;
    }

    .highlight-box--info {
      background: #EFF6FF;
      border-left: 5px solid #3B82F6;
      color: #1E40AF;
    }

    .highlight-box--success {
      background: #ECFDF5;
      border-left: 5px solid #10B981;
      color: #065F46;
    }

    .highlight-box strong {
      font-weight: 700;
    }

    /* ========================================
       Code Block
       ======================================== */
    .code-block-wrap {
      margin: 24px 0;
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .code-block-header {
      background: var(--color-aws-dark);
      color: rgba(255,255,255,0.7);
      padding: 12px 20px;
      font-size: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .code-block-header .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .code-block-header .dot--red { background: #EF4444; }
    .code-block-header .dot--yellow { background: #F59E0B; }
    .code-block-header .dot--green { background: #10B981; }

    .code-block {
      background: #1a1f2e;
      color: #E2E8F0;
      padding: 24px;
      overflow-x: auto;
      font-family: 'Fira Code', 'Consolas', 'Monaco', monospace;
      font-size: 18px;
      line-height: 1.7;
    }

    .code-block .comment { color: #6B7280; }
    .code-block .keyword { color: #93C5FD; }
    .code-block .value { color: #FCA5A5; }
    .code-block .string { color: #86EFAC; }

    /* ========================================
       Solution Section
       ======================================== */
    .solution-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin: 28px 0;
    }

    .solution-card {
      background: var(--color-bg-light);
      border-radius: var(--radius-lg);
      padding: 28px;
      border: 2px solid var(--color-border-light);
      transition: border-color var(--transition-base), box-shadow var(--transition-base);
    }

    .solution-card:hover {
      border-color: var(--color-keepalive);
      box-shadow: var(--shadow-md);
    }

    .solution-card .solution-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--color-keepalive);
      color: white;
      font-size: 18px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .solution-card h3 {
      font-size: 22px;
      color: var(--color-aws-dark);
      margin-bottom: 10px;
    }

    .solution-card p {
      font-size: 20px;
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    /* ========================================
       Number Comparison Visual
       ======================================== */
    .number-compare {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin: 28px 0;
      align-items: center;
    }

    .number-box {
      text-align: center;
      padding: 28px 20px;
      border-radius: var(--radius-lg);
    }

    .number-box--danger {
      background: #FEE2E2;
      border: 2px solid #FECACA;
    }

    .number-box--ok {
      background: #ECFDF5;
      border: 2px solid #A7F3D0;
    }

    .number-box--target {
      background: #EFF6FF;
      border: 2px solid #BFDBFE;
    }

    .number-big {
      font-size: 42px;
      font-weight: 900;
      line-height: 1.2;
    }

    .number-box--danger .number-big { color: var(--color-error); }
    .number-box--ok .number-big { color: var(--color-success); }
    .number-box--target .number-big { color: var(--color-keepalive); }

    .number-label {
      font-size: 20px;
      font-weight: 600;
      margin-top: 4px;
    }

    .number-sub {
      font-size: 18px;
      color: var(--color-text-secondary);
      margin-top: 4px;
    }

    /* ========================================
       FAQ Accordion
       ======================================== */
    .faq-list {
      margin: 24px 0;
    }

    .faq-item {
      border: 1px solid var(--color-border-light);
      border-radius: var(--radius-md);
      margin-bottom: 12px;
      overflow: hidden;
      transition: box-shadow var(--transition-base);
    }

    .faq-item:hover {
      box-shadow: var(--shadow-sm);
    }

    .faq-question {
      width: 100%;
      background: var(--color-bg-white);
      border: none;
      padding: 20px 24px;
      font-size: 20px;
      font-weight: 700;
      color: var(--color-aws-dark);
      text-align: left;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-main);
      transition: background var(--transition-base);
    }

    .faq-question:hover {
      background: var(--color-bg-light);
    }

    .faq-question::after {
      content: '+';
      font-size: 24px;
      font-weight: 700;
      color: var(--color-aws-orange);
      transition: transform var(--transition-base);
      flex-shrink: 0;
      margin-left: 16px;
    }

    .faq-item.active .faq-question::after {
      content: '−';
    }

    .faq-answer {
      display: none;
      padding: 0 24px 20px;
      font-size: 20px;
      line-height: 1.8;
      color: var(--color-text-secondary);
      background: var(--color-bg-white);
    }

    .faq-item.active .faq-answer {
      display: block;
    }

    /* ========================================
       Footer
       ======================================== */
    .page-footer {
      background: var(--color-aws-dark);
      color: rgba(255,255,255,0.6);
      text-align: center;
      padding: 30px 24px;
      font-size: 18px;
      margin-top: 60px;
    }

    /* ========================================
       Responsive
       ======================================== */
    @media (max-width: 768px) {
      .hero h1 { font-size: 28px; }
      .hero-subtitle { font-size: 18px; }
      .takeaway-grid,
      .compare-grid,
      .solution-grid,
      .number-compare {
        grid-template-columns: 1fr;
      }
      .lifecycle-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .lifecycle-step:not(:last-child)::after { display: none; }
      .section-card { padding: 28px; }
      .conclusion-first { padding: 28px; margin: -20px 16px 40px; }
    }</style>
