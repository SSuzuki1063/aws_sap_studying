    <!-- ==================== How Timeout Works ==================== -->
    <section class="content-section" aria-label="タイムアウトの仕組み">
      <div class="section-card">
        <div class="section-label" style="color: var(--color-error);">Mechanism</div>
        <h2 id="⏱️-NAT-ゲートウェイのタイムアウト動作"><span aria-hidden="true">⏱️</span> NAT ゲートウェイのタイムアウト動作</h2>

        <p>NAT ゲートウェイは、プライベートサブネットのリソースがインターネットに通信する際の出口となるサービスです。内部的に接続の追跡テーブル（コネクショントラッキング）を維持しますが、リソース管理のために<strong>350秒間データ転送がない接続を自動的に終了</strong>させます。</p>

        <!-- Timeout Flow Diagram -->
        <div class="diagram-wrapper" role="img" aria-label="NAT ゲートウェイのタイムアウト発生フロー図">
          <svg viewBox="0 0 1100 480" xmlns="http://www.w3.org/2000/svg">
            <rect width="1100" height="480" fill="#FAFBFC"/>

            <text x="550" y="36" text-anchor="middle" font-size="22" font-weight="800" fill="#232F3E">タイムアウト発生フロー</text>

            <!-- Client Box -->
            <rect x="40" y="60" width="200" height="80" rx="12" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="2"/>
            <text x="140" y="95" text-anchor="middle" font-size="18" font-weight="700" fill="#1E40AF">クライアント</text>
            <text x="140" y="120" text-anchor="middle" font-size="16" fill="#3B82F6">EC2 / Lambda</text>

            <!-- NAT Gateway Box -->
            <rect x="400" y="60" width="240" height="80" rx="12" fill="#FFF7ED" stroke="#FDE68A" stroke-width="2"/>
            <text x="520" y="95" text-anchor="middle" font-size="18" font-weight="700" fill="#92400E">NAT ゲートウェイ</text>
            <text x="520" y="120" text-anchor="middle" font-size="16" fill="#B45309">接続テーブル管理</text>

            <!-- Server Box -->
            <rect x="810" y="60" width="220" height="80" rx="12" fill="#ECFDF5" stroke="#A7F3D0" stroke-width="2"/>
            <text x="920" y="95" text-anchor="middle" font-size="18" font-weight="700" fill="#065F46">外部サーバー</text>
            <text x="920" y="120" text-anchor="middle" font-size="16" fill="#047857">DB / API</text>

            <!-- Step 1: Long Query -->
            <text x="30" y="178" font-size="18" font-weight="700" fill="#2563EB">① 長時間クエリ送信</text>
            <line x1="240" y1="185" x2="400" y2="185" stroke="#2563EB" stroke-width="2.5" marker-end="url(#arrow-blue)"/>
            <line x1="640" y1="185" x2="810" y2="185" stroke="#2563EB" stroke-width="2.5" marker-end="url(#arrow-blue)"/>
            <text x="520" y="205" text-anchor="middle" font-size="16" fill="#3B82F6">リクエスト転送 →</text>

            <!-- Step 2: Idle -->
            <text x="30" y="260" font-size="18" font-weight="700" fill="#F59E0B">② アイドル状態 350秒経過…</text>
            <rect x="335" y="235" width="370" height="44" rx="8" fill="#FEF3C7" stroke="#FDE68A" stroke-width="1.5"/>
            <text x="520" y="263" text-anchor="middle" font-size="17" font-weight="600" fill="#92400E">⏱ 350秒間 データ転送なし ⏱</text>

            <!-- Step 3: Timeout -->
            <text x="30" y="328" font-size="18" font-weight="700" fill="#DC2626">③ タイムアウト発生！</text>
            <rect x="395" y="298" width="250" height="44" rx="8" fill="#DC2626"/>
            <text x="520" y="326" text-anchor="middle" font-size="17" font-weight="700" fill="white">接続テーブルからエントリ削除</text>
            <text x="520" y="362" text-anchor="middle" font-size="16" fill="#DC2626">IdleTimeoutCount メトリクス +1</text>

            <!-- Step 4: RST -->
