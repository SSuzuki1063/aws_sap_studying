            <div class="number-big">7,200秒</div>
            <div class="number-label">Linux デフォルト Keepalive</div>
            <div class="number-sub">約2時間（長すぎる！）</div>
          </div>
          <div class="number-box number-box--ok">
            <div class="number-big">350秒</div>
            <div class="number-label">NAT GW タイムアウト</div>
            <div class="number-sub">約5分50秒（固定値）</div>
          </div>
          <div class="number-box number-box--target">
            <div class="number-big">300秒</div>
            <div class="number-label">推奨 Keepalive 設定</div>
            <div class="number-sub">350秒よりも短く設定</div>
          </div>
        </div>

        <!-- Keepalive Diagram -->
