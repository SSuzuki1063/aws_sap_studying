            <line x1="400" y1="410" x2="240" y2="410" stroke="#DC2626" stroke-width="3" stroke-dasharray="8,4" marker-end="url(#arrow-red)"/>
            <rect x="255" y="395" width="130" height="30" rx="6" fill="#DC2626"/>
            <text x="320" y="416" text-anchor="middle" font-size="15" font-weight="700" fill="white">RST パケット</text>

            <!-- Step 5: Response Lost -->
            <text x="30" y="460" font-size="18" font-weight="700" fill="#991B1B">⑤ レスポンスがロスト</text>
            <line x1="810" y1="455" x2="648" y2="455" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrow-green)"/>
            <text x="730" y="448" text-anchor="middle" font-size="15" fill="#047857">応答データ</text>
            <text x="580" y="462" text-anchor="middle" font-size="30" fill="#DC2626">✕</text>
            <text x="520" y="475" text-anchor="middle" font-size="15" fill="#991B1B">接続なし → 破棄</text>

