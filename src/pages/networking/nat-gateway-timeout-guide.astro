    { level: 'h2', id: '☕-喫茶店のたとえで理解する', text: '☕ 喫茶店のたとえで理解する' },
    { level: 'h2', id: '⏱️-NAT-ゲートウェイのタイムアウト動作', text: '⏱️ NAT ゲートウェイのタイムアウト動作' },
    { level: 'h2', id: 'FIN-パケット-vs-RST-パケット', text: '🔄 FIN パケット vs RST パケット' },
