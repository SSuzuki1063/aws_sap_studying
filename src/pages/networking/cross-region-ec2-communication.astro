---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: '',
  pageTitle: 'クロスリージョンEC2通信アーキテクチャ &amp; トラブルシューティング完全ガイド',
  category: 'networking',
  categoryLabel: 'ネットワーキング',
  subcategory: '',
  slug: 'cross-region-ec2-communication',
  pageCss: undefined,
  tocItems: [
    { level: 'h2', id: '&#x1F4EE;-国際郵便システムでたとえると超わかりやすい！', text: '&#x1F4EE; 国際郵便システムでたとえると超わかりやすい！' },
    { level: 'h2', id: '&#x1F5FA;&#xFE0F;-全体アーキテクチャ図', text: '&#x1F5FA;&#xFE0F; 全体アーキテクチャ図' },
    { level: 'h2', id: '&#x1F517;-3つの接続パターン', text: '&#x1F517; 3つの接続パターン' },
    { level: 'h2', id: '&#x1F6E0;&#xFE0F;-VPCピアリング構築の5ステップ', text: '&#x1F6E0;&#xFE0F; VPCピアリング構築の5ステップ' },
    { level: 'h2', id: '&#x26A0;&#xFE0F;-CIDR設計の最重要ルール', text: '&#x26A0;&#xFE0F; CIDR設計の最重要ルール' },
    { level: 'h2', id: '&#x1F50D;-トラブルシューティング-5つの関所チェック', text: '&#x1F50D; トラブルシューティング：5つの関所チェック' },
    { level: 'h2', id: '&#x1F4CB;-5つの関所チェックリスト詳細', text: '&#x1F4CB; 5つの関所チェックリスト詳細' },
    { level: 'h3', id: '関所-①-ルートテーブル-─-配達ルート表', text: '関所 ① ルートテーブル ─ 「配達ルート表」' },
    { level: 'h3', id: '関所-②-セキュリティグループ-─-建物のガードマン', text: '関所 ② セキュリティグループ ─ 「建物のガードマン」' },
    { level: 'h3', id: '関所-③-NACL-─-都市の入国管理局', text: '関所 ③ NACL ─ 「都市の入国管理局」' },
    { level: 'h3', id: '関所-④-DNS解決-─-住所録サービス', text: '関所 ④ DNS解決 ─ 「住所録サービス」' },
    { level: 'h3', id: '関所-⑤-アプリケーション-─-宛先の部屋番号', text: '関所 ⑤ アプリケーション ─ 「宛先の部屋番号」' },
    { level: 'h2', id: '&#x1F4BB;-実践トラブルシューティングコマンド', text: '&#x1F4BB; 実践トラブルシューティングコマンド' },
    { level: 'h2', id: '&#x1F9F0;-AWS公式トラブルシューティングツール', text: '&#x1F9F0; AWS公式トラブルシューティングツール' },
    { level: 'h2', id: '&#x2753;-よくある質問FAQ', text: '&#x2753; よくある質問（FAQ）' },
    { level: 'h2', id: '&#x1F3C1;-まとめ-覚えておくべきポイント', text: '&#x1F3C1; まとめ：覚えておくべきポイント' }
  ],
  prevPage: undefined,
  nextPage: undefined,
  pageNum: 1,
  pageTotal: 1,
};

const rawContent = `<style>/* ========================================
       CSS Variables
       ======================================== */
    :root {
      --color-aws-dark: #232F3E;
      --color-aws-orange: #dc7600;
      --color-aws-orange-original: #FF9900;
      --color-text-primary: #374151;
      --color-text-secondary: #6B7280;
      --color-text-white: #FFFFFF;
      --color-bg-light: #F9FAFB;
      --color-bg-white: #FFFFFF;
      --color-border-light: #E5E7EB;
      --color-success: #10B981;
      --color-warning: #F59E0B;
      --color-error: #EF4444;
      --color-info: #3B82F6;
      --color-region-a: #3B82F6;
      --color-region-b: #8B5CF6;
      --color-peering: #EC4899;
      --color-tgw: #06B6D4;
      --color-vpn: #F97316;
      --font-size-body: 20px;
      --font-size-h1: 42px;
      --font-size-h2: 30px;
      --font-size-h3: 24px;
      --font-size-small: 20px;
      --font-size-label: 20px;
      --spacing-xs: 5px;
      --spacing-sm: 10px;
      --spacing-md: 15px;
      --spacing-base: 20px;
      --spacing-lg: 25px;
      --spacing-xl: 30px;
      --spacing-2xl: 40px;
      --spacing-3xl: 60px;
      --radius-sm: 6px;
      --radius-md: 8px;
      --radius-base: 10px;
      --radius-lg: 15px;
      --radius-xl: 20px;
      --shadow-sm: 0 2px 4px rgba(0,0,0,0.08);
      --shadow-md: 0 4px 12px rgba(0,0,0,0.1);
      --shadow-lg: 0 10px 40px rgba(0,0,0,0.12);
    }

    /* ========================================
       Reset & Base
       ======================================== */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-size: var(--font-size-body);
      line-height: 1.7;
      color: var(--color-text-primary);
      background-color: #F3F4F6;
      padding: var(--spacing-base);
            padding-top: 70px;}

    /* ========================================
       Layout Container
       ======================================== */
    .page-container {
      max-width: 1200px;
      margin: 0 auto;
      background: var(--color-bg-white);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
    }

    /* ========================================
       Header
       ======================================== */
    .page-header {
      background: linear-gradient(135deg, var(--color-aws-dark) 0%, #37475A 100%);
      color: var(--color-text-white);
      padding: var(--spacing-3xl) var(--spacing-2xl) var(--spacing-2xl);
      text-align: center;
      position: relative;
    }
    .page-header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--color-region-a), var(--color-peering), var(--color-region-b));
    }
    .header-badge {
      display: inline-block;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 30px;
      padding: 6px 20px;
      font-size: var(--font-size-small);
      margin-bottom: var(--spacing-base);
      letter-spacing: 0.5px;
    }
    .page-header h1 {
      font-size: var(--font-size-h1);
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: var(--spacing-sm);
    }
    .header-sub {
      font-size: var(--font-size-small);
      opacity: 0.85;
      max-width: 700px;
      margin: 0 auto;
    }

    /* ========================================
       Content Area
       ======================================== */
    .content {
      padding: var(--spacing-2xl);
    }

    /* ========================================
       Section Common
       ======================================== */
    .section-block {
      margin-bottom: var(--spacing-3xl);
    }
    .section-heading {
      font-size: var(--font-size-h2);
      font-weight: 700;
      color: var(--color-aws-dark);
      margin-bottom: var(--spacing-lg);
      padding-bottom: var(--spacing-sm);
      border-bottom: 3px solid var(--color-aws-orange);
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }
    .section-heading .icon {
      font-size: 28px;
    }
    .sub-heading {
      font-size: var(--font-size-h3);
      font-weight: 600;
      color: var(--color-aws-dark);
      margin-bottom: var(--spacing-base);
      margin-top: var(--spacing-xl);
    }
    .intro-text {
      font-size: var(--font-size-body);
      color: var(--color-text-secondary);
      margin-bottom: var(--spacing-lg);
      line-height: 1.8;
    }

    /* ========================================
       Conclusion First (結論ファースト)
       ======================================== */
    .conclusion-first {
      background: linear-gradient(135deg, #FFF7ED 0%, #FFFBEB 100%);
      border: 2px solid #FBBF24;
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      margin-bottom: var(--spacing-2xl);
    }
    .conclusion-first-title {
      font-size: var(--font-size-h3);
      font-weight: 700;
      color: #92400E;
      margin-bottom: var(--spacing-sm);
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }
    .conclusion-first p {
      font-size: var(--font-size-body);
      color: #78350F;
      line-height: 1.8;
    }

    /* ========================================
       Analogy Box
       ======================================== */
    .analogy-box {
      background: linear-gradient(135deg, #EFF6FF 0%, #F0F9FF 100%);
      border-left: 5px solid var(--color-info);
      border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
      padding: var(--spacing-lg);
      margin-bottom: var(--spacing-2xl);
    }
    .analogy-title {
      font-size: var(--font-size-h3);
      font-weight: 700;
      color: #1E40AF;
      margin-bottom: var(--spacing-sm);
    }
    .analogy-box p {
      font-size: var(--font-size-body);
      color: #1E3A5F;
      line-height: 1.8;
    }

    /* ========================================
       Equal Grid Cards
       ======================================== */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-lg);
    }
    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-lg);
    }
    .grid-4 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-lg);
    }
    .card {
      background: var(--color-bg-white);
      border: 1px solid var(--color-border-light);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
    .card-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-md);
    }
    .card-icon {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-base);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }
    .card-title {
      font-size: var(--font-size-h3);
      font-weight: 600;
      color: var(--color-aws-dark);
    }
    .card p, .card li {
      font-size: var(--font-size-body);
      line-height: 1.7;
    }

    /* Card color variants */
    .card-blue { border-top: 4px solid var(--color-region-a); }
    .card-blue .card-icon { background: #DBEAFE; color: #2563EB; }
    .card-purple { border-top: 4px solid var(--color-region-b); }
    .card-purple .card-icon { background: #EDE9FE; color: #7C3AED; }
    .card-orange { border-top: 4px solid var(--color-aws-orange); }
    .card-orange .card-icon { background: #FFF7ED; color: #EA580C; }
    .card-green { border-top: 4px solid var(--color-success); }
    .card-green .card-icon { background: #D1FAE5; color: #059669; }
    .card-cyan { border-top: 4px solid var(--color-tgw); }
    .card-cyan .card-icon { background: #CFFAFE; color: #0891B2; }
    .card-pink { border-top: 4px solid var(--color-peering); }
    .card-pink .card-icon { background: #FCE7F3; color: #DB2777; }

    /* ========================================
       Mapping Table (Analogy ↔ AWS)
       ======================================== */
    .mapping-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: var(--spacing-lg);
      border-radius: var(--radius-base);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .mapping-table th,
    .mapping-table td {
      padding: var(--spacing-md) var(--spacing-base);
      font-size: var(--font-size-body);
      text-align: left;
      border-bottom: 1px solid var(--color-border-light);
    }
    .mapping-table th {
      background: var(--color-aws-dark);
      color: var(--color-text-white);
      font-weight: 600;
    }
    .mapping-table tr:nth-child(even) td {
      background: var(--color-bg-light);
    }
    .mapping-table tr:hover td {
      background: #FFF7ED;
    }
    .mapping-table td:first-child {
      font-weight: 500;
    }

    /* ========================================
       SVG Diagram Container
       ======================================== */
    .diagram-container {
      background: var(--color-bg-light);
      border: 1px solid var(--color-border-light);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      margin-bottom: var(--spacing-lg);
      text-align: center;
    }
    .diagram-caption {
      font-size: var(--font-size-body);
      color: var(--color-text-secondary);
      margin-top: var(--spacing-sm);
      text-align: center;
    }

    /* ========================================
       Step Flow (横並びステップ)
       ======================================== */
    .step-flow {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--spacing-base);
      margin-bottom: var(--spacing-lg);
    }
    .step-item {
      background: var(--color-bg-white);
      border: 1px solid var(--color-border-light);
      border-radius: var(--radius-lg);
      padding: var(--spacing-base);
      text-align: center;
      position: relative;
      box-shadow: var(--shadow-sm);
    }
    .step-number {
      width: 40px;
      height: 40px;
      background: var(--color-aws-dark);
      color: var(--color-text-white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--font-size-body);
      font-weight: 700;
      margin: 0 auto var(--spacing-sm);
    }
    .step-title {
      font-size: var(--font-size-body);
      font-weight: 600;
      color: var(--color-aws-dark);
      margin-bottom: var(--spacing-xs);
    }
    .step-desc {
      font-size: var(--font-size-body);
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* ========================================
       Troubleshooting Checklist
       ======================================== */
    .checklist {
      list-style: none;
      margin-bottom: var(--spacing-lg);
    }
    .checklist li {
      font-size: var(--font-size-body);
      padding: var(--spacing-md) var(--spacing-base);
      border-bottom: 1px solid var(--color-border-light);
      display: flex;
      align-items: flex-start;
      gap: var(--spacing-sm);
      line-height: 1.7;
    }
    .checklist li:last-child {
      border-bottom: none;
    }
    .check-icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      margin-top: 3px;
    }
    .check-error { background: #FEE2E2; color: var(--color-error); }
    .check-warn { background: #FEF3C7; color: #D97706; }
    .check-ok { background: #D1FAE5; color: var(--color-success); }

    /* ========================================
       Comparison Table (Before/After)
       ======================================== */
    .comparison-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-lg);
    }
    .comparison-box {
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      box-shadow: var(--shadow-sm);
    }
    .comparison-box.before {
      background: #FEF2F2;
      border: 2px solid #FECACA;
    }
    .comparison-box.after {
      background: #F0FDF4;
      border: 2px solid #BBF7D0;
    }
    .comparison-label {
      font-size: var(--font-size-h3);
      font-weight: 700;
      margin-bottom: var(--spacing-sm);
    }
    .comparison-box.before .comparison-label { color: var(--color-error); }
    .comparison-box.after .comparison-label { color: var(--color-success); }
    .comparison-box p {
      font-size: var(--font-size-body);
      line-height: 1.7;
    }

    /* ========================================
       Highlight Badge
       ======================================== */
    .badge {
      display: inline-block;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: var(--font-size-small);
      font-weight: 600;
    }
    .badge-blue { background: #DBEAFE; color: #1D4ED8; }
    .badge-purple { background: #EDE9FE; color: #6D28D9; }
    .badge-orange { background: #FFF7ED; color: #C2410C; }
    .badge-green { background: #D1FAE5; color: #047857; }
    .badge-red { background: #FEE2E2; color: #DC2626; }

    /* ========================================
       FAQ Accordion
       ======================================== */
    .faq-item {
      background: var(--color-bg-white);
      border: 1px solid var(--color-border-light);
      border-radius: var(--radius-base);
      margin-bottom: var(--spacing-sm);
      overflow: hidden;
    }
    .faq-question {
      width: 100%;
      background: none;
      border: none;
      padding: var(--spacing-base) var(--spacing-lg);
      font-size: var(--font-size-body);
      font-weight: 600;
      color: var(--color-aws-dark);
      text-align: left;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .faq-question:hover {
      background: var(--color-bg-light);
    }
    .faq-arrow {
      transition: transform 0.3s ease;
      font-size: var(--font-size-body);
    }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .faq-answer-inner {
      padding: 0 var(--spacing-lg) var(--spacing-base);
      font-size: var(--font-size-body);
      color: var(--color-text-secondary);
      line-height: 1.8;
    }
    .faq-item.open .faq-arrow {
      transform: rotate(180deg);
    }
    .faq-item.open .faq-answer {
      max-height: 500px;
    }

    /* ========================================
       Footer
       ======================================== */
    .page-footer {
      background: var(--color-bg-light);
      border-top: 1px solid var(--color-border-light);
      padding: var(--spacing-lg) var(--spacing-2xl);
      text-align: center;
      font-size: var(--font-size-body);
      color: var(--color-text-secondary);
    }

    /* ========================================
       Responsive
       ======================================== */
    @media (max-width: 768px) {
      .grid-2, .grid-3, .grid-4, .comparison-grid {
        grid-template-columns: 1fr;
      }
      .page-header { padding: var(--spacing-2xl) var(--spacing-base); }
      .page-header h1 { font-size: 30px; }
      .content { padding: var(--spacing-base); }
    }</style>
<!-- CONTENT EXTRACTION FAILED -->
<script>document.querySelectorAll('.faq-question').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = this.closest('.faq-item');
        var isOpen = item.classList.contains('open');
        // close all
        document.querySelectorAll('.faq-item').forEach(function(i) {
          i.classList.remove('open');
          i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
        });
        // toggle current
        if (!isOpen) {
          item.classList.add('open');
          this.setAttribute('aria-expanded', 'true');
        }
      });
    });</script>`;
---

<ResourceLayout {...frontmatter}>
  <Fragment set:html={rawContent} />
</ResourceLayout>
