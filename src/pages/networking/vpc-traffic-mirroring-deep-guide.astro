      max-width: 100%;
      height: auto;
    }

    /* ========================================
       4構成要素カード（2x2均等グリッド）
       ======================================== */
    .components-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .comp-card {
      border-radius: 14px;
      padding: 1.5rem;
      border: 2px solid;
      position: relative;
    }

    .comp-card-source {
      background: #fef2f2;
      border-color: #fca5a5;
    }

    .comp-card-target {
      background: #f0fdf4;
      border-color: #86efac;
    }

    .comp-card-filter {
      background: #fefce8;
      border-color: #fde047;
    }

    .comp-card-session {
      background: #f5f3ff;
      border-color: #c4b5fd;
    }

    .comp-card-number {
      position: absolute;
      top: -0.7rem;
      left: 1rem;
      width: 1.6rem;
      height: 1.6rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.85rem;
      color: #fff;
    }

    .comp-card-source .comp-card-number { background: #ef4444; }
    .comp-card-target .comp-card-number { background: #22c55e; }
    .comp-card-filter .comp-card-number { background: #eab308; }
    .comp-card-session .comp-card-number { background: #8b5cf6; }

    .comp-card-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.8rem;
    }

    .comp-card-header-icon {
      font-size: 1.6rem;
    }

    .comp-card-header h3 {
      margin: 0;
      font-size: 1.1rem;
    }

    .comp-card-source .comp-card-header h3 { color: #b91c1c; }
    .comp-card-target .comp-card-header h3 { color: #15803d; }
    .comp-card-filter .comp-card-header h3 { color: #a16207; }
    .comp-card-session .comp-card-header h3 { color: #6d28d9; }

    .comp-card-analogy {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.8rem;
      border-radius: 8px;
      margin-bottom: 0.8rem;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .comp-card-source .comp-card-analogy { background: #fee2e2; color: #991b1b; }
    .comp-card-target .comp-card-analogy { background: #dcfce7; color: #166534; }
    .comp-card-filter .comp-card-analogy { background: #fef9c3; color: #854d0e; }
    .comp-card-session .comp-card-analogy { background: #ede9fe; color: #5b21b6; }

    .comp-card p {
      margin-bottom: 0;
      color: #374151;
    }

    /* ========================================
       深掘りセクション
       ======================================== */
    .deep-section {
      background: #fff;
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
      border-top: 4px solid;
    }

    .deep-source { border-top-color: #ef4444; }
    .deep-target { border-top-color: #22c55e; }
    .deep-filter { border-top-color: #eab308; }
    .deep-session { border-top-color: #8b5cf6; }

    .deep-section h2 {
      margin-bottom: 1.2rem;
      padding-bottom: 0.5rem;
    }

    .deep-source h2 { color: #b91c1c; border-bottom: 2px solid #ef4444; }
    .deep-target h2 { color: #15803d; border-bottom: 2px solid #22c55e; }
    .deep-filter h2 { color: #a16207; border-bottom: 2px solid #eab308; }
    .deep-session h2 { color: #6d28d9; border-bottom: 2px solid #8b5cf6; }

    .deep-section h3 {
      margin-top: 1.5rem;
      margin-bottom: 0.8rem;
    }

    /* ========================================
       対応可能リソースグリッド（均等）
       ======================================== */
    .resource-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1rem;
      margin-top: 1rem;
    }

    .resource-card {
      text-align: center;
      padding: 1.2rem;
      border-radius: 12px;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
    }

    .resource-card-icon {
      font-size: 2rem;
      margin-bottom: 0.4rem;
    }

    .resource-card-name {
      font-weight: 700;
      display: block;
      margin-bottom: 0.2rem;
    }

    .resource-card-desc {
      font-size: 0.85rem;
      color: #6b7280;
    }

    /* ========================================
       ターゲット3種類の均等グリッド
       ======================================== */
    .target-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1rem;
      margin-top: 1rem;
    }

    .target-card {
      padding: 1.2rem;
      border-radius: 12px;
      text-align: center;
      border: 2px solid #86efac;
      background: #f0fdf4;
    }

    .target-card-icon {
      font-size: 2rem;
      margin-bottom: 0.4rem;
    }

    .target-card-name {
      font-weight: 700;
      display: block;
      color: #15803d;
      margin-bottom: 0.3rem;
    }

    .target-card-desc {
      font-size: 0.85rem;
      color: #374151;
      margin-bottom: 0.5rem;
    }

    .target-card-analogy {
      font-size: 0.85rem;
      color: #6b7280;
      padding: 0.3rem 0.6rem;
      background: #dcfce7;
      border-radius: 6px;
      display: inline-block;
    }

    /* ========================================
       フィルタールール表
       ======================================== */
    .filter-table-wrap {
      overflow-x: auto;
      margin-top: 1rem;
    }

    .filter-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      border-radius: 12px;
      overflow: hidden;
      font-size: 1rem;
    }

    .filter-table thead th {
      padding: 0.8rem 1rem;
      text-align: left;
      font-weight: 700;
      background: #a16207;
      color: #fff;
    }

    .filter-table tbody td {
      padding: 0.7rem 1rem;
      border-bottom: 1px solid #e5e7eb;
      vertical-align: top;
    }

    .filter-table tbody tr:nth-child(even) {
      background: #fefce8;
    }

    .filter-table tbody tr:last-child td {
      border-bottom: none;
    }

    .filter-badge-accept {
      display: inline-block;
      background: #dcfce7;
      color: #15803d;
      font-weight: 700;
      padding: 0.15rem 0.6rem;
      border-radius: 6px;
      font-size: 0.85rem;
    }

    .filter-badge-reject {
      display: inline-block;
      background: #fee2e2;
      color: #b91c1c;
      font-weight: 700;
      padding: 0.15rem 0.6rem;
      border-radius: 6px;
      font-size: 0.85rem;
    }

    /* ========================================
       セッション設定図
       ======================================== */
    .session-flow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin: 1.5rem 0;
    }

    .session-flow-box {
      padding: 0.8rem 1.2rem;
      border-radius: 10px;
      font-weight: 700;
      text-align: center;
      min-width: 130px;
    }

    .session-flow-source {
      background: #fee2e2;
      color: #b91c1c;
      border: 2px solid #fca5a5;
    }

    .session-flow-filter {
      background: #fef9c3;
      color: #a16207;
      border: 2px solid #fde047;
    }

    .session-flow-target {
      background: #dcfce7;
      color: #15803d;
      border: 2px solid #86efac;
    }

    .session-flow-arrow {
      font-size: 1.3rem;
      color: #9ca3af;
    }

    .session-param-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-top: 1rem;
    }

    .session-param-card {
      background: #f5f3ff;
      border: 1px solid #c4b5fd;
      border-radius: 10px;
      padding: 1rem;
    }

    .session-param-card strong {
      display: block;
      color: #6d28d9;
      margin-bottom: 0.3rem;
    }

    .session-param-card p {
      margin-bottom: 0;
      color: #374151;
      font-size: 0.9rem;
    }

    /* ========================================
       たとえ話の全体対応表
       ======================================== */
    .mapping-table-wrap {
      overflow-x: auto;
      margin-top: 1rem;
    }

    .mapping-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      border-radius: 12px;
      overflow: hidden;
      font-size: 1rem;
    }

    .mapping-table thead th {
      padding: 0.8rem 1rem;
      text-align: left;
      font-weight: 700;
      color: #fff;
    }

    .mapping-table thead th:first-child {
      background: #6b7280;
    }

    .mapping-table thead th:nth-child(2) {
      background: #2563eb;
    }

    .mapping-table thead th:nth-child(3) {
      background: #374151;
    }

    .mapping-table tbody td {
      padding: 0.7rem 1rem;
      border-bottom: 1px solid #e5e7eb;
      vertical-align: top;
    }

    .mapping-table tbody tr:nth-child(even) {
      background: #f9fafb;
    }

    .mapping-table tbody tr:last-child td {
      border-bottom: none;
    }

    /* ========================================
       実践セクション：CLI例
       ======================================== */
    .cli-block {
      background: #1e293b;
      border-radius: 12px;
      padding: 1.2rem 1.5rem;
      margin-top: 1rem;
      overflow-x: auto;
    }

    .cli-block code {
      color: #e2e8f0;
      font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
      font-size: 0.82rem;
      line-height: 1.6;
      white-space: pre;
    }

    .cli-block .cli-comment {
      color: #94a3b8;
    }

    .cli-block .cli-key {
      color: #7dd3fc;
    }

    .cli-block .cli-val {
      color: #86efac;
    }

    .cli-block .cli-cmd {
      color: #fbbf24;
    }

