          <rect x="195" y="15" width="280" height="250" rx="12" fill="#fef9c3" stroke="#fde047" stroke-width="2"/>
          <text x="335" y="40" text-anchor="middle" font-size="13" font-weight="700" fill="#a16207">🎚️ ミラーフィルター</text>

          <!-- インバウンドルール -->
          <rect x="215" y="55" width="240" height="85" rx="8" fill="#fff" stroke="#e5e7eb" stroke-width="1"/>
          <text x="335" y="75" text-anchor="middle" font-size="11" font-weight="700" fill="#374151">⬇️ インバウンドルール</text>
          <text x="225" y="95" font-size="10" fill="#15803d">✅ ルール100: TCP/443 ACCEPT</text>
          <text x="225" y="112" font-size="10" fill="#15803d">✅ ルール200: TCP/80 ACCEPT</text>
          <text x="225" y="129" font-size="10" fill="#b91c1c">❌ ルール300: ALL REJECT</text>

