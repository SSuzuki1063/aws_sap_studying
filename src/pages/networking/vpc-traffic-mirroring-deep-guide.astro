    }

    .faq-a {
      padding-left: 1.8rem;
      color: #374151;
    }

    .faq-a p {
      margin-bottom: 0;
    }

    /* ========================================
       まとめ
       ======================================== */
    .summary-box {
      background: linear-gradient(135deg, #232F3E 0%, #37475A 100%);
      color: #fff;
      border-radius: 16px;
      padding: 2rem;
      margin-top: 2rem;
    }

    .summary-box h2 {
