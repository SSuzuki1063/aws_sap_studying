const rawContent = `<style>/* ========================================
       リセット・基本設定
       ======================================== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-size: 20px;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      background: #f5f6f8;
      color: #374151;
      line-height: 1.7;
            padding-top: 70px;}

    /* ========================================
       ヘッダー
       ======================================== */
    .page-header {
      background: linear-gradient(135deg, #232F3E 0%, #37475A 50%, #232F3E 100%);
      padding: 3rem 2rem 2.5rem;
      text-align: center;
      color: #fff;
      position: relative;
      overflow: hidden;
    }

    .page-header::before {
      content: "";
      position: absolute;
      top: -40%;
      right: -10%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
      border-radius: 50%;
    }

    .page-header-inner {
      max-width: 960px;
      margin: 0 auto;
      position: relative;
    }

    .page-badge {
      display: inline-block;
      background: rgba(59, 130, 246, 0.2);
      color: #93c5fd;
      font-weight: 700;
      padding: 0.3rem 1.2rem;
      border-radius: 20px;
      margin-bottom: 1rem;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .page-header h1 {
      font-size: 1.7rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.35;
      margin-bottom: 0.8rem;
    }

    .page-header h1 span {
      color: #FF9900;
    }

    .page-header-sub {
      color: #d1d5db;
      font-size: 1rem;
    }

    /* ========================================
       メインコンテナ
       ======================================== */
    .container {
      max-width: 1060px;
      margin: 0 auto;
      padding: 2rem 1.5rem 3rem;
    }

    /* ========================================
       結論ファースト
       ======================================== */
    .conclusion-box {
      background: #fff;
      border: 2px solid #3b82f6;
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 2.5rem;
      box-shadow: 0 4px 24px rgba(59, 130, 246, 0.08);
    }

    .conclusion-box h2 {
      font-size: 1.3rem;
      color: #1e3a5f;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #3b82f6;
    }

    .conclusion-text {
      margin-bottom: 1.2rem;
    }

    .conclusion-4cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .conclusion-4card {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      padding: 0.9rem 1rem;
      border-radius: 10px;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
    }

    .conclusion-4card-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
      line-height: 1;
    }

    .conclusion-4card-body strong {
      display: block;
      color: #1e40af;
      margin-bottom: 0.15rem;
    }

    .conclusion-4card-body span {
      color: #6b7280;
      font-size: 0.9rem;
    }

    .conclusion-oneliner {
      text-align: center;
      padding: 1rem;
      background: #fef3c7;
      border-radius: 10px;
      font-weight: 600;
      color: #92400e;
    }

    /* ========================================
       セクション共通
       ======================================== */
    .section {
      background: #fff;
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
