          <text x="85" y="65" text-anchor="middle" font-size="12" font-weight="700" fill="#374151">📦 全パケット</text>
          <text x="85" y="83" text-anchor="middle" font-size="10" fill="#6b7280">ENIを通過する全通信</text>

          <!-- 矢印 -->
          <line x1="150" y1="70" x2="195" y2="70" stroke="#a16207" stroke-width="2" marker-end="url(#arrow-yellow)"/>

