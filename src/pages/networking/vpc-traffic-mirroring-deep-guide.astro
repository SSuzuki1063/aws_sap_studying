      font-size: 1.3rem;
      color: #1e3a5f;
      margin-bottom: 1.2rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #3b82f6;
    }

    .section h3 {
      font-size: 1.1rem;
      color: #374151;
      margin-bottom: 0.8rem;
      margin-top: 1.5rem;
    }

    .section p {
      margin-bottom: 0.8rem;
    }

    /* ========================================
       たとえ話：全体像
       ======================================== */
