          <line x1="475" y1="140" x2="520" y2="140" stroke="#22c55e" stroke-width="2" marker-end="url(#arrow-green2)"/>

          <!-- 通過パケット -->
          <rect x="520" y="85" width="140" height="110" rx="10" fill="#f0fdf4" stroke="#86efac" stroke-width="2"/>
          <text x="590" y="110" text-anchor="middle" font-size="12" font-weight="700" fill="#15803d">✅ 通過パケット</text>
