---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Aws Eni Infographic',
  pageTitle: 'AWS ENI（Elastic Network Interface）初心者向け図解',
  category: 'networking',
  categoryLabel: 'ネットワーキング',
  subcategory: 'VPC & ネットワーク基礎',
  slug: 'aws-eni-infographic',
  pageCss: '/aws_sap_studying/css/pages/aws-eni-infographic.css',
  tocItems: [
    { level: 'h2', id: 'ENIの基本概念', text: 'ENIの基本概念' },
    { level: 'h2', id: 'ENIの主な特徴', text: 'ENIの主な特徴' },
    { level: 'h3', id: '接続性', text: '🔌 接続性' },
