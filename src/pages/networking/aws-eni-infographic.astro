    { level: 'h2', id: 'ENIの作成-管理方法', text: 'ENIの作成・管理方法' },
    { level: 'h3', id: 'ENIの作成', text: 'ENIの作成' },
    { level: 'h3', id: 'ENIのアタッチ', text: 'ENIのアタッチ' },
    { level: 'h3', id: 'セキュリティグループの設定', text: 'セキュリティグループの設定' },
    { level: 'h3', id: 'IPアドレスの管理', text: 'IPアドレスの管理' },
    { level: 'h3', id: 'モニタリングと管理', text: 'モニタリングと管理' },
    { level: 'h2', id: 'ENIと関連するAWSサービス', text: 'ENIと関連するAWSサービス' },
    { level: 'h3', id: 'EC2', text: 'EC2' },
    { level: 'h3', id: 'VPC', text: 'VPC' },
    { level: 'h3', id: 'LambdaVPC内', text: 'Lambda（VPC内）' },
    { level: 'h3', id: 'RDS', text: 'RDS' },
    { level: 'h3', id: 'EKS', text: 'EKS' },
    { level: 'h3', id: 'ECS', text: 'ECS' },
    { level: 'h2', id: 'ENIに関するよくある質問', text: 'ENIに関するよくある質問' },
    { level: 'h3', id: 'ENIとEIPの違いは何ですか？', text: 'ENIとEIPの違いは何ですか？' },
    { level: 'h3', id: '1つのEC2インスタンスに複数のENIをアタッチする理由は？', text: '1つのEC2インスタンスに複数のENIをアタッチする理由は？' },
    { level: 'h3', id: 'ENIの制限事項は何ですか？', text: 'ENIの制限事項は何ですか？' },
    { level: 'h3', id: 'ENIの料金はどうなっていますか？', text: 'ENIの料金はどうなっていますか？' }
  ],
  prevPage: '../new-solutions/vpn-vs-privatelink.html',
  nextPage: '../new-solutions/aws_eip_nat_infographic.html',
  pageNum: 6,
  pageTotal: 19,
