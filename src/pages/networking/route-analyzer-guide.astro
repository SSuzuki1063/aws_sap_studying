const rawContent = `<style>/* ========================================
       CSS Variables
       ======================================== */
    :root {
      --color-primary: #232F3E;
      --color-accent: #dc7600;
      --color-accent-light: #fff3e0;
      --color-accent-original: #FF9900;
      --color-text: #374151;
      --color-text-secondary: #6B7280;
      --color-bg: #FAFBFC;
      --color-white: #FFFFFF;
      --color-border: #E5E7EB;
      --color-success: #059669;
      --color-success-bg: #ecfdf5;
      --color-error: #DC2626;
      --color-error-bg: #fef2f2;
      --color-info: #2563EB;
      --color-info-bg: #eff6ff;
      --color-warning: #D97706;
      --color-warning-bg: #fffbeb;
      --color-teal: #0D9488;
      --color-teal-bg: #f0fdfa;
      --color-purple: #7C3AED;
      --color-purple-bg: #f5f3ff;
      --font-display: 'Noto Sans JP', sans-serif;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 20px;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
      --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
      --shadow-lg: 0 8px 30px rgba(0,0,0,0.10);
      --transition: 0.25s ease;
    }

    /* ========================================
       Base & Reset
       ======================================== */
    *,*::before,*::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-display);
      font-size: 20px;
      line-height: 1.8;
      color: var(--color-text);
      background: var(--color-bg);
      -webkit-font-smoothing: antialiased;
            padding-top: 70px;}

    img { max-width: 100%; height: auto; }

    /* ========================================
       Layout
       ======================================== */
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ========================================
       Hero Header
       ======================================== */
    .hero {
      background: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      padding: 56px 0 48px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--color-primary);
      color: var(--color-accent-original);
      font-size: 14px;
      font-weight: 700;
      padding: 6px 16px;
      border-radius: 100px;
      letter-spacing: 0.04em;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    .hero h1 {
      font-size: clamp(28px, 4vw, 40px);
      font-weight: 900;
      color: var(--color-primary);
      line-height: 1.3;
      margin-bottom: 16px;
    }

    .hero h1 .highlight {
      color: var(--color-accent);
    }

    .hero-subtitle {
      font-size: 22px;
      color: var(--color-text-secondary);
      max-width: 700px;
    }

    /* ========================================
       Section Common
       ======================================== */
    .section {
      padding: 56px 0;
    }

    .section + .section {
      border-top: 1px solid var(--color-border);
    }

    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 12px;
    }

    .section-label--orange { color: var(--color-accent); }
    .section-label--teal { color: var(--color-teal); }
    .section-label--blue { color: var(--color-info); }
    .section-label--purple { color: var(--color-purple); }
    .section-label--green { color: var(--color-success); }
    .section-label--red { color: var(--color-error); }

    .section h2 {
      font-size: clamp(24px, 3vw, 32px);
      font-weight: 800;
      color: var(--color-primary);
      line-height: 1.4;
      margin-bottom: 20px;
    }

    .section-lead {
      font-size: 20px;
      color: var(--color-text-secondary);
      max-width: 760px;
      margin-bottom: 32px;
    }

    /* ========================================
       Conclusion First Box
       ======================================== */
    .conclusion-box {
      background: var(--color-white);
      border: 2px solid var(--color-accent);
      border-radius: var(--radius-lg);
      padding: 32px;
      margin-bottom: 48px;
      position: relative;
    }

    .conclusion-box::before {
      content: "結論";
      position: absolute;
      top: -14px;
      left: 24px;
      background: var(--color-accent);
      color: var(--color-white);
      font-size: 14px;
      font-weight: 800;
      padding: 4px 16px;
      border-radius: 100px;
      letter-spacing: 0.08em;
    }

    .conclusion-points {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .conclusion-point {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 20px;
      font-weight: 600;
      color: var(--color-primary);
    }

    .conclusion-point .num {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      background: var(--color-accent);
      color: var(--color-white);
      font-size: 14px;
      font-weight: 800;
      border-radius: 50%;
      margin-top: 4px;
    }

    /* ========================================
       Analogy Section
       ======================================== */
    .analogy-banner {
      background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #f0fdfa 100%);
      border: 1px solid #bae6fd;
      border-radius: var(--radius-lg);
      padding: 36px;
      margin-bottom: 36px;
      text-align: center;
    }

    .analogy-banner .emoji-icon {
      font-size: 48px;
      margin-bottom: 12px;
    }

    .analogy-banner h3 {
      font-size: 24px;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 8px;
    }

    .analogy-banner p {
      font-size: 20px;
      color: var(--color-text-secondary);
    }

    /* ========================================
       Mapping Table
       ======================================== */
    .mapping-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      margin-bottom: 36px;
      font-size: 20px;
    }

    .mapping-table thead th {
      background: var(--color-primary);
      color: var(--color-white);
      font-weight: 700;
      padding: 16px 20px;
      text-align: left;
    }

    .mapping-table thead th:nth-child(1) {
      width: 10%;
      text-align: center;
    }

    .mapping-table thead th:nth-child(2) {
      width: 35%;
    }

    .mapping-table thead th:nth-child(3) {
      width: 10%;
      text-align: center;
    }

    .mapping-table thead th:nth-child(4) {
      width: 45%;
    }

    .mapping-table tbody td {
      padding: 14px 20px;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-white);
      vertical-align: middle;
    }

    .mapping-table tbody td:nth-child(1) {
      text-align: center;
      font-size: 28px;
    }

    .mapping-table tbody td:nth-child(3) {
      text-align: center;
      font-size: 22px;
      color: var(--color-accent);
    }

    .mapping-table tbody tr:last-child td {
      border-bottom: none;
    }

    .mapping-table tbody td .term {
      font-weight: 700;
      color: var(--color-primary);
    }

    .mapping-table tbody td .desc {
      font-size: 18px;
      color: var(--color-text-secondary);
    }

    /* ========================================
       Grid Cards (Equal)
       ======================================== */
    .equal-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 36px;
    }

    .equal-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 36px;
    }

    .equal-grid-4 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 36px;
    }

    .card {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 28px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition), transform var(--transition);
    }

    .card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .card-icon {
      font-size: 36px;
      margin-bottom: 12px;
    }

    .card h3 {
      font-size: 22px;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 8px;
    }

    .card p {
      font-size: 20px;
      color: var(--color-text-secondary);
    }

    /* ========================================
       Use Case Cards
       ======================================== */
    .usecase-card {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 28px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition), transform var(--transition);
      border-left: 4px solid var(--color-accent);
    }

    .usecase-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .usecase-card h3 {
      font-size: 22px;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 4px;
    }

    .usecase-card .analogy-text {
      font-size: 18px;
      color: var(--color-accent);
      font-weight: 600;
      margin-bottom: 8px;
    }

    .usecase-card p {
      font-size: 20px;
      color: var(--color-text-secondary);
    }

    /* ========================================
       SVG Diagram Wrapper
       ======================================== */
    .diagram-wrapper {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 32px;
      margin-bottom: 36px;
      box-shadow: var(--shadow-sm);
      overflow-x: auto;
    }

    .diagram-wrapper h3 {
      font-size: 22px;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 20px;
      text-align: center;
    }

    .diagram-wrapper svg {
      display: block;
      margin: 0 auto;
    }

    /* ========================================
       Flow Steps (Vertical)
       ======================================== */
    .flow-steps {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-bottom: 36px;
    }

    .flow-step {
      display: flex;
      align-items: flex-start;
      gap: 20px;
      padding: 24px 0;
    }

    .flow-step-marker {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    .flow-step-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      background: var(--color-primary);
      color: var(--color-accent-original);
      font-size: 20px;
      font-weight: 900;
      border-radius: 50%;
    }

    .flow-step-line {
      width: 3px;
      flex: 1;
      min-height: 20px;
      background: var(--color-border);
    }

    .flow-step:last-child .flow-step-line {
      display: none;
    }

    .flow-step-content h3 {
      font-size: 22px;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 4px;
    }

    .flow-step-content .step-analogy {
      font-size: 18px;
      color: var(--color-accent);
      font-weight: 600;
      margin-bottom: 4px;
    }

    .flow-step-content p {
      font-size: 20px;
      color: var(--color-text-secondary);
    }

    /* ========================================
       Comparison: OK / NG
       ======================================== */
    .compare-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 36px;
    }

    .compare-card {
      border-radius: var(--radius-md);
      padding: 28px;
      box-shadow: var(--shadow-sm);
    }

    .compare-card--ok {
      background: var(--color-success-bg);
      border: 2px solid var(--color-success);
    }

    .compare-card--ng {
      background: var(--color-error-bg);
      border: 2px solid var(--color-error);
    }

    .compare-card h3 {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .compare-card--ok h3 { color: var(--color-success); }
    .compare-card--ng h3 { color: var(--color-error); }

    .compare-card p {
      font-size: 20px;
      color: var(--color-text);
    }

    .compare-card ul {
      list-style: none;
      padding: 0;
    }

    .compare-card ul li {
      font-size: 20px;
      color: var(--color-text);
      padding: 6px 0;
      padding-left: 28px;
      position: relative;
    }

    .compare-card--ok ul li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--color-success);
      font-weight: 800;
    }

    .compare-card--ng ul li::before {
      content: "✗";
      position: absolute;
      left: 0;
      color: var(--color-error);
      font-weight: 800;
    }

    /* ========================================
       Info / Warning / Tip boxes
       ======================================== */
    .callout {
      border-radius: var(--radius-md);
      padding: 24px 28px;
      margin-bottom: 28px;
      font-size: 20px;
    }

    .callout--info {
      background: var(--color-info-bg);
      border-left: 4px solid var(--color-info);
    }

    .callout--warning {
      background: var(--color-warning-bg);
      border-left: 4px solid var(--color-warning);
    }

    .callout--success {
      background: var(--color-success-bg);
      border-left: 4px solid var(--color-success);
    }

    .callout--error {
      background: var(--color-error-bg);
      border-left: 4px solid var(--color-error);
    }

    .callout-title {
      font-weight: 800;
      margin-bottom: 6px;
      font-size: 20px;
    }

    .callout--info .callout-title { color: var(--color-info); }
    .callout--warning .callout-title { color: var(--color-warning); }
    .callout--success .callout-title { color: var(--color-success); }
    .callout--error .callout-title { color: var(--color-error); }

    /* ========================================
       Result Status Diagram
       ======================================== */
    .status-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 36px;
    }

    .status-card {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      text-align: center;
    }

    .status-card .status-icon {
      font-size: 40px;
      margin-bottom: 8px;
    }

    .status-card h3 {
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 4px;
    }

    .status-card p {
      font-size: 18px;
      color: var(--color-text-secondary);
    }

    .status-card--connected { border-top: 4px solid var(--color-success); }
    .status-card--connected h3 { color: var(--color-success); }

    .status-card--not-connected { border-top: 4px solid var(--color-error); }
    .status-card--not-connected h3 { color: var(--color-error); }

    .status-card--blackhole { border-top: 4px solid var(--color-warning); }
    .status-card--blackhole h3 { color: var(--color-warning); }

    .status-card--no-route { border-top: 4px solid var(--color-text-secondary); }
    .status-card--no-route h3 { color: var(--color-text-secondary); }

    /* ========================================
       Limitation List
       ======================================== */
    .limitation-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 36px;
    }

    .limitation-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 20px 24px;
      font-size: 20px;
    }

    .limitation-icon {
      flex-shrink: 0;
      font-size: 24px;
      margin-top: 2px;
    }

    .limitation-item .term {
      font-weight: 700;
      color: var(--color-primary);
    }

    /* ========================================
       FAQ
       ======================================== */
    .faq-item {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      margin-bottom: 16px;
      overflow: hidden;
    }

    .faq-question {
      font-size: 20px;
      font-weight: 700;
      color: var(--color-primary);
      padding: 20px 24px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 12px;
      user-select: none;
      transition: background var(--transition);
    }

    .faq-question:hover {
      background: var(--color-bg);
    }

    .faq-question .toggle-icon {
      margin-left: auto;
      font-size: 20px;
      transition: transform var(--transition);
      color: var(--color-text-secondary);
    }

    .faq-item.open .faq-question .toggle-icon {
      transform: rotate(180deg);
    }

    .faq-answer {
      display: none;
      padding: 0 24px 20px;
      font-size: 20px;
      color: var(--color-text-secondary);
      border-top: 1px solid var(--color-border);
      padding-top: 16px;
    }

    .faq-item.open .faq-answer {
      display: block;
    }

    /* ========================================
       Middlebox Diagram
       ======================================== */
    .middlebox-flow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .middlebox-node {
      background: var(--color-white);
      border: 2px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 12px 18px;
      text-align: center;
      font-size: 18px;
      font-weight: 700;
      color: var(--color-primary);
      min-width: 100px;
    }

    .middlebox-node--source {
      border-color: var(--color-info);
      background: var(--color-info-bg);
    }

    .middlebox-node--dest {
      border-color: var(--color-success);
      background: var(--color-success-bg);
    }

    .middlebox-node--mb {
      border-color: var(--color-purple);
      background: var(--color-purple-bg);
    }

    .middlebox-node--tgw {
      border-color: var(--color-accent);
