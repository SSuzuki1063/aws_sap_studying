          <polygon points="600,100 730,175 470,175" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
          <text x="600" y="148" text-anchor="middle" font-family="sans-serif" font-size="15" font-weight="700" fill="#065F46">R100: 最も具体的</text>
          <text x="600" y="168" text-anchor="middle" font-family="sans-serif" font-size="12" fill="#065F46">tag=Prod AND Region=us-east-1</text>

          <!-- Level 2 -->
          <polygon points="440,185 760,185 810,255 390,255" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
          <text x="600" y="218" text-anchor="middle" font-family="sans-serif" font-size="15" font-weight="700" fill="#3730A3">R200: やや具体的</text>
          <text x="600" y="240" text-anchor="middle" font-family="sans-serif" font-size="12" fill="#3730A3">tag=Production（リージョン問わず）</text>

          <!-- Level 3 -->
          <polygon points="360,265 840,265 900,335 300,335" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2"/>
