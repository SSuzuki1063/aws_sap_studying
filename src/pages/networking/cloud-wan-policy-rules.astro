    <section class="content-section" id="code-examples">
      <h2 id="settei-code-rei">&#128187; 設定コード例</h2>
      <div class="code-tabs" id="codeTabs1">
        <div class="code-tab-buttons" role="tablist">
          <button class="code-tab-btn active" role="tab" aria-selected="true" data-tab="cli1">AWS CLI（JSON）</button>
