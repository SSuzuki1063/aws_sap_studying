<pre><code>{
  "attachment-policies": [
    {
      "rule-number": 100,
      "description": "Production VPCs in us-east-1",
      "conditions": [
        { "type": "tag-value", "operator": "equals",
          "key": "Environment", "value": "Production" },
        { "type": "region", "operator": "equals",
