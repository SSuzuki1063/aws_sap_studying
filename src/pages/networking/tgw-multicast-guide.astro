            <line x1="760" y1="80" x2="760" y2="440" stroke="#7C3AED" stroke-width="2" stroke-dasharray="5 3"/>

            <!-- Step 1: JOIN -->
            <rect x="60" y="110" width="200" height="44" rx="8" fill="#ECFDF5" stroke="#059669" stroke-width="1.5"/>
            <text x="160" y="138" text-anchor="middle" fill="#059669" font-size="15" font-weight="700">① IGMP JOIN 送信</text>

            <line x1="260" y1="132" x2="360" y2="132" stroke="#059669" stroke-width="2.5" marker-end="url(#arrowGreen)"/>
            <text x="310" y="122" text-anchor="middle" fill="#059669" font-size="13">JOIN</text>

            <rect x="360" y="110" width="200" height="44" rx="8" fill="#FFF3E0" stroke="#FF9900" stroke-width="1.5"/>
            <text x="460" y="138" text-anchor="middle" fill="#B45309" font-size="15" font-weight="600">メンバー登録</text>

            <line x1="560" y1="132" x2="660" y2="132" stroke="#7C3AED" stroke-width="2" marker-end="url(#arrowPurple)"/>

            <rect x="660" y="110" width="200" height="44" rx="8" fill="#F5F3FF" stroke="#7C3AED" stroke-width="1.5"/>
            <text x="760" y="138" text-anchor="middle" fill="#7C3AED" font-size="14" font-weight="600">✅ 配信開始</text>

            <!-- Step 2: QUERY (every 2 min) -->
            <rect x="360" y="190" width="200" height="44" rx="8" fill="#FFF3E0" stroke="#FF9900" stroke-width="1.5"/>
            <text x="460" y="218" text-anchor="middle" fill="#B45309" font-size="15" font-weight="700">② IGMP QUERY</text>

            <defs>
                <marker id="arrowPurple" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
                    <path d="M0,0 L10,4 L0,8 Z" fill="#7C3AED"/>
