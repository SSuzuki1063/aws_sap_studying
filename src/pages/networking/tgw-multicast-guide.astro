            <rect x="660" y="190" width="200" height="44" rx="8" fill="#F5F3FF" stroke="#7C3AED" stroke-width="1.5"/>
            <text x="760" y="218" text-anchor="middle" fill="#7C3AED" font-size="14" font-weight="600">🔄 メンバー確認</text>
            <line x1="560" y1="212" x2="660" y2="212" stroke="#7C3AED" stroke-width="2" marker-end="url(#arrowPurple)"/>

            <!-- Step 3: Response -->
            <rect x="60" y="270" width="200" height="44" rx="8" fill="#ECFDF5" stroke="#059669" stroke-width="1.5"/>
