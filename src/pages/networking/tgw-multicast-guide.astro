            <line x1="460" y1="80" x2="460" y2="440" stroke="#232F3E" stroke-width="2" stroke-dasharray="5 3"/>

            <!-- Result Column -->
            <rect x="660" y="30" width="200" height="50" rx="10" fill="#7C3AED"/>
