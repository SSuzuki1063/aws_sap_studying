    border-color: var(--color-primary);
}

.code-block {
    display: none;
    background: var(--color-primary);
    color: #E5E7EB;
    border-radius: 0 var(--radius-md) var(--radius-md) var(--radius-md);
    padding: var(--spacing-lg);
    overflow-x: auto;
    font-family: "Cascadia Code", "Fira Code", "Source Code Pro", monospace;
    font-size: 0.78em;
    line-height: 1.7;
}

.code-block.active { display: block; }

.code-block .comment { color: #6B7280; }
.code-block .keyword { color: #93C5FD; }
.code-block .string { color: #86EFAC; }
.code-block .prop { color: #FCD34D; }

/* ========================================
   Comparison Table (Static vs IGMP)
   ======================================== */
.compare-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
}

.compare-card {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-md);
}

.compare-card.static-mode {
    border-top: 4px solid var(--color-info);
}

.compare-card.igmp-mode {
    border-top: 4px solid var(--color-multicast-purple);
}

.compare-card h3 {
    font-size: 1.1em;
    margin-bottom: var(--spacing-md);
}

.compare-card .compare-item {
    display: flex;
    justify-content: space-between;
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.85em;
}

.compare-card .compare-item:last-child { border-bottom: none; }

.compare-label { color: var(--color-text-secondary); }
.compare-value { font-weight: 600; }

/* ========================================
   ACL / Security Table
   ======================================== */
.security-table-wrapper {
    overflow-x: auto;
    margin-bottom: var(--spacing-lg);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
}

.security-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85em;
}

.security-table thead { background: #1E3A5F; color: var(--color-text-white); }

.security-table th {
    padding: var(--spacing-md);
    text-align: left;
    font-weight: 600;
}

.security-table td {
    padding: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
}

.security-table tbody tr:nth-child(even) { background: var(--color-bg-light); }

.security-table code {
    background: #E5E7EB;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.95em;
    font-family: "Cascadia Code", monospace;
}

/* ========================================
   FAQ Section
   ======================================== */
.faq-list { margin-bottom: var(--spacing-2xl); }

.faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-sm);
    overflow: hidden;
    transition: box-shadow var(--transition);
}

.faq-item:hover { box-shadow: var(--shadow-sm); }

.faq-question {
    width: 100%;
    background: var(--color-bg);
    border: none;
    padding: var(--spacing-md) var(--spacing-lg);
    text-align: left;
    font-size: 0.95em;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: inherit;
    transition: background var(--transition);
}

.faq-question:hover { background: var(--color-bg-light); }

.faq-arrow {
    transition: transform var(--transition);
    font-size: 0.85em;
    color: var(--color-text-secondary);
}

.faq-item.open .faq-arrow { transform: rotate(180deg); }

.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.3s ease;
}

.faq-item.open .faq-answer {
    max-height: 500px;
}

.faq-answer-inner {
    padding: 0 var(--spacing-lg) var(--spacing-lg);
    font-size: 0.88em;
    line-height: 1.65;
    color: var(--color-text-secondary);
}

/* ========================================
   Summary Section
   ======================================== */
.summary-section {
    background: linear-gradient(135deg, var(--color-primary), #1a2332);
    color: var(--color-text-white);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    margin: var(--spacing-2xl) 0;
    text-align: center;
}

.summary-section h2 {
    margin-bottom: var(--spacing-lg);
}

.summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    text-align: left;
    margin-bottom: var(--spacing-lg);
}

.summary-item {
    background: rgba(255,255,255,0.07);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    border: 1px solid rgba(255,255,255,0.1);
}

.summary-item h3 {
    font-size: 0.95em;
    color: var(--color-accent-original);
    margin-bottom: var(--spacing-xs);
}

.summary-item p {
    font-size: 0.82em;
    opacity: 0.85;
    margin-bottom: 0;
    line-height: 1.5;
}

.summary-formula {
    font-size: 1.15em;
    font-weight: 700;
    padding: var(--spacing-md);
    background: rgba(255,153,0,0.15);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255,153,0,0.3);
    display: inline-block;
}

/* ========================================
   Footer
   ======================================== */
footer {
    text-align: center;
    padding: var(--spacing-2xl) var(--spacing-lg);
    color: var(--color-text-secondary);
    font-size: 0.82em;
    border-top: 1px solid var(--color-border);
}

footer a {
    color: var(--color-networking);
    text-decoration: none;
}

footer a:hover { text-decoration: underline; }

/* ========================================
   Responsive
   ======================================== */
@media (max-width: 768px) {
    body { font-size: 18px;
            padding-top: 70px;}
    .conclusion-grid,
    .comm-grid,
    .flow-steps,
    .arch-grid,
    .benefit-grid,
    .usecase-grid,
    .compare-grid,
    .summary-grid {
        grid-template-columns: 1fr;
    }
    .hero { padding: var(--spacing-2xl) var(--spacing-md); }
}</style>
