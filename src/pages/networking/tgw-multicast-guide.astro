const rawContent = `<style>/* ========================================
   CSS Custom Properties
   ======================================== */
:root {
    --color-primary: #232F3E;
    --color-accent: #dc7600;
    --color-accent-light: #FFF3E0;
    --color-accent-original: #FF9900;
    --color-text: #374151;
    --color-text-secondary: #6B7280;
    --color-text-white: #FFFFFF;
    --color-bg: #FFFFFF;
    --color-bg-light: #F9FAFB;
    --color-bg-section: #F3F4F6;
    --color-border: #E5E7EB;
    --color-border-dark: #909296;
    --color-success: #10B981;
    --color-warning: #F59E0B;
    --color-error: #EF4444;
    --color-info: #3B82F6;
    --color-networking: #2563EB;
    --color-networking-light: #EFF6FF;
    --color-networking-mid: #BFDBFE;
    --color-multicast-purple: #7C3AED;
    --color-multicast-light: #F5F3FF;
    --color-igmp-teal: #0D9488;
    --color-igmp-light: #F0FDFA;
    --color-source-pink: #DB2777;
    --color-source-light: #FDF2F8;
    --color-member-green: #059669;
    --color-member-light: #ECFDF5;
    --font-sans: "Segoe UI", "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Meiryo", sans-serif;
    --spacing-xs: 5px;
    --spacing-sm: 10px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;
    --spacing-2xl: 48px;
    --spacing-3xl: 64px;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --shadow-sm: 0 2px 4px rgba(0,0,0,0.06);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
    --shadow-lg: 0 8px 30px rgba(0,0,0,0.12);
    --transition: 0.3s ease;
}

/* ========================================
   Base Styles
   ======================================== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.7;
    color: var(--color-text);
    background: var(--color-bg);
            padding-top: 70px;}

main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
}

h1 { font-size: 2.2em; line-height: 1.3; }
h2 { font-size: 1.6em; line-height: 1.35; }
h3 { font-size: 1.25em; line-height: 1.4; }
p { margin-bottom: var(--spacing-md); }

/* ========================================
   Hero Section
   ======================================== */
.hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, #1a2332 60%, #2d1b69 100%);
    color: var(--color-text-white);
    padding: var(--spacing-3xl) var(--spacing-lg);
    text-align: center;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 80%, rgba(124,58,237,0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(37,99,235,0.15) 0%, transparent 50%);
    pointer-events: none;
}

.hero-content { position: relative; max-width: 900px; margin: 0 auto; }

.hero-badge {
    display: inline-block;
    background: rgba(255,153,0,0.2);
    border: 1px solid rgba(255,153,0,0.4);
    color: var(--color-accent-original);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: 100px;
    font-size: 0.85em;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    letter-spacing: 0.03em;
}

.hero h1 { margin-bottom: var(--spacing-md); }

.hero-sub {
    font-size: 1.1em;
    opacity: 0.85;
    max-width: 700px;
    margin: 0 auto var(--spacing-2xl);
}

/* Conclusion-First Cards */
.conclusion-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    text-align: left;
    max-width: 800px;
    margin: 0 auto;
}

.conclusion-card {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    backdrop-filter: blur(10px);
    transition: background var(--transition);
}

.conclusion-card:hover { background: rgba(255,255,255,0.12); }

.conclusion-icon {
    font-size: 1.5em;
    margin-bottom: var(--spacing-xs);
    display: block;
}

.conclusion-card .conclusion-card-title {
    font-size: 1em;
    margin-bottom: var(--spacing-xs);
    color: var(--color-accent-original);
}

.conclusion-card p {
    font-size: 0.88em;
    opacity: 0.85;
    margin-bottom: 0;
    line-height: 1.55;
}

/* ========================================
   Section Styles
   ======================================== */
.section {
    padding: var(--spacing-3xl) 0;
    border-bottom: 1px solid var(--color-border);
}

.section:last-child { border-bottom: none; }

.section-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
}

.section-number {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-text-white);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    line-height: 44px;
    text-align: center;
    font-weight: 700;
    font-size: 1.1em;
    margin-bottom: var(--spacing-sm);
}

.section-header h2 { margin-bottom: var(--spacing-xs); }

.section-header p {
    color: var(--color-text-secondary);
    font-size: 0.95em;
}

/* ========================================
   Analogy Section
   ======================================== */
.analogy-hero {
    background: linear-gradient(135deg, var(--color-networking-light) 0%, #f0f0ff 100%);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
    text-align: center;
    border: 1px solid var(--color-networking-mid);
}

.analogy-hero .analogy-emoji {
    font-size: 3.5em;
    display: block;
    margin-bottom: var(--spacing-md);
}

.analogy-hero h3 {
    font-size: 1.35em;
    color: var(--color-networking);
    margin-bottom: var(--spacing-sm);
}

.analogy-hero p {
    max-width: 680px;
    margin: 0 auto;
    color: var(--color-text-secondary);
    font-size: 0.95em;
}

/* Communication Types Comparison */
.comm-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
}

.comm-card {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-md);
    text-align: center;
    transition: transform var(--transition), box-shadow var(--transition);
    border-top: 4px solid transparent;
}

.comm-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.comm-card.unicast { border-top-color: var(--color-info); }
.comm-card.broadcast { border-top-color: var(--color-warning); }
.comm-card.multicast { border-top-color: var(--color-multicast-purple); }

.comm-card .card-emoji {
    font-size: 2.5em;
    display: block;
    margin-bottom: var(--spacing-sm);
}

.comm-card h3 { font-size: 1.1em; margin-bottom: var(--spacing-xs); }

.comm-card .comm-type {
    font-size: 0.85em;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-sm);
}

.comm-card p {
    font-size: 0.88em;
    line-height: 1.5;
    margin-bottom: 0;
}

.comm-card .highlight-label {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 100px;
    font-size: 0.8em;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
}

.unicast .highlight-label { background: #DBEAFE; color: #1D4ED8; }
.broadcast .highlight-label { background: #FEF3C7; color: #B45309; }
.multicast .highlight-label { background: #EDE9FE; color: #6D28D9; }

/* ========================================
   Mapping Table
   ======================================== */
.mapping-table-wrapper {
    overflow-x: auto;
    margin-bottom: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
}

.mapping-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92em;
}

.mapping-table thead {
    background: var(--color-primary);
    color: var(--color-text-white);
}

.mapping-table th {
    padding: var(--spacing-md) var(--spacing-lg);
    text-align: left;
    font-weight: 600;
}

.mapping-table td {
    padding: var(--spacing-md) var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
}

.mapping-table tbody tr:nth-child(even) { background: var(--color-bg-light); }
.mapping-table tbody tr:hover { background: var(--color-accent-light); }

.mapping-table .emoji-cell {
    text-align: center;
    font-size: 1.4em;
}

/* ========================================
   SVG Diagram Area
   ======================================== */
.diagram-container {
    background: var(--color-bg-light);
    border-radius: var(--radius-xl);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
    border: 1px solid var(--color-border);
}

.diagram-title {
    text-align: center;
    font-size: 1.1em;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
}

.diagram-container svg {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    height: auto;
}

/* ========================================
   IGMP Flow
   ======================================== */
.flow-steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
}

.flow-step {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-sm);
    border-left: 5px solid var(--color-igmp-teal);
    position: relative;
}

.flow-step-number {
    position: absolute;
    top: -12px;
    left: -12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-igmp-teal);
    color: var(--color-text-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95em;
}

.flow-step h3 {
    color: var(--color-igmp-teal);
    font-size: 1.05em;
    margin-bottom: var(--spacing-xs);
}

.flow-step p {
    font-size: 0.88em;
    margin-bottom: 0;
    line-height: 1.55;
}

/* ========================================
   Domain / Architecture Cards
   ======================================== */
.arch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
}

.arch-card {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-md);
    border-top: 4px solid var(--color-networking);
}

.arch-card h3 {
    font-size: 1.05em;
    color: var(--color-networking);
    margin-bottom: var(--spacing-sm);
}

.arch-card p {
    font-size: 0.88em;
    line-height: 1.6;
    margin-bottom: var(--spacing-sm);
}

.arch-card ul {
    list-style: none;
    padding: 0;
}

.arch-card li {
    font-size: 0.85em;
    padding: var(--spacing-xs) 0;
    padding-left: 1.5em;
    position: relative;
}

.arch-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-success);
    font-weight: 700;
}

/* ========================================
   Benefit Grid
   ======================================== */
.benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
}

.benefit-card {
    display: flex;
    gap: var(--spacing-md);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    transition: box-shadow var(--transition);
}

.benefit-card:hover { box-shadow: var(--shadow-md); }

.benefit-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5em;
    background: var(--color-multicast-light);
}

.benefit-card h3 {
    font-size: 1em;
    margin-bottom: var(--spacing-xs);
}

.benefit-card p {
    font-size: 0.85em;
    color: var(--color-text-secondary);
    margin-bottom: 0;
    line-height: 1.5;
}

/* ========================================
   Use Case Section
   ======================================== */
.usecase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-2xl);
}

.usecase-card {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-md);
    transition: transform var(--transition);
}

.usecase-card:hover { transform: translateY(-3px); }

.usecase-card .card-emoji {
    font-size: 2em;
    display: block;
    margin-bottom: var(--spacing-sm);
}

.usecase-card h3 {
    font-size: 1.05em;
    margin-bottom: var(--spacing-sm);
}

.usecase-card p {
    font-size: 0.85em;
    color: var(--color-text-secondary);
    margin-bottom: 0;
    line-height: 1.55;
}

/* ========================================
   Caution / Warning Boxes
   ======================================== */
.caution-box {
    background: #FEF2F2;
    border: 1px solid #FCA5A5;
    border-left: 5px solid var(--color-error);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.caution-box h3 {
    color: var(--color-error);
    font-size: 1.05em;
    margin-bottom: var(--spacing-sm);
}

.caution-box ul {
    padding-left: 1.5em;
    margin: 0;
}

.caution-box li {
    font-size: 0.88em;
    line-height: 1.6;
    margin-bottom: var(--spacing-xs);
}

.tip-box {
    background: var(--color-networking-light);
    border: 1px solid var(--color-networking-mid);
    border-left: 5px solid var(--color-networking);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.tip-box h3 {
    color: var(--color-networking);
    font-size: 1.05em;
    margin-bottom: var(--spacing-sm);
}

.tip-box p {
    font-size: 0.88em;
    margin-bottom: 0;
    line-height: 1.6;
}

.exam-tip {
