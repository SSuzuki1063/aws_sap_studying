    border-left: 5px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.exam-tip h3 {
    color: var(--color-accent);
    font-size: 1.05em;
    margin-bottom: var(--spacing-sm);
}

.exam-tip ul {
    padding-left: 1.5em;
    margin: 0;
}

.exam-tip li {
    font-size: 0.88em;
    line-height: 1.6;
    margin-bottom: var(--spacing-xs);
}

/* ========================================
   Code Block
   ======================================== */
.code-section { margin-bottom: var(--spacing-2xl); }

.code-tabs {
    display: flex;
    gap: 2px;
    margin-bottom: 0;
}

.code-tab {
