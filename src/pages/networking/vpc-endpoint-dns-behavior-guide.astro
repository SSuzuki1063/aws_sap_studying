    { id: 'best-practices', text: '8. ベストプラクティス vs アンチパターン', level: 'h2' },
    { id: 'troubleshooting', text: '9. トラブルシューティング', level: 'h2' },
    { id: 'exam-tips', text: '10. 試験対策ポイント', level: 'h2' },
    { id: 'faq', text: '11. よくある質問（FAQ）', level: 'h2' },
    { id: 'glossary', text: '12. 用語集', level: 'h2' },
