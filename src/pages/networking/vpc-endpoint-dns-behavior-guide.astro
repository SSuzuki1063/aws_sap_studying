import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Vpc Endpoint Dns Behavior Guide',
  pageTitle: 'インターフェースVPCエンドポイントのDNS動作 完全ガイド',
  category: 'networking',
  categoryLabel: 'ネットワーキング',
  subcategory: 'VPC & ネットワーク基礎',
  slug: 'vpc-endpoint-dns-behavior-guide',
  tocItems: [
    { id: 'takeaways', text: '最初に押さえる3つの要点', level: 'h2' },
    { id: 'analogy', text: '1. たとえ話：ビル内線電話システム', level: 'h2' },
    { id: 'architecture', text: '2. アーキテクチャ図解', level: 'h2' },
    { id: 'dns-enabled-flow', text: '2-1. プライベートDNS有効時のDNS解決フロー', level: 'h3' },
    { id: 'dns-disabled-flow', text: '2-2. プライベートDNS無効時のDNS解決フロー', level: 'h3' },
    { id: 'comparison', text: '3. プライベートDNS 有効 vs 無効 徹底比較', level: 'h2' },
    { id: 'dns-flow', text: '4. DNS解決フロー詳細', level: 'h2' },
    { id: 'dns-flow-enabled', text: '4-1. プライベートDNS有効時のフロー', level: 'h3' },
    { id: 'dns-flow-disabled', text: '4-2. プライベートDNS無効時のフロー', level: 'h3' },
    { id: 'multi-vpc', text: '5. 複数VPC・ハイブリッド構成での使い方', level: 'h2' },
    { id: 'hub-spoke', text: '5-1. Hub-Spoke構成の推奨アーキテクチャ', level: 'h3' },
    { id: 'strategic-arch', text: '6. 戦略的アーキテクチャ設計 ― 4つの柱', level: 'h2' },
    { id: 'integrated-arch', text: '6-1. 4つの戦略を統合した完全アーキテクチャ', level: 'h3' },
    { id: 'strategy-details', text: '6-2. 各戦略の詳細と実装ポイント', level: 'h3' },
    { id: 'code-examples', text: '7. 設定コード例', level: 'h2' },
