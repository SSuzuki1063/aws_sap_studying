---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: '',
  pageTitle: 'S3バケットポリシー Principal要素 完全ガイド',
  category: 'networking',
  categoryLabel: 'ネットワーキング',
  subcategory: '',
  slug: 's3-bucket-policy-principal-guide',
  pageCss: '/aws_sap_studying/css/pages/s3-bucket-policy-principal-guide.css',
  tocItems: [
    { level: 'h2', id: 'たとえ話で理解するPrincipalとグループの関係', text: '🏢 たとえ話で理解する「Principalとグループの関係」' },
    { level: 'h2', id: 'なぜIAMグループをPrincipalに指定できないのか？', text: '🔍 なぜIAMグループをPrincipalに指定できないのか？' },
    { level: 'h2', id: 'Principal-に指定できるもの-できないもの', text: '📝 Principal に指定できるもの・できないもの' },
    { level: 'h2', id: 'なぜAWSはこの設計にしたのか？', text: '🤔 なぜAWSはこの設計にしたのか？' },
    { level: 'h3', id: 'AWSの設計思想', text: '💡 AWSの設計思想' },
