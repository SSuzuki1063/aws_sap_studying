---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = `AWS概念マップ｜階層用語集エンジン`;
const headContent = `<meta name="description" content="AWSサービスを設計軸・ドメイン・サービス・重要概念・キーワードの5階層で整理した知識エンジン。SAP試験対策に最適。"/>
  <link href="/aws_sap_studying/css/variables.css" rel="stylesheet"/>
  <link href="/aws_sap_studying/css/design-system.css" rel="stylesheet"/>
  <link href="/aws_sap_studying/css/common.css" rel="stylesheet"/>
  <link href="/aws_sap_studying/css/layout.css" rel="stylesheet"/>
  <link href="/aws_sap_studying/css/responsive.css" rel="stylesheet"/>
  <link href="/aws_sap_studying/css/pages/concept-map.css" rel="stylesheet"/>
  <link href="/aws_sap_studying/css/pages/mindmap.css" rel="stylesheet"/>`;
const bodyContent = `<!-- 学習進捗バー（概念マップ固有） -->
      <div class="mm-progress-wrap" role="status" aria-label="学習進捗">
        <span class="mm-progress-pct" id="mm-progress-pct">0%</span>
        <div class="mm-progress-track">
          <div class="mm-progress-fill" id="mm-progress-fill" style="width:0%"
               role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
      </div>

  <!-- パンくずナビゲーション -->
  <nav class="mm-breadcrumb-bar" aria-label="パンくず">
    <ol class="mm-breadcrumb-list" id="mm-breadcrumb"></ol>
  </nav>

  <main class="mm-page" id="mm-page">

    <!-- モバイル用タブバー (≤900px のみ表示) -->
    <div class="mm-tab-bar" role="tablist" aria-label="表示切り替え">
      <button id="mm-tab-map"    class="mm-tab mm-tab--active" role="tab"
              aria-selected="true"  aria-controls="mm-nav-col"    type="button">マップ</button>
      <button id="mm-tab-detail" class="mm-tab"                  role="tab"
              aria-selected="false" aria-controls="mm-detail-col" type="button">詳細</button>
    </div>

    <!-- 2カラムレイアウト -->
    <div class="mm-layout">

      <!-- 左列: マインドマップナビゲーター -->
      <div class="mm-nav-col" id="mm-nav-col" role="tabpanel" aria-labelledby="mm-tab-map">

        <!-- 検索バー -->
        <section class="mm-search-section search-section" aria-label="概念検索">
          <div class="search-bar-wrapper">
            <label class="sr-only" for="concept-search">AWS概念を検索</label>
            <input type="search" id="concept-search" class="concept-search-input"
              placeholder="概念・サービスを検索（3文字以上）" autocomplete="off"
              aria-label="AWS概念を検索" aria-controls="search-results" aria-autocomplete="list"/>
            <span class="search-icon" aria-hidden="true">🔍</span>
          </div>
          <div id="search-results" class="search-results" role="listbox" aria-label="検索結果" hidden></div>
          <p id="search-empty" class="search-empty" hidden>一致する概念が見つかりませんでした</p>
        </section>

        <!-- タグフィルタ -->
        <section class="mm-filter-section" aria-label="タグフィルタ">
          <div class="mm-filter-row">
            <div class="mm-filter-group">
              <fieldset>
                <legend class="mm-filter-label">設計軸</legend>
                <div class="mm-filter-tags" id="mm-axis-filter-tags"></div>
              </fieldset>
            </div>
            <div class="mm-filter-group">
              <fieldset>
                <legend class="mm-filter-label">SAPドメイン</legend>
                <div class="mm-filter-tags" id="mm-sap-filter-tags"></div>
              </fieldset>
            </div>
            <button type="button" class="mm-filter-clear" id="mm-filter-clear" hidden>✕ クリア</button>
          </div>
          <p class="mm-filter-status" id="mm-filter-status" aria-live="polite"></p>
        </section>

        <!-- 水平マインドマップツリー -->
        <nav class="mm-tree-nav" aria-label="AWS概念ナビゲーション">
          <ul id="mm-tree" class="mm-tree" role="tree" aria-label="AWS概念ツリー">
            <li class="mm-loading">
              <p class="loading-msg" id="loading-msg">概念マップを読み込み中...</p>
            </li>
          </ul>
        </nav>
      </div>

      <!-- リサイズハンドル（デスクトップのみ表示） -->
      <div class="mm-resize-handle" id="mm-resize-handle" aria-hidden="true"></div>

      <!-- 右列: 詳細パネル -->
      <div class="mm-detail-col" id="mm-detail-col" role="tabpanel" aria-labelledby="mm-tab-detail">
        <div id="mm-detail-panel" class="mm-detail-panel">
          <p class="mm-detail-placeholder">左からノードを選択してください</p>
        </div>
      </div>

    </div>
  </main>

  <script src="/aws_sap_studying/js/concept-engine/ConceptLoader.js"></script>
  <script src="/aws_sap_studying/js/concept-engine/ConceptIndex.js"></script>
  <script src="/aws_sap_studying/js/concept-engine/CrossLinkResolver.js"></script>
  <script src="/aws_sap_studying/js/concept-engine/SearchEngine.js"></script>
  <script src="/aws_sap_studying/js/concept-engine/MindmapController.js"></script>
  <script src="/aws_sap_studying/js/theme-toggle.js"></script>`;
---

<BaseLayout pageTitle={pageTitle}>
  <Fragment slot="head" set:html={headContent} />
  <Fragment set:html={bodyContent} />
</BaseLayout>
