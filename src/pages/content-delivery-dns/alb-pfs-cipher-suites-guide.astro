          </td>
<td>
<span class="cipher-pfs-badge">
            ✓ PFS
           </span>
</td>
<td>
           1.3
          </td>
<td>
<div class="cipher-strength">
<div class="strength-bar active high">
</div>
<div class="strength-bar active high">
</div>
<div class="strength-bar active high">
</div>
<div class="strength-bar active high">
</div>
<div class="strength-bar active high">
</div>
</div>
</td>
