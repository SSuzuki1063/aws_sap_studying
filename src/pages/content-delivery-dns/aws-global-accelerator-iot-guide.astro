    <section class="section">
      <h2 class="section-title">
        <span class="section-title-icon" aria-hidden="true">💻</span>
        実装例：CLI / CloudFormation / Python
      </h2>

      <div class="code-tabs" role="tablist">
        <button class="code-tab active" role="tab" aria-selected="true" aria-controls="panel-cli" id="tab-cli">AWS CLI</button>
        <button class="code-tab" role="tab" aria-selected="false" aria-controls="panel-cfn" id="tab-cfn">CloudFormation</button>
