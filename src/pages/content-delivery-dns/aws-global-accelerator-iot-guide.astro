---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Aws Global Accelerator Iot Guide',
  pageTitle: 'AWS Global Accelerator × IoT デバイス接続 完全ガイド',
  category: 'content-delivery-dns',
  categoryLabel: 'コンテンツ配信・DNS',
  subcategory: 'CloudFront & コンテンツ配信',
  slug: 'aws-global-accelerator-iot-guide',
  pageCss: '/aws_sap_studying/css/pages/aws-global-accelerator-iot-guide.css',
  tocItems: [
    { level: 'h3', id: '静的-IP-でファイアウォール設定を簡素化', text: '静的 IP でファイアウォール設定を簡素化' },
    { level: 'h3', id: 'AWS-グローバルネットワークで低レイテンシー', text: 'AWS グローバルネットワークで低レイテンシー' },
    { level: 'h3', id: 'TCPUDP-プロトコルをネイティブサポート', text: 'TCP/UDP プロトコルをネイティブサポート' },
    { level: 'h3', id: '自動フェイルオーバーで高可用性を実現', text: '自動フェイルオーバーで高可用性を実現' },
    { level: 'h2', id: 'たとえ話「世界規模の高速道路ネットワーク」で理解する', text: '🚄 たとえ話：「世界規模の高速道路ネットワーク」で理解する' },
    { level: 'h3', id: 'IoT-デバイスの通信-世界中の工場から本社へ荷物を届ける物流', text: 'IoT デバイスの通信 ＝ 世界中の工場から本社へ荷物を届ける物流' },
    { level: 'h2', id: 'IoT-デバイス接続が難しい-4-つの理由', text: '🤔 IoT デバイス接続が難しい 4 つの理由' },
    { level: 'h2', id: '全体アーキテクチャ図', text: '📐 全体アーキテクチャ図' },
    { level: 'h2', id: 'なぜ-IoT-に-Global-Accelerator-が最適なのか', text: '💡 なぜ IoT に Global Accelerator が最適なのか' },
    { level: 'h3', id: '試験対策ポイントANS-C01', text: '📝 試験対策ポイント（ANS-C01）' },
    { level: 'h2', id: '比較Global-Accelerator-あり-vs-なし', text: '⚖️ 比較：Global Accelerator あり vs なし' },
    { level: 'h3', id: 'Global-Accelerator-なし', text: '❌ Global Accelerator なし' },
    { level: 'h3', id: 'Global-Accelerator-あり', text: '✅ Global Accelerator あり' },
    { level: 'h2', id: '代表的なアーキテクチャパターン', text: '🏗️ 代表的なアーキテクチャパターン' },
    { level: 'h2', id: '実装例CLI-CloudFormation-Python', text: '💻 実装例：CLI / CloudFormation / Python' },
    { level: 'h2', id: 'ベストプラクティス', text: '✅ ベストプラクティス' },
    { level: 'h2', id: 'よくある質問FAQ', text: '❓ よくある質問（FAQ）' },
    { level: 'h2', id: 'まとめ', text: 'まとめ' },
  ],
};

const rawContent = `

  <!-- Hero Section: 結論ファースト -->
  <header class="hero">
    <div class="hero-content">
      <div class="hero-badge" aria-hidden="true">Networking × IoT</div>
      <h1>AWS Global Accelerator を使用した<br>IoT デバイス接続</h1>
      <p class="hero-subtitle">世界中の IoT デバイスを高速・安定・シンプルに AWS へ接続する方法</p>

      <div class="conclusion-grid">
        <div class="conclusion-card">
          <div class="conclusion-icon" aria-hidden="true">🌐</div>
          <h3>静的 IP でファイアウォール設定を簡素化</h3>
          <p>DNS に依存せず、2つの固定 Anycast IP で世界中の IoT デバイスから接続可能</p>
        </div>
        <div class="conclusion-card">
          <div class="conclusion-icon" aria-hidden="true">⚡</div>
          <h3>AWS グローバルネットワークで低レイテンシー</h3>
          <p>公衆インターネットを最小化し、AWS 専用バックボーンでデータを高速転送</p>
        </div>
        <div class="conclusion-card">
          <div class="conclusion-icon" aria-hidden="true">🔄</div>
          <h3>TCP/UDP プロトコルをネイティブサポート</h3>
          <p>MQTT・HTTP・TCP すべてのIoTプロトコルに対応し柔軟な接続が可能</p>
        </div>
        <div class="conclusion-card">
          <div class="conclusion-icon" aria-hidden="true">🛡️</div>
          <h3>自動フェイルオーバーで高可用性を実現</h3>
          <p>エンドポイントのヘルスチェックと自動切り替えでダウンタイムを最小化</p>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="container">

    <!-- たとえ話セクション -->
    <section class="section">
      <h2 class="section-title">
        <span class="section-title-icon" aria-hidden="true">🚄</span>
        たとえ話：「世界規模の高速道路ネットワーク」で理解する
      </h2>

      <div class="analogy-intro">
        <h3>IoT デバイスの通信 ＝ 世界中の工場から本社へ荷物を届ける物流</h3>
        <p>Global Accelerator は、一般道（公衆インターネット）の代わりに<br><strong>専用高速道路（AWS グローバルネットワーク）</strong>を使って荷物を最速で届ける仕組みです</p>
      </div>

      <div class="analogy-mapping">
        <div class="analogy-card">
          <div class="analogy-card-header">
            <span class="analogy-emoji" aria-hidden="true">🏭</span>
            <h4>IoT デバイス ＝ 世界中の工場</h4>
          </div>
          <div class="analogy-real">
            <div class="analogy-real-label">たとえ話</div>
            <p>各地の工場がセンサーデータ（荷物）を本社に送りたい</p>
          </div>
          <div class="analogy-aws">
            <div class="analogy-aws-label">AWS での実体</div>
            <p>温度センサー、カメラ、機器モニターなどの IoT デバイスが AWS にデータを送信</p>
          </div>
        </div>

        <div class="analogy-card">
          <div class="analogy-card-header">
            <span class="analogy-emoji" aria-hidden="true">🛣️</span>
            <h4>Global Accelerator ＝ 専用高速道路</h4>
          </div>
          <div class="analogy-real">
            <div class="analogy-real-label">たとえ話</div>
            <p>渋滞する一般道ではなく、最寄りの IC（エッジロケーション）から専用高速道路へ</p>
          </div>
          <div class="analogy-aws">
            <div class="analogy-aws-label">AWS での実体</div>
            <p>Anycast IP で最寄りのエッジロケーションに到達後、AWS バックボーンネットワークで転送</p>
          </div>
        </div>

        <div class="analogy-card">
          <div class="analogy-card-header">
            <span class="analogy-emoji" aria-hidden="true">🏢</span>
            <h4>AWS リージョン ＝ 本社データセンター</h4>
          </div>
          <div class="analogy-real">
            <div class="analogy-real-label">たとえ話</div>
            <p>荷物が届く最終目的地。複数の本社があれば近い方に自動振り分け</p>
          </div>
          <div class="analogy-aws">
            <div class="analogy-aws-label">AWS での実体</div>
            <p>NLB + IoT Core エンドポイントが稼働するリージョン。フェイルオーバーも自動</p>
          </div>
        </div>

        <div class="analogy-card">
          <div class="analogy-card-header">
            <span class="analogy-emoji" aria-hidden="true">📍</span>
            <h4>固定 IP ＝ 本社の住所（変わらない）</h4>
          </div>
          <div class="analogy-real">
            <div class="analogy-real-label">たとえ話</div>
            <p>工場に配る住所は 2つだけ。引っ越ししても住所は変わらない</p>
          </div>
          <div class="analogy-aws">
            <div class="analogy-aws-label">AWS での実体</div>
            <p>2つの静的 Anycast IP はリージョン追加・変更しても不変。ファイアウォール設定も固定</p>
          </div>
        </div>
      </div>

      <!-- たとえ話マッピングテーブル -->
      <div class="mapping-table-wrapper">
        <table class="mapping-table">
          <thead>
            <tr>
              <th>たとえ話（物流ネットワーク）</th>
              <th>AWS の実際の概念</th>
              <th>役割</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>世界中の工場</td>
              <td>IoT デバイス群</td>
              <td>データの送信元</td>
            </tr>
            <tr>
              <td>一般道（渋滞あり）</td>
              <td>パブリックインターネット</td>
              <td>通常の通信経路（遅延大）</td>
            </tr>
            <tr>
              <td>最寄りの IC（インターチェンジ）</td>
              <td>エッジロケーション</td>
              <td>最も近い接続ポイント</td>
            </tr>
            <tr>
              <td>専用高速道路</td>
              <td>AWS グローバルネットワーク</td>
              <td>高速・安定の専用回線</td>
            </tr>
            <tr>
              <td>本社の固定住所（2つ）</td>
              <td>静的 Anycast IP（2つ）</td>
              <td>変わらない接続先アドレス</td>
            </tr>
            <tr>
              <td>本社の荷受け窓口</td>
              <td>NLB + IoT Core</td>
              <td>データの受け取りと処理</td>
            </tr>
            <tr>
              <td>自動転送（本社A障害→本社Bへ）</td>
              <td>自動フェイルオーバー</td>
              <td>障害時の自動切り替え</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- IoTデバイス接続の課題 -->
    <section class="section">
      <h2 class="section-title">
        <span class="section-title-icon" aria-hidden="true">🤔</span>
        IoT デバイス接続が難しい 4 つの理由
      </h2>

      <div class="challenge-grid">
        <div class="challenge-card">
          <div class="challenge-icon" aria-hidden="true">🌍</div>
          <h4>グローバル分散</h4>
          <p>デバイスは世界中のあらゆる場所に配置される。遠隔地・衛星回線の場合も</p>
        </div>
        <div class="challenge-card">
          <div class="challenge-icon" aria-hidden="true">🔒</div>
          <h4>厳格なファイアウォール</h4>
          <p>工場や施設では開放できる IP・ポートが限られる。DNS ベースでは管理困難</p>
        </div>
        <div class="challenge-card">
          <div class="challenge-icon" aria-hidden="true">🔋</div>
          <h4>リソース制約</h4>
          <p>バッテリー駆動の IoT デバイスは DNS 解決のような追加通信も節約したい</p>
        </div>
        <div class="challenge-card">
          <div class="challenge-icon" aria-hidden="true">⏱️</div>
          <h4>低レイテンシー要求</h4>
          <p>リアルタイム監視や制御では、通信遅延が致命的な問題になる</p>
        </div>
      </div>
    </section>

    <!-- アーキテクチャ図 -->
    <section class="section">
      <h2 class="section-title">
        <span class="section-title-icon" aria-hidden="true">📐</span>
        全体アーキテクチャ図
      </h2>
      <p>IoT デバイスが Global Accelerator を経由して AWS リージョンに接続する全体の流れを可視化します。</p>

      <div class="diagram-container">
        <svg width="1200" height="700" viewBox="0 0 1200 700" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="IoTデバイスがGlobal Acceleratorを経由してAWSリージョンに接続するアーキテクチャ図">
          <defs>
            <marker id="arrow-blue" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
              <path d="M0,0 L10,5 L0,10 Z" fill="#3B82F6"/>
            </marker>
            <marker id="arrow-green" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
              <path d="M0,0 L10,5 L0,10 Z" fill="#10B981"/>
            </marker>
            <marker id="arrow-orange" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
              <path d="M0,0 L10,5 L0,10 Z" fill="#F59E0B"/>
            </marker>
            <filter id="shadow-soft" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#0F172A" flood-opacity="0.10"/>
            </filter>
            <style>
              .svg-title { font-family: "Noto Sans JP", sans-serif; font-size: 22px; font-weight: 700; fill: #0F172A; }
              .svg-label { font-family: "Noto Sans JP", sans-serif; font-size: 20px; font-weight: 600; fill: #1E293B; }
              .svg-sub { font-family: "Noto Sans JP", sans-serif; font-size: 20px; font-weight: 500; fill: #475569; }
              .svg-step { font-family: "Noto Sans JP", sans-serif; font-size: 20px; font-weight: 700; fill: #FFFFFF; }
              .svg-zone-label { font-family: "Noto Sans JP", sans-serif; font-size: 20px; font-weight: 600; fill: #6B7280; }
            </style>
          </defs>

          <!-- Background -->
          <rect x="0" y="0" width="1200" height="700" fill="#F3F4F6"/>
          <rect x="20" y="20" width="1160" height="660" rx="22" fill="#FFFFFF" filter="url(#shadow-soft)"/>

          <!-- Title -->
          <text x="600" y="65" text-anchor="middle" class="svg-title">IoT × Global Accelerator アーキテクチャ全体図</text>

          <!-- Inner Panel -->
          <rect x="36" y="85" width="1128" height="580" rx="18" fill="#F8FAFC"/>

          <!-- Zone Labels -->
          <text x="150" y="115" text-anchor="middle" class="svg-zone-label">IoT デバイス</text>
          <text x="430" y="115" text-anchor="middle" class="svg-zone-label">エッジ</text>
          <text x="710" y="115" text-anchor="middle" class="svg-zone-label">AWS ネットワーク</text>
          <text x="1020" y="115" text-anchor="middle" class="svg-zone-label">AWS リージョン</text>

          <!-- Zone dividers -->
          <line x1="290" y1="95" x2="290" y2="655" stroke="#E5E7EB" stroke-width="1" stroke-dasharray="6,4"/>
          <line x1="560" y1="95" x2="560" y2="655" stroke="#E5E7EB" stroke-width="1" stroke-dasharray="6,4"/>
          <line x1="850" y1="95" x2="850" y2="655" stroke="#E5E7EB" stroke-width="1" stroke-dasharray="6,4"/>

          <!-- IoT Devices (Column 1) -->
          <g>
            <rect x="56" y="150" width="190" height="90" rx="16" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
            <text x="151" y="185" text-anchor="middle" class="svg-label">🏭 工場センサー</text>
            <text x="151" y="220" text-anchor="middle" class="svg-sub">TCP / MQTT</text>
          </g>
          <g>
            <rect x="56" y="280" width="190" height="90" rx="16" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
            <text x="151" y="315" text-anchor="middle" class="svg-label">🚗 車載デバイス</text>
            <text x="151" y="350" text-anchor="middle" class="svg-sub">TCP / HTTP</text>
          </g>
          <g>
            <rect x="56" y="410" width="190" height="90" rx="16" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
            <text x="151" y="445" text-anchor="middle" class="svg-label">📡 遠隔モニタ</text>
            <text x="151" y="480" text-anchor="middle" class="svg-sub">TCP / UDP</text>
          </g>
          <g>
            <rect x="56" y="540" width="190" height="90" rx="16" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/>
            <text x="151" y="575" text-anchor="middle" class="svg-label">🌡️ スマート農業</text>
            <text x="151" y="610" text-anchor="middle" class="svg-sub">MQTT</text>
          </g>

          <!-- Edge Locations (Column 2) -->
          <g>
            <rect x="320" y="190" width="220" height="90" rx="16" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
            <text x="430" y="228" text-anchor="middle" class="svg-label">エッジロケーション</text>
            <text x="430" y="260" text-anchor="middle" class="svg-sub">東京</text>
          </g>
          <g>
            <rect x="320" y="380" width="220" height="90" rx="16" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
            <text x="430" y="418" text-anchor="middle" class="svg-label">エッジロケーション</text>
            <text x="430" y="450" text-anchor="middle" class="svg-sub">フランクフルト</text>
          </g>
          <g>
            <rect x="320" y="540" width="220" height="90" rx="16" fill="#EEF2FF" stroke="#818CF8" stroke-width="2"/>
            <text x="430" y="578" text-anchor="middle" class="svg-label">エッジロケーション</text>
            <text x="430" y="610" text-anchor="middle" class="svg-sub">バージニア</text>
          </g>

          <!-- Global Accelerator (Column 3) -->
          <g>
            <rect x="590" y="220" width="230" height="120" rx="16" fill="#FFF7ED" stroke="#FDBA74" stroke-width="2.5"/>
            <text x="705" y="260" text-anchor="middle" class="svg-label">Global Accelerator</text>
            <text x="705" y="290" text-anchor="middle" class="svg-sub">静的 IP: 2つ</text>
            <text x="705" y="320" text-anchor="middle" class="svg-sub">TCP/UDP リスナー</text>
          </g>
          <g>
            <rect x="590" y="400" width="230" height="100" rx="16" fill="#FEFCE8" stroke="#FACC15" stroke-width="2"/>
            <text x="705" y="438" text-anchor="middle" class="svg-label">ヘルスチェック</text>
            <text x="705" y="470" text-anchor="middle" class="svg-sub">自動フェイルオーバー</text>
          </g>

          <!-- AWS Region endpoints (Column 4) -->
          <g>
            <rect x="880" y="150" width="260" height="90" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
            <text x="1010" y="185" text-anchor="middle" class="svg-label">NLB → IoT Core</text>
            <text x="1010" y="218" text-anchor="middle" class="svg-sub">ap-northeast-1</text>
          </g>
          <g>
            <rect x="880" y="290" width="260" height="90" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
            <text x="1010" y="325" text-anchor="middle" class="svg-label">NLB → IoT Core</text>
            <text x="1010" y="358" text-anchor="middle" class="svg-sub">eu-west-1</text>
          </g>
          <g>
            <rect x="880" y="430" width="260" height="90" rx="16" fill="#ECFDF5" stroke="#34D399" stroke-width="2"/>
            <text x="1010" y="465" text-anchor="middle" class="svg-label">NLB → IoT Core</text>
            <text x="1010" y="498" text-anchor="middle" class="svg-sub">us-east-1</text>
          </g>

          <!-- VPC Endpoint label -->
          <g>
            <rect x="880" y="560" width="260" height="80" rx="16" fill="#FEF2F2" stroke="#F87171" stroke-width="2"/>
            <text x="1010" y="593" text-anchor="middle" class="svg-label">VPC Endpoint</text>
            <text x="1010" y="623" text-anchor="middle" class="svg-sub">プライベート接続</text>
          </g>

          <!-- Arrows: IoT → Edge -->
          <line x1="246" y1="195" x2="318" y2="225" stroke="#3B82F6" stroke-width="2.5" marker-end="url(#arrow-blue)"/>
          <line x1="246" y1="325" x2="318" y2="415" stroke="#3B82F6" stroke-width="2.5" marker-end="url(#arrow-blue)"/>
          <line x1="246" y1="455" x2="318" y2="425" stroke="#3B82F6" stroke-width="2.5" marker-end="url(#arrow-blue)"/>
          <line x1="246" y1="585" x2="318" y2="585" stroke="#3B82F6" stroke-width="2.5" marker-end="url(#arrow-blue)"/>

          <!-- Arrows: Edge → GA -->
          <line x1="540" y1="235" x2="588" y2="265" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrow-orange)"/>
          <line x1="540" y1="425" x2="588" y2="310" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrow-orange)"/>
          <line x1="540" y1="585" x2="588" y2="320" stroke="#F59E0B" stroke-width="2.5" marker-end="url(#arrow-orange)"/>

          <!-- Arrows: GA → Region endpoints -->
          <line x1="820" y1="260" x2="878" y2="200" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrow-green)"/>
          <line x1="820" y1="280" x2="878" y2="335" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrow-green)"/>
          <line x1="820" y1="300" x2="878" y2="475" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrow-green)"/>

          <!-- Health check arrow -->
          <line x1="820" y1="450" x2="878" y2="475" stroke="#94A3B8" stroke-width="1.5" stroke-dasharray="6,4"/>
          <line x1="820" y1="440" x2="878" y2="345" stroke="#94A3B8" stroke-width="1.5" stroke-dasharray="6,4"/>
          <line x1="820" y1="430" x2="878" y2="210" stroke="#94A3B8" stroke-width="1.5" stroke-dasharray="6,4"/>

          <!-- Step labels -->
          <circle cx="280" cy="200" r="14" fill="#3B82F6"/>
          <text x="280" y="206" text-anchor="middle" class="svg-step">1</text>

          <circle cx="565" cy="270" r="14" fill="#F59E0B"/>
