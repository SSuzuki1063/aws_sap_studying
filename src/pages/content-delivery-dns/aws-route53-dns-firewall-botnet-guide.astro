---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Aws Route53 Dns Firewall Botnet Guide',
  pageTitle: 'Route 53 Resolver DNS Firewall｜ボットネットC&amp;C対策完全ガイド',
  category: 'content-delivery-dns',
  categoryLabel: 'コンテンツ配信・DNS',
  subcategory: 'Route53 & DNS管理',
  slug: 'aws-route53-dns-firewall-botnet-guide',
  pageCss: undefined,
  tocItems: [
    { level: 'h2', id: 'DNS-Firewallは電話帳の番号を照合する門番', text: 'DNS Firewallは「電話帳の番号を照合する門番」' },
    { level: 'h3', id: '会社のPCが乗っ取られた場面', text: '会社のPCが乗っ取られた場面' }
  ],
  prevPage: 'route53-dnssec-100.html',
  nextPage: undefined,
  pageNum: 19,
  pageTotal: 19,
};

const rawContent = `<style>/* ===== リセット & ベース ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', sans-serif;
      background: #F0F4F8;
      color: #1E293B;
      line-height: 1.7;
      font-size: 15px;
            padding-top: 70px;}

    /* ===== ページヘッダー ===== */
    .page-header {
      background: linear-gradient(135deg, #0F172A 0%, #1E3A5F 50%, #0F172A 100%);
      color: #fff;
      padding: 56px 40px 40px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .page-header::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at 30% 50%, rgba(99,179,237,0.15) 0%, transparent 60%),
                  radial-gradient(ellipse at 70% 50%, rgba(239,68,68,0.10) 0%, transparent 60%);
    }
    .page-header .service-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(99,179,237,0.2);
      border: 1px solid rgba(99,179,237,0.4);
      border-radius: 999px;
      padding: 6px 18px;
      font-size: 0.82em;
      font-weight: 600;
      color: #93C5FD;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 20px;
      position: relative;
    }
    .page-header h1 {
      font-size: 2.4em;
      font-weight: 800;
      line-height: 1.2;
      position: relative;
      margin-bottom: 12px;
      color: #fff;
    }
    .page-header h1 .accent { color: #FBB040; }
    .page-header .subtitle {
      font-size: 1.05em;
      color: #94A3B8;
      position: relative;
      max-width: 700px;
      margin: 0 auto 30px;
    }
    .header-meta {
      display: flex; justify-content: center; gap: 24px;
      position: relative;
    }
    .header-meta .meta-item {
      display: flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,0.08);
      border-radius: 8px; padding: 8px 16px;
      font-size: 0.88em; color: #CBD5E1;
    }

    /* ===== コンテンツラッパー ===== */
    .wrapper {
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }

    /* ===== セクション共通 ===== */
    .section {
      background: #fff;
      border-radius: 16px;
      padding: 36px 40px;
      margin-bottom: 32px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06), 0 0 0 1px rgba(0,0,0,0.04);
    }
    .section-title {
      display: flex; align-items: center; gap: 12px;
      font-size: 1.35em; font-weight: 700;
      color: #0F172A;
      margin-bottom: 28px;
      padding-bottom: 16px;
      border-bottom: 2px solid #E2E8F0;
    }
    .section-title .icon-wrap {
      width: 40px; height: 40px;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2em; flex-shrink: 0;
    }

    /* ===== 結論カード ===== */
    .conclusion-box {
      background: linear-gradient(135deg, #1E3A5F 0%, #0F172A 100%);
      border-radius: 16px;
      padding: 36px 40px;
      margin-bottom: 32px;
      color: #fff;
      position: relative;
      overflow: hidden;
    }
    .conclusion-box::before {
      content: '💡';
      position: absolute; right: 40px; top: 30px;
      font-size: 5em; opacity: 0.08;
    }
    .conclusion-box .label {
      display: inline-block;
      background: #FBB040;
      color: #0F172A;
      font-size: 0.78em; font-weight: 800;
      letter-spacing: 0.1em; text-transform: uppercase;
      padding: 4px 14px; border-radius: 999px;
      margin-bottom: 16px;
    }
    .conclusion-box h2 {
      font-size: 1.55em; font-weight: 700;
      line-height: 1.3; margin-bottom: 16px;
      color: #E2E8F0;
    }
    .conclusion-box h2 .hl { color: #FBB040; }
    .conclusion-points {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 14px; margin-top: 20px;
    }
    .conclusion-point {
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 10px; padding: 14px 18px;
      display: flex; align-items: flex-start; gap: 10px;
    }
    .conclusion-point .cp-icon { font-size: 1.4em; flex-shrink: 0; }
    .conclusion-point .cp-text { font-size: 0.9em; color: #CBD5E1; line-height: 1.5; }
    .conclusion-point .cp-text strong { color: #fff; display: block; margin-bottom: 2px; }

    /* ===== 均等グリッド ===== */
    .equal-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .equal-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
    .equal-grid-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; }

    /* ===== たとえ話カード ===== */
    .analogy-card {
      border-radius: 12px; padding: 22px;
      border: 2px solid;
    }
    .analogy-card.real {
      background: #FFF7ED; border-color: #FED7AA;
    }
    .analogy-card.aws {
      background: #EFF6FF; border-color: #BFDBFE;
    }
    .analogy-card .ac-label {
      font-size: 0.72em; font-weight: 800;
      letter-spacing: 0.08em; text-transform: uppercase;
      padding: 3px 10px; border-radius: 999px;
      display: inline-block; margin-bottom: 10px;
    }
    .analogy-card.real .ac-label { background: #FED7AA; color: #92400E; }
    .analogy-card.aws .ac-label { background: #BFDBFE; color: #1E40AF; }
    .analogy-card h4 { font-size: 1.05em; font-weight: 700; margin-bottom: 8px; }
    .analogy-card p { font-size: 0.9em; color: #475569; line-height: 1.6; }

    /* ===== フロー図 ===== */
    .flow-diagram {
      position: relative;
    }
    .flow-row {
      display: flex; align-items: stretch;
      gap: 0; margin-bottom: 0;
    }
    .flow-node {
      flex: 1; border-radius: 12px; padding: 18px 16px;
      text-align: center; position: relative;
    }
    .flow-node .fn-icon { font-size: 2em; margin-bottom: 8px; display: block; }
    .flow-node .fn-label { font-size: 0.78em; font-weight: 700; line-height: 1.3; }
    .flow-node .fn-sub { font-size: 0.68em; color: #64748B; margin-top: 4px; }
    .flow-arrow {
      display: flex; align-items: center; justify-content: center;
      width: 36px; flex-shrink: 0; color: #94A3B8; font-size: 1.3em;
    }

    .attack-flow {
      background: linear-gradient(135deg, #FEF2F2 0%, #FFF7ED 100%);
      border: 2px solid #FECACA; border-radius: 16px; padding: 28px 28px 28px;
      overflow: visible;
    }
    .attack-flow .af-title {
      color: #B91C1C; font-weight: 700; font-size: 0.9em;
      text-transform: uppercase; letter-spacing: 0.06em;
      margin-bottom: 20px; display: flex; align-items: center; gap: 8px;
    }

    /* ===== 保護フロー ===== */
    .protect-flow {
      background: linear-gradient(135deg, #F0FDF4 0%, #ECFDF5 100%);
      border: 2px solid #BBF7D0; border-radius: 16px; padding: 28px 28px 28px;
      overflow: visible;
    }
    .protect-flow .pf-title {
      color: #15803D; font-weight: 700; font-size: 0.9em;
      text-transform: uppercase; letter-spacing: 0.06em;
      margin-bottom: 20px; display: flex; align-items: center; gap: 8px;
    }

    /* ===== フロー共通ステップ ===== */
    .af-steps {
      display: flex; align-items: stretch; gap: 0;
      padding-top: 18px; /* バッジの上はみ出し分を確保 */
    }
    .af-step {
      flex: 1; min-width: 0;
      background: #fff; border-radius: 10px; padding: 14px 8px 14px;
      text-align: center; border: 2px solid #FECACA;
      position: relative;
    }
    .af-step .step-num {
      position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
      background: #EF4444; color: #fff;
      width: 26px; height: 26px; border-radius: 50%;
      font-size: 0.75em; font-weight: 800;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 2px 6px rgba(239,68,68,0.4);
    }
    .af-step .step-icon { font-size: 1.6em; margin: 6px 0 6px; display: block; }
    .af-step .step-text { font-size: 0.75em; font-weight: 600; line-height: 1.3; color: #374151; }
    .af-step .step-detail { font-size: 0.65em; color: #6B7280; margin-top: 4px; line-height: 1.4; }
    .af-arrow {
      color: #EF4444; font-size: 1.1em;
      padding: 0 4px; flex-shrink: 0;
      display: flex; align-items: center; padding-top: 14px;
    }

    /* ===== コンポーネントカード ===== */
    .comp-card {
      border-radius: 12px; padding: 22px;
      border: 2px solid; position: relative;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .comp-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
    .comp-card .cc-icon { font-size: 2em; margin-bottom: 10px; display: block; }
    .comp-card h4 { font-size: 1em; font-weight: 700; margin-bottom: 6px; }
    .comp-card p { font-size: 0.85em; line-height: 1.55; }
    .comp-card.blue { background: #EFF6FF; border-color: #93C5FD; }
    .comp-card.blue h4 { color: #1D4ED8; }
    .comp-card.purple { background: #F5F3FF; border-color: #C4B5FD; }
    .comp-card.purple h4 { color: #6D28D9; }
    .comp-card.green { background: #F0FDF4; border-color: #86EFAC; }
    .comp-card.green h4 { color: #15803D; }
    .comp-card.orange { background: #FFF7ED; border-color: #FDB96D; }
    .comp-card.orange h4 { color: #C2410C; }

    /* ===== アクション比較 ===== */
    .action-card {
      border-radius: 12px; padding: 24px;
      border: 2px solid; text-align: center;
    }
    .action-card .ac2-icon { font-size: 2.5em; margin-bottom: 10px; display: block; }
    .action-card h4 { font-size: 1.05em; font-weight: 800; margin-bottom: 8px; }
    .action-card .ac2-code {
      font-family: 'Courier New', monospace;
      font-size: 0.85em; font-weight: 700;
      padding: 4px 12px; border-radius: 6px;
      display: inline-block; margin-bottom: 10px;
    }
    .action-card p { font-size: 0.84em; color: #475569; line-height: 1.5; }
    .action-card .ac2-example {
      margin-top: 12px; padding: 10px;
      border-radius: 8px; font-size: 0.8em;
      font-style: italic;
    }
    .action-card.block { background: #FEF2F2; border-color: #FCA5A5; }
    .action-card.block h4 { color: #B91C1C; }
    .action-card.block .ac2-code { background: #FEE2E2; color: #B91C1C; }
    .action-card.block .ac2-example { background: #FEE2E2; color: #991B1B; }
    .action-card.alert { background: #FFFBEB; border-color: #FCD34D; }
    .action-card.alert h4 { color: #92400E; }
    .action-card.alert .ac2-code { background: #FEF3C7; color: #92400E; }
    .action-card.alert .ac2-example { background: #FEF3C7; color: #78350F; }
    .action-card.override { background: #EFF6FF; border-color: #93C5FD; }
    .action-card.override h4 { color: #1D4ED8; }
    .action-card.override .ac2-code { background: #DBEAFE; color: #1D4ED8; }
    .action-card.override .ac2-example { background: #DBEAFE; color: #1E40AF; }

    /* ===== ドメインリスト比較 ===== */
    .domain-list-card {
      border-radius: 12px; padding: 24px;
      border: 2px solid;
    }
    .domain-list-card h4 { font-size: 1.05em; font-weight: 700; margin-bottom: 10px; }
    .domain-list-card .dl-badge {
      display: inline-block; padding: 3px 10px;
      border-radius: 999px; font-size: 0.75em; font-weight: 700;
      margin-bottom: 12px;
    }
    .domain-list-card ul { list-style: none; padding: 0; }
    .domain-list-card ul li {
      display: flex; align-items: flex-start; gap: 8px;
      font-size: 0.85em; color: #475569;
      padding: 4px 0; border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    .domain-list-card ul li:last-child { border-bottom: none; }
    .domain-list-card.managed { background: #F5F3FF; border-color: #C4B5FD; }
    .domain-list-card.managed h4 { color: #5B21B6; }
    .domain-list-card.managed .dl-badge { background: #DDD6FE; color: #5B21B6; }
    .domain-list-card.custom { background: #FFF7ED; border-color: #FDB96D; }
    .domain-list-card.custom h4 { color: #C2410C; }
    .domain-list-card.custom .dl-badge { background: #FED7AA; color: #9A3412; }

    /* ===== アーキテクチャ図 ===== */
    .arch-diagram {
      background: #F8FAFC; border: 2px solid #E2E8F0;
      border-radius: 16px; padding: 32px;
    }
    .arch-vpc {
      border: 3px dashed #3B82F6; border-radius: 14px;
      padding: 24px; margin-bottom: 20px;
      position: relative;
    }
    .arch-vpc::before {
      content: '🌐 VPC';
      position: absolute; top: -13px; left: 20px;
      background: #3B82F6; color: #fff;
      font-size: 0.78em; font-weight: 700;
      padding: 3px 12px; border-radius: 999px;
    }
    .arch-subnet {
      background: #EFF6FF; border: 2px solid #93C5FD;
      border-radius: 10px; padding: 16px;
      display: flex; align-items: center; justify-content: center;
      gap: 32px; flex-wrap: wrap;
    }
    .arch-ec2 {
      display: flex; flex-direction: column; align-items: center;
      gap: 6px;
    }
    .arch-ec2 .ec2-icon {
      width: 64px; height: 64px; border-radius: 12px;
      background: #DBEAFE; border: 2px solid #60A5FA;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.8em;
    }
    .arch-ec2 .ec2-label { font-size: 0.78em; font-weight: 600; color: #1E40AF; }
    .arch-middle {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; margin-bottom: 20px;
    }
    .arch-firewall {
      flex: 1; background: linear-gradient(135deg, #1E3A5F, #0F172A);
      border-radius: 14px; padding: 20px 24px;
      text-align: center; color: #fff;
    }
    .arch-firewall .fw-icon { font-size: 2.2em; margin-bottom: 8px; display: block; }
    .arch-firewall h4 { font-size: 1em; font-weight: 700; margin-bottom: 4px; color: #FBB040; }
    .arch-firewall p { font-size: 0.8em; color: #94A3B8; }
    .arch-internet {
      display: flex; flex-direction: column; align-items: center; gap: 12px;
    }
    .arch-server {
      border-radius: 10px; padding: 14px 18px;
      text-align: center; min-width: 130px;
    }
    .arch-server.good { background: #F0FDF4; border: 2px solid #86EFAC; }
    .arch-server.bad { background: #FEF2F2; border: 2px solid #FCA5A5; }
    .arch-server .srv-icon { font-size: 1.6em; margin-bottom: 4px; display: block; }
    .arch-server .srv-label { font-size: 0.78em; font-weight: 700; }
    .arch-server.good .srv-label { color: #15803D; }
    .arch-server.bad .srv-label { color: #B91C1C; }
    .arch-log {
      background: #FFFBEB; border: 2px solid #FCD34D;
      border-radius: 10px; padding: 16px 20px;
    }
    .arch-log h5 { font-size: 0.85em; font-weight: 700; color: #92400E; margin-bottom: 8px; }
    .arch-log .log-items {
      display: flex; gap: 12px; flex-wrap: wrap;
    }
    .log-item {
      display: flex; align-items: center; gap: 6px;
      background: #fff; border-radius: 8px; padding: 6px 12px;
      font-size: 0.78em; color: #374151; border: 1px solid #FDE68A;
    }

    /* ===== ステップ実装 ===== */
    .impl-steps { counter-reset: step; }
    .impl-step {
      display: flex; gap: 20px; align-items: flex-start;
      padding: 20px 0; border-bottom: 1px solid #F1F5F9;
    }
    .impl-step:last-child { border-bottom: none; }
    .impl-step .step-num-wrap {
      width: 40px; height: 40px; flex-shrink: 0;
      border-radius: 50%;
      background: linear-gradient(135deg, #1E3A5F, #3B82F6);
      color: #fff; font-weight: 800; font-size: 1em;
      display: flex; align-items: center; justify-content: center;
    }
    .impl-step h4 { font-size: 1em; font-weight: 700; margin-bottom: 6px; }
    .impl-step p { font-size: 0.88em; color: #475569; line-height: 1.55; }
    .impl-step .code-chip {
      display: inline-flex; align-items: center; gap: 6px;
      background: #1E293B; color: #7DD3FC;
      font-family: 'Courier New', monospace; font-size: 0.8em;
      padding: 6px 12px; border-radius: 8px;
      margin-top: 8px;
    }

    /* ===== ベストプラクティス ===== */
    .bp-card {
      background: #F8FAFC; border: 1px solid #E2E8F0;
      border-left: 4px solid; border-radius: 10px;
      padding: 18px 20px;
    }
    .bp-card h4 { font-size: 0.95em; font-weight: 700; margin-bottom: 6px; }
    .bp-card p { font-size: 0.85em; color: #475569; line-height: 1.5; }
    .bp-card.bp-blue { border-left-color: #3B82F6; }
    .bp-card.bp-blue h4 { color: #1D4ED8; }
    .bp-card.bp-green { border-left-color: #10B981; }
    .bp-card.bp-green h4 { color: #065F46; }
    .bp-card.bp-orange { border-left-color: #F59E0B; }
    .bp-card.bp-orange h4 { color: #92400E; }
    .bp-card.bp-red { border-left-color: #EF4444; }
    .bp-card.bp-red h4 { color: #B91C1C; }

    /* ===== GuardDuty 連携バナー ===== */
    .integration-banner {
      background: linear-gradient(135deg, #4C1D95, #1E3A5F);
      border-radius: 14px; padding: 28px 32px;
      color: #fff; margin-top: 28px;
      display: flex; align-items: center; gap: 24px;
    }
    .integration-banner .ib-icon { font-size: 3em; flex-shrink: 0; }
    .integration-banner h4 { font-size: 1.15em; font-weight: 700; margin-bottom: 6px; color: #E9D5FF; }
    .integration-banner p { font-size: 0.88em; color: #C4B5FD; line-height: 1.6; }
    .integration-banner .ib-flow {
      display: flex; align-items: center; gap: 10px;
      margin-top: 12px; flex-wrap: wrap;
    }
    .ib-chip {
      background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px; padding: 6px 14px;
      font-size: 0.82em; font-weight: 600; color: #E9D5FF;
    }
    .ib-arrow { color: #A78BFA; }

    /* ===== 注意・補足 ===== */
    .note-box {
      display: flex; gap: 12px; align-items: flex-start;
      background: #F0F9FF; border: 1px solid #BAE6FD;
      border-radius: 10px; padding: 16px 20px;
      margin-top: 20px;
    }
    .note-box .nb-icon { font-size: 1.3em; flex-shrink: 0; }
    .note-box p { font-size: 0.86em; color: #0369A1; line-height: 1.55; }

    /* ===== FAQ ===== */
    .faq-item {
      border-bottom: 1px solid #F1F5F9; padding: 16px 0;
    }
    .faq-item:last-child { border-bottom: none; }
    .faq-q { font-weight: 700; font-size: 0.95em; color: #0F172A; margin-bottom: 8px; display: flex; gap: 10px; }
    .faq-q::before { content: 'Q'; color: #3B82F6; font-size: 1.1em; flex-shrink: 0; }
    .faq-a { font-size: 0.88em; color: #475569; line-height: 1.6; padding-left: 22px; }

    /* ===== フッター ===== */
    .page-footer {
      text-align: center; padding: 32px;
      color: #94A3B8; font-size: 0.82em;
      border-top: 1px solid #E2E8F0;
    }

    /* ===== レスポンシブ ===== */
    @media (max-width: 768px) {
      .page-header { padding: 40px 20px 30px; }
      .page-header h1 { font-size: 1.7em; }
      .wrapper { padding: 24px 16px 60px; }
      .section { padding: 24px 20px; }
      .equal-grid-2, .equal-grid-3, .equal-grid-4 { grid-template-columns: 1fr; }
      .conclusion-points { grid-template-columns: 1fr; }
      .header-meta { flex-direction: column; align-items: center; gap: 10px; }
      .af-steps { flex-direction: column; }
      .af-arrow { transform: rotate(90deg); }
      .integration-banner { flex-direction: column; }
      .arch-middle { flex-direction: column; }
    }
  
        /* ブレッドクラムナビゲーション */
