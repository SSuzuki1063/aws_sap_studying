            border-radius: 14px;
            border: 1px solid #e2e8f0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.92em;
        }

        thead th {
            background: #f1f5f9;
            padding: 14px 18px;
            text-align: left;
            font-weight: 700;
            color: #334155;
            border-bottom: 2px solid #e2e8f0;
        }

        thead th:first-child {
            width: 20%;
        }

        tbody td {
            padding: 14px 18px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: top;
        }

        tbody tr:hover {
            background: #fafbfd;
        }

        .td-open {
            background: #f0fdf4;
        }

        .td-close {
            background: #fef2f2;
        }

        /* ===== TECHNICAL FLOW DIAGRAMS ===== */
        .tech-flow-container {
            margin: 30px 0;
        }

        .tech-flow-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .tech-flow-panel {
            background: white;
            border-radius: 14px;
            padding: 30px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .tech-flow-panel h4 {
            font-size: 1.15em;
