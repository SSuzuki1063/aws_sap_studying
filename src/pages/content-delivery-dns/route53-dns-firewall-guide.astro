            padding: 3px 12px;
            border-radius: 8px;
            position: relative;
        }

        .comparison-card.fail-open .en-label {
            background: #d1fae5;
            color: #047857;
        }

        .comparison-card.fail-close .en-label {
            background: #fee2e2;
            color: #b91c1c;
        }

