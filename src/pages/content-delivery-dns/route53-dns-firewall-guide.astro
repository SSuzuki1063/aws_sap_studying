        .open-panel .step-number { background: #10b981; }
        .close-panel .step-number { background: #ef4444; }

        .step-content {
            flex: 1;
        }

        .step-content .step-title {
            font-weight: 700;
            font-size: 0.92em;
            margin-bottom: 3px;
        }

        .open-panel .step-title { color: #065f46; }
        .close-panel .step-title { color: #991b1b; }

        .step-content .step-desc {
            font-size: 0.85em;
            color: #64748b;
