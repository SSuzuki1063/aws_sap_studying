            line-height: 1.6;
            color: #334155;
            padding-top: 70px;}

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.12);
            overflow: hidden;
        }

        /* ===== HEADER ===== */
        .header {
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 40%, #1e40af 100%);
            color: white;
            padding: 50px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '🛡️';
            position: absolute;
            font-size: 18em;
            opacity: 0.08;
            top: -40px;
            right: -30px;
        }

        .header::after {
            content: '🌐';
            position: absolute;
            font-size: 12em;
            opacity: 0.06;
            bottom: -30px;
            left: -20px;
        }

        .header h1 {
            font-size: 2.8em;
            margin-bottom: 12px;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .header .subtitle {
            font-size: 1.3em;
            opacity: 0.92;
            position: relative;
            z-index: 1;
        }

        .badge-row {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 18px;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }

        .badge {
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85em;
            border: 1px solid rgba(255,255,255,0.3);
        }

        /* ===== CONTENT ===== */
        .content {
            padding: 50px;
        }

        /* ===== CONCLUSION FIRST ===== */
        .conclusion-first {
            background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 100%);
            border-radius: 16px;
            padding: 40px;
            margin-bottom: 50px;
            border: 2px solid #bfdbfe;
            position: relative;
        }

        .conclusion-first h2 {
            font-size: 1.8em;
            color: #1e40af;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .takeaway-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .takeaway-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            border-left: 4px solid;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .takeaway-card:nth-child(1) { border-left-color: #3b82f6; }
        .takeaway-card:nth-child(2) { border-left-color: #10b981; }
        .takeaway-card:nth-child(3) { border-left-color: #f59e0b; }

        .takeaway-card .label {
            font-size: 0.8em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }

        .takeaway-card:nth-child(1) .label { color: #3b82f6; }
        .takeaway-card:nth-child(2) .label { color: #10b981; }
        .takeaway-card:nth-child(3) .label { color: #f59e0b; }

        .takeaway-card p {
            font-size: 0.95em;
            color: #475569;
            line-height: 1.7;
        }

