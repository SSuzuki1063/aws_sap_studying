            line-height: 1.7;
        }

        .feature-card.blue h4 { color: #1d4ed8; }
        .feature-card.green h4 { color: #059669; }
        .feature-card.purple h4 { color: #7c3aed; }
        .feature-card.orange h4 { color: #d97706; }

        .feature-card.blue { border-top: 3px solid #3b82f6; }
        .feature-card.green { border-top: 3px solid #10b981; }
        .feature-card.purple { border-top: 3px solid #8b5cf6; }
        .feature-card.orange { border-top: 3px solid #f59e0b; }

        /* ===== FAIL-OPEN / FAIL-CLOSE COMPARISON ===== */
        .comparison-section {
            margin: 40px 0;
        }

        .comparison-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .comparison-card {
            border-radius: 16px;
            padding: 30px;
            position: relative;
            overflow: hidden;
        }

