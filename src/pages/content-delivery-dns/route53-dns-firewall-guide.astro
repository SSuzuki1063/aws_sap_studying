        .comparison-card.fail-close .desc { color: #7f1d1d; }

        .comparison-card .priority-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 700;
            position: relative;
        }

        .comparison-card.fail-open .priority-badge {
            background: #a7f3d0;
            color: #065f46;
        }

        .comparison-card.fail-close .priority-badge {
            background: #fecaca;
            color: #991b1b;
        }

