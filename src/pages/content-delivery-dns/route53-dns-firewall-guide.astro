            gap: 30px;
            margin-top: 20px;
        }

        .gate-scenario {
            background: white;
            border-radius: 14px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .gate-scenario h4 {
            font-size: 1.1em;
            margin-bottom: 12px;
        }

        .gate-scenario.open-gate h4 { color: #059669; }
        .gate-scenario.close-gate h4 { color: #dc2626; }

        .gate-visual {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            margin: 15px 0;
            font-size: 1.2em;
