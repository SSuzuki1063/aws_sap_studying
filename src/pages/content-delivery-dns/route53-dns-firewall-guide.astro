            opacity: 0.06;
            top: -20px;
            right: -10px;
        }

        .comparison-card.fail-open {
            background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
            border: 2px solid #86efac;
        }

        .comparison-card.fail-open::before {
            content: '🟢';
        }

        .comparison-card.fail-close {
            background: linear-gradient(135deg, #fef2f2 0%, #fecaca 100%);
            border: 2px solid #fca5a5;
        }

        .comparison-card.fail-close::before {
            content: '🔴';
        }

        .comparison-card h3 {
            font-size: 1.5em;
