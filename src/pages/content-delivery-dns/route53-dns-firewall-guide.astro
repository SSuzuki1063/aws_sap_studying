            color: #065f46;
            border: 1px solid #86efac;
        }

        .close-panel .step-result {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        /* ===== USE CASE GRID ===== */
        .usecase-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin: 30px 0;
        }

        .usecase-card {
            background: white;
            border-radius: 14px;
            padding: 25px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .usecase-card h4 {
