    { level: 'h3', id: 'シナリオ-大企業の複数オフィス', text: '📍 シナリオ：大企業の複数オフィス' },
    { level: 'h3', id: '東京オフィス', text: '🏢 東京オフィス' },
    { level: 'h3', id: '大阪オフィス', text: '🏢 大阪オフィス' },
    { level: 'h2', id: 'ネットワーク層L3の問題', text: 'ネットワーク層（L3）の問題' },
    { level: 'h3', id: 'アプリケーション層', text: 'アプリケーション層' },
    { level: 'h3', id: '東京オフィス-1', text: '東京オフィス' },
    { level: 'h3', id: '大阪オフィス-1', text: '大阪オフィス' },
    { level: 'h2', id: 'アプリケーション層L7の解決', text: 'アプリケーション層（L7）の解決' },
    { level: 'h3', id: 'DNS名による解決プロセス', text: '🔍 DNS名による解決プロセス' },
    { level: 'h2', id: 'AWS-PrivateLinkでの実装', text: 'AWS PrivateLinkでの実装' },
    { level: 'h3', id: '🪄-PrivateLinkの魔法的な仕組み', text: '🪄 PrivateLinkの魔法的な仕組み' },
    { level: 'h2', id: 'レイヤー別比較表', text: 'レイヤー別比較表' },
    { level: 'h3', id: '本質的な違いの理解', text: '本質的な違いの理解' },
    { level: 'h2', id: 'まとめ', text: '🎯 まとめ' }
  ],
  prevPage: 'aws_eip_nat_infographic.html',
  nextPage: '../organizational-complexity/aws_ram_vpc_prefix_infographic.html',
  pageNum: 8,
  pageTotal: 19,
