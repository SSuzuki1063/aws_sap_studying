---
import ResourceLayout from '../../layouts/ResourceLayout.astro';

const frontmatter = {
  title: 'Vpc Privatelink Cidr Overlap',
  pageTitle: 'ネットワーク層とアプリケーション層の違い',
  category: 'new-solutions',
  categoryLabel: 'ネットワーキング',
  subcategory: 'VPC & ネットワーク基礎',
  slug: 'vpc_privatelink_cidr_overlap',
  pageCss: '/aws_sap_studying/css/pages/vpc_privatelink_cidr_overlap.css',
  tocItems: [
