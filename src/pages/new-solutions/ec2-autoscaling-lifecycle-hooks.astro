    { level: 'h3', id: '終了ライフサイクルフック', text: '終了ライフサイクルフック' },
    { level: 'h3', id: 'Terminated', text: 'Terminated' },
    { level: 'h2', id: 'ライフサイクルフックの動作', text: '🔄 ライフサイクルフックの動作' },
    { level: 'h3', id: '一時停止とタイムアウト', text: '一時停止とタイムアウト' },
    { level: 'h3', id: '通知の送信', text: '通知の送信' },
    { level: 'h3', id: 'カスタムアクションの実行', text: 'カスタムアクションの実行' },
    { level: 'h3', id: 'ライフサイクルアクションの完了', text: 'ライフサイクルアクションの完了' },
    { level: 'h2', id: '️-実用的なユースケース', text: '🛠️ 実用的なユースケース' },
    { level: 'h3', id: '起動時のライフサイクルフック活用例', text: '起動時のライフサイクルフック活用例' },
    { level: 'h3', id: '終了時のライフサイクルフック活用例', text: '終了時のライフサイクルフック活用例' },
    { level: 'h2', id: 'ライフサイクルフックの設定方法', text: '📝 ライフサイクルフックの設定方法' },
