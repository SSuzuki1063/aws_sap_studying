<g>
<path d="M130,160 L190,160" stroke="#666" stroke-width="2">
</path>
<polygon fill="#666" points="190,160 185,156 185,164">
</polygon>
<text font-size="14" text-anchor="middle" x="160" y="150">
        リクエスト
       </text>
</g>
<!-- CloudFront → プライマリ（正常時） -->
<g>
<path d="M350,130 L440,130" stroke="#52C41A" stroke-width="3">
</path>
<polygon fill="#52C41A" points="440,130 435,126 435,134">
</polygon>
<circle cx="370" cy="130" fill="#52C41A" r="15">
