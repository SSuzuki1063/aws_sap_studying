<!-- プライマリオリジン -->
<g>
<rect fill="#F6FFED" height="80" rx="8" ry="8" stroke="#52C41A" stroke-width="2" width="80" x="450" y="110">
</rect>
<text font-size="14" font-weight="bold" text-anchor="middle" x="490" y="145">
