      </text>
<!-- ユーザー -->
<g>
<circle cx="80" cy="160" fill="#E6F7FF" r="40" stroke="#1890FF" stroke-width="2">
</circle>
<text font-size="14" font-weight="bold" text-anchor="middle" x="80" y="165">
