direction: down

# --- スタイル定義 ---
classes: {
  external: {
    style: {
      fill: "#E5E7EB"
      stroke: "#6B7280"
      font-color: "#374151"
      border-radius: 8
    }
  }
  gateway: {
    style: {
      fill: "#FF9900"
      stroke: "#232F3E"
      font-color: "#232F3E"
      border-radius: 8
      bold: true
    }
  }
  public: {
    style: {
      fill: "#DBEAFE"
      stroke: "#2563EB"
      font-color: "#1E3A5F"
      border-radius: 4
    }
  }
  private: {
    style: {
      fill: "#E0E7FF"
      stroke: "#4F46E5"
      font-color: "#312E81"
      border-radius: 4
    }
  }
  sap-tip: {
    style: {
      fill: "#FFF3CD"
      stroke: "#ED7100"
      font-color: "#232F3E"
      border-radius: 8
      bold: true
      font-size: 13
    }
  }
}

# --- 外部 ---
internet: Internet {class: external}

# --- VPC コンテナ ---
vpc: "VPC (10.0.0.0/16)" {
  style: {
    fill: "#F9FAFB"
    stroke: "#8C4FFF"
    font-color: "#232F3E"
    border-radius: 12
    bold: true
  }

  igw: Internet Gateway {class: gateway}

  # --- AZ-a ---
  az-a: "Availability Zone A" {
    style: {
      fill: "#F0FDF4"
      stroke: "#86EFAC"
      font-color: "#166534"
      border-radius: 8
    }

    pub-a: "Public Subnet\n(ELB / NAT GW)" {class: public}
    priv-a: "Private Subnet\n(App Server)" {class: private}
  }

  # --- AZ-b ---
  az-b: "Availability Zone B" {
    style: {
      fill: "#F0FDF4"
      stroke: "#86EFAC"
      font-color: "#166534"
      border-radius: 8
    }

    pub-b: "Public Subnet\n(NAT GW)" {class: public}
    priv-b: "Private Subnet\n(App Server)" {class: private}
  }
}

# --- SAP Tip ---
sap-tip: "SAP Tip:\nPublic = IGW経由\nPrivate = NAT GW経由" {class: sap-tip}

# --- 接続 ---
internet -> vpc.igw: "インバウンド" {
  style.stroke: "#2563EB"
}
vpc.igw -> vpc.az-a.pub-a: "" {
  style.stroke: "#2563EB"
}
vpc.igw -> vpc.az-b.pub-b: "" {
  style.stroke: "#2563EB"
}
vpc.az-a.pub-a -> vpc.az-a.priv-a: "NAT GW経由" {
  style.stroke: "#4F46E5"
  style.stroke-dash: 3
}
vpc.az-b.pub-b -> vpc.az-b.priv-b: "NAT GW経由" {
  style.stroke: "#4F46E5"
  style.stroke-dash: 3
}

# Multi-AZ 双方向
vpc.az-a.priv-a <-> vpc.az-b.priv-b: "Multi-AZ\n冗長化" {
  style.stroke: "#10B981"
  style.stroke-dash: 5
}
