{
  "id": "svc-vpc",
  "layer": 2,
  "type": "service",
  "name_ja": "Amazon VPC",
  "name_en": "Amazon VPC",
  "description_ja": "Amazon Virtual Private Cloud（VPC）は、AWSクラウド内に論理的に分離されたネットワーク空間を提供するサービス。IP範囲・サブネット・ルーティング・セキュリティを完全制御できる。",
  "sap_tip": "SAP試験では「サブネット設計」「Transit Gatewayによる複数VPC接続」「PrivateLinkによるサービスエンドポイント」が頻出。NAT GatewayとInternet Gatewayの使い分けを理解すること。",
  "parent_domain_id": "dom-network",
  "axis_tags": [
    "axis-security",
    "axis-governance",
    "axis-availability"
  ],
  "sap_domains": [
    "sap-d1-org-governance",
    "sap-d2-new-solutions"
  ],
  "tags": [
    "vpc",
    "subnet",
    "routing",
    "security-group",
    "nacl",
    "transit-gateway"
  ],
  "crosslinks": [
    {
      "target_id": "svc-route53",
      "type": "related",
      "description_ja": "PrivateHostedZoneはVPC内でのみ解決される"
    },
    {
      "target_id": "svc-ec2",
      "type": "related",
      "description_ja": "EC2インスタンスはVPCサブネット内に配置される"
    },
    {
      "target_id": "svc-rds",
      "type": "related",
      "description_ja": "RDSはVPCサブネットグループ内に配置される"
    }
  ],
  "key_concepts": [
    {
      "id": "con-vpc-subnet",
      "layer": 3,
      "type": "concept",
      "name_ja": "サブネット設計",
      "name_en": "Subnet Design",
      "description_ja": "VPCをパブリック・プライベート・データベース層に分割するサブネット設計。Multi-AZでの冗長化が基本。",
      "sap_tip": "パブリックサブネットはIGW経由でインターネット接続。プライベートサブネットはNAT Gateway経由で外部通信。",
      "axis_tags": [
        "axis-security",
        "axis-availability"
      ],
      "keywords": [
        {
          "id": "kw-vpc-subnet-public",
          "layer": 4,
          "type": "keyword",
          "name_ja": "パブリックサブネット",
          "name_en": "Public Subnet",
          "description_ja": "Internet Gatewayへのルートを持つサブネット。ELBやNAT Gatewayを配置。",
          "axis_tags": [
            "axis-availability"
          ]
        },
        {
          "id": "kw-vpc-subnet-private",
          "layer": 4,
          "type": "keyword",
          "name_ja": "プライベートサブネット",
          "name_en": "Private Subnet",
          "description_ja": "インターネットへの直接ルートを持たないサブネット。EC2やRDSを配置。",
          "axis_tags": [
            "axis-security"
          ]
        },
        {
          "id": "kw-vpc-subnet-nat",
          "layer": 4,
          "type": "keyword",
          "name_ja": "NAT Gateway",
          "name_en": "NAT Gateway",
          "description_ja": "プライベートサブネットからインターネットへのアウトバウンド通信を可能にするマネージドNAT。",
          "axis_tags": [
            "axis-availability",
            "axis-cost"
          ]
        }
      ]
    },
    {
      "id": "con-vpc-connectivity",
      "layer": 3,
      "type": "concept",
      "name_ja": "VPC接続オプション",
      "name_en": "VPC Connectivity",
      "description_ja": "複数VPCまたはオンプレミスとの接続方法。Transit Gateway・VPCピアリング・PrivateLink・VPN・Direct Connectを状況に応じて選択する。",
      "sap_tip": "Transit Gatewayはスターアーキテクチャで多数VPCを効率接続。VPCピアリングはCIDR重複不可、推移的ルーティング不可。",
      "axis_tags": [
        "axis-governance",
        "axis-availability"
      ],
      "keywords": [
        {
          "id": "kw-vpc-connectivity-tgw",
          "layer": 4,
          "type": "keyword",
          "name_ja": "Transit Gateway",
          "name_en": "Transit Gateway",
          "description_ja": "複数VPC・オンプレミスを中央ハブで接続するネットワークトランジットサービス。",
          "axis_tags": [
            "axis-governance"
          ]
        },
        {
          "id": "kw-vpc-connectivity-peering",
          "layer": 4,
          "type": "keyword",
          "name_ja": "VPCピアリング",
          "name_en": "VPC Peering",
          "description_ja": "2つのVPC間のプライベートネットワーク接続。CIDR重複不可、推移的ルーティング不可。",
          "axis_tags": [
            "axis-availability"
          ]
        },
        {
          "id": "kw-vpc-connectivity-privatelink",
          "layer": 4,
          "type": "keyword",
          "name_ja": "AWS PrivateLink",
          "name_en": "AWS PrivateLink",
          "description_ja": "VPCエンドポイント経由でAWSサービスやサードパーティサービスにプライベートアクセス。",
          "axis_tags": [
            "axis-security"
          ]
        }
      ]
    },
    {
      "id": "con-vpc-security",
      "layer": 3,
      "type": "concept",
      "name_ja": "VPCセキュリティ制御",
      "name_en": "VPC Security Controls",
      "description_ja": "セキュリティグループ（インスタンスレベル・ステートフル）とネットワークACL（サブネットレベル・ステートレス）の二層防御。",
      "sap_tip": "SG=ステートフル（戻りトラフィック自動許可）、NACL=ステートレス（インバウンド・アウトバウンド両方定義必要）。試験頻出の違い。",
      "axis_tags": [
        "axis-security"
      ],
      "keywords": [
        {
          "id": "kw-vpc-security-sg",
          "layer": 4,
          "type": "keyword",
          "name_ja": "セキュリティグループ",
          "name_en": "Security Group",
          "description_ja": "インスタンスレベルのステートフルファイアウォール。許可ルールのみ定義。",
          "axis_tags": [
            "axis-security"
          ]
        },
        {
          "id": "kw-vpc-security-nacl",
          "layer": 4,
          "type": "keyword",
          "name_ja": "ネットワークACL",
          "name_en": "Network ACL",
          "description_ja": "サブネットレベルのステートレスファイアウォール。許可・拒否ルールを番号順に評価。",
          "axis_tags": [
            "axis-security"
          ]
        },
        {
          "id": "kw-vpc-security-flow-log",
          "layer": 4,
          "type": "keyword",
          "name_ja": "VPCフローログ",
          "name_en": "VPC Flow Logs",
          "description_ja": "VPC内のネットワークトラフィックをキャプチャしCloudWatch LogsまたはS3に保存。",
          "axis_tags": [
            "axis-governance"
          ]
        }
      ]
    }
  ]
}